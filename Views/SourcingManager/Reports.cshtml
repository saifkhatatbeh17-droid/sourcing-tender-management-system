@model ManagerReportPage
@{
    ViewData["Title"] = "Reports & decisions";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sourcing-manager.css" asp-append-version="true" />
}

<div class="manager-shell manager-refresh">
    <header class="mr-heading"><div><h1>Reports &amp; decisions</h1><p>Review your recorded decisions, comments and tender outcomes.</p></div><span class="mr-count">@Model.Decisions.Count records</span></header>
    <form class="mr-filters workspace-search-card" method="get" asp-action="Reports">
        <h2 class="workspace-search-title">Find a report</h2>
            <div class="col-sm-5">
                <label for="search" class="form-label">Tender title</label>
                <div class="voice-search-control">
                    <div class="input-group">
                        <input class="form-control" id="search" name="search" placeholder="Search tender titles" value="@Model.Search" data-voice-search data-voice-search-mode="submit" aria-describedby="manager-report-voice-status" />
                        <select class="form-select form-select-sm w-auto" data-voice-search-language aria-label="Voice search language"><option value="en-US">English</option><option value="ar-JO">العربية</option></select>
                        <button type="button" class="btn btn-outline-primary" data-voice-search-button aria-label="Start voice search" aria-pressed="false" aria-describedby="manager-report-voice-status">
                            <svg data-voice-icon="mic" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3m-4 0h8"/></svg>
                            <svg data-voice-icon="stop" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" hidden><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
                        </button>
                    </div>
                    <div id="manager-report-voice-status" class="form-text small" data-voice-search-status role="status" aria-live="polite"></div>
                </div>
            </div>
            <div class="col-sm-4">
                <label for="decision" class="form-label">Decision</label>
                <select class="form-select" id="decision" name="decision">
                    <option value="">All decisions</option>
                    <option value="Approved" selected="@(Model.Decision == "Approved")">Approved</option>
                    <option value="Rejected" selected="@(Model.Decision == "Rejected")">Rejected</option>
                    <option value="ReturnedForReview" selected="@(Model.Decision == "ReturnedForReview")">Returned for review</option>
                </select>
            </div>
            <div class="col-sm-auto">
                <div class="mr-actions">
                    <button type="submit" class="btn btn-primary">Apply filters</button>
                    @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Decision))
                    {
                        <a class="btn btn-outline-primary" asp-action="Reports">Clear filters</a>
                    }
                </div>
            </div>
        </form>

<section class="workspace-section" aria-label="Reports">
        <div class="mr-record-heading mr-results-heading">
            <h2 id="manager-report-results">Decision history</h2>
            <a class="btn btn-outline-primary" asp-action="ReportsPdf" asp-route-search="@Model.Search" asp-route-decision="@Model.Decision">Download results (PDF)</a>
        </div>

        @if (Model.Decisions.Count == 0)
        {
            <div class="mr-empty"><span aria-hidden="true">↗</span>
                @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Decision))
                {
                    <h3>No matching decisions</h3><p>Try a different tender title or clear the filters.</p>
                }
                else
                {
                    <h3>No decisions recorded</h3><p>Decisions appear here after a committee submission has been reviewed.</p>
                    <a class="btn btn-outline-primary" asp-action="Submissions">Open Officer Submissions</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive" tabindex="0" role="region" aria-labelledby="manager-report-results">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th scope="col">Tender</th><th scope="col">Manager</th><th scope="col">Decision</th><th scope="col">Recorded (UTC)</th><th scope="col">Tender status</th><th scope="col">Comments</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Decisions)
                        {
                            <tr>
                                <td><strong class="mr-record-title">@item.Tender.Title</strong><small class="mr-reference">Tender #@item.TenderId</small></td>
                                <td>@item.User.FullName</td>
                                <td><span class="mr-status" data-state="@item.Decision">@(item.Decision == "ReturnedForReview" ? "Returned for review" : item.Decision)</span></td>
                                <td>@item.DecidedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@System.Text.RegularExpressions.Regex.Replace(item.Tender.Status, "([a-z])([A-Z])", "$1 $2")</td>
                                <td>@if (string.IsNullOrWhiteSpace(item.Notes)) { <span class="text-secondary">No comments</span> } else { <details class="mr-notes"><summary>Read comments</summary><p class="manager-text">@item.Notes</p></details> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts { <script src="~/js/sourcing-manager-workspace.js" asp-append-version="true"></script> }
