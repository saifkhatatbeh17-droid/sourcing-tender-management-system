@model IReadOnlyList<SourcingTenderManagement.Models.Entities.Tender>
<div class="modal fade" id="manager-rejections" tabindex="-1" aria-labelledby="manager-rejections-title" aria-hidden="true">
<div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
<div class="modal-header"><h2 id="manager-rejections-title" class="modal-title fs-5">Committee rejections</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
<div class="modal-body">
@if (Model.Count == 0) { <p>No committee rejections assigned to you.</p> }
@foreach (var tender in Model)
{
    var rejection = tender.TenderApprovals.First(a => a.Stage == "Top" && a.Decision == "Rejected");
    <section class="workspace-section">
        <h2>@tender.Title · #@tender.TenderId</h2>
        <p>Rejected by <strong>@rejection.User.FullName</strong> · @rejection.DecidedAt.ToString("yyyy-MM-dd HH:mm") UTC</p>
        <p class="text-break" style="white-space:pre-wrap">@rejection.Notes</p>
        @if (tender.RejectionForwardedAt.HasValue)
        { <p>Forwarded to the responsible officer on @tender.RejectionForwardedAt.Value.ToString("yyyy-MM-dd HH:mm") UTC.</p> }
        else if (tender.Status == "AwaitingManagerReview")
        { <form asp-action="ForwardRejection" method="post"><input name="id" value="@tender.TenderId" type="hidden" /><button class="btn btn-primary">Forward to Sourcing Officer</button></form> }
    </section>
}

</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button></div></div></div></div>
