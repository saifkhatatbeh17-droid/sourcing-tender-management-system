@model ManagerDashboard
@{
    ViewData["Title"] = "Sourcing Manager Dashboard";
    var metrics = new[]
    {
        (Label: "Awaiting manager review", Count: Model.AwaitingReview, Action: "Submissions", Decision: (string?)null),
        (Label: "Approved recommendations", Count: Model.Approved, Action: "Submissions", Decision: (string?)null),
        (Label: "Awaiting committee decision", Count: Model.AwaitingCommittee, Action: "Reports", Decision: (string?)"Approved"),
        (Label: "Pending questions for you", Count: Model.PendingClarifications, Action: "Clarifications", Decision: (string?)null)
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/sourcing-manager.css" asp-append-version="true" />
}

<div class="manager-shell">
    <div class="admin-dashboard">
        <div class="workspace-heading">
            <h1>Sourcing Manager Dashboard</h1>
            <a class="btn btn-primary" asp-action="Submissions">Review submissions <span aria-hidden="true">→</span></a>
        </div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 admin-metrics">
            @foreach (var metric in metrics)
            {
                <div class="col">
                    <a class="admin-metric manager-metric" asp-action="@metric.Action" asp-route-decision="@metric.Decision">
                        <dl class="mb-0">
                            <dt>@metric.Label</dt>
                            <dd>@metric.Count.ToString("N0")</dd>
                        </dl>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
