@model ManagerDashboard
@{
    ViewData["Title"] = "Sourcing Manager Dashboard";
    var metrics = new[]
    {
        (Label: "Needs your review", Count: Model.AwaitingReview, Description: "Read the committee’s findings and record a decision.", Link: "Review recommendations", Action: "Submissions", Decision: (string?)null, Fragment: "awaiting-review"),
        (Label: "Ready to forward", Count: Model.Approved, Description: "Add the referral reason and send approved recommendations to the Top Committee.", Link: "Open approved submissions", Action: "Submissions", Decision: (string?)null, Fragment: "ready-to-forward"),
        (Label: "With the Top Committee", Count: Model.AwaitingCommittee, Description: "Follow tender outcomes from your approved decisions.", Link: "View approved decisions", Action: "Reports", Decision: (string?)"Approved", Fragment: ""),
        (Label: "Questions for you", Count: Model.PendingClarifications, Description: "Open your conversations and respond to pending questions.", Link: "Open clarifications", Action: "Clarifications", Decision: (string?)null, Fragment: "")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/sourcing-manager.css" asp-append-version="true" />
}

<div class="manager-shell manager-refresh unified-dashboard">
    <div class="manager-dashboard">
        <header class="dashboard-heading mr-illustrated-heading">
            <div class="mr-heading-copy"><h1>Sourcing manager dashboard</h1><p>Review recommendations, forward approved submissions, and follow final decisions.</p></div>
            <img class="mr-heading-art" src="~/images/workspace-header-medicines.png" asp-append-version="true" width="720" height="369" alt="" decoding="async" />
            <div class="mr-actions mr-heading-actions">
                <a class="dashboard-cta" asp-action="Submissions">Open committee submissions <span aria-hidden="true">→</span></a>
                <a class="btn btn-outline-primary" asp-action="ChosenOffers">View chosen offers</a>
            </div>
        </header>
        <section class="dashboard-metrics is-four mr-dashboard-metrics" aria-label="Manager activity">
            @foreach (var metric in metrics)
            {
                <article class="dashboard-metric @(metric.Fragment == "awaiting-review" && metric.Count > 0 ? "mr-priority-metric" : null)">
                    <h2>@metric.Label</h2>
                    <strong>@metric.Count.ToString("N0")</strong>
                    <p>@metric.Description</p>
                    <div class="mr-metric-action">
                        <a class="btn btn-outline-primary" asp-action="@metric.Action" asp-route-decision="@metric.Decision"
                           asp-fragment="@metric.Fragment">@metric.Link <span aria-hidden="true">→</span></a>
                    </div>
                </article>
            }
        </section>
    </div>
</div>
