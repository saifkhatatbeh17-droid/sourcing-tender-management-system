@model IReadOnlyList<SourcingTenderManagement.Models.Entities.Tender>
@{
    ViewData["Title"] = "Chosen Offers";
}

<h1>Chosen Offers</h1>
@if (Model.Count == 0)
{
    <p>No evaluated tenders have been awarded.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th scope="col">Tender</th><th scope="col">Chosen supplier</th><th scope="col">Awarded (UTC)</th><th scope="col">Award notes</th></tr>
            </thead>
            <tbody>
                @foreach (var tender in Model)
                {
                    <tr>
                        <td>@tender.Title</td>
                        <td>@tender.Bid?.Invitation.SupplierProfile.CompanyName</td>
                        <td>@tender.AwardedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-break" style="white-space: pre-wrap">@tender.AwardNotes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
