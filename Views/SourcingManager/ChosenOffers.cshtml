@model IReadOnlyList<SourcingTenderManagement.Models.Entities.Tender>
@{
    ViewData["Title"] = "Chosen Offers";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sourcing-manager.css" asp-append-version="true" />
}

<div class="manager-shell">
    <div class="workspace-heading">
        <h1>Chosen Offers</h1>
    </div>

    <section class="workspace-section" aria-label="ChosenOffers">
        @if (Model.Count == 0)
        {
            <p>No evaluated tenders have been awarded.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th scope="col">Tender</th><th scope="col">Chosen supplier</th><th scope="col">Awarded (UTC)</th><th scope="col">Award notes</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var tender in Model)
                        {
                            <tr>
                                <td>@tender.Title</td>
                                <td>@tender.Bid?.Invitation.SupplierProfile.CompanyName</td>
                                <td>@tender.AwardedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-break manager-text">@tender.AwardNotes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
