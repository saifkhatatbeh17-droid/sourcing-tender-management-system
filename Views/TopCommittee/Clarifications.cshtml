@model CommitteeClarificationsPage
@section Styles { <partial name="_ReadStyles" /> }
@{ ViewData["Title"] = "Committee Clarifications"; }
<div class="workspace-heading"><div><h1>Clarifications</h1><p>Your private questions to the Sourcing Manager and their responses. Reload to see updates.</p></div><div class="tc-heading-actions"><a class="btn" asp-action="Dashboard">Back to dashboard</a></div></div>
@if (TempData["ClarificationSuccess"] is string success) { <p class="border rounded p-3" role="status">@success</p> }
@if (TempData["ClarificationError"] is string failure) { <p class="text-danger border rounded p-3" role="alert">@failure</p> }
@if (Model.Error != null) { <p class="text-danger" role="alert">@Model.Error</p> }
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (Model.Tenders.Count == 0)
{
    <section class="workspace-section tc-empty"><h2>No tenders assigned yet</h2><p class="mb-0">Clarifications become available when you are assigned to a tender's Top Committee.</p></section>
}
else
{
    <form asp-action="Clarifications" method="get" class="workspace-section">
        <label for="clarification-tender" class="form-label">Assigned tender</label>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-9"><select id="clarification-tender" name="tenderId" class="form-select">
                <option value="">All assigned tenders</option>
                @foreach (var tender in Model.Tenders)
                { <option value="@tender.TenderId" selected="@(Model.Create.TenderId == tender.TenderId)">#@tender.TenderId · @tender.Title · @CommitteeDisplay.Status(tender.Status)</option> }
            </select></div>
            <div class="col-12 col-md-3"><button class="btn btn-primary" type="submit">View clarifications</button></div>
        </div>
    </form>
    @if (Model.Create.TenderId > 0)
    {
        <div class="workspace-toolbar"><a asp-action="TenderDetails" asp-route-id="@Model.Create.TenderId">View tender details</a>
            <span>@(Model.OpenCount > 0 ? $"Voting paused: {Model.OpenCount} unresolved clarification(s) for this tender." : "No unresolved committee clarifications for this tender.")</span></div>
    }
    <section class="workspace-section" aria-labelledby="create-heading">
        <h2 id="create-heading">New clarification</h2>
        @if (Model.CreateBlockedReason != null) { <p class="mb-0">@Model.CreateBlockedReason</p> }
        else
        {
            <p>Send to <strong>@Model.ManagerName</strong>. This pauses committee voting for the tender until all open clarifications are resolved.</p>
            <form asp-action="CreateClarification" method="post">
                <input asp-for="Create.TenderId" type="hidden" />
                <div class="field"><label asp-for="Create.Subject">Subject</label><input asp-for="Create.Subject" class="form-control" maxlength="200" required /><span asp-validation-for="Create.Subject" class="text-danger"></span></div>
                <div class="field"><label asp-for="Create.Description">Question</label><textarea asp-for="Create.Description" class="form-control" rows="5" maxlength="4000" required></textarea><span asp-validation-for="Create.Description" class="text-danger"></span></div>
                <button class="btn btn-primary" type="submit">Send clarification</button>
            </form>
        }
    </section>
}
<h2 class="mt-4 mb-3">Your conversations</h2>
@if (Model.Threads.Count == 0)
{ <section class="workspace-section tc-empty"><h3>No conversations yet</h3><p class="mb-0">No private clarifications are recorded for @(Model.Create.TenderId > 0 ? "this tender" : "your assigned tenders").</p></section> }
else
{
    @foreach (var thread in Model.Threads)
    { <partial name="_ClarificationThread" model="thread" /> }
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
