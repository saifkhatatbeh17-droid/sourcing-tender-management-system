@model CommitteeNotificationPage
@{
    ViewData["Title"] = "Committee Notifications";
    var pages = Math.Max(1, (int)Math.Ceiling(Model.Total / 20d));
}
<div class="workspace-heading">
    <div><h1>Notifications</h1><p>@Model.Unread unread @(Model.Unread == 1 ? "notification" : "notifications") · @Model.Total total. Reload to see the latest updates.</p></div>
    <div class="tc-heading-actions"><a class="btn" asp-action="Dashboard">Dashboard</a><a class="btn" asp-action="Reports">Reports</a></div>
</div>
@if (TempData["NotificationSuccess"] is string success)
{
    <p role="status" class="border rounded p-3">@success</p>
}
@if (Model.Unread > 0)
{
    <form asp-action="MarkAllNotificationsRead" method="post" class="mb-4">
        <button class="btn btn-outline-primary">Mark all as read</button>
    </form>
}
@if (Model.Items.Count == 0)
{
    <section class="workspace-section tc-empty"><h2>No notifications on this page</h2><p class="mb-0">Updates about your committee assignments and decisions will appear here.</p></section>
}
@foreach (var item in Model.Items)
{
    <article class="workspace-section tc-notification">
        <div class="workspace-heading mb-3">
            <h2 class="mb-0 @(item.IsRead ? "fw-normal" : "fw-bold")">@item.Title</h2>
            <span class="badge @(item.IsRead ? "text-bg-secondary" : "text-bg-primary")">@(item.IsRead ? "Read" : "Unread")</span>
        </div>
        <p>@item.Message</p>
        <p class="small text-secondary"><time datetime="@item.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")">@CommitteeDisplay.Utc(item.CreatedAt)</time></p>
        <div class="workspace-toolbar mb-0">
            @if (item.TenderId.HasValue)
            {
                <a asp-action="TenderDetails" asp-route-id="@item.TenderId">View tender #@item.TenderId</a>
            }
            @if (!item.IsRead)
            {
                <form asp-action="MarkNotificationRead" method="post">
                    <input type="hidden" name="id" value="@item.Id" /><button class="btn btn-outline-primary">Mark as read</button>
                </form>
            }
        </div>
    </article>
}
<nav class="workspace-toolbar" aria-label="Notification pages">
    <span>Page @Model.Page of @pages</span>
    @foreach (var p in new[] { Model.Page - 1, Model.Page + 1 }.Where(p => p >= 1 && p <= pages))
    {
        <a asp-action="Notifications" asp-route-page="@p">Page @p</a>
    }
</nav>
