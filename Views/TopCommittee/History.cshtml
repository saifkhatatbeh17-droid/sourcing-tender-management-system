@model CommitteeHistoryPage
@using SourcingTenderManagement.Services.TopCommittee
@{
    ViewData["Title"] = "Decision History";
    var f = Model.Filter;
    var pages = Math.Max(1, (int)Math.Ceiling(Model.Total / (double)Math.Max(1, f.PageSize)));
}
@section Styles { <partial name="_ReadStyles" /> }
<div class="workspace-heading"><h1>Decision History</h1><a asp-action="Dashboard">Dashboard</a><a asp-action="Decisions">Pending tenders</a></div>
<p>Your recorded votes, newest first. Your approval is an individual decision; an award requires the collective decision. All times are UTC.</p>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form method="get" asp-action="History" class="workspace-section">
    <div class="row g-3">
        <div class="col-md-4"><label for="history-search">Tender title</label><div class="voice-search-control"><div class="input-group"><input id="history-search" name="Search" value="@f.Search" maxlength="200" class="form-control" data-voice-search data-voice-search-mode="submit" aria-describedby="top-history-voice-status"/><select class="form-select form-select-sm w-auto" data-voice-search-language aria-label="Voice search language"><option value="en-US">English</option><option value="ar-JO">العربية</option></select><button type="button" class="btn btn-outline-primary" data-voice-search-button aria-label="Start voice search" aria-pressed="false" aria-describedby="top-history-voice-status"><svg data-voice-icon="mic" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3m-4 0h8"/></svg><svg data-voice-icon="stop" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" hidden><rect x="6" y="6" width="12" height="12" rx="2"/></svg></button></div><div id="top-history-voice-status" class="form-text small" data-voice-search-status role="status" aria-live="polite">Voice search is ready.</div></div></div>
        <div class="col-md-4"><label for="history-status">Current tender status</label>
            <select id="history-status" name="Status" class="form-select"><option value="">All statuses</option>
            @foreach (var status in TopCommitteeReports.Statuses)
            { <option value="@status" selected="@(f.Status == status)">@CommitteeDisplay.Status(status)</option> }
            </select>
        </div>
        <div class="col-md-4"><label for="history-decision">My decision</label>
            <select id="history-decision" name="Decision" class="form-select"><option value="">All decisions</option>
            @foreach (var decision in new[] { "Approved", "Rejected" })
            { <option value="@decision" selected="@(f.Decision == decision)">@decision</option> }
            </select>
        </div>
        <div class="col-md-4"><label for="history-size">Decisions per page</label>
            <select id="history-size" name="PageSize" class="form-select">
            @foreach (var size in new[] { 10, 20, 50, 100 })
            { <option value="@size" selected="@(f.PageSize == size)">@size</option> }
            </select>
        </div>
        <div class="col-md-8 align-self-end"><button class="btn btn-primary">Apply filters</button><a asp-action="History" class="ms-2">Reset</a></div>
    </div>
</form>
<p>@Model.Total matching recorded decision(s). Outcomes and bid references reflect the current persisted tender; refresh for updates.</p>
@if (Model.Rows.Count == 0)
{
    <section class="workspace-section"><h2>No recorded decisions on this page</h2>
        <p>Only your votes on currently assigned tenders appear here. Adjust the filters, return to the first page, or review your pending tenders.</p>
        <a asp-action="History">Show all my decisions</a>
    </section>
}
else
{
    <div class="table-responsive" role="region" aria-label="My decision history" tabindex="0">
        <table class="table committee-read-table">
            <caption>Your final votes are read-only. Clarifications are not votes and their private conversations are excluded.</caption>
            <thead><tr><th scope="col">My vote / time (UTC)</th><th scope="col">Tender</th><th scope="col">Current status</th><th scope="col">Committee outcome</th><th scope="col">Nominated / awarded bid</th></tr></thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td><strong>@row.Decision</strong><br /><time datetime="@row.DecidedAt.ToString("yyyy-MM-ddTHH:mm:ss.fffffffZ")">@CommitteeDisplay.Utc(row.DecidedAt)</time></td>
                    <th scope="row"><a asp-action="TenderDetails" asp-route-id="@row.TenderId">#@row.TenderId · @row.Title</a></th>
                    <td>@CommitteeDisplay.Status(row.Status)</td>
                    <td>@row.Outcome<br /><span>@row.Approvals / 4 recorded approvals</span></td>
                    <td>@(row.NominatedBidId.HasValue ? "#" + row.NominatedBidId : "Not recorded") / @(row.AwardedBidId.HasValue ? "#" + row.AwardedBidId : "None")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<nav class="workspace-toolbar" aria-label="History pages"><span>Page @f.Page of @pages</span>
@foreach (var pageNumber in new[] { f.Page - 1, f.Page + 1 }.Where(p => p >= 1 && p <= pages))
{
    <a asp-action="History" asp-route-Page="@pageNumber" asp-route-PageSize="@f.PageSize" asp-route-Search="@f.Search" asp-route-Status="@f.Status" asp-route-Decision="@f.Decision">Page @pageNumber</a>
}
</nav>
