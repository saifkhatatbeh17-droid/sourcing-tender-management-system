@model SourcingTenderManagement.Models.TopCommittee.CommitteeNotificationBellViewModel
@* Selected only for the CEO & Chiefs workspace; other roles keep the shared bell. *@
<link rel="stylesheet" href="~/css/top-committee-notifications.css" asp-append-version="true" />
<script src="~/js/top-committee-notifications.js" asp-append-version="true" defer></script>
<div class="dropdown tc-notification-bell" data-open-notifications="@(Model.OpenOnLoad ? "true" : "false")">
    <button type="button" class="btn btn-outline-secondary notification-bell" id="notification-bell"
            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-controls="tc-notification-menu" aria-label="Notifications, @Model.UnreadCount unread">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        @if (Model.UnreadCount > 0) { <span class="badge text-bg-primary">@Model.UnreadCount</span> }
    </button>
    <div class="dropdown-menu dropdown-menu-end notification-dropdown notice-center" id="tc-notification-menu" aria-labelledby="notification-bell">
        <header class="notice-center-header">
            <partial name="~/Views/Shared/_NotificationHeading.cshtml" model="Model.UnreadCount" />
            @if (Model.UnreadCount > 0)
            {
                <form asp-controller="TopCommittee" asp-action="MarkAllNotificationsRead" method="post" class="notice-center-header-action">
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="notice-center-action">Mark all as read</button>
                </form>
            }
        </header>
        @if (Model.OpenOnLoad && TempData["NotificationSuccess"] is string success)
        {
            <p class="notice-center-feedback" role="status">@success</p>
        }
        @if (Model.Items.Count == 0)
        {
            <p class="notice-center-empty"><strong>No notifications yet</strong><span>New updates will appear here.</span></p>
        }
        else
        {
            <partial name="~/Views/Shared/_NotificationFilters.cshtml" model="@Model.Items.Count(item => !item.IsRead)" />
            <p class="notice-center-empty" data-notice-empty hidden role="status">No notifications match this filter.</p>
            <ul class="notice-center-list" aria-label="Your notifications" tabindex="0">
            @foreach (var notification in Model.Items)
            {
                <li class="notice-center-item @(!notification.IsRead ? "is-unread" : null)">
                    <partial name="~/Views/Shared/_NotificationSummary.cshtml" model="notification" />
                    @if (Url.IsLocalUrl(notification.RelativeUrl))
                    {
                        <a class="notice-center-card-link notice-center-open" href="@notification.RelativeUrl" aria-label="View details: @notification.Title"><span aria-hidden="true">›</span></a>
                    }
                    @if (!notification.IsRead)
                    {
                        <form asp-controller="TopCommittee" asp-action="MarkNotificationRead" method="post" class="notice-center-row-action">
                            <input type="hidden" name="id" value="@notification.NotificationId" />
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <button type="submit" class="notice-center-action" aria-label="Mark @notification.Title as read">Mark as read</button>
                        </form>
                    }
                </li>
            }
            </ul>
        }
        <div class="notice-center-footer"><a asp-controller="TopCommittee" asp-action="Notifications">View all notifications <span aria-hidden="true">›</span></a></div>
        @if (Model.Pages > 1)
        {
            <nav class="notice-center-pages" aria-label="Notification pages">
                @if (Model.PreviousUrl != null) { <a class="notice-center-action" href="@Model.PreviousUrl" aria-label="Newer notifications">Newer</a> }
                <span>Page @Model.Page of @Model.Pages</span>
                @if (Model.NextUrl != null) { <a class="notice-center-action" href="@Model.NextUrl" aria-label="Older notifications">Older</a> }
            </nav>
        }
    </div>
</div>
