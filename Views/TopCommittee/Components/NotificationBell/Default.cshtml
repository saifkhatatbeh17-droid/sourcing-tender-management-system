@model SourcingTenderManagement.Models.TopCommittee.CommitteeNotificationBellViewModel
@* Selected only for the CEO & Chiefs workspace; other roles keep the shared bell. *@
<link rel="stylesheet" href="~/css/top-committee-notifications.css" asp-append-version="true" />
<script src="~/js/top-committee-notifications.js" asp-append-version="true" defer></script>
<div class="dropdown tc-notification-bell" data-open-notifications="@(Model.OpenOnLoad ? "true" : "false")">
    <button type="button" class="btn btn-outline-secondary notification-bell" id="notification-bell"
            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-controls="tc-notification-menu" aria-label="Notifications, @Model.UnreadCount unread">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        @if (Model.UnreadCount > 0) { <span class="badge text-bg-primary">@Model.UnreadCount</span> }
    </button>
    <div class="dropdown-menu dropdown-menu-end notification-dropdown p-2" id="tc-notification-menu" aria-labelledby="notification-bell">
        <header class="tc-notification-header">
            <h2 class="fs-6 mb-1">Notifications</h2>
            <p class="small text-secondary mb-2">@Model.UnreadCount unread · @Model.Total total</p>
            @if (Model.UnreadCount > 0)
            {
                <form asp-controller="TopCommittee" asp-action="MarkAllNotificationsRead" method="post">
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button class="btn btn-sm btn-outline-primary">Mark all as read</button>
                </form>
            }
        </header>
        @if (Model.OpenOnLoad && TempData["NotificationSuccess"] is string success)
        {
            <p class="small px-2 pt-2 mb-0" role="status">@success</p>
        }
        @if (Model.Items.Count == 0)
        {
            <p class="text-secondary px-2 mb-2">No notifications yet.</p>
        }
        else
        {
            <ul class="list-unstyled mb-0 tc-notification-list" aria-label="Your notifications">
            @foreach (var notification in Model.Items)
            {
                <li class="notification-item">
                    <strong class="@(notification.IsRead ? "fw-normal" : "")">@notification.Title</strong>
                    <p class="mb-1">@notification.Message</p>
                    <p class="small text-secondary mb-2"><time datetime="@notification.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture)">@notification.CreatedAt.ToString("dd MMM yyyy, HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</time> · @(notification.IsRead ? "Read" : "Unread")</p>
                    <div class="tc-notification-actions">
                    @if (Url.IsLocalUrl(notification.RelativeUrl))
                    {
                        <a href="@notification.RelativeUrl">View details</a>
                    }
                    @if (!notification.IsRead)
                    {
                        <form asp-controller="TopCommittee" asp-action="MarkNotificationRead" method="post">
                            <input type="hidden" name="id" value="@notification.NotificationId" />
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <button class="btn btn-sm btn-outline-primary" aria-label="Mark @notification.Title as read">Mark as read</button>
                        </form>
                    }
                    </div>
                </li>
            }
            </ul>
        }
        @if (Model.Pages > 1)
        {
            <nav class="tc-notification-pagination" aria-label="Notification pages">
                @if (Model.PreviousUrl != null) { <a class="btn btn-sm btn-outline-primary" href="@Model.PreviousUrl" aria-label="Newer notifications">Newer</a> }
                <span class="small text-secondary">Page @Model.Page of @Model.Pages</span>
                @if (Model.NextUrl != null) { <a class="btn btn-sm btn-outline-primary" href="@Model.NextUrl" aria-label="Older notifications">Older</a> }
            </nav>
        }
    </div>
</div>
