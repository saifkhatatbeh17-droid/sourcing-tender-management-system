@model CommitteeTenderDetails
@if (Model.Bids.Count == 0)
{ <p class="mb-0">No submitted bids are available for this tender.</p> }
else
{
    <p class="text-secondary">Totals include item prices, taxes and additional costs in the quoted currency. Scores are shown as recorded, without currency conversion or a combined ranking.</p>
    <div class="table-responsive" tabindex="0" role="region" aria-label="Submitted bid comparison"><table class="committee-bid-table table align-middle mb-0">
        <caption>@Model.Bids.Count submitted @(Model.Bids.Count == 1 ? "bid" : "bids"). Compliance and decision statuses reflect the latest recorded information.</caption>
        <thead><tr><th scope="col">Supplier and bid</th><th scope="col">Total</th><th scope="col">Delivery</th><th scope="col">Compliance</th><th scope="col">Evaluation results</th><th scope="col">Details</th></tr></thead>
        <tbody>@foreach (var bid in Model.Bids)
        {
            <tr class="@(bid.IsNominated ? "table-primary" : null)">
                <th scope="row"><div class="tc-cell-stack"><span>@bid.SupplierName</span><span class="tc-cell-meta">Bid #@bid.BidId · @CommitteeDisplay.Status(bid.Status)</span>@if (bid.IsNominated) { <span><span class="badge text-bg-primary">Manager nominated</span></span> }</div></th>
                <td class="text-nowrap">@CommitteeDisplay.Money(bid.Total) @bid.Currency</td>
                <td>@bid.DeliveryDays days</td><td>@CommitteeDisplay.Status(bid.ComplianceStatus)</td>
                <td>@if (bid.Evaluations.Count == 0) { <span class="text-secondary">No submitted evaluation results</span> }
                else
                {
                    <ul class="list-unstyled small mb-0">@foreach (var evaluation in bid.Evaluations)
                    {
                        <li class="tc-evaluation-result"><strong>@evaluation.Evaluator</strong><span class="tc-cell-meta">@CommitteeDisplay.Status(evaluation.Status)</span>
                            @if (evaluation.Scores.Count == 0) { <span class="d-block">No scores recorded</span> }
                            @foreach (var score in evaluation.Scores)
                            { <span class="tc-score-line"><span><strong>@(score.Category == "Requirements" ? "Technical" : score.Category)</strong><span class="d-block">@score.Criterion</span></span><span>@CommitteeDisplay.Quantity(score.Score) / 100</span></span> }
                        </li>
                    }</ul>
                }</td>
                <td><a asp-action="TenderDetails" asp-route-id="@Model.TenderId" asp-route-bidId="@bid.BidId" asp-fragment="selected-bid" aria-label="View bid @bid.BidId from @bid.SupplierName">View bid</a></td>
            </tr>
        }</tbody>
    </table></div>
}
