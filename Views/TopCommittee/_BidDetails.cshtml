@model CommitteeBid
<dl class="row">
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@CommitteeDisplay.Status(Model.Status)</dd>
    <dt class="col-sm-3">Submitted</dt><dd class="col-sm-9">@CommitteeDisplay.Utc(Model.SubmittedAt)</dd>
    <dt class="col-sm-3">Item subtotal</dt><dd class="col-sm-9">@CommitteeDisplay.Money(Model.Subtotal) @Model.Currency</dd>
    <dt class="col-sm-3">Tax</dt><dd class="col-sm-9">@CommitteeDisplay.Money(Model.TaxAmount) @Model.Currency</dd>
    <dt class="col-sm-3">Additional costs</dt><dd class="col-sm-9">@CommitteeDisplay.Money(Model.AdditionalCosts) @Model.Currency</dd>
    <dt class="col-sm-3">Total</dt><dd class="col-sm-9 fw-semibold">@CommitteeDisplay.Money(Model.Total) @Model.Currency</dd>
    <dt class="col-sm-3">Delivery timeframe</dt><dd class="col-sm-9">@Model.DeliveryDays days</dd>
    <dt class="col-sm-3">Payment terms</dt><dd class="col-sm-9">@CommitteeDisplay.Text(Model.PaymentTerms)</dd>
    <dt class="col-sm-3">Valid until</dt><dd class="col-sm-9">@CommitteeDisplay.Date(Model.ValidUntil)</dd>
    <dt class="col-sm-3">Technical details</dt><dd class="col-sm-9">@CommitteeDisplay.Text(Model.TechnicalDetails)</dd>
    <dt class="col-sm-3">Compliance</dt><dd class="col-sm-9">@CommitteeDisplay.Status(Model.ComplianceStatus)</dd>
    <dt class="col-sm-3">Compliance notes</dt><dd class="col-sm-9">@CommitteeDisplay.Text(Model.ComplianceNotes)</dd>
</dl>
@if (Model.Items.Count == 0) { <p>No bid items are recorded.</p> }
else
{
    <div class="table-responsive" tabindex="0" role="region" aria-label="Quoted bid items"><table class="committee-read-table table">
        <caption>Quoted items. Unit prices are in @Model.Currency.</caption>
        <thead><tr><th scope="col">Item</th><th scope="col">Quantity</th><th scope="col">Unit price</th><th scope="col">Offered specifications</th></tr></thead>
        <tbody>@foreach (var item in Model.Items)
        { <tr><th scope="row">@item.ItemName</th><td>@CommitteeDisplay.Quantity(item.Quantity)</td><td>@CommitteeDisplay.Money(item.UnitPrice)</td><td>@item.OfferedSpecifications</td></tr> }</tbody>
    </table></div>
}
<h3 class="fs-6 mt-4">Bid documents</h3>
@if (Model.Documents.Count == 0) { <p>No bid documents are recorded.</p> }
else { <ul>@foreach (var document in Model.Documents) { <li>@document.OriginalFileName · @CommitteeDisplay.Text(document.DocumentType) <span class="text-secondary">(@document.SizeBytes.ToString("N0") bytes)</span></li> }</ul> }
<h3 class="fs-6 mt-4">Evaluation details</h3>
@if (Model.Evaluations.Count == 0) { <p class="mb-0">No submitted technical or financial evaluations are available.</p> }
else
{
    @foreach (var evaluation in Model.Evaluations)
    {
        <h4 class="fs-6 mt-3">@evaluation.Evaluator · @CommitteeDisplay.Status(evaluation.Status)</h4>
        <p>@CommitteeDisplay.Text(evaluation.Notes)</p>
        <p class="text-secondary small">Submitted: @CommitteeDisplay.Utc(evaluation.SubmittedAt) · Approved: @CommitteeDisplay.Utc(evaluation.ApprovedAt)</p>
        @if (evaluation.Scores.Count > 0)
        {
            <div class="table-responsive" tabindex="0" role="region" aria-label="Criterion scores for @evaluation.Evaluator"><table class="committee-read-table table">
                <caption>Recorded criterion scores and configured weights.</caption>
                <thead><tr><th scope="col">Criterion</th><th scope="col">Category</th><th scope="col">Weight</th><th scope="col">Score</th><th scope="col">Notes</th></tr></thead>
                <tbody>@foreach (var score in evaluation.Scores)
                { <tr><th scope="row">@score.Criterion</th><td>@(score.Category == "Requirements" ? "Technical" : score.Category)</td><td>@CommitteeDisplay.Quantity(score.Weight)%</td><td>@CommitteeDisplay.Quantity(score.Score)/100</td><td>@CommitteeDisplay.Text(score.Notes)</td></tr> }</tbody>
            </table></div>
        }
        else { <p>No criterion scores are recorded for this evaluation.</p> }
    }
}
