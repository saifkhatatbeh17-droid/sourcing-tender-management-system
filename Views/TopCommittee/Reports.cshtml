@model CommitteeReportPage
@using SourcingTenderManagement.Services.TopCommittee
@{
    ViewData["Title"] = "CEO & Chiefs Reports";
    var f = Model.Filter;
    var pages = Math.Max(1, (int)Math.Ceiling(Model.Summary.Matching / 20d));
    var hasFilters = !string.IsNullOrWhiteSpace(f.Search) || !string.IsNullOrWhiteSpace(f.Status) ||
        !string.IsNullOrWhiteSpace(f.Decision) || f.FromDate.HasValue || f.ToDate.HasValue;
}
@section Styles{<partial name="_ReadStyles" />}
<header class="workspace-heading tc-page-heading">
    <div class="tc-heading-copy"><h1>Reports</h1><p>See the outcomes of your assigned tenders and export the results you need.</p></div>
</header>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<details class="record-filters" open="@hasFilters">
    <summary>Search and filter tenders</summary>
<form asp-action="Reports" method="get" class="workspace-section tc-query" aria-labelledby="tc-query-title">
    <h2 id="tc-query-title">Filter report results</h2>
<div class="tc-query-fields">
<div><label for="report-search">Tender title</label><div class="voice-search-control"><div class="input-group"><input id="report-search" name="Search" value="@f.Search" maxlength="200" placeholder="Search by tender title" class="form-control" data-voice-search data-voice-search-mode="submit" aria-describedby="top-reports-voice-status"/><select class="form-select form-select-sm w-auto" data-voice-search-language aria-label="Voice search language"><option value="en-US">English</option><option value="ar-JO">العربية</option></select><button type="button" class="btn btn-outline-primary" data-voice-search-button aria-label="Start voice search" aria-pressed="false" aria-describedby="top-reports-voice-status"><svg data-voice-icon="mic" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3m-4 0h8"/></svg><svg data-voice-icon="stop" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" hidden><rect x="6" y="6" width="12" height="12" rx="2"/></svg></button></div><div id="top-reports-voice-status" class="form-text small" data-voice-search-status role="status" aria-live="polite"></div></div></div>
<div><label for="report-status">Status</label><select id="report-status" name="Status" class="form-select"><option value="">All statuses</option>@foreach(var s in TopCommitteeReports.Statuses){<option value="@s" selected="@(f.Status==s)">@CommitteeDisplay.Status(s)</option>}</select></div>
<div><label for="report-decision">My decision</label><select id="report-decision" name="Decision" class="form-select"><option value="">All</option>@foreach(var d in new[]{"Approved","Rejected","NotVoted"}){<option value="@d" selected="@(f.Decision==d)">@(d=="NotVoted"?"Not voted":d)</option>}</select></div>
<div><label for="report-from">Created from (UTC)</label><input id="report-from" name="FromDate" type="date" value="@f.FromDate?.ToString("yyyy-MM-dd")" class="form-control" /></div>
<div><label for="report-to">Created through (UTC)</label><input id="report-to" name="ToDate" type="date" value="@f.ToDate?.ToString("yyyy-MM-dd")" class="form-control" /></div>
<div class="tc-flow-actions tc-query-actions"><button class="btn btn-primary" type="submit">Apply filters</button> <a class="btn" asp-action="Reports">Clear filters</a></div></div></form>
</details>
<section class="workspace-section" aria-labelledby="report-summary-heading">
    <div class="tc-section-heading">
        <h2 id="report-summary-heading">Tender outcomes</h2>
        @if (ViewData.ModelState.IsValid)
        {
            <nav class="tc-flow-actions" aria-label="Export report">
                @foreach (var format in new[] { "pdf", "xlsx" })
                {
                    <a class="btn" asp-action="ReportExport" asp-route-format="@format" asp-route-Search="@f.Search" asp-route-Status="@f.Status" asp-route-Decision="@f.Decision" asp-route-FromDate="@f.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@f.ToDate?.ToString("yyyy-MM-dd")">Download @(format == "pdf" ? "PDF" : "Excel")</a>
                }
            </nav>
        }
    </div>
    <dl class="tc-report-summary">
        <div><dt>Total assigned</dt><dd>@Model.Summary.Assigned</dd></div>
        <div><dt>Matching</dt><dd>@Model.Summary.Matching</dd></div>
        <div><dt>Pending</dt><dd>@Model.Summary.Pending</dd></div>
        <div><dt>Awarded</dt><dd>@Model.Summary.Awarded</dd></div>
        <div><dt>Rejected</dt><dd>@Model.Summary.Rejected</dd></div>
        <div><dt>Manager review</dt><dd>@Model.Summary.Returned</dd></div>
        <div><dt>My decisions</dt><dd>@Model.Summary.MyDecisions</dd></div>
    </dl>
    <p class="small text-secondary mb-0">Counts reflect your filters; total assigned includes all your assignments. Rejected tenders may also appear under Manager review.</p>
</section>
@if (!ViewData.ModelState.IsValid)
{ <p class="tc-flow-meta">Correct the filters above to load the report.</p> }
else if (Model.Rows.Count == 0)
{
    <section class="workspace-section tc-flow-empty">
        <h2>@(Model.Summary.Matching > 0 ? "No tenders on this page" : hasFilters ? "No tenders match these filters" : "No assigned tenders to report")</h2>
        @if (Model.Summary.Matching > 0 || hasFilters)
        {
            <p>Show all assigned tenders to start a new report.</p>
            <a class="btn" asp-action="Reports">Show all assigned tenders</a>
        }
        else
        {
            <p>Assigned tenders and their outcomes will appear here as they are recorded.</p>
            <a class="btn" asp-action="Decisions">Check pending tenders</a>
        }
    </section>
}
else
{
    <header class="tc-flow-section-heading">
        <h2>Report results <span class="tc-flow-count">@Model.Summary.Matching matching</span></h2>
    </header>
    <div class="table-responsive" role="region" aria-label="Tender report" tabindex="0">
        <table class="table committee-read-table tc-report-table">
            <caption>Recorded decisions. Generated @CommitteeDisplay.Utc(Model.GeneratedAt).</caption>
            <thead><tr><th scope="col">Tender</th><th scope="col">Status</th><th scope="col">Bid references</th><th scope="col">Approvals</th><th scope="col">Final outcome</th><th scope="col">My decision</th><th scope="col">Decided (UTC)</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <th scope="row"><a asp-action="TenderDetails" asp-route-id="@r.TenderId">@r.Title</a><span class="tc-cell-meta text-secondary">Tender #@r.TenderId</span></th>
                    <td>@CommitteeDisplay.Status(r.Status)</td>
                    <td><dl class="tc-bid-references"><div><dt>Nominated</dt><dd>@(r.NominatedBidId.HasValue ? "#" + r.NominatedBidId : "None")</dd></div><div><dt>Awarded</dt><dd>@(r.AwardedBidId.HasValue ? "#" + r.AwardedBidId : "None")</dd></div></dl></td>
                    <td><span class="text-nowrap">@r.Approvals / 4</span><span class="tc-cell-meta">recorded</span></td>
                    <td>@TopCommitteeReportExport.Outcome(r)</td>
                    <td>@(r.MyDecision ?? "Not voted")</td>
                    <td>@if (r.DecisionAt is { } decidedAt) { <time class="tc-date-stack" datetime="@decidedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")"><span>@decidedAt.ToString("yyyy-MM-dd")</span><span>@decidedAt.ToString("HH:mm") UTC</span></time> } else { <span>Not recorded</span> }</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (ViewData.ModelState.IsValid && Model.Summary.Matching > 0 && (pages > 1 || f.Page > 1))
{
    <nav class="workspace-toolbar" aria-label="Report pages"><span>Page @f.Page of @pages</span>
        @foreach (var pageNumber in new[] { f.Page - 1, f.Page + 1 }.Where(p => p >= 1 && p <= pages))
        {
            <a asp-action="Reports" asp-route-Page="@pageNumber" asp-route-Search="@f.Search" asp-route-Status="@f.Status" asp-route-Decision="@f.Decision" asp-route-FromDate="@f.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@f.ToDate?.ToString("yyyy-MM-dd")">@(pageNumber < f.Page ? "Previous" : "Next")</a>
        }
    </nav>
}
