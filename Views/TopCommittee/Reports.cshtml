@model CommitteeReportPage
@using SourcingTenderManagement.Services.TopCommittee
@{ViewData["Title"]="Top Committee Reports";var f=Model.Filter;var pages=Math.Max(1,(int)Math.Ceiling(Model.Summary.Matching/20d));}
@section Styles{<partial name="_ReadStyles" />}
<div class="workspace-heading"><div><h1>Reports</h1><p>Review assigned tenders and recorded decisions. Filter dates refer to tender creation and use UTC.</p></div><div class="tc-heading-actions"><a class="btn" asp-action="Dashboard">Dashboard</a></div></div>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form method="get" class="workspace-section"><div class="row g-3 tc-filter-grid">
<div class="col-md-4"><label for="report-search">Tender title</label><div class="voice-search-control"><div class="input-group"><input id="report-search" name="Search" value="@f.Search" maxlength="200" class="form-control" data-voice-search data-voice-search-mode="submit" aria-describedby="top-reports-voice-status"/><select class="form-select form-select-sm w-auto" data-voice-search-language aria-label="Voice search language"><option value="en-US">English</option><option value="ar-JO">العربية</option></select><button type="button" class="btn btn-outline-primary" data-voice-search-button aria-label="Start voice search" aria-pressed="false" aria-describedby="top-reports-voice-status"><svg data-voice-icon="mic" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3m-4 0h8"/></svg><svg data-voice-icon="stop" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" hidden><rect x="6" y="6" width="12" height="12" rx="2"/></svg></button></div><div id="top-reports-voice-status" class="form-text small" data-voice-search-status role="status" aria-live="polite">Voice search is ready.</div></div></div>
<div class="col-md-4"><label for="report-status">Status</label><select id="report-status" name="Status" class="form-select"><option value="">All statuses</option>@foreach(var s in TopCommitteeReports.Statuses){<option value="@s" selected="@(f.Status==s)">@CommitteeDisplay.Status(s)</option>}</select></div>
<div class="col-md-4"><label for="report-decision">My decision</label><select id="report-decision" name="Decision" class="form-select"><option value="">All</option>@foreach(var d in new[]{"Approved","Rejected","NotVoted"}){<option value="@d" selected="@(f.Decision==d)">@(d=="NotVoted"?"Not voted":d)</option>}</select></div>
<div class="col-md-4"><label for="report-from">Created from (UTC)</label><input id="report-from" name="FromDate" type="date" value="@f.FromDate?.ToString("yyyy-MM-dd")" class="form-control" /></div>
<div class="col-md-4"><label for="report-to">Created through (UTC)</label><input id="report-to" name="ToDate" type="date" value="@f.ToDate?.ToString("yyyy-MM-dd")" class="form-control" /></div>
<div class="col-md-4 align-self-end d-flex flex-wrap gap-2 tc-filter-actions"><button class="btn btn-primary">Apply filters</button> <a class="btn" asp-action="Reports">Reset</a></div></div></form>
<section class="workspace-section" aria-labelledby="report-summary-heading">
    <h2 id="report-summary-heading">Summary</h2>
    <dl class="tc-report-summary">
        <div><dt>Total assigned</dt><dd>@Model.Summary.Assigned</dd></div>
        <div><dt>Matching</dt><dd>@Model.Summary.Matching</dd></div>
        <div><dt>Pending</dt><dd>@Model.Summary.Pending</dd></div>
        <div><dt>Awarded</dt><dd>@Model.Summary.Awarded</dd></div>
        <div><dt>Rejected</dt><dd>@Model.Summary.Rejected</dd></div>
        <div><dt>Manager review</dt><dd>@Model.Summary.Returned</dd></div>
        <div><dt>My decisions</dt><dd>@Model.Summary.MyDecisions</dd></div>
    </dl>
    <p class="small text-secondary mb-0">Counts reflect your filters; total assigned includes all your assignments. Rejected tenders may also appear under Manager review.</p>
</section>
<nav class="workspace-toolbar" aria-label="Exports">@foreach(var format in new[]{"pdf","xlsx"}){<a asp-action="ReportExport" asp-route-format="@format" asp-route-Search="@f.Search" asp-route-Status="@f.Status" asp-route-Decision="@f.Decision" asp-route-FromDate="@f.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@f.ToDate?.ToString("yyyy-MM-dd")">Download @(format=="pdf"?"PDF":"Excel")</a>}</nav>
@if (Model.Rows.Count == 0)
{
    <section class="workspace-section tc-empty"><h2>No matching tenders</h2><p>Adjust the filters or check your committee assignments.</p></section>
}
else
{
    <div class="table-responsive" role="region" aria-label="Tender report" tabindex="0">
        <table class="table committee-read-table tc-report-table">
            <caption>Recorded decisions. Generated @CommitteeDisplay.Utc(Model.GeneratedAt).</caption>
            <thead><tr><th scope="col">Tender</th><th scope="col">Status</th><th scope="col">Bid references</th><th scope="col">Approvals</th><th scope="col">Final outcome</th><th scope="col">My decision</th><th scope="col">Decided (UTC)</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <th scope="row"><a asp-action="TenderDetails" asp-route-id="@r.TenderId">@r.Title</a><span class="tc-cell-meta text-secondary">Tender #@r.TenderId</span></th>
                    <td>@CommitteeDisplay.Status(r.Status)</td>
                    <td><dl class="tc-bid-references"><div><dt>Nominated</dt><dd>@(r.NominatedBidId.HasValue ? "#" + r.NominatedBidId : "None")</dd></div><div><dt>Awarded</dt><dd>@(r.AwardedBidId.HasValue ? "#" + r.AwardedBidId : "None")</dd></div></dl></td>
                    <td><span class="text-nowrap">@r.Approvals / 4</span><span class="tc-cell-meta">recorded</span></td>
                    <td>@TopCommitteeReportExport.Outcome(r)</td>
                    <td>@(r.MyDecision ?? "Not voted")</td>
                    <td>@if (r.DecisionAt is { } decidedAt) { <time class="tc-date-stack" datetime="@decidedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")"><span>@decidedAt.ToString("yyyy-MM-dd")</span><span>@decidedAt.ToString("HH:mm") UTC</span></time> } else { <span>Not recorded</span> }</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<nav class="workspace-toolbar" aria-label="Report pages"><span>Page @f.Page of @pages</span>@foreach(var pageNumber in new[]{f.Page-1,f.Page+1}.Where(p=>p>=1&&p<=pages)){<a asp-action="Reports" asp-route-Page="@pageNumber" asp-route-Search="@f.Search" asp-route-Status="@f.Status" asp-route-Decision="@f.Decision" asp-route-FromDate="@f.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@f.ToDate?.ToString("yyyy-MM-dd")">Page @pageNumber</a>}</nav>
