@using SourcingTenderManagement.Models.Entities
@model List<PurchaseRequest>
@{
    ViewData["Title"] = "Request Review";
    var selectedRequest = ViewBag.SelectedRequest as PurchaseRequest;
    var currentUserId = ViewBag.CurrentUserId as string;
    var submittedRequestCount = Model.Count(request => request.Status == "Submitted");
    var underReviewRequestCount = Model.Count(request => request.Status == "UnderReview");
    var approvedRequestCount = Model.Count(request => request.Status == "Approved");
}
@section Styles { <link rel="stylesheet" href="~/css/sourcing-officer.css" asp-append-version="true" /> }

<div class="so-page so-page--requests">
<header class="so-page-header"><div><p class="so-eyebrow">SOURCING WORKSPACE</p>
<h1>Request Review</h1>
<p class="so-page-description">Review purchase requests, inspect requested items, and record the review decision for requests assigned to you.</p></div><span class="so-page-header-icon" aria-hidden="true">PR</span></header>
@if (TempData["RequestSuccess"] is string requestSuccess)
{
    <div class="alert alert-success" role="status">@requestSuccess</div>
}
@if (TempData["RequestError"] is string requestError)
{
    <div class="alert alert-danger" role="alert">@requestError</div>
}
<section class="so-summary-grid" aria-label="Request summary">
    <article class="so-summary-card so-tone-blue"><span class="so-summary-label">Requests in this view</span><strong>@Model.Count</strong><span class="so-summary-note">Based on the selected status filter</span></article>
    <article class="so-summary-card so-tone-amber"><span class="so-summary-label">Submitted</span><strong>@submittedRequestCount</strong><span class="so-summary-note">Awaiting an officer review</span></article>
    <article class="so-summary-card so-tone-violet"><span class="so-summary-label">Under review</span><strong>@underReviewRequestCount</strong><span class="so-summary-note">Currently being reviewed</span></article>
    <article class="so-summary-card so-tone-teal"><span class="so-summary-label">Approved</span><strong>@approvedRequestCount</strong><span class="so-summary-note">Ready for the next sourcing step</span></article>
</section>
<div class="nav nav-tabs workspace-tabs" role="tablist" aria-label="Request Review">
    <button class="nav-link @(selectedRequest == null ? "active" : "")" id="review-0-tab" data-bs-toggle="tab" data-bs-target="#review-0" type="button" role="tab" aria-controls="review-0" aria-selected="@(selectedRequest == null ? "true" : "false")">Requests</button>
    <button class="nav-link @(selectedRequest != null ? "active" : "")" id="review-1-tab" data-bs-toggle="tab" data-bs-target="#review-1" type="button" role="tab" aria-controls="review-1" aria-selected="@(selectedRequest != null ? "true" : "false")">Request Details</button>
</div>
<div class="tab-content workspace-content">
    <div class="tab-pane fade @(selectedRequest == null ? "show active" : "")" id="review-0" role="tabpanel" aria-labelledby="review-0-tab" tabindex="0">
        <section class="workspace-section">
            <div class="so-section-heading"><div><p class="so-eyebrow">RECORDS</p><h2>Purchase Requests</h2></div><span class="so-section-count">@Model.Count</span></div>
            <form asp-action="Requests" method="get" class="so-filter-form">
                <div><label for="request-status" class="form-label">Filter by status</label>
                    <select id="request-status" name="status" class="form-select" style="max-width: 240px">
                        <option value="All" selected="@(ViewBag.StatusFilter == "All")">All</option>
                        <option value="Submitted" selected="@(ViewBag.StatusFilter == "Submitted")">Submitted</option>
                        <option value="UnderReview" selected="@(ViewBag.StatusFilter == "UnderReview")">Under Review</option>
                        <option value="Approved" selected="@(ViewBag.StatusFilter == "Approved")">Approved</option>
                        <option value="Returned" selected="@(ViewBag.StatusFilter == "Returned")">Returned</option>
                        <option value="Rejected" selected="@(ViewBag.StatusFilter == "Rejected")">Rejected</option>
                    </select>
                </div><button type="submit" class="btn btn-primary">Apply Filter</button>
            </form>
            @if (Model.Count == 0)
            {
                <p class="text-secondary">No requests match this status filter.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr><th>Title</th><th>Department</th><th>Priority</th><th>Target Date</th><th>Submitted</th><th>Status</th><th>Assigned Reviewer</th><th></th></tr>
                        </thead>
                        <tbody>
                        @foreach (var request in Model)
                        {
                            <tr>
                                <td>@request.Title</td>
                                <td>@request.Department.Name</td>
                                <td>@request.Priority</td>
                                <td>@request.TargetDate</td>
                                <td>@request.SubmittedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="so-status-badge" data-status="@request.Status">@request.Status</span></td>
                                <td>@(request.ReviewedByUser?.FullName ?? "Unassigned")</td>
                                <td><a class="btn btn-outline-primary btn-sm" asp-action="Requests" asp-route-id="@request.PurchaseRequestId" asp-route-status="@ViewBag.StatusFilter">Review</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
    <div class="tab-pane fade @(selectedRequest != null ? "show active" : "")" id="review-1" role="tabpanel" aria-labelledby="review-1-tab" tabindex="0">
        <section class="workspace-section">
            <h2>Request Details &amp; Review</h2>
            @if (selectedRequest is null)
            {
                <p class="text-secondary">Select a submitted request to review its details.</p>
            }
            else
            {
                <dl>
                    <dt>Title</dt><dd>@selectedRequest.Title</dd>
                    <dt>Department</dt><dd>@selectedRequest.Department.Name</dd>
                    <dt>Requested By</dt><dd>@selectedRequest.RequestedByUser.FullName</dd>
                    <dt>Reason</dt><dd>@selectedRequest.Reason</dd>
                    <dt>Priority</dt><dd>@selectedRequest.Priority</dd>
                    <dt>Target Date</dt><dd>@selectedRequest.TargetDate</dd>
                    <dt>Status</dt><dd><span class="so-status-badge" data-status="@selectedRequest.Status">@selectedRequest.Status</span></dd>
                    <dt>Assigned Reviewer</dt><dd>@(selectedRequest.ReviewedByUser?.FullName ?? "Unassigned")</dd>
                    @if (selectedRequest.ReviewedAt.HasValue)
                    {
                        <dt>Last Reviewed (UTC)</dt><dd>@selectedRequest.ReviewedAt.Value.ToString("yyyy-MM-dd HH:mm")</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(selectedRequest.ReviewNotes))
                    {
                        <dt>Review Notes</dt><dd>@selectedRequest.ReviewNotes</dd>
                    }
                </dl>

                <h3>Requested Items</h3>
                @if (selectedRequest.PurchaseRequestItems.Count == 0)
                {
                    <p class="text-secondary">No items were added to this request.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead><tr><th>Item</th><th>Quantity</th><th>Unit</th><th>Specifications</th></tr></thead>
                            <tbody>
                            @foreach (var item in selectedRequest.PurchaseRequestItems)
                            {
                                <tr><td>@item.ItemName</td><td>@item.Quantity</td><td>@item.Unit</td><td>@item.Specifications</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }

                @if (selectedRequest.Status == "Submitted" &&
                    (selectedRequest.ReviewedByUserId == null || selectedRequest.ReviewedByUserId == currentUserId))
                {
                    <form asp-action="StartReview" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@selectedRequest.PurchaseRequestId" />
                        <button type="submit" class="btn btn-primary">Start Review</button>
                    </form>
                }
                else if (selectedRequest.Status == "UnderReview" && selectedRequest.ReviewedByUserId == currentUserId)
                {
                    <div class="workspace-section mt-3">
                        <h3>Review Decision</h3>
                        <form asp-action="ApproveRequest" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@selectedRequest.PurchaseRequestId" />
                            <div class="mb-2">
                                <label for="approve-notes" class="form-label">Review notes (optional)</label>
                                <textarea id="approve-notes" name="notes" class="form-control" rows="2" maxlength="2000"></textarea>
                            </div>
                            <button type="submit" class="btn btn-success">Approve</button>
                        </form>
                        <form asp-action="ReturnRequest" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@selectedRequest.PurchaseRequestId" />
                            <div class="mb-2">
                                <label for="return-reason-@selectedRequest.PurchaseRequestId" class="form-label">Return reason (required)</label>
                                <textarea id="return-reason-@selectedRequest.PurchaseRequestId" name="reason" class="form-control" rows="3" maxlength="2000" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-outline-primary">Return for Correction</button>
                        </form>
                        <form asp-action="RejectRequest" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@selectedRequest.PurchaseRequestId" />
                        <div class="mb-3">
                                <label for="reject-reason-@selectedRequest.PurchaseRequestId" class="form-label">Rejection reason (required)</label>
                                <textarea id="reject-reason-@selectedRequest.PurchaseRequestId" name="reason" class="form-control" rows="3" maxlength="2000" required></textarea>
                        </div>
                            <button type="submit" class="btn btn-danger">Reject</button>
                        </form>
                    </div>
                }
            }
        </section>
    </div>
</div>
</div>
