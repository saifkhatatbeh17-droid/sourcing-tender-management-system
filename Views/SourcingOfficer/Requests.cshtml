@using SourcingTenderManagement.Models.Entities
@model List<PurchaseRequest>
@{
    ViewData["Title"] = "Request review";
    var request = ViewBag.SelectedRequest as PurchaseRequest;
    var currentUserId = ViewBag.CurrentUserId as string;
    var blocked = ViewBag.HasOpenRequestClarifications is true;
    var canDecide = request != null && ((request.Status == "UnderReview" && request.ReviewedByUserId == currentUserId) || (request.Status == "Submitted" && request.ReviewedByUserId == null));
    string StatusLabel(string value) => value switch {
        "All" => "All statuses", "Submitted" => "Awaiting review", "UnderReview" => "Under review",
        "Approved" => "Ready for tender", "Returned" => "Changes requested", "ConvertedToTender" => "Tender created", _ => value
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/sourcing-officer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/request-review.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/officer-workspace-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/request-inbox.css" asp-append-version="true" />
}
<div class="so-page rr-page">
<header class="so-page-header"><div><h1>@(request == null ? "Purchase requests" : "Request review")</h1><p class="so-page-description">Review department requests and prepare approved requests for tender.</p></div>
@if (request != null) { <a class="btn btn-outline-primary" asp-action="Requests" asp-route-status="@ViewBag.StatusFilter">← All requests</a> }
</header>
@if (TempData["RequestSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["RequestError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if (request == null)
{
    <section class="rr-card rr-inbox">
        <header class="rr-inbox-heading rr-inbox-top">
            <div><h2>Request inbox <span class="rr-count rr-search-result" role="status" aria-live="polite">@Model.Count @(Model.Count == 1 ? "request" : "requests")</span></h2><p>Action needed first · Newest within each action</p></div>
        </header>
        <div class="rr-inbox-toolbar">
            <div class="rr-inbox-search"><label for="request-search">Search requests</label><input id="request-search" type="search" class="form-control" placeholder="Title, department or request number" autocomplete="off" /></div>
            <form asp-action="Requests" method="get" class="rr-filter rr-inbox-status">
                <div><label for="request-status">Status</label><select id="request-status" name="status" class="form-select">
                @foreach (var status in new[] { "All", "Submitted", "UnderReview", "Approved", "ConvertedToTender", "Returned", "Rejected" }) { <option value="@status" selected="@(ViewBag.StatusFilter == status)">@StatusLabel(status)</option> }
                </select></div>
                <button class="btn btn-outline-primary" type="submit">Filter</button>
            </form>
        </div>
        <p class="rr-no-results" hidden>No matching requests. Try a different title or number.</p>
        @if (Model.Count == 0) { <div class="rr-empty"><h3>No requests here yet</h3><p>New department submissions will appear here. Try another status filter.</p></div> }
        @if (Model.Count > 0)
        {
            <table class="rr-inbox-table">
                <caption class="visually-hidden">Purchase requests ordered by action needed: review and decide, prepare tender, then view request. Newest submissions first within each action.</caption>
                <colgroup><col class="rr-col-request" /><col class="rr-col-status" /><col class="rr-col-submitted" /><col class="rr-col-action" /></colgroup>
                <thead><tr>
                    <th scope="col">Request<span>Department, title &amp; priority</span></th>
                    <th scope="col">Status<span>Current progress</span></th>
                    <th scope="col">Submitted<span>Date &amp; time · UTC</span></th>
                    <th scope="col">Next action<span>What you can do</span></th>
                </tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var canPrepareTender = item.Status == "Approved" && item.ReviewedByUserId == currentUserId;
                    var needsReview = item.Status is "Submitted" or "UnderReview";
                    <tr class="rr-request-row" data-search="@($"{item.PurchaseRequestId} {item.Title} {item.Department.Name} {StatusLabel(item.Status)}")">
                        <td class="rr-request-cell"><div class="rr-row-title"><span>#@item.PurchaseRequestId · @item.Department.Name</span><h3><a asp-action="Requests" asp-route-id="@item.PurchaseRequestId" asp-route-status="@ViewBag.StatusFilter">@item.Title</a></h3><p>@item.Priority priority · Needed @item.TargetDate.ToString("dd MMM yyyy")</p></div></td>
                        <td class="rr-row-state" data-label="Status"><span class="so-status-badge" data-status="@item.Status">@StatusLabel(item.Status)</span></td>
                        <td class="rr-row-date" data-label="Submitted">
                            @if (item.SubmittedAt is DateTime submitted)
                            { <time datetime="@submitted.ToString("O")">@submitted.ToString("dd MMM yyyy")<span>@submitted.ToString("HH:mm") UTC</span></time> }
                            else { <span class="rr-date-unavailable">Not submitted</span> }
                        </td>
                        <td class="rr-row-action" data-label="Next action">
                            @if (canPrepareTender)
                            {
                                <a class="btn btn-primary rr-next-action officer-prepare" asp-action="Create" asp-route-purchaseRequestId="@item.PurchaseRequestId" aria-label="Prepare tender for request @item.PurchaseRequestId">Prepare tender <span aria-hidden="true">→</span></a>
                            }
                            else
                            {
                                <a class="btn @(needsReview ? "btn-primary rr-next-action" : "btn-outline-primary rr-history-action")" asp-action="Requests" asp-route-id="@item.PurchaseRequestId" asp-route-status="@ViewBag.StatusFilter" aria-label="@(needsReview ? "Review and decide on" : "View") request @item.PurchaseRequestId">@(needsReview ? "Review & decide" : "View request") <span aria-hidden="true">→</span></a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
}
else
{
    <section class="rr-request-heading"><div><span class="rr-eyebrow">PURCHASE REQUEST #@request.PurchaseRequestId</span><h2>@request.Title</h2><p>@request.Department.Name <span>·</span> Requested by @request.RequestedByUser.FullName</p></div><span class="so-status-badge" data-status="@request.Status">@StatusLabel(request.Status)</span></section>
    <div class="rr-layout">
        <div class="rr-main">
            <section class="rr-card rr-requirements"><header><div><span class="rr-eyebrow">THE PURCHASE NEED</span><h3>Requirements &amp; specifications</h3></div><span class="rr-count">@request.PurchaseRequestItems.Count items</span></header>
                <div class="rr-reason"><h4>Why it’s needed</h4><p>@request.Reason</p></div>
                @if (request.PurchaseRequestItems.Count == 0) { <p class="rr-empty">No requested items were provided.</p> }
                @foreach (var item in request.PurchaseRequestItems)
                {
                    <article class="rr-item"><div><h4>@item.ItemName</h4><p>@item.Specifications</p></div><span class="rr-quantity">@item.Quantity.ToString("0.###") <small>@item.Unit</small></span></article>
                }
            </section>
            <section class="rr-card rr-conversation"><header><div><h3>Questions &amp; clarification</h3><p>Keep follow-ups connected to this request.</p></div>
            @if (canDecide) { <a class="btn btn-outline-primary" asp-controller="Clarification" asp-action="Index" asp-route-kind="request" asp-route-recordId="@request.PurchaseRequestId">Ask a question ↗</a> }
            </header>
            @if (blocked) { <div class="rr-blocked" role="status"><strong>Open questions need resolution</strong><p>Both participants must confirm resolution before a decision can be recorded.</p><a asp-controller="Clarification" asp-action="Index" asp-route-kind="request" asp-route-recordId="@request.PurchaseRequestId">Review conversations →</a></div> }
            <details open="@blocked"><summary>Conversation history</summary>@await Component.InvokeAsync("ClarificationHistory", new { kind = "request", recordId = request.PurchaseRequestId })</details>
            </section>
        </div>
        <aside class="rr-side">
            <section class="rr-card rr-facts"><h3>At a glance</h3><dl><div><dt>Priority</dt><dd>@request.Priority</dd></div><div><dt>Needed by</dt><dd>@request.TargetDate.ToString("dd MMM yyyy")</dd></div><div><dt>Submitted</dt><dd>@request.SubmittedAt?.ToString("dd MMM yyyy · HH:mm")</dd></div><div><dt>Reviewer</dt><dd>@(request.ReviewedByUser?.FullName ?? "Unassigned")</dd></div>
            @if (request.ReviewedAt.HasValue) { <div><dt>Last reviewed</dt><dd>@request.ReviewedAt.Value.ToString("dd MMM yyyy · HH:mm")</dd></div> }</dl>
            @await Component.InvokeAsync("DetailsQr", new { controller = "SourcingOfficer", action = "Details", id = request.PurchaseRequestId, label = "Purchase request" })
            </section>
            <section class="rr-card rr-decision"><h3>Your decision</h3>
            @if (canDecide)
            {
                <p>Approve this purchase request to make it available for tender preparation.</p>
                @if (blocked) { <p class="rr-decision-hint">Resolve the open questions to continue.</p> }
                <form asp-action="ApproveRequest" method="post" id="request-approve-form">
                    <input type="hidden" name="id" value="@request.PurchaseRequestId" />
                    <button type="submit" class="btn btn-primary rr-approve pharma-action-approve" disabled="@blocked">Approve request</button>
                </form>
                <div class="rr-secondary-actions"><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#request-return" disabled="@blocked">Request changes</button><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#request-reject" disabled="@blocked">Reject</button></div>
            }
            else if (request.Status == "Submitted" && (request.ReviewedByUserId == null || request.ReviewedByUserId == currentUserId))
            {
                <p>Take ownership of this request to review and record your decision.</p><form asp-action="StartReview" method="post"><input type="hidden" name="id" value="@request.PurchaseRequestId" /><button class="btn btn-primary rr-approve">Start review →</button></form>
            }
            else if (request.Status == "Approved" && request.ReviewedByUserId == currentUserId)
            {
                <span class="rr-decision-result">✓ Approved</span><p>Request approved. Prepare its tender when you’re ready.</p><a asp-action="Create" asp-route-purchaseRequestId="@request.PurchaseRequestId" class="btn btn-primary rr-approve">Prepare tender &amp; invite suppliers →</a>
            }
            else { <p>This request is @StatusLabel(request.Status). No review action is available.</p> }
            @if (!string.IsNullOrWhiteSpace(request.ReviewNotes)) { <div class="rr-recorded-notes"><h4>Recorded review notes</h4><p>@request.ReviewNotes</p></div> }
            </section>
        </aside>
    </div>
    @if (canDecide && !blocked)
    {
        @foreach (var action in new[] { (Key: "return", Action: "ReturnRequest", Title: "Request changes", Description: "Explain what the department needs to update before resubmitting."), (Key: "reject", Action: "RejectRequest", Title: "Reject request", Description: "Explain why this purchase request cannot proceed.") })
        {
            <div class="modal fade" id="request-@action.Key" tabindex="-1" aria-labelledby="request-@action.Key-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="@action.Action" method="post"><input type="hidden" name="id" value="@request.PurchaseRequestId" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="request-@action.Key-title">@action.Title</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p>@action.Description</p><label for="request-@action.Key-reason" class="form-label">Reason <span>(required)</span></label><textarea id="request-@action.Key-reason" name="reason" class="form-control" rows="4" maxlength="2000" required></textarea></div><div class="modal-footer"><button class="btn btn-outline-primary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">@action.Title</button></div>
            </form></div></div></div>
        }
    }
}
</div>
@section Scripts {
<script>
document.querySelectorAll('.rr-page .modal').forEach(dialog => dialog.addEventListener('shown.bs.modal', () => dialog.querySelector('textarea')?.focus()));
</script>
<script src="~/js/officer-workspace-polish.js" asp-append-version="true"></script>
}
