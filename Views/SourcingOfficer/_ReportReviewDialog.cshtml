@using SourcingTenderManagement.Models.Entities
@model EvaluationReport
@{
 var members = ViewBag.ReviewMembers as List<CommitteeAssignment> ?? [];
 var approvals = ViewBag.ReviewApprovals as List<TenderApproval> ?? [];
 var canReview = Model.Status == "CommitteeApproved" && Model.Tender.Status == "AwaitingOfficerSummary" && members.Count == 4 && members.All(m => approvals.Any(a => a.CommitteeAssignmentId == m.CommitteeAssignmentId));
 var bid = Model.Bid;
}
<div class="modal-header"><div><p class="rp-reference">Report #@Model.EvaluationReportId · Tender #@Model.TenderId</p><h2 class="modal-title" id="report-review-title">Review evaluation report</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close report review"></button></div>
<div class="modal-body">
 <h3 class="rv-tender">@Model.Tender.Title</h3>
 <section class="rv-recommendation" aria-label="Committee recommendation"><div><span class="rv-label">Recommended supplier</span><strong>@(bid?.Invitation.SupplierProfile.CompanyName ?? "Not recorded")</strong><span>Offer #@Model.RecommendedBidId · @approvals.Select(a => a.CommitteeAssignmentId).Distinct().Count() of 4 committee approvals</span></div>@if(bid != null){<div class="rv-price"><strong>@SourcingTenderManagement.Models.CommitteeEvaluationPage.Total(bid).ToString("N2") <small>@bid.Currency</small></strong><span>@bid.DeliveryDays-day delivery</span></div>}</section>
 <div class="rv-document-heading"><h3>Committee report</h3><a class="btn btn-outline-primary" asp-action="ReportPdf" asp-route-id="@Model.EvaluationReportId"><partial name="_ReportDownloadIcon" />Download PDF</a></div>
 @if(string.IsNullOrWhiteSpace(Model.CommitteeSummary)){<p>No committee report has been submitted.</p>}else{<div class="rv-document"><partial name="_FormattedReport" model="Model.CommitteeSummary" /></div>}
 <details class="rv-approvals"><summary>Committee approval record</summary><ul>@foreach(var member in members){<li><span>@SourcingTenderManagement.Models.CommitteeEvaluationPage.MemberName(member.Position)</span><strong>@(approvals.Any(a => a.CommitteeAssignmentId == member.CommitteeAssignmentId)?"Approved":"Pending")</strong></li>}</ul></details>
 <partial name="_TenderOfferRoundHistory" model="Model.Tender" />
 @if(!string.IsNullOrWhiteSpace(Model.OfficerSummary)){<section><h3>Previous officer review</h3><partial name="_FormattedReport" model="Model.OfficerSummary" /></section>}
</div>
<div class="modal-footer rv-footer">
 @if(canReview){
 <div class="rv-actions"><p>Choose how to proceed with this recommendation.</p><div><button type="button" class="btn btn-outline-danger" data-report-decision="Reject">Reject</button><button type="button" class="btn btn-outline-secondary" data-report-decision="RequestEdits">Request edits</button><button type="button" class="btn btn-primary" data-report-decision="Approve">Approve &amp; forward</button></div></div>
 <form asp-action="ReviewCommitteeReport" asp-route-id="" method="post" class="rv-confirm" hidden>
  <input type="hidden" name="tenderId" value="@Model.TenderId" /><input type="hidden" name="version" value="@SourcingTenderManagement.Controllers.SourcingOfficerController.ReportReviewVersion(Model)" /><input type="hidden" name="fromReports" value="true" /><input type="hidden" name="decision" />
  <h3 id="rv-confirm-title" tabindex="-1"></h3><p id="rv-confirm-help"></p><div class="rv-reason"><label for="rv-reason">Reason <span>(required)</span></label><textarea id="rv-reason" name="reason" rows="3" maxlength="4000" class="form-control" aria-describedby="rv-confirm-help"></textarea></div>
  <div class="rv-confirm-buttons"><button type="button" class="btn btn-outline-secondary" data-report-back>Back</button><button type="submit" class="btn btn-primary" data-report-confirm></button></div>
 </form>
 }else{<p class="mb-0">This report is no longer available for review. Refresh the list to see its current status.</p><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>}
</div>
