@using SourcingTenderManagement.Models.Entities
@model List<Bid>
@{
    ViewData["Title"] = "Tender workspace";
    var tenders = ViewBag.OfferTenders as List<Tender> ?? [];
    var tender = ViewBag.SelectedTender as Tender;
    var questions = ViewBag.OpenQuestions as List<int> ?? [];
    var members = ViewBag.WorkspaceMembers as List<CommitteeAssignment> ?? [];
    var approvals = ViewBag.WorkspaceApprovals as List<TenderApproval> ?? [];
    var invitations = ViewBag.WorkspaceInvitations as List<Invitation> ?? [];
    var now = DateTime.UtcNow;
    var canInvite = tender?.CanCancel(now) == true;
    var editable = tender?.Status is "Published" or "Open" or "Closed";
    var activeOfferCount = Model.Count(b => b.Status != "Withdrawn");
    var compliantOfferCount = Model.Count(b => b.Status != "Withdrawn" && b.ComplianceStatus == "Compliant");
}
@section Styles {
    <link rel="stylesheet" href="~/css/sourcing-officer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/offer-review.css" asp-append-version="true" />
}
<div class="so-page offer-review">
<header class="so-page-header"><div><h1>Tender workspace</h1><p class="so-page-description">Track invitations, review supplier offers, and follow the committee’s progress.</p></div><div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-primary" asp-action="Tenders">All tenders</a>@if (tenders.Count > 0) { <a class="btn btn-primary" asp-action="Create">Prepare new tender</a> }</div></header>
@if (TempData["TenderSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["TenderError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if (TempData["EvaluationSuccess"] is string reviewSuccess) { <div class="alert alert-success" role="status">@reviewSuccess</div> }
@if (TempData["EvaluationError"] is string reviewError) { <div class="alert alert-danger" role="alert">@reviewError</div> }
@if (TempData["ComplianceSuccess"] is string saved) { <div class="alert alert-success" role="status">@saved</div> }
@if (TempData["ComplianceError"] is string failed) { <div class="alert alert-danger" role="alert">@failed</div> }
@if (tender == null)
{
    <section class="workspace-section"><h2>No tenders yet</h2><p>Prepare a tender from an eligible approved purchase request to begin.</p><a class="btn btn-primary" asp-action="Create">Prepare new tender</a></section>
}
else
{
    var statusLabel = SourcingTenderManagement.Models.CommitteeEvaluationPage.StatusLabel(tender.Status);
    var nextStep = tender.Status switch
    {
        "Draft" when canInvite => "Check the requirements, then publish the tender and invite suppliers.",
        "Draft" => "The deadline has passed. Edit the draft to update its dates before publishing.",
        "Cancelled" => "This tender is cancelled. You can still view its requirements, invitations, and past offers.",
        _ when canInvite && invitations.Count == 0 => "Invite suppliers so they can participate in this tender.",
        _ when canInvite && now < tender.OpensAt => "Suppliers can submit offers when the tender opens.",
        _ when editable && now < tender.ClosesAt => "Review offers as they arrive. You can send them to the committee after the deadline.",
        _ when editable && activeOfferCount == 0 => "The deadline has passed without any active offers to send to the committee.",
        _ when editable && questions.Count > 0 => "Resolve the open questions before sending offers to the committee.",
        _ when editable => "Complete compliance review and send eligible offers to the committee.",
        "UnderEvaluation" => "Follow the committee’s progress below.",
        "AwaitingOfficerSummary" => "Review the committee’s report and submit your summary.",
        _ => null
    };
    <form asp-action="Offers" method="get" class="offer-picker">
        <div>
            <label for="review-tender">Choose a tender</label>
            <select id="review-tender" name="tenderId" class="form-select">
                @foreach (var item in tenders)
                {
                    <option value="@item.TenderId" selected="@(item.TenderId == tender.TenderId)">#@item.TenderId · @item.Title · @SourcingTenderManagement.Models.CommitteeEvaluationPage.StatusLabel(item.Status)</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-outline-primary">View selected tender</button>
    </form>
    <section class="tw-overview" aria-labelledby="tw-tender-title">
        <header class="tw-tender-heading">
            <div>
                <p class="tw-tender-reference">Tender #@tender.TenderId · @(tender.Category ?? "Uncategorized")</p>
                <h2 id="tw-tender-title">@tender.Title</h2>
            </div>
            <span class="so-status-badge" data-status="@tender.Status">@statusLabel</span>
        </header>
        <dl class="tw-tender-facts">
            <div><dt>Tender deadline (UTC)</dt><dd>@tender.ClosesAt.ToString("dd MMM yyyy, HH:mm")</dd></div>
            <div><dt>Suppliers invited</dt><dd>@invitations.Count</dd></div>
            <div><dt>Active offers</dt><dd>@activeOfferCount</dd></div>
            <div><dt>Compliant offers</dt><dd>@compliantOfferCount</dd></div>
        </dl>
        <div class="tw-overview-actions">
            @if (nextStep != null)
            {
                <div class="tw-next-step"><h3>Next step</h3><p>@nextStep</p></div>
            }
            <div class="tw-tools">
                <button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#tender-requirements">View requirements</button>
                @if (tender.Status == "Draft" && !canInvite)
                {
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@tender.TenderId">Edit tender dates</a>
                }
                <button class="btn @(canInvite ? "btn-primary" : "btn-outline-primary")" type="button" data-bs-toggle="modal" data-bs-target="#tender-suppliers">@(canInvite ? tender.Status == "Draft" ? "Publish & invite suppliers" : "Manage invitations" : "View invitations")</button>
            </div>
        </div>
    </section>
    @if (tender.Status == "UnderEvaluation")
    {
        <section class="workspace-section"><h2>Committee review in progress</h2><p>The committee is ready to choose an offer. @approvals.Count(a => a.Decision == "Approved") of 4 members have approved.</p><div class="tw-member-status">@foreach (var member in members) { <span>@SourcingTenderManagement.Models.CommitteeEvaluationPage.MemberName(member.Position) · @(approvals.Any(a => a.CommitteeAssignmentId == member.CommitteeAssignmentId && a.Decision == "Approved") ? "Approved" : "Pending")</span> }</div></section>
    }
    @if (ViewBag.WorkspaceReport is EvaluationReport { CommitteeSummary: not null }) { <partial name="_TenderReport" /> }
    @if (questions.Count > 0)
    {
        <aside class="workspace-section" role="status"><h2>@questions.Count open questions</h2><p>Both participants must resolve these conversations before handoff.</p>
        @foreach (var question in questions) { <a class="btn btn-outline-primary" asp-controller="Clarification" asp-action="Index" asp-route-id="@question">Open question #@question ↗</a> }
        </aside>
    }
    <header class="tw-offers-heading"><h2>Supplier offers <span class="tw-offer-count">@Model.Count</span></h2></header>
    <form asp-action="ReviewAndSend" method="post">
        <input type="hidden" name="tenderId" value="@tender.TenderId" />
        @if (Model.Count == 0)
        {
            <section class="tw-empty-offers" aria-label="No submitted offers">
                <span class="tw-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 7h16v13H4zM4 7l3-4h10l3 4M8 12h8M10 16h4"/></svg></span>
                <h3>No offers submitted yet</h3>
                @if (tender.IsAcceptingOffers(now) && invitations.Count > 0)
                {
                    <p>Offers appear here when an invited supplier submits one.</p>
                }
            </section>
        }
        <div class="offer-review-list">
        @foreach (var bid in Model)
        {
            var total = bid.BidItems.Sum(i => i.Quantity * i.UnitPrice) + bid.TaxAmount + bid.AdditionalCosts;
            var finalDecision = bid.ComplianceStatus is "Compliant" or "NonCompliant";
            <article class="offer-review-card">
                <header><div><span class="text-secondary">Offer #@bid.BidId</span><h3>@bid.Invitation.SupplierProfile.CompanyName</h3></div><div class="offer-amount"><strong>@total.ToString("N2") @bid.Currency</strong><span>@bid.DeliveryDays-day delivery · Includes tax & additional costs</span></div></header>
                <details open="@(ViewBag.SelectedBidId == bid.BidId)"><summary>Review requirements, pricing & documents</summary>
                    <div class="offer-detail-columns"><section><h4>What was requested</h4><p>@bid.Invitation.Tender.Description</p>
                    @foreach (var item in bid.Invitation.Tender.PurchaseRequest.PurchaseRequestItems) { <p><strong>@item.ItemName · @item.Quantity @item.Unit</strong><br />@item.Specifications</p> }
                    </section><section><h4>What this supplier offers</h4><p>@bid.TechnicalDetails</p><p><strong>Payment:</strong> @bid.PaymentTerms</p><p><strong>Tender deadline:</strong> @tender.ClosesAt.ToString("dd MMM yyyy, HH:mm") UTC</p>
                    @foreach (var item in bid.BidItems) { <p><strong>@item.PurchaseRequestItem.ItemName</strong><br />@item.OfferedSpecifications<br />@item.Quantity × @item.UnitPrice.ToString("N2") @bid.Currency</p> }
                    @if (bid.BidDocuments.Count > 0) { <h4>Submitted documents</h4><ul>@foreach (var document in bid.BidDocuments) { <li>@document.OriginalFileName — @document.DocumentType</li> }</ul> }
                    </section></div>
                </details>
                <footer>
                    @if (editable && !finalDecision && (bid.Status is "Submitted" or "UnderReview"))
                    {
                        <fieldset><legend>Compliance decision</legend><label><input type="radio" name="decisions[@bid.BidId]" value="Compliant" required /> Compliant</label><label><input type="radio" name="decisions[@bid.BidId]" value="NonCompliant" required /> Non-compliant</label></fieldset>
                    }
                    else { <span class="so-status-badge">@(tender.Status == "Cancelled" ? "Cancelled" : bid.Status == "Withdrawn" ? "Withdrawn" : bid.ComplianceStatus == "NonCompliant" ? "Non-compliant" : bid.ComplianceStatus ?? bid.Status)</span> }
                    @if (tender.Status != "Cancelled" && bid.Status != "Withdrawn")
                    {
                        <a asp-controller="Clarification" asp-action="Index" asp-route-kind="bid" asp-route-recordId="@bid.BidId">Ask a question ↗</a>
                    }
                </footer>
            </article>
        }
        </div>
        @if (editable && activeOfferCount > 0)
        {
            <div class="offer-handoff">
                <div><strong>Send offers for evaluation</strong><p>@(now < tender.ClosesAt ? "You can send offers after the tender deadline." : questions.Count > 0 ? "Resolve the open questions before sending offers." : "Choose a decision for every unreviewed offer. At least one offer must be compliant.")</p></div>
                <button class="btn btn-primary" disabled="@(questions.Count > 0 || now < tender.ClosesAt)">Send to committee</button>
            </div>
        }
    </form>
    @if (tender.CanCancel(now))
    {
        <details class="tw-management">
            <summary>Tender management</summary>
            <form asp-action="CancelTender" asp-route-id="@tender.TenderId" method="post"
                  onsubmit="return confirm('Cancel this tender for all invited suppliers?');">
                <button type="submit" class="btn btn-outline-danger">Cancel tender</button>
            </form>
        </details>
    }
    <div class="modal fade tw-dialog" id="tender-requirements" tabindex="-1" aria-labelledby="tender-requirements-title" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="tender-requirements-title">Purchase requirements</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><h3 class="fs-6">@tender.Title</h3><p class="tw-preserve">@tender.Description</p>@if (!string.IsNullOrWhiteSpace(tender.Terms)) { <h3 class="fs-6">Tender terms</h3><p class="tw-preserve">@tender.Terms</p> }<div class="tw-window"><span>Opens @tender.OpensAt.ToString("dd MMM yyyy, HH:mm") UTC</span><span>Tender deadline @tender.ClosesAt.ToString("dd MMM yyyy, HH:mm") UTC</span></div></div></div></div></div>
    <div class="modal fade tw-dialog" id="tender-suppliers" tabindex="-1" aria-labelledby="tender-suppliers-title" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="tender-suppliers-title">@(tender.Status == "Draft" ? "Publish & invite suppliers" : "Supplier invitations")</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body">
        @if (invitations.Count > 0)
        {
            <div class="tw-invited-list">@foreach (var invitation in invitations) { <div><strong>@invitation.SupplierProfile.CompanyName</strong><span class="so-status-badge">@invitation.Status</span></div> }</div>
        }
        else if (!canInvite) { <p>No suppliers were invited to this tender.</p> }
        @if (canInvite)
        {
            <form asp-action="PublishAndInvite" method="post"><input type="hidden" name="id" value="@tender.TenderId" /><partial name="_LaunchSuppliers" /><div class="so-action-buttons"><button class="btn btn-primary">@(tender.Status == "Draft" ? "Publish & invite →" : "Send invitations →")</button><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@tender.TenderId">Edit tender</a></div></form>
        }
    </div></div></div></div>
}
</div>

@section Scripts { <script src="~/js/officer-report-review.js" asp-append-version="true"></script> }
