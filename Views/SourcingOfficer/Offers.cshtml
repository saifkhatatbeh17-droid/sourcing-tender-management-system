@* Tender workspace: a Sourcing Officer page. Shown by SourcingOfficerController.Offers(). *@
@using SourcingTenderManagement.Models.Entities
@model List<Bid>
@{
    ViewData["Title"] = "Tender workspace";
    var tenders = ViewBag.OfferTenders as List<Tender> ?? [];
    var tender = ViewBag.SelectedTender as Tender;
    var questions = ViewBag.OpenQuestions as List<int> ?? [];
    var members = ViewBag.WorkspaceMembers as List<CommitteeAssignment> ?? [];
    var approvals = ViewBag.WorkspaceApprovals as List<TenderApproval> ?? [];
    var invitations = ViewBag.WorkspaceInvitations as List<Invitation> ?? [];
    var alreadySent = ViewBag.WorkspaceReport is EvaluationReport;
    var now = DateTime.UtcNow;
    var canInvite = tender?.CanCancel(now) == true;
    var editable = !alreadySent && tender != null && (ViewBag.RoundRejected is not true) && (tender.Status is "Published" or "Open" or "Closed");
    ViewData["CanReviewCompliance"] = editable;
}
@section Styles {
    <link rel="stylesheet" href="~/css/spec-match.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sourcing-officer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/offer-review.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/officer-workspace-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/offers-simple.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/offers-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/offer-precheck.css" asp-append-version="true" />
}
<div class="so-page offer-review offer-simple offer-redesign">
<header class="so-page-header"><div><h1>Supplier offers</h1><p class="so-page-description">Review supplier offers and move your tender forward.</p></div><div class="d-flex flex-wrap gap-2"><a class="btn btn-primary officer-prepare" asp-action="Create">Prepare tender ＋</a></div></header>
@if (TempData["TenderSuccess"] is string success) { <div data-flash-message class="alert alert-success" role="status">@success</div> }
@if (TempData["TenderError"] is string error) { <div data-flash-message class="alert alert-danger" role="alert">@error</div> }
@if (TempData["EvaluationSuccess"] is string reviewSuccess) { <div data-flash-message class="alert alert-success" role="status">@reviewSuccess</div> }
@if (TempData["EvaluationError"] is string reviewError) { <div data-flash-message class="alert alert-danger" role="alert">@reviewError</div> }
@if (TempData["ComplianceSuccess"] is string saved) { <div data-flash-message class="alert alert-success" role="status">@saved</div> }
@if (TempData["ComplianceError"] is string failed) { <div data-flash-message class="alert alert-danger" role="alert">@failed</div> }
@if (tender == null) { <section class="workspace-section"><h2>No tenders yet</h2><p>Prepare a tender from a purchase request to begin.</p><a asp-action="Create">Prepare tender →</a></section> }
else
{
    <section class="ow-tender-context" aria-labelledby="tw-tender-title"><partial name="_TenderChooser" /></section>
    @if (tender.CanCancel(now))
    {
        <details class="os-options"><summary>Tender options</summary><form asp-action="CancelTender" asp-route-id="@tender.TenderId" method="post" class="mb-3"
              onsubmit="return confirm('Cancel this tender for all invited suppliers?');">
            <button type="submit" class="btn btn-outline-danger">Cancel tender</button>
        </form></details>
    }
    @if (questions.Count > 0)
    {
        <aside class="workspace-section" role="status"><h2>@questions.Count open questions</h2><p>Both participants must resolve these conversations before handoff.</p>
        @foreach (var question in questions) { <a class="btn btn-outline-primary" asp-controller="Clarification" asp-action="Index" asp-route-id="@question">Open question #@question ↗</a> }
        </aside>
    }
    @if (!string.IsNullOrWhiteSpace(tender.TopEditState))
    {
        var editRequester = ViewBag.TopEditRequesterName as string ?? "CEO & Chiefs Member";
        var compliantChoices = ViewBag.CompliantOffersForSwitch as List<Bid> ?? [];
        var currentRecommendedId = (ViewBag.WorkspaceReport as EvaluationReport)?.RecommendedBidId;
        <section class="workspace-section border-warning" aria-label="CEO &amp; Chiefs edit request">
            <h2>@(tender.TopEditState == "WithOfficer" ? "Action Required: CEO & Chiefs / Manager Edit Request" : "CEO & Chiefs Edit Cycle in Progress")</h2>
            <p class="mb-1"><strong>CEO &amp; Chiefs request (@editRequester @(tender.TopEditRequestedAt.HasValue ? $"· {tender.TopEditRequestedAt.Value:dd MMM yyyy, HH:mm} UTC" : "")):</strong></p>
            <p class="tw-preserve mb-2">@tender.TopEditRequestNotes</p>
            @if (!string.IsNullOrWhiteSpace(tender.TopEditManagerNotes))
            {
                <p class="mb-1"><strong>Sourcing Manager instructions:</strong></p>
                <p class="tw-preserve mb-3">@tender.TopEditManagerNotes</p>
            }

            @if (tender.Status == "AwaitingOfficerSummary" && tender.TopEditState == "WithOfficer")
            {
                <form asp-action="RespondToTopEdit" method="post" class="border rounded p-3">
                    <input type="hidden" name="tenderId" value="@tender.TenderId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="top-edit-bid-select">Keep current offer or choose another compliant offer instead</label>
                        <select id="top-edit-bid-select" name="selectedBidId" class="form-select" required>
                            @foreach (var choice in compliantChoices)
                            {
                                var choiceTotal = choice.BidItems.Sum(x => x.Quantity * x.UnitPrice) + choice.TaxAmount + choice.AdditionalCosts;
                                var isCurrent = choice.BidId == currentRecommendedId;
                                <option value="@choice.BidId" selected="@isCurrent">
                                    @(isCurrent ? "★ Keep current nominated offer: " : "Switch to alternative offer: ")#@choice.BidId — @choice.Invitation.SupplierProfile.CompanyName (@choiceTotal.ToString("N2") @choice.Currency · @choice.DeliveryDays days delivery)
                                </option>
                            }
                        </select>
                        <div class="form-text">Choose the existing offer to answer &amp; keep it, or select a different compliant offer to nominate instead.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="top-edit-officer-notes">Your answer / offer-selection justification (sent back to Sourcing Manager)</label>
                        <textarea id="top-edit-officer-notes" name="officerNotes" class="form-control" rows="3" required maxlength="4000" placeholder="Provide your answer for the Sourcing Manager / CEO &amp; Chiefs, or explain why you selected an alternative offer…"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Send answer / selected offer to Sourcing Manager</button>
                </form>
            }
            else if (tender.TopEditState == "OfficerAnswered")
            {
                <div class="alert alert-info mb-0">
                    <strong>Sent to Sourcing Manager:</strong> @tender.TopEditOfficerNotes
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Currently with the Sourcing Manager for review.</p>
            }
        </section>
    }
    @if (ViewBag.ForwardedRejection is TenderApproval rejection)
    {
        <section class="workspace-section" aria-label="Forwarded rejection"><h2>@(ViewBag.ReplacementTender is Tender ? "Replacement tender prepared" : tender.Status == "Cancelled" ? "Replacement declined" : "Replacement tender needed")</h2><p>Rejected by @rejection.User.FullName · @rejection.DecidedAt.ToString("dd MMM yyyy, HH:mm") UTC</p><p class="tw-preserve">@rejection.Notes</p>
        @if (ViewBag.ReplacementTender is Tender replacement) { <a asp-action="Offers" asp-route-tenderId="@replacement.TenderId">View replacement tender #@replacement.TenderId →</a> }
        else if (tender.Status == "Closed")
        {
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary officer-prepare" asp-action="Create" asp-route-replacesTenderId="@tender.TenderId">Prepare replacement tender</a>
                <form asp-action="CancelTender" asp-route-id="@tender.TenderId" method="post" onsubmit="return confirm('Reject the replacement and close this tender without a new round?');">
                    <input type="hidden" name="declineReplacement" value="true" />
                    <button type="submit" class="btn btn-outline-danger">Reject</button>
                </form>
            </div>
        }
        </section>
    }
    <header class="tw-offers-heading"><div><h2>Offers <span class="tw-offer-count">@Model.Count</span></h2></div></header>
    @if (ViewBag.SpecMatch is SourcingTenderManagement.Controllers.OfficerSpecMatchPage specMatch)
    {
        <partial name="_SpecMatch" model="specMatch" />
    }
    <form asp-action="ReviewAndSend" method="post">
        <input type="hidden" name="tenderId" value="@tender.TenderId" />
        @if (Model.Count == 0)
        {
            <section class="tw-empty-offers" aria-label="No submitted offers">
                <span class="tw-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 7h16v13H4zM4 7l3-4h10l3 4M8 12h8M10 16h4"/></svg></span>
                <h3>Waiting for the first offer</h3>
                <p>@(invitations.Count == 0 ? "Invite suppliers to begin receiving offers." : $"{invitations.Count} suppliers invited. Their submitted offers will appear here.")</p>
            </section>
        }
        <partial name="_OfferRows" model="Model" />
        @if (alreadySent)
        {
            <div class="os-sent-notice" role="status"><strong>Offers sent to the committee</strong><span>Follow the review in the committee report and decisions below.</span></div>
        }
        <partial name="_StrictOfferHandoff" />
    </form>
    <partial name="_OfferDetails" model="Model" />
    <partial name="_StrictOfferRound" />
    @if (tender.Status == "UnderEvaluation")
    {
        <details class="os-record os-progress"><summary><strong>Committee review progress</strong><span aria-hidden="true">⌄</span></summary><section class="workspace-section"><h2>Committee review in progress</h2><p>The committee is ready to choose an offer. @approvals.Count(a => a.Decision == "Approved") of 4 members have approved.</p><div class="tw-member-status">@foreach (var member in members) { <span>@SourcingTenderManagement.Models.CommitteeEvaluationPage.MemberName(member.Position) · @(approvals.Any(a => a.CommitteeAssignmentId == member.CommitteeAssignmentId && a.Decision == "Approved") ? "Approved" : "Pending")</span> }</div></section></details>
    }
    @if (ViewBag.WorkspaceReport is EvaluationReport { CommitteeSummary: not null } report)
    {
        <details class="os-record" id="committee-section" open="@(tender.Status == "AwaitingOfficerSummary")">
            <summary><span><strong>Committee report &amp; decisions</strong><small>@SourcingTenderManagement.Models.CommitteeEvaluationPage.StatusLabel(report.Status)</small></span><span class="os-record-open">View record <span aria-hidden="true">⌄</span></span></summary>
            <partial name="_TenderReport" />
        </details>
    }
    <partial name="_TenderRequirements" />
    <div class="modal fade tw-dialog" id="tender-suppliers" tabindex="-1" aria-labelledby="tender-suppliers-title" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="tender-suppliers-title">Supplier invitations</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body">
        @if (invitations.Count > 0)
        {
            <div class="tw-invited-list">@foreach (var invitation in invitations) { <div><strong>@invitation.SupplierProfile.CompanyName</strong><span class="so-status-badge">@invitation.Status</span></div> }</div>
        }
        else if (!canInvite) { <p>No suppliers were invited to this tender.</p> }
        @if (canInvite)
        {
            <form asp-action="PublishAndInvite" method="post"><input type="hidden" name="id" value="@tender.TenderId" /><partial name="_LaunchSuppliers" /><div class="so-action-buttons"><button class="btn btn-primary">Send invitations</button></div></form>
        }
    </div></div></div></div>
}
@if (ViewBag.OpenCreateModal == true) { <partial name="_CreateTenderModal" /> }
</div>

@section Scripts { <script src="~/js/spec-match.js" asp-append-version="true"></script> <script src="~/js/offers-workspace.js" asp-append-version="true"></script> <script src="~/js/offer-precheck.js" asp-append-version="true"></script> <script src="~/js/procurement-categories.js" asp-append-version="true"></script><script src="~/js/tender-edit-modal.js" asp-append-version="true"></script> <script src="~/js/offer-read-state.js" asp-append-version="true"></script> <script src="~/js/officer-workspace-polish.js" asp-append-version="true"></script> <script src="~/js/officer-report-review.js" asp-append-version="true"></script> }
