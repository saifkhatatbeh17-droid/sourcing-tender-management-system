@using SourcingTenderManagement.Models.Entities
@model TendersPageViewModel
@{
    ViewData["Title"] = "Tenders";
    var eligibleRequests = ViewBag.EligiblePurchaseRequests as List<PurchaseRequest> ?? [];
    var createTender = ViewBag.CreateTender as SourcingOfficerTenderForm ?? new SourcingOfficerTenderForm();
    var editTender = ViewBag.EditTender as SourcingOfficerTenderForm;
    var now = DateTime.UtcNow;
    var draftTenderCount = Model.Tenders.Count(tender => tender.Status == "Draft");
    var publishedTenderCount = Model.Tenders.Count(tender => tender.Status == "Published");
}
@section Styles { <link rel="stylesheet" href="~/css/sourcing-officer.css" asp-append-version="true" /> }

<div class="so-page so-page--tenders">
<header class="so-page-header"><div>
<h1>Tenders</h1>
<p class="so-page-description">Prepare, publish and track your tenders.</p></div><button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#tender-create">Create tender <span aria-hidden="true">＋</span></button></header>
<section class="so-summary-grid" aria-label="Tender summary">
    <article class="so-summary-card"><span class="so-summary-label">My Tenders</span><strong>@Model.Tenders.Count</strong></article>
    <article class="so-summary-card"><span class="so-summary-label">Draft</span><strong>@draftTenderCount</strong></article>
    <article class="so-summary-card"><span class="so-summary-label">Published</span><strong>@publishedTenderCount</strong></article>
    <article class="so-summary-card"><span class="so-summary-label">Eligible requests</span><strong>@eligibleRequests.Count</strong></article>
</section>
@if (TempData["TenderSuccess"] is string successMessage) { <div class="alert alert-success" role="status">@successMessage</div> }
@if (TempData["TenderError"] is string tenderError) { <div class="alert alert-danger" role="alert">@tenderError</div> }
@foreach (var rejected in Model.Tenders.Where(t => t.RejectionForwardedAt.HasValue))
{
    var rejection = rejected.TenderApprovals.FirstOrDefault(a => a.Stage == "Top" && a.Decision == "Rejected");
    var replacement = Model.Tenders.FirstOrDefault(t => t.ReplacesTenderId == rejected.TenderId);
    <section class="workspace-section">
        <h2>Rejected tender: @rejected.Title · #@rejected.TenderId</h2>
        @if (rejection != null)
        {
            <p>Rejected by <strong>@rejection.User.FullName</strong> · @rejection.DecidedAt.ToString("yyyy-MM-dd HH:mm") UTC</p>
            <p class="text-break" style="white-space:pre-wrap">@rejection.Notes</p>
        }
        <a asp-action="Offers" asp-route-tenderId="@rejected.TenderId">Original tender and offers</a>
        @if (replacement == null) { <a class="btn btn-primary" asp-action="Create" asp-route-replacesTenderId="@rejected.TenderId">Create New Tender</a> }
        else { <p>Replacement: <a asp-action="Offers" asp-route-tenderId="@replacement.TenderId">@replacement.Title · #@replacement.TenderId</a></p> }
    </section>
}
<div class="nav nav-tabs workspace-tabs" role="tablist" aria-label="Tenders">
<button class="nav-link @(Model.SelectedTender == null ? "active" : "")" id="tenders-0-tab" data-bs-toggle="tab" data-bs-target="#tenders-0" type="button" role="tab" aria-controls="tenders-0" aria-selected="@(Model.SelectedTender == null ? "true" : "false")">Tenders</button>
<button class="nav-link @(Model.SelectedTender != null ? "active" : "")" id="tenders-1-tab" data-bs-toggle="tab" data-bs-target="#tenders-1" type="button" role="tab" aria-controls="tenders-1" aria-selected="@(Model.SelectedTender != null ? "true" : "false")">Tender Details</button></div>
<div class="tab-content workspace-content"><div class="tab-pane fade @(Model.SelectedTender == null ? "show active" : "")" id="tenders-0" role="tabpanel" aria-labelledby="tenders-0-tab" tabindex="0"><section class="workspace-section"><div class="so-section-heading"><div><h2>Existing Tenders</h2></div><span class="so-section-count">@Model.Tenders.Count</span></div>@if (Model.Tenders.Count == 0) { <div class="so-empty-state"><span class="so-empty-mark" aria-hidden="true">T</span><div><strong>No tenders yet</strong><p>Create a Tender after a Purchase Request has been approved.</p></div></div> }
<div class="table-responsive"><table class="table"><thead><tr><th>Tender</th><th>Status</th><th>Tender deadline (UTC)</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
@foreach (var tender in Model.Tenders) { <tr><td><a class="so-record-title" asp-action="Tenders" asp-route-id="@tender.TenderId">@tender.Title</a><span class="so-record-ref">Tender #@tender.TenderId</span></td><td><span class="so-status-badge" data-status="@tender.Status">@tender.Status</span></td><td>@tender.ClosesAt.ToString("dd MMM yyyy · HH:mm")</td><td><a asp-action="Tenders" asp-route-id="@tender.TenderId" class="btn btn-sm btn-outline-primary">View tender ↗</a><a asp-action="Tenders" asp-route-id="@tender.TenderId" asp-route-showQr="true" class="so-qr-link">QR code</a>
    @if (tender.CanCancel(now))
    {
        <form asp-action="CancelTender" asp-route-id="@tender.TenderId" asp-route-fromList="true" method="post"
              class="d-inline-block ms-2" onsubmit="return confirm('Cancel this tender for all invited suppliers?');">
            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel tender</button>
        </form>
    }
</td></tr> }
</tbody></table></div></section></div>
<div class="tab-pane fade @(Model.SelectedTender != null ? "show active" : "")" id="tenders-1" role="tabpanel" aria-labelledby="tenders-1-tab" tabindex="0">
<section class="workspace-section"><div class="so-section-heading"><div><h2>Tender Details</h2></div></div>@if (Model.SelectedTender is { } selected)
{
    @await Component.InvokeAsync("DetailsQr", new { controller = "SourcingOfficer", action = "Tenders", id = selected.TenderId, label = "Tender" })
    <dl><dt>Title</dt><dd>@selected.Title</dd><dt>Tender category</dt><dd>@(selected.Category ?? "Uncategorized")</dd><dt>Status</dt><dd><span class="so-status-badge" data-status="@selected.Status">@selected.Status</span></dd><dt>Description</dt><dd>@selected.Description</dd><dt>Terms</dt><dd>@selected.Terms</dd><dt>Tender deadline (UTC)</dt><dd>@selected.ClosesAt.ToString("yyyy-MM-dd HH:mm")</dd></dl>
}
else { <p class="text-secondary">Select a tender to view its details.</p> }</section><section class="workspace-section"><h2>Chosen Offer</h2>@if (Model.SelectedTender is { Status: "Awarded", Bid: { } winner } awarded)
{
    var total = winner.BidItems.Sum(i => i.Quantity * i.UnitPrice) + winner.TaxAmount + winner.AdditionalCosts;
    <dl><dt>Chosen supplier</dt><dd>@winner.Invitation.SupplierProfile.CompanyName</dd><dt>Offer number</dt><dd>@winner.BidId</dd><dt>Total</dt><dd>@total.ToString("N2") @winner.Currency</dd><dt>Awarded on (UTC)</dt><dd>@awarded.AwardedAt?.ToString("yyyy-MM-dd HH:mm")</dd><dt>Decision notes</dt><dd>@awarded.AwardNotes</dd></dl>
}
else { <p class="text-secondary">The chosen offer appears here after the final decision is recorded.</p> }
<!-- TEAM TODO: Add announcement/closure processing here after the approved final decision. The officer does not choose a winner independently. --></section>
@if (Model.SelectedTender is { } actionTender)
{
    <section class="so-action-panel"><div><h2>Available actions</h2><p>You can send a tender to evaluation as soon as compliance review is complete, including before its deadline.</p></div><div class="so-action-buttons">
        @if (actionTender.Status == "Draft")
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@actionTender.TenderId">Edit Tender</a>
            <form asp-action="PublishTender" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@actionTender.TenderId" />
                <button type="submit" class="btn btn-primary">Publish Tender</button>
            </form>
        }
        @if ((actionTender.Status is "Published" or "Open") && actionTender.ClosesAt > DateTime.UtcNow)
        {
            <a class="btn btn-primary" asp-action="Invitations" asp-route-tenderId="@actionTender.TenderId" asp-fragment="invitations-create">Invite suppliers →</a>
        }
        @if (actionTender.Status is "Published" or "Open" or "Closed")
        {
            <a class="btn btn-outline-primary" asp-action="Offers" asp-route-tenderId="@actionTender.TenderId">Review offers & send to committee →</a>
        }
    </div></section>
}
</div></div><div class="modal fade" id="tender-create" tabindex="-1" aria-labelledby="tender-create-title" aria-hidden="true">
<div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
<div class="modal-header"><h2 class="modal-title fs-5" id="tender-create-title">Prepare tender &amp; invite suppliers</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
<form asp-action="Create" method="post" data-filter-suppliers>
@Html.AntiForgeryToken()
<input name="ReplacesTenderId" type="hidden" value="@createTender.ReplacesTenderId" />
<div class="modal-body">
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    @if (eligibleRequests.Count == 0)
    {
        <p class="text-secondary" role="status">No purchase requests are available for a new tender.</p>
    }
    <div class="mb-3">
        <label for="PurchaseRequestId" class="form-label">Purchase request</label>
        <select id="PurchaseRequestId" name="PurchaseRequestId" class="form-select" required disabled="@(eligibleRequests.Count == 0)">
            <option value="">Select a purchase request</option>
            @foreach (var request in eligibleRequests)
            {
                <option value="@request.PurchaseRequestId" selected="@(createTender.PurchaseRequestId == request.PurchaseRequestId)">@request.Title (Request #@request.PurchaseRequestId)</option>
            }
        </select>
        @Html.ValidationMessage("PurchaseRequestId", "", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label for="Title" class="form-label">Tender Title</label>
        <input id="Title" name="Title" value="@createTender.Title" maxlength="200" class="form-control" required />
        @Html.ValidationMessage("Title", "", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label for="Description" class="form-label">Description</label>
        <textarea id="Description" name="Description" maxlength="4000" rows="3" class="form-control" required>@createTender.Description</textarea>
        @Html.ValidationMessage("Description", "", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label for="Terms" class="form-label">Terms (optional)</label>
        <textarea id="Terms" name="Terms" maxlength="4000" rows="3" class="form-control">@createTender.Terms</textarea>
        @Html.ValidationMessage("Terms", "", new { @class = "text-danger" })
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="OpensAt" class="form-label">Opens At (UTC)</label>
            <input id="OpensAt" name="OpensAt" type="datetime-local" value="@(createTender.OpensAt == default ? "" : createTender.OpensAt.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" required />
            @Html.ValidationMessage("OpensAt", "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 mb-3">
            <label for="ClosesAt" class="form-label">Tender deadline (UTC)</label>
            <input id="ClosesAt" name="ClosesAt" type="datetime-local" value="@(createTender.ClosesAt == default ? "" : createTender.ClosesAt.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" required />
            @Html.ValidationMessage("ClosesAt", "", new { @class = "text-danger" })
        </div>
    </div>
<partial name="_ProcurementCategoryFields" model='((ProcurementCategoryInput)createTender, "Create", "Tender category")' />
<partial name="_LaunchSuppliers" />
</div>
<div class="modal-footer"><button type="submit" name="launch" value="false" class="btn btn-outline-primary" disabled="@(eligibleRequests.Count == 0)">Approve &amp; save draft</button><button type="submit" name="launch" value="true" class="btn btn-primary" disabled="@(eligibleRequests.Count == 0)">Approve, publish &amp; invite →</button></div>
</form>
</div></div></div><div class="modal fade" id="tender-edit" tabindex="-1" aria-labelledby="tender-edit-title" aria-hidden="true">
<div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
<div class="modal-header"><h2 class="modal-title fs-5" id="tender-edit-title">Edit Tender</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
<form asp-action="Edit" method="post">
@Html.AntiForgeryToken()
<input type="hidden" name="TenderId" value="@editTender?.TenderId" />
<div class="modal-body">
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    <div class="mb-3">
        <partial name="_ProcurementCategoryFields" model='((ProcurementCategoryInput?)editTender ?? new ProcurementCategoryInput(), "Edit", "Tender category")' />
        <label for="EditTitle" class="form-label">Tender Title</label>
        <input id="EditTitle" name="Title" value="@editTender?.Title" maxlength="200" class="form-control" required />
        @Html.ValidationMessage("Title", "", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label for="EditDescription" class="form-label">Description</label>
        <textarea id="EditDescription" name="Description" maxlength="4000" rows="3" class="form-control" required>@editTender?.Description</textarea>
        @Html.ValidationMessage("Description", "", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label for="EditTerms" class="form-label">Terms (optional)</label>
        <textarea id="EditTerms" name="Terms" maxlength="4000" rows="3" class="form-control">@editTender?.Terms</textarea>
        @Html.ValidationMessage("Terms", "", new { @class = "text-danger" })
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="EditOpensAt" class="form-label">Opens At (UTC)</label>
            <input id="EditOpensAt" name="OpensAt" type="datetime-local" value="@(editTender == null || editTender.OpensAt == default ? "" : editTender.OpensAt.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" required />
            @Html.ValidationMessage("OpensAt", "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 mb-3">
            <label for="EditClosesAt" class="form-label">Tender deadline (UTC)</label>
            <input id="EditClosesAt" name="ClosesAt" type="datetime-local" value="@(editTender == null || editTender.ClosesAt == default ? "" : editTender.ClosesAt.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" required />
            @Html.ValidationMessage("ClosesAt", "", new { @class = "text-danger" })
        </div>
    </div>
</div>
<div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button><button type="submit" class="btn btn-primary" disabled="@(editTender == null)">Save Changes</button></div>
</form>
</div></div></div>
</div>
<script src="~/js/procurement-categories.js" asp-append-version="true" defer></script>
@if (ViewBag.OpenCreateModal == true || ViewBag.OpenEditModal == true)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalId = '@(ViewBag.OpenEditModal == true ? "tender-edit" : "tender-create")';
            const modal = document.getElementById(modalId);
            if (modal) bootstrap.Modal.getOrCreateInstance(modal).show();
        });
    </script>
}

@if (Model.SelectedTender is { } clarificationRecord)
{
    @await Component.InvokeAsync("ClarificationHistory", new { kind = "tender", recordId = clarificationRecord.TenderId })
}
