@using SourcingTenderManagement.Models.Entities
@model List<Bid>
@{
    ViewData["Title"] = "Compliance Review";
    var selectedBid = ViewBag.SelectedBid as Bid;
}

@section Styles { <link rel="stylesheet" href="~/css/sourcing-officer.css" asp-append-version="true" /> }

<div class="so-page so-page--compliance">
<header class="so-page-header"><div><p class="so-eyebrow">ELIGIBILITY CHECK</p>
<h1>Compliance Review</h1>
<p class="so-page-description">Inspect submitted offers against the linked Purchase Request and record the applicable compliance decision.</p></div><span class="so-page-header-icon" aria-hidden="true">✓</span></header>
@if (TempData["ComplianceSuccess"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ComplianceError"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
<section class="so-summary-grid" aria-label="Compliance summary">
    <article class="so-summary-card so-tone-blue"><span class="so-summary-label">Offers in review list</span><strong>@Model.Count</strong><span class="so-summary-note">Submitted offers for your Tenders</span></article>
    <article class="so-summary-card so-tone-teal"><span class="so-summary-label">Compliant</span><strong>@Model.Count(bid => bid.ComplianceStatus == "Compliant")</strong><span class="so-summary-note">Final compliance decision</span></article>
    <article class="so-summary-card so-tone-coral"><span class="so-summary-label">Non-compliant</span><strong>@Model.Count(bid => bid.ComplianceStatus == "NonCompliant")</strong><span class="so-summary-note">Final compliance decision</span></article>
</section>

<div class="nav nav-tabs workspace-tabs" role="tablist" aria-label="Compliance Review">
    <button class="nav-link @(selectedBid == null ? "active" : "")" id="compliance-list-tab" data-bs-toggle="tab" data-bs-target="#compliance-list" type="button" role="tab" aria-controls="compliance-list" aria-selected="@(selectedBid == null ? "true" : "false")">Submitted Offers</button>
    <button class="nav-link @(selectedBid != null ? "active" : "")" id="compliance-details-tab" data-bs-toggle="tab" data-bs-target="#compliance-details" type="button" role="tab" aria-controls="compliance-details" aria-selected="@(selectedBid != null ? "true" : "false")">Offer Review</button>
</div>

<div class="tab-content workspace-content">
    <div class="tab-pane fade @(selectedBid == null ? "show active" : "")" id="compliance-list" role="tabpanel" aria-labelledby="compliance-list-tab" tabindex="0">
        <section class="workspace-section">
            <h2>Offers for Compliance Review</h2>
            @if (Model.Count == 0)
            {
                <p class="text-secondary">No submitted offers are available for your tenders.</p>
            }
            else
            {
                <div class="table-responsive"><table class="table">
                    <thead><tr><th>Tender</th><th>Supplier</th><th>Submitted (UTC)</th><th>Bid Status</th><th>Compliance Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var bid in Model)
                        {
                            <tr>
                                <td>@bid.Invitation.Tender.Title</td>
                                <td>@bid.Invitation.SupplierProfile.CompanyName</td>
                                <td>@bid.SubmittedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="so-status-badge" data-status="@bid.Status">@bid.Status</span></td>
                                <td><span class="so-status-badge" data-status="@(bid.ComplianceStatus ?? "Pending")">@(bid.ComplianceStatus ?? "Pending review")</span></td>
                                <td><a class="btn btn-outline-primary btn-sm" asp-action="Compliance" asp-route-id="@bid.BidId">Review</a></td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </section>
    </div>

    <div class="tab-pane fade @(selectedBid != null ? "show active" : "")" id="compliance-details" role="tabpanel" aria-labelledby="compliance-details-tab" tabindex="0">
        <section class="workspace-section">
            <h2>Offer and Tender Requirements</h2>
            @if (selectedBid is null)
            {
                <p class="text-secondary">Select a submitted offer to review its compliance.</p>
            }
            else
            {
                <dl>
                    <dt>Tender</dt><dd>@selectedBid.Invitation.Tender.Title</dd>
                    <dt>Supplier</dt><dd>@selectedBid.Invitation.SupplierProfile.CompanyName</dd>
                    <dt>Bid Status</dt><dd><span class="so-status-badge" data-status="@selectedBid.Status">@selectedBid.Status</span></dd>
                    <dt>Compliance Status</dt><dd><span class="so-status-badge" data-status="@(selectedBid.ComplianceStatus ?? "Pending")">@(selectedBid.ComplianceStatus ?? "Pending review")</span></dd>
                    <dt>Previous Review Notes</dt><dd>@selectedBid.ComplianceNotes</dd>
                </dl>

                <h3>Purchase Request Requirements</h3>
                @if (selectedBid.Invitation.Tender.PurchaseRequest.PurchaseRequestItems.Count == 0)
                {
                    <p class="text-secondary">No requested items are stored for this Tender.</p>
                }
                else
                {
                    <ul>
                        @foreach (var item in selectedBid.Invitation.Tender.PurchaseRequest.PurchaseRequestItems)
                        {
                            <li>@item.ItemName — @item.Quantity @item.Unit: @item.Specifications</li>
                        }
                    </ul>
                }

                <h3>Supplier Offer</h3>
                <p>@selectedBid.TechnicalDetails</p>
                @if (selectedBid.BidItems.Count > 0)
                {
                    <div class="table-responsive"><table class="table">
                        <thead><tr><th>Item</th><th>Quantity</th><th>Offered Specifications</th><th>Unit Price</th></tr></thead>
                        <tbody>
                            @foreach (var item in selectedBid.BidItems)
                            {
                                <tr><td>@item.PurchaseRequestItem.ItemName</td><td>@item.Quantity</td><td>@item.OfferedSpecifications</td><td>@item.UnitPrice.ToString("N2") @selectedBid.Currency</td></tr>
                            }
                        </tbody>
                    </table></div>
                }
                @if (selectedBid.BidDocuments.Count > 0)
                {
                    <h3>Submitted Document Metadata</h3>
                    <ul>@foreach (var document in selectedBid.BidDocuments) { <li>@document.OriginalFileName — @document.DocumentType (@document.ContentType)</li> }</ul>
                }

                <a asp-controller="Clarification" asp-action="Index" asp-route-kind="bid"
                   asp-route-recordId="@selectedBid.BidId" class="btn btn-outline-primary">Ask for clarification</a>
                @await Component.InvokeAsync("ClarificationHistory", new { kind = "bid", recordId = selectedBid.BidId })

                var hasOpenClarification = selectedBid.Clarifications.Any(c => c.Status != "Resolved");
                var canReview = (selectedBid.Status == "Submitted" || selectedBid.Status == "UnderReview")
                    && selectedBid.ComplianceStatus != "Compliant"
                    && selectedBid.ComplianceStatus != "NonCompliant"
                    && !hasOpenClarification;
                @if (canReview)
                {
                    <form asp-action="ReviewCompliance" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@selectedBid.BidId" />
                        <div class="mb-3">
                            <label for="compliance-notes" class="form-label">Review Notes (optional)</label>
                            <textarea id="compliance-notes" name="notes" maxlength="2000" rows="3" class="form-control">@selectedBid.ComplianceNotes</textarea>
                        </div>
                        <button type="submit" name="decision" value="Compliant" class="btn btn-success">Mark Compliant</button>
                        <button type="submit" name="decision" value="NonCompliant" class="btn btn-outline-danger">Mark Non-Compliant</button>
                    </form>
                }
                else if (hasOpenClarification)
                {
                    <p class="alert alert-info">Both sides must resolve the open offer clarifications before compliance review can continue.</p>
                }
                else
                {
                    <p class="text-secondary">This offer is not eligible for another compliance decision.</p>
                }
            }
        </section>
    </div>
</div>
</div>
