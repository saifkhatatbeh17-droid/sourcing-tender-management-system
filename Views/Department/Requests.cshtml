@model IReadOnlyList<SourcingTenderManagement.Models.Entities.PurchaseRequest>
@{ ViewData["Title"] = "Purchase Requests"; }
<h1>Purchase Requests</h1>
<div class="nav nav-tabs workspace-tabs" aria-label="Purchase Requests">
    <a class="nav-link active" asp-action="Requests" aria-current="page">My Requests</a>
    <span class="nav-link disabled">Request Details</span>
</div>
<div class="workspace-content">
    <p><a asp-action="Create" class="btn btn-primary">Create Request</a></p>
    <section class="workspace-section">
        <h2>My Purchase Requests</h2>
        <partial name="_PurchaseRequestList" model="Model" />
    </section>
</div>
