@using System.Globalization
@model IReadOnlyList<TeamMember>
@{
    ViewData["Title"] = "Meet Our Team";
    ViewData["DarkPublicPage"] = true;
    ViewData["HideWorkspaceSidebar"] = true;
    string No(int i) => (i + 1).ToString("D2", CultureInfo.InvariantCulture);
    var total = Model.Count.ToString("D2", CultureInfo.InvariantCulture);
}

<section class="cv-page" aria-labelledby="cv-title" data-cv>
    <header class="cv-top">
        <p class="cv-eyebrow">The team · Shipment TQ-@total</p>
        <h1 id="cv-title">The team behind <em>every delivery.</em></h1>
    </header>

    <div class="cv-layout">
        <div class="cv-stage" data-cv-stage>
            <div class="cv-lamp" aria-hidden="true"></div>

            <div class="cv-gate" aria-hidden="true">
                <div class="cv-gate-bar"><span class="cv-screen" data-cv-screen>Awaiting crate</span></div>
                <span class="cv-laser" data-cv-laser></span>
            </div>

            <div class="cv-crate-slot" data-cv-slot-crate>
                <div class="cv-crate" data-cv-crate>
                    <span class="cv-crate-top"></span>
                    <article class="cv-card" data-cv-card aria-live="polite"></article>
                    <span class="cv-crate-front">
                        <span class="cv-stencil-top">Tiryaq · Fragile</span>
                        <span class="cv-stencil-main" data-cv-crate-no>Crate 01</span>
                        <span class="cv-stencil-sub" data-cv-crate-role>Contents: 1 × team member</span>
                        <span class="cv-arrows">▲ ▲</span>
                    </span>
                    <span class="cv-lid" data-cv-lid></span>
                </div>
            </div>
            <div class="cv-peanuts" data-cv-peanuts aria-hidden="true"></div>

            <div class="cv-belt" data-cv-belt aria-hidden="true">
                <span class="cv-belt-surface"></span>
                <span class="cv-rollers">@for (var r = 0; r < 14; r++) {<i></i>}</span>
            </div>
        </div>

        <aside class="cv-manifest" aria-labelledby="cv-manifest-title">
            <h2 id="cv-manifest-title">Shipping manifest</h2>
            <ol>
                @for (var i = 0; i < Model.Count; i++)
                {
                    var member = Model[i];
                    var zoom = member.PortraitZoom.ToString(CultureInfo.InvariantCulture);
                    <li style="--i:@i">
                        <button type="button" class="cv-row" data-cv-row aria-label="Crate @No(i): @member.Name, @member.Role">
                            <span class="cv-row-avatar" data-cv-avatar><img src="@Url.Content(member.Portrait)" alt="" width="64" height="64" style="--focus:@member.PortraitFocus; --zoom:@zoom" /></span>
                            <span class="cv-row-text">
                                <span class="cv-row-no">Crate @No(i)</span>
                                <span class="cv-row-name">@member.Name</span>
                            </span>
                            <span class="cv-row-status" data-cv-status>Queued</span>
                        </button>
                    </li>
                }
            </ol>
            <div class="cv-controls">
                <button type="button" class="cv-btn" data-cv-prev aria-label="Previous crate"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <button type="button" class="cv-btn cv-btn-wide" data-cv-next>Next crate <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <button type="button" class="cv-btn" data-cv-toggle aria-pressed="false" aria-label="Pause the conveyor">
                    <svg class="cv-i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    <svg class="cv-i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
                </button>
            </div>
        </aside>
    </div>

    @for (var i = 0; i < Model.Count; i++)
    {
        var member = Model[i];
        var zoom = member.PortraitZoom.ToString(CultureInfo.InvariantCulture);
        var c = 0;
        <template data-cv-template data-role="@member.Role">
            <div class="cv-card-photo"><img src="@Url.Content(member.Portrait)" alt="" width="320" height="400" style="--focus:@member.PortraitFocus; --zoom:@zoom" /></div>
            <div class="cv-card-body">
                <p class="cv-card-tag"><span>Crate @No(i)</span>@member.Role</p>
                <h2 aria-label="@member.Name">@foreach (var word in member.Name.Split(' '))
                {<span class="cv-word" aria-hidden="true">@foreach (var ch in word)
                    {<span class="cv-ch" style="--c:@(c++)">@ch</span>}</span>}</h2>
                @if (!string.IsNullOrWhiteSpace(member.Bio))
                {
                    <p class="cv-card-bio">@member.Bio</p>
                }
                <div class="cv-card-links">
                    @if (member.LinkedInUrl != null)
                    {
                        <a href="@member.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="@member.Name on LinkedIn (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>LinkedIn</a>
                    }
                    @if (member.GitHubUrl != null)
                    {
                        <a href="@member.GitHubUrl" target="_blank" rel="noopener noreferrer" aria-label="@member.Name on GitHub (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3"/></svg>GitHub</a>
                    }
                    @if (member.PortfolioUrl != null)
                    {
                        <a href="@member.PortfolioUrl" target="_blank" rel="noopener noreferrer" aria-label="@member.Name's portfolio (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm-9 9h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9z"/></svg>Portfolio</a>
                    }
                </div>
            </div>
        </template>
    }
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/team-conveyor.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/team-conveyor.js" asp-append-version="true" defer></script>
}
