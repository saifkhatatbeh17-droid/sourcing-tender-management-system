@model ContactMessageInputModel
@{
    var isHomeLanding = ViewData["HomeLanding"] is true;
}
<section class="public-guide contact-panel" id="contact" aria-labelledby="contact-title">
    @if (isHomeLanding)
    {
        <h2 id="contact-title">Contact Us</h2>
    }
    else
    {
        <h1 id="contact-title">Contact Us</h1>
    }
    @if (TempData["ContactSuccess"] is string feedback)
    {
        <p role="status">@feedback</p>
    }
    <form class="contact-form" asp-controller="Home" asp-action="Contact" method="post" aria-labelledby="contact-title">
        <div>
            <label for="contact-name">Full name</label>
            <input asp-for="FullName" id="contact-name" class="form-control" autocomplete="name" required maxlength="120" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div>
            <label for="contact-email">Email address</label>
            <input asp-for="Email" id="contact-email" type="email" class="form-control" autocomplete="email" required maxlength="254" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="contact-wide">
            <label for="contact-subject">Subject</label>
            <input asp-for="Subject" id="contact-subject" class="form-control" required maxlength="150" />
            <span asp-validation-for="Subject" class="text-danger"></span>
        </div>
        <div class="contact-wide">
            <label for="contact-message">Message</label>
            <textarea asp-for="Message" id="contact-message" class="form-control" rows="4" required maxlength="2000"></textarea>
            <span asp-validation-for="Message" class="text-danger"></span>
        </div>
        <button type="submit" class="btn contact-send">Send message</button>
    </form>
</section>
