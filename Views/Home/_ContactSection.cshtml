@{
    var isHomeLanding = ViewData["HomeLanding"] is true;
}
<section class="public-guide contact-panel" id="contact" aria-labelledby="contact-title">
    @if (isHomeLanding)
    {
        <h2 id="contact-title">Contact Us</h2>
    }
    else
    {
        <h1 id="contact-title">Contact Us</h1>
    }
    <p id="contact-preview-note">Online messaging is currently unavailable.</p>
    <div class="contact-form" role="group" aria-labelledby="contact-title" aria-describedby="contact-preview-note">
        <div>
            <label for="contact-name">Full name</label>
            <input id="contact-name" class="form-control" autocomplete="name" maxlength="120" />
        </div>
        <div>
            <label for="contact-email">Email address</label>
            <input id="contact-email" type="email" class="form-control" autocomplete="email" maxlength="254" />
        </div>
        <div class="contact-wide">
            <label for="contact-subject">Subject</label>
            <input id="contact-subject" class="form-control" maxlength="150" />
        </div>
        <div class="contact-wide">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" class="form-control" rows="4" maxlength="2000"></textarea>
        </div>
        <button type="button" class="btn contact-send" disabled>Send message</button>
    </div>
</section>
