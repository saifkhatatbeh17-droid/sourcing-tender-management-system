@using System.Globalization
@model IReadOnlyList<TeamMember>
@{
    ViewData["Title"] = "Meet Our Team";
    ViewData["DarkPublicPage"] = true;
    ViewData["HideWorkspaceSidebar"] = true;
    var total = Model.Count.ToString("D2", CultureInfo.InvariantCulture);
}

<section class="spot-page" aria-labelledby="spot-title" data-spot>
    <header class="spot-top">
        <p class="spot-eyebrow">The team</p>
        <h1 id="spot-title"><span>Meet the people</span> <span>behind <em>Tiryaq.</em></span></h1>
    </header>

    <div class="spot-stage" data-spot-stage>
        <span class="spot-watermark" aria-hidden="true" data-spot-watermark>@Model[0].Name.Split(' ')[0]</span>

        <div class="spot-copy">
            <p class="spot-count" aria-hidden="true"><span class="spot-count-window"><span data-spot-count>01</span></span><span class="spot-count-total">/ @total</span></p>

            <div class="spot-texts" aria-live="polite">
                @for (var i = 0; i < Model.Count; i++)
                {
                    var member = Model[i];
                    var c = 0;
                    <article class="spot-text@(i == 0 ? " is-active" : "")" data-spot-text id="spot-member-@member.Id">
                        <p class="spot-role">@member.Role</p>
                        <h2 aria-label="@member.Name">
                            @foreach (var word in member.Name.Split(' '))
                            {
                                <span class="spot-word" aria-hidden="true">@foreach (var ch in word)
                                {<span class="spot-ch" style="--c:@(c++)">@ch</span>}</span>
                            }
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(member.Bio))
                        {
                            <p class="spot-bio">@member.Bio</p>
                        }
                        <div class="spot-links">
                            @if (member.LinkedInUrl != null)
                            {
                                <a href="@member.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="@member.Name on LinkedIn (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>LinkedIn</a>
                            }
                            @if (member.GitHubUrl != null)
                            {
                                <a href="@member.GitHubUrl" target="_blank" rel="noopener noreferrer" aria-label="@member.Name on GitHub (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3"/></svg>GitHub</a>
                            }
                            @if (member.PortfolioUrl != null)
                            {
                                <a href="@member.PortfolioUrl" target="_blank" rel="noopener noreferrer" aria-label="@member.Name's portfolio (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm-9 9h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9z"/></svg>Portfolio</a>
                            }
                        </div>
                    </article>
                }
            </div>

            <div class="spot-controls">
                <button type="button" class="spot-arrow" data-spot-prev aria-label="Previous team member"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <button type="button" class="spot-arrow" data-spot-next aria-label="Next team member"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <button type="button" class="spot-play" data-spot-toggle aria-pressed="false">
                    <svg class="spot-icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    <svg class="spot-icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
                    <span data-spot-toggle-label>Pause</span>
                </button>
            </div>
        </div>

        <div class="spot-frame-wrap">
            <div class="spot-frame" data-spot-frame>
                @for (var i = 0; i < Model.Count; i++)
                {
                    var member = Model[i];
                    var zoom = member.PortraitZoom.ToString(CultureInfo.InvariantCulture);
                    <img class="spot-photo@(i == 0 ? " is-active" : "")" data-spot-photo src="@Url.Content(member.Portrait)" alt=""
                         width="640" height="800" decoding="async" style="--focus:@member.PortraitFocus; --zoom:@zoom" />
                }
                <span class="spot-glare" aria-hidden="true"></span>
                <span class="spot-corner spot-corner-tl" aria-hidden="true"></span>
                <span class="spot-corner spot-corner-br" aria-hidden="true"></span>
            </div>
        </div>
    </div>

    <nav class="spot-rail" aria-label="Team members">
        @for (var i = 0; i < Model.Count; i++)
        {
            var member = Model[i];
            var zoom = member.PortraitZoom.ToString(CultureInfo.InvariantCulture);
            <button type="button" class="spot-thumb@(i == 0 ? " is-active" : "")" data-spot-thumb style="--i:@i"
                    aria-label="@member.Name, @member.Role" aria-controls="spot-member-@member.Id" aria-current="@(i == 0 ? "true" : "false")">
                <span class="spot-thumb-img"><img src="@Url.Content(member.Portrait)" alt="" width="96" height="96" style="--focus:@member.PortraitFocus; --zoom:@zoom" /></span>
                <svg class="spot-ring" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="30" pathLength="100" /></svg>
            </button>
        }
    </nav>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/team-spotlight.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/team-spotlight.js" asp-append-version="true" defer></script>
}
