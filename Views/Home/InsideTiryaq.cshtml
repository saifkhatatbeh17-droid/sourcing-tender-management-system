@{
    ViewData["Title"] = "Inside Tiryaq";
    ViewData["HidePublicNavigation"] = true;
    ViewData["HideWorkspaceSidebar"] = true;
}
@section Styles {
    <link rel="stylesheet" href="~/css/inside-tiryaq-city.css" asp-append-version="true" />
}
<div class="tiryaq-city" data-campus>
    <header class="city-header">
        <a asp-action="Index" class="city-brand" aria-label="Tiryaq home"><partial name="_PharmaBrand" /></a>
        <span>Inside Tiryaq <small>Follow one request through the city</small></span>
        <a asp-action="Index">Back to home ↗</a>
    </header>
    <main class="city-scroll" data-city-scroll>
        <section class="city-stage" aria-label="Interactive 2D sourcing city">
            <div class="city-caption">
                <div><span data-city-chapter>Pharmacy Department · sample PR-2041</span><h1 data-city-title>A request starts here.</h1><p data-city-caption>Follow the orange document through the people and places behind a tender.</p></div>
                <button type="button" data-city-overview>See the whole city</button>
            </div>
            <div class="city-viewport" data-city-viewport tabindex="0" role="region" aria-label="Continuous city. Drag to explore. Use arrow keys to move between stages, plus and minus to zoom.">
                <svg data-city-svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1050" role="img" aria-labelledby="city-svg-title city-svg-description">
                    <title id="city-svg-title">Inside the Tiryaq procurement city</title>
                    <desc id="city-svg-description">Six connected cutaway buildings show a purchase request becoming a tender, supplier offers, evaluations, approvals, and an award. One orange document travels through the same city.</desc>
                    <g data-city-world></g>
                </svg>
                <div class="city-map-tools"><button type="button" data-city-zoom="1" aria-label="Zoom in">+</button><button type="button" data-city-zoom="-1" aria-label="Zoom out">−</button><button type="button" data-city-follow>Follow the request</button></div>
                <span class="city-pan-hint">Drag to look around · scroll to follow the journey</span>
            </div>
            <div class="city-dock">
                <div class="city-playback">
                    <button type="button" class="city-play" data-city-play>Play journey</button>
                    <button type="button" data-city-replay aria-label="Replay the journey">↺</button>
                    <button type="button" data-city-previous aria-label="Previous step">←</button>
                    <output data-city-progress>01 · 1 / 5</output>
                    <button type="button" data-city-next aria-label="Next step">→</button>
                    <label class="city-scrub"><span class="visually-hidden">Journey position</span><input type="range" min="0" max="1000" value="0" step="1" data-city-scrub /></label>
                    <label class="city-suppliers">Suppliers <output data-city-count>3</output><input type="range" min="3" max="6" step="1" value="3" data-city-suppliers /></label>
                </div>
                <nav class="city-route" aria-label="Explore the city buildings">
                    @foreach (var step in new[] { (Id: 0, Name: "Request"), (Id: 1, Name: "Tender"), (Id: 2, Name: "Offers"), (Id: 3, Name: "Evaluation"), (Id: 4, Name: "Approvals"), (Id: 5, Name: "Award") })
                    { <button type="button" data-city-step="@step.Id"><span data-city-tick>@((step.Id + 1).ToString("00"))</span><strong>@step.Name</strong></button> }
                </nav>
            </div>
            <p class="visually-hidden" data-city-status role="status" aria-live="polite"></p>
        </section>
    </main>
</div>
@section Scripts {
    <script src="~/js/inside-tiryaq-scenes.js" asp-append-version="true"></script>
    <script src="~/js/inside-tiryaq-city.js" asp-append-version="true"></script>
}
