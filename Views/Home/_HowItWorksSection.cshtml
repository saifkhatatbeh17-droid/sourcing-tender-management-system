@{
    var chapterStarts = new[] { 0d, 18.350, 33.508, 54.474, 72.584, 90.646 };
    var chapterLabels = new[] { "0:00", "0:18", "0:33", "0:54", "1:12", "1:30" };
    var stages = new[]
    {
        (Icon: "needs", Title: "Identify Needs", Description: "Departments submit purchase requests with specifications, quantities, and target dates."),
        (Icon: "tender", Title: "Create the Tender", Description: "The sourcing team turns approved requests into tenders with clear terms and deadlines."),
        (Icon: "partners", Title: "Invite Suppliers", Description: "Invited suppliers review the requirements and submit their offers."),
        (Icon: "review", Title: "Evaluate Offers", Description: "Reviewers check compliance and assess offers against technical and financial criteria."),
        (Icon: "recommend", Title: "Review Recommendations", Description: "The Sourcing Manager reviews the recommendation, with CEO & Chiefs approval when required."),
        (Icon: "award", Title: "Award the Tender", Description: "The team records the award, closes the tender, and notifies the relevant parties.")
    };
}

<div class="public-guide journey-video-page" id="how-it-works">
    <section class="journey-video" aria-labelledby="journey-video-title">
        <header><div>
            @if (ViewData["HomeLanding"] is true || ViewData["EmbeddedSourcingJourney"] is true)
            { <h2 id="journey-video-title" class="journey-main-title">Our Sourcing Journey</h2> }
            else
            { <h1 id="journey-video-title" class="journey-main-title">Our Sourcing Journey</h1> }
            <p>See how your team takes a purchase request from first submission to final award.</p>
        </div></header>
        <div class="journey-video-meta"><span>1 min 51 sec</span><span>6 chapters</span><span>English AI narration</span><span>Closed captions</span></div>
        <video controls playsinline preload="metadata" poster="@Url.Content("~/media/sourcing-journey/poster-natural.jpg")" aria-label="Tiryaq sourcing journey explained with English narration">
            <source src="~/media/sourcing-journey/tiryaq-sourcing-journey-natural.mp4" type="video/mp4" />
            <track kind="captions" src="~/media/sourcing-journey/captions-natural-en.vtt" srclang="en" label="English" default />
            <track kind="chapters" src="~/media/sourcing-journey/chapters-natural-en.vtt" srclang="en" label="Sourcing stages" />
            <p>Your browser cannot play this video. <a href="~/media/sourcing-journey/tiryaq-sourcing-journey-natural.mp4">Download the walkthrough</a>.</p>
        </video>
        <div class="journey-player-footer"><p data-journey-current>Start the walkthrough, or choose a step below.</p><a href="~/media/sourcing-journey/tiryaq-sourcing-journey-natural.mp4" download>Download video</a></div>
        <details class="journey-transcript"><summary>Read the transcript</summary><partial name="_SourcingVideoTranscript" /></details>
    </section>

    <section class="guide-section guide-journey" id="sourcing-journey" aria-labelledby="journey-title">
        <div class="journey-steps-heading"><h2 id="journey-title">The six steps</h2><p>Choose a step to watch that part of the journey.</p></div>
        <div class="guide-journey-controls" hidden>
            <button type="button" data-direction="-1" aria-controls="journey-steps" aria-label="Previous sourcing stage">←</button>
            <button type="button" data-direction="1" aria-controls="journey-steps" aria-label="Next sourcing stage">→</button>
        </div>
        <div class="guide-journey-scroll" id="journey-steps" tabindex="0" role="group" aria-label="The six sourcing stages">
            <ol class="guide-journey-track" role="list">
            @for (var index = 0; index < stages.Length; index++)
            {
                var stage = stages[index];
                <li class="guide-stage" data-journey-stage="@index">
                    <div class="guide-stage-marker">
                        <span class="guide-step" aria-hidden="true">@((index + 1).ToString("00"))</span>
                    </div>
                    <div class="guide-stage-content">
                        <svg class="guide-art" viewBox="0 0 320 200" aria-hidden="true" focusable="false"><use href="@Url.Content($"~/images/public-guide.svg#{stage.Icon}")" /></svg>
                        <h3>@stage.Title</h3>
                        <p>@stage.Description</p>
                        <button type="button" class="journey-chapter" data-journey-seek="@chapterStarts[index].ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Watch @stage.Title at @chapterLabels[index]" hidden><span>Watch step</span><span>@chapterLabels[index]</span></button>
                    </div>
                </li>
            }
            </ol>
        </div>
    </section>

</div>
