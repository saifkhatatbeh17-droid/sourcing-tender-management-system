@{
    var isHomeLanding = ViewData["HomeLanding"] is true;
    var stages = new[]
    {
        (Icon: "needs", Title: "Identify Needs", Description: "Departments submit purchase requests with specifications, quantities, and target dates."),
        (Icon: "tender", Title: "Create the Tender", Description: "The sourcing team turns approved requests into tenders with clear terms and deadlines."),
        (Icon: "partners", Title: "Invite Suppliers", Description: "Invited suppliers review the requirements and submit their offers."),
        (Icon: "review", Title: "Evaluate Offers", Description: "Reviewers check compliance and assess offers against technical and financial criteria."),
        (Icon: "recommend", Title: "Review Recommendations", Description: "The Sourcing Manager reviews the recommendation, with CEO & Chiefs approval when required."),
        (Icon: "award", Title: "Award the Tender", Description: "The team records the award, closes the tender, and notifies the relevant parties.")
    };
}

<div class="public-guide" id="how-it-works">
    <section class="guide-hero guide-split" aria-labelledby="guide-title">
        <div>
            <p class="guide-kicker">Pharmaceutical procurement</p>
            @if (isHomeLanding)
            {
                <h2 id="guide-title">How It Works</h2>
            }
            else
            {
                <h1 id="guide-title">How It Works</h1>
            }
            <p class="guide-headline">Smarter Sourcing. Better Decisions.</p>
            <p>At Tiryaq, we believe that effective sourcing begins with clear planning, trusted collaboration, and transparent decisions.</p>
            <p>Our Sourcing &amp; Tender Management System brings departments, sourcing teams, suppliers, and evaluation committees together in one organized platform.</p>
            <a class="guide-link" href="#sourcing-journey">Explore the sourcing journey <span aria-hidden="true">↓</span></a>
        </div>
        <svg class="guide-art" viewBox="0 0 320 200" aria-hidden="true" focusable="false"><use href="@Url.Content("~/images/public-guide.svg#lab")" /></svg>
    </section>

    <section class="guide-section guide-split" aria-labelledby="guide-purpose">
        <svg class="guide-art" viewBox="0 0 320 200" aria-hidden="true" focusable="false"><use href="@Url.Content("~/images/public-guide.svg#platform")" /></svg>
        <div>
            <h2 id="guide-purpose">Connecting Every Step of the Sourcing Process</h2>
            <p>The platform keeps purchase requests, tender documents, supplier submissions, evaluation records, and procurement decisions together. Each team can work from the same requirements and see when its input is needed.</p>
            <p>For suppliers, it provides one place to review invitations, submit offers, and follow the outcome of a tender.</p>
        </div>
    </section>

    <section class="guide-section guide-journey" id="sourcing-journey" aria-labelledby="journey-title">
        <h2 id="journey-title">Our Sourcing Journey</h2>
        <div class="guide-journey-controls" hidden>
            <button type="button" data-direction="-1" aria-controls="journey-steps" aria-label="Previous sourcing stage">←</button>
            <button type="button" data-direction="1" aria-controls="journey-steps" aria-label="Next sourcing stage">→</button>
        </div>
        <div class="guide-journey-scroll" id="journey-steps" tabindex="0" role="group" aria-label="Sourcing stages. Scroll horizontally to see all six.">
            <ol class="guide-journey-track" role="list">
            @for (var index = 0; index < stages.Length; index++)
            {
                var stage = stages[index];
                <li class="guide-stage">
                    <div class="guide-stage-marker">
                        <span class="guide-step" aria-hidden="true">@((index + 1).ToString("00"))</span>
                    </div>
                    <div class="guide-stage-content">
                        <svg class="guide-art" viewBox="0 0 320 200" aria-hidden="true" focusable="false"><use href="@Url.Content($"~/images/public-guide.svg#{stage.Icon}")" /></svg>
                        <h3>@stage.Title</h3>
                        <p>@stage.Description</p>
                    </div>
                </li>
            }
            </ol>
        </div>
    </section>

    <section class="guide-section guide-benefits" aria-labelledby="guide-benefits-title">
        <h2 id="guide-benefits-title">Why Our Process Matters</h2>
        <dl>
            <div><dt>Transparency in Every Decision</dt><dd>Requirements, reviews, and approvals give teams a record of how decisions were made.</dd></div>
            <div><dt>Better Collaboration</dt><dd>Departments, sourcing teams, and reviewers work from the same tender information.</dd></div>
            <div><dt>Fair and Consistent Evaluation</dt><dd>Eligible offers are assessed against the same published criteria.</dd></div>
            <div><dt>Greater Efficiency</dt><dd>Keeping documents and decisions together reduces duplicate work and makes handoffs clearer.</dd></div>
        </dl>
    </section>

</div>
