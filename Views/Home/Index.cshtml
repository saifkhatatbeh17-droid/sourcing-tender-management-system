@{
    ViewData["Title"] = "Tiryaq Pharma";
    ViewData["HomeLanding"] = true;
    ViewData["HidePublicNavigation"] = true;
    var signedIn = User.Identity?.IsAuthenticated == true;
}
@* Homepage: follow one bottle (lot TQ-0417) through the production line. The scene is a canvas driven by scroll.
   Styles: wwwroot/css/tiryaq-journey.css. Behaviour: wwwroot/js/tiryaq-journey.js. Section id "contact" is kept for old links. *@
<div class="tj-root">
<header class="tj-nav">
  <a class="brand" href="#top" aria-label="Tiryaq Pharma, back to start">
    <svg viewBox="0 0 26 26" aria-hidden="true"><path d="M9 3h8v3H9z" fill="#efb85c"/><path d="M10 6h6v2.6c3.4 1 5 3.2 5 6.4v6a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-6c0-3.2 1.6-5.4 5-6.4z" fill="none" stroke="#f4eee2" stroke-width="1.6"/><path d="M6.6 16h12.8v5a2 2 0 0 1-2 2H8.6a2 2 0 0 1-2-2z" fill="#d98a2b"/></svg>
    Tiryaq<small>Pharma</small>
  </a>
  <nav class="links" aria-label="Main navigation">
    <button type="button" data-go="2.3">Formulation</button>
    <button type="button" data-go="3.55">Filling</button>
    <button type="button" data-go="6.95">Quality</button>
    <button type="button" data-go="9.0">Products</button>
    <a asp-controller="Home" asp-action="Team">Our team</a>
    <a class="public-page-link" asp-controller="Home" asp-action="HowItWorks">Sourcing</a>
    <a class="public-page-link" asp-controller="Home" asp-action="Contact">Contact</a>
    @if (signedIn)
    {
        <a asp-controller="FaceEnrollment" asp-action="Index">Biometric sign-in</a>
        @await Component.InvokeAsync("NotificationBell")
        <a class="cta" asp-controller="Account" asp-action="GoToDashboard">My dashboard</a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="tj-signout"><button type="submit">Sign out</button></form>
    }
    else
    {
        <a class="keep" asp-controller="Account" asp-action="Login">Login</a>
        <a class="cta" asp-controller="Account" asp-action="Register">Supplier registration</a>
    }
  </nav>
</header>

<div id="top">
<div id="track">
  <section id="stage" aria-label="The making of one medicine, controlled by scrolling">
    <canvas id="scene" role="img" aria-label="An illustrated pharmaceutical production line. One bottle, lot TQ-0417, travels on a conveyor through formulation, filling, capping, labelling, inspection and packaging, and finally arrives on a windowsill at home."></canvas>

    <div class="tj-card" id="c-hero" data-in="-1" data-out=".72">
      <p class="eyebrow"><i></i>Tiryaq Pharma · Line 04 · Oral liquids</p>
      <h1>From the smallest detail to the <em>greatest human impact.</em></h1>
      <p>Tiryaq Pharma develops and manufactures medicines. This is one bottle, lot TQ-0417, and the care it receives on its way to someone’s home.</p>
      <div class="btns"><button class="tj-btn solid" type="button" data-go="1.4">Follow the bottle <b>↓</b></button>@if (signedIn) {<a class="tj-btn" asp-controller="Account" asp-action="GoToDashboard">Go to my dashboard</a>} else {<a class="tj-btn" asp-controller="Account" asp-action="Register">Become a supplier</a>}</div>
    </div>

    <div class="tj-card" id="c-reveal" data-in="1.05" data-out="1.75">
      <h2>One line. One bottle. <em>Every detail.</em></h2>
      <p>Line 04 joins formulation, filling, capping, labelling, inspection and packaging in a single continuous rail. Our bottle has just stepped onto it.</p>
    </div>

    <aside class="tj-card" id="ticket" data-in=".95" data-out="8.72" aria-label="Batch record for lot TQ-0417">
      <header><b>TQ-0417</b><span>BATCH RECORD</span></header>
      <ol id="stamps">
        <li data-at="2.62">Formulated <s>OK</s></li>
        <li data-at="3.82">Filled <s>OK</s></li>
        <li data-at="4.97">Capped <s>OK</s></li>
        <li data-at="5.86">Labelled <s>OK</s></li>
        <li data-at="7.2">Inspected <s>PASS</s></li>
        <li data-at="8.42">Packed <s>OK</s></li>
      </ol>
    </aside>

    <article class="tj-card L ins" id="c-form" data-tab="01 · Formulation" data-in="1.95" data-out="3.0">
      <h2>Where science becomes <em>medicine.</em></h2>
      <p>Before a bottle is filled, the solution is prepared: ingredients are weighed, dissolved in purified water and mixed under controlled conditions, then sampled and released for filling.</p>
      <ol class="steps" id="form-steps">
        <li data-at="1.98">Weigh each ingredient <span>dispensary</span></li>
        <li data-at="2.12">Dissolve in purified water <span>vessel</span></li>
        <li data-at="2.3">Mix to a uniform solution <span>agitator</span></li>
        <li data-at="2.5">Sample &amp; release <span>QC</span></li>
        <li data-at="2.75">Transfer to the filler <span>line</span></li>
      </ol>
      <small class="illus-note">Illustrative, simplified sequence. Process parameters are product-specific.</small>
    </article>

    <article class="tj-card R inst" id="c-fill" data-in="3.2" data-out="4.02">
      <p class="eyebrow" style="color:var(--signal)"><i></i>02 · Filling</p>
      <h2>Measured to <em>the line.</em></h2>
      <p>The nozzle enters the neck, doses, and withdraws. Filling from inside the neck keeps the stream calm and the level exact.</p>
      <div class="gauge">
        <div class="tube" id="tube"><i></i><b></b><u style="top:30%"></u><u style="top:45%"></u><u style="top:60%"></u><u style="top:75%"></u></div>
        <dl class="readout">
          <div><dt>Nozzle</dt><dd id="r-noz">raised</dd></div>
          <div><dt>Dose</dt><dd id="r-dose">0%</dd></div>
          <div><dt>Level</dt><dd id="r-lvl">—</dd></div>
          <div><dt>Bottle</dt><dd>TQ-0417</dd></div>
        </dl>
      </div>
    </article>

    <article class="tj-card L inst" id="c-cap" data-in="4.45" data-out="5.1">
      <p class="eyebrow" style="color:var(--signal)"><i></i>03 · Capping</p>
      <h2>Sealed, then <em>secured.</em></h2>
      <p>Caps travel from the feeder bowl down a chute. The capping head picks one, seats it on the neck and turns it to a controlled torque.</p>
      <div class="dial">
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <circle cx="60" cy="60" r="52" fill="none" stroke="rgba(207,230,218,.18)" stroke-width="8"/>
          <path d="M23 97 A52 52 0 1 1 97 97" fill="none" stroke="rgba(207,230,218,.18)" stroke-width="2"/>
          <path id="dial-arc" d="M23 97 A52 52 0 1 1 97 97" fill="none" stroke="#efb85c" stroke-width="8" stroke-linecap="round" pathLength="100" stroke-dasharray="0 100"/>
          <path d="M84 30 A52 52 0 0 1 100 52" fill="none" stroke="#6fe0a8" stroke-width="3"/>
          <g class="needle" id="needle"><line x1="60" y1="60" x2="60" y2="18" stroke="#f4eee2" stroke-width="2"/><circle cx="60" cy="60" r="5" fill="#f4eee2"/></g>
        </svg>
        <dl class="readout">
          <div><dt>Cap</dt><dd id="r-cap">in chute</dd></div>
          <div><dt>Torque</dt><dd id="r-tq">—</dd></div>
          <div><dt>Window</dt><dd>green band</dd></div>
        </dl>
      </div>
    </article>

    <article class="tj-card R ins" id="c-label" data-tab="04 · Labelling" data-in="5.5" data-out="6.15">
      <h2>Giving it an <em>identity.</em></h2>
      <p>The label peels from its roll and wraps the bottle in one turn. Everything a pharmacist and a patient need sits in a clear order.</p>
      <ul class="anat">
        <li><span><b>Brand &amp; product</b> · Tiryaq · Velmira</span></li>
        <li><span><b>Strength &amp; form</b> · 5 mg / 5 mL oral solution</span></li>
        <li><span><b>Volume</b> · 100 mL</span></li>
        <li><span><b>Batch &amp; expiry</b> · TQ-0417, printed on line</span></li>
        <li><span><b>Barcode</b> · scanned again at inspection</span></li>
      </ul>
      <small class="illus-note">Velmira is a fictional, illustrative product. It is not a real medicine.</small>
    </article>

    <article class="tj-card L inst" id="c-qc" data-in="6.45" data-out="7.32">
      <p class="eyebrow" style="color:var(--signal)"><i></i>05 · Inspection</p>
      <h2>Five checks. <em>One decision.</em></h2>
      <p>Cameras and lighting check every unit. A bottle moves on only when every check agrees. The one ahead of ours did not.</p>
      <ol class="qc" id="qc">
        <li data-at="6.6">Fill level within band <em></em></li>
        <li data-at="6.72">Cap seated · tamper ring intact <em></em></li>
        <li data-at="6.84">Label present &amp; aligned <em></em></li>
        <li data-at="6.96">Batch code read · TQ-0417 <em></em></li>
        <li data-at="7.08">No visible particles <em></em></li>
      </ol>
    </article>

    <article class="tj-card R ins" id="c-pack" data-tab="06 · Packaging" data-in="7.7" data-out="8.5">
      <h2>Folded around <em>it.</em></h2>
      <p>A flat carton blank opens into a box. The bottle is lowered in, the flaps fold and tuck, and the carton carries the same identity as the label.</p>
      <ol class="steps" id="pack-steps">
        <li data-at="7.74">Bottle picked from the line <span>gripper</span></li>
        <li data-at="7.94">Carton erected from a flat blank <span>magazine</span></li>
        <li data-at="8.08">Lowered into the carton <span>insert</span></li>
        <li data-at="8.24">Flaps folded &amp; tucked <span>closing</span></li>
      </ol>
    </article>

    <section class="tj-card" id="c-products" data-in="8.78" data-out="9.4" aria-labelledby="p-title">
      <div class="head">
        <h2 id="p-title">The same care, in <em>every form.</em></h2>
        <p>Line 04 makes oral liquids. The standard it follows applies to everything we make. [Portfolio to be confirmed by Tiryaq.]</p>
      </div>
      <div class="pgrid" id="pgrid">
        <article class="pc" tabindex="0"><div class="art" style="background:#f6dfc0"><svg viewBox="0 0 80 100" aria-hidden="true"><rect x="31" y="4" width="18" height="12" rx="2" fill="#1d5560"/><path d="M33 16h14v6c9 3 13 8 13 15v50a8 8 0 0 1-8 8H28a8 8 0 0 1-8-8V37c0-7 4-12 13-15z" fill="#fff" fill-opacity=".5" stroke="#0a1f26" stroke-width="1.6"/><path d="M21 52h38v35a7 7 0 0 1-7 7H28a7 7 0 0 1-7-7z" fill="#d98a2b"/><rect x="21" y="44" width="38" height="26" fill="#fbf7ef" stroke="#0a1f26" stroke-width=".8"/><rect x="21" y="44" width="38" height="5" fill="#1d5560"/><path d="M27 57h26" stroke="#e07a5f" stroke-width="1.5"/></svg></div><h3>Oral solutions</h3><p>Liquids measured to the line, for flexible dosing.</p><small>Line 04 · this journey</small></article>
        <article class="pc" tabindex="0"><div class="art" style="background:#d9e9e1"><svg viewBox="0 0 80 100" aria-hidden="true"><rect x="12" y="20" width="56" height="62" rx="8" fill="#eef1ee" stroke="#0a1f26" stroke-width="1.4"/><g fill="#fff" stroke="#8db8a8" stroke-width="1.4"><ellipse cx="28" cy="38" rx="9" ry="7"/><ellipse cx="52" cy="38" rx="9" ry="7"/><ellipse cx="28" cy="62" rx="9" ry="7"/><ellipse cx="52" cy="62" rx="9" ry="7"/></g><g fill="#efb85c"><rect x="21" y="34" width="14" height="8" rx="4"/><rect x="45" y="58" width="14" height="8" rx="4"/></g><path d="M45 38h14M21 62h14" stroke="#0a1f26" stroke-width=".8"/></svg></div><h3>Tablets &amp; capsules</h3><p>Solid doses with consistent weight and release.</p><small>Compression · encapsulation</small></article>
        <article class="pc" tabindex="0"><div class="art" style="background:#efe3d3"><svg viewBox="0 0 80 100" aria-hidden="true"><path d="M14 38l44-8v34l-44 8z" fill="#fbf7ef" stroke="#0a1f26" stroke-width="1.4"/><path d="M58 30l10 2v30l-10 2z" fill="#1d5560"/><rect x="68" y="40" width="8" height="14" rx="2" fill="#d98a2b"/><path d="M14 38l-6 2v30l6 2z" fill="#cfd6d2" stroke="#0a1f26" stroke-width="1"/><text x="34" y="54" font-family="Georgia,serif" font-size="9" fill="#1d5560" transform="rotate(-9 34 54)">Tiryaq</text></svg></div><h3>Topical preparations</h3><p>Creams and ointments made for even application.</p><small>Mixing · tube filling</small></article>
        <article class="pc" tabindex="0"><div class="art" style="background:#dfe2ec"><svg viewBox="0 0 80 100" aria-hidden="true"><path d="M22 30h36l-5 52a6 6 0 0 1-6 5H33a6 6 0 0 1-6-5z" fill="#fff" fill-opacity=".6" stroke="#0a1f26" stroke-width="1.4"/><path d="M25 58h30l-2.6 24a5 5 0 0 1-5 4H32.6a5 5 0 0 1-5-4z" fill="#d98a2b"/><g stroke="#0a1f26" stroke-width="1"><path d="M23 40h8M23.6 48h6M24.4 56h8M25.2 64h6M26 72h8"/></g><text x="38" y="47" font-family="ui-monospace,monospace" font-size="6" fill="#0a1f26">5 mL</text></svg></div><h3>Accurate dosing</h3><p>Measuring devices matched to each liquid product.</p><small>Packed with the product</small></article>
      </div>
    </section>

    <div class="tj-card" id="c-end" data-in="9.8" data-out="11">
      <p class="eyebrow" style="color:#7a5a3a"><i></i>Lot TQ-0417 · delivered</p>
      <h2>Every detail matters, because every medicine <em>reaches a person.</em></h2>
      <p>Tiryaq Pharma brings scientific precision, careful manufacturing and quality checks to every unit, so a quiet morning can stay quiet.</p>
      <div class="btns"><a class="tj-btn solid" asp-controller="Home" asp-action="Contact">Partner with Tiryaq</a><button class="tj-btn" type="button" data-go="0">Watch it again ↑</button></div>
    </div>

    <div id="rail" aria-label="Journey progress">
      <div class="line"></div><div class="done"></div>
      <svg class="mini" viewBox="0 0 14 24" aria-hidden="true"><rect x="4.5" y="0" width="5" height="4" rx="1" fill="#1d5560"/><path d="M5 4h4v2.4c2.6.8 4 2.4 4 5V21a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-9.6c0-2.6 1.4-4.2 4-5z" fill="#f4eee2"/><path d="M1.2 14h11.6v7a1.6 1.6 0 0 1-1.6 1.6H2.8A1.6 1.6 0 0 1 1.2 21z" fill="#d98a2b"/></svg>
    </div>
    <p class="hint" id="hint" aria-hidden="true"><i></i>Scroll to run the line</p>
  </section>
</div>

<section class="after" id="contact" aria-labelledby="contact-title">
  <div class="grid">
    <h2 id="contact-title">Precision you can <em>partner with.</em></h2>
    <div>
      <p>For manufacturing partnerships, supply enquiries, distribution or careers, tell us what you need and the right team will reply. Suppliers can also raise tender questions through Clarifications in their workspace.</p>
      <div class="btns"><a class="tj-btn solid" asp-controller="Home" asp-action="Contact">Write to Tiryaq</a>@if (signedIn) {<a class="tj-btn" asp-controller="Account" asp-action="GoToDashboard">My dashboard</a>} else {<a class="tj-btn" asp-controller="Account" asp-action="Register">Supplier registration</a><a class="tj-btn" asp-controller="Account" asp-action="Login">Login</a>}</div>
    </div>
    <div class="values">
      <div><h3>Science that can be explained</h3><p>Every formulation step is documented, tested and reviewable.</p></div>
      <div><h3>Quality as a routine</h3><p>Checks are built into each station, not added at the end.</p></div>
      <div><h3>Accountability to people</h3><p>Medicines reach real households. That sets our standard.</p></div>
    </div>
  </div>
  <footer><span>&copy; @DateTime.UtcNow.Year Tiryaq Pharma</span><nav class="tj-foot-links" aria-label="Footer"><a asp-controller="Home" asp-action="About">About</a><a asp-controller="Home" asp-action="Team">Our team</a><a asp-controller="Home" asp-action="HowItWorks">How sourcing works</a><a asp-controller="Home" asp-action="Contact">Contact</a></nav><span>Velmira and lot TQ-0417 are illustrative. Machinery and steps are simplified for explanation and make no regulatory or performance claim.</span><span>[Legal and regulatory information to be supplied]</span></footer>
</section>
</div>
</div>

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@@0;1&family=Geist:wght@@400;500;600&family=JetBrains+Mono:wght@@400;500&display=swap" />
    <link rel="stylesheet" href="~/css/tiryaq-journey.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/tiryaq-journey.js" asp-append-version="true"></script>
}
