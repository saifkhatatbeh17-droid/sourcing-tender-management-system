@{
    ViewData["Title"] = "Tiryaq Pharma";
    ViewData["HomeLanding"] = true;
    var signedIn = User.Identity?.IsAuthenticated == true;
}
@* Tiryaq Pharma — The Genesis Line (Lot TQ-0417):
   Synthesizes the intimate single-bottle scroll-instrument storytelling of Lot TQ-0417 with a progressive Three.js 3D world
   that begins on one serene studio rail, passes through sourcing convergence, diving-nozzle filling, torque sealing, and dark-field
   vision, blooms into a sunlit 12-rail cleanroom atrium, and arrives quietly on a morning windowsill at home.
   Section id "contact" is preserved on the closing section for legacy anchor compatibility. *@
<div class="tj-root" id="top">
  <div id="track">
    <section id="stage" aria-label="The making of Lot TQ-0417, controlled by scrolling">
      <canvas id="gl-canvas" role="img" aria-label="Interactive 3D pharmaceutical journey following bottle TQ-0417 from a single cleanroom rail through verified sourcing, filling, sealing, optical inspection, a twelve-rail cleanroom atrium, and arrival on a sunlit home windowsill."></canvas>

      <!-- Graceful illustrated fallback if WebGL is unavailable -->
      <div id="gl-fallback" hidden role="status">
        <svg viewBox="0 0 960 540" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <rect width="960" height="540" fill="#0a2129"/>
          <line x1="0" y1="390" x2="960" y2="390" stroke="#9eb8b5" stroke-width="6"/>
          <line x1="0" y1="414" x2="960" y2="414" stroke="#1d5560" stroke-width="14"/>
          <path d="M620 170h56v34c34 12 52 34 52 68v114a16 16 0 0 1-16 16H584a16 16 0 0 1-16-16V272c0-34 18-56 52-68z" fill="rgba(255,255,255,0.12)" stroke="#d9ece8" stroke-width="3"/>
        </svg>
      </div>

      <!-- Soft editorial left vignette during Hero & warm sunlight threshold veil before Home -->
      <div class="tj-hero-scrim" id="hero-scrim" aria-hidden="true"></div>
      <div class="tj-sun-veil" id="sun-veil" aria-hidden="true"></div>

      <!-- ==================== BEAT 0: INTIMATE SINGLE-RAIL STUDIO HERO ==================== -->
      <div class="tj-beat tj-hero is-on" id="b-hero" data-in="-0.5" data-out="0.80">
        <p class="tj-kicker"><span>LOT TQ-0417</span>Line 04 · Sourcing to Patient</p>
        <h1>From the smallest detail to <em>every trusted line.</em></h1>
        <p class="tj-hero-lead">Tiryaq Pharma unites verified sourcing and precision manufacturing. Follow one crystal vessel—lot TQ-0417—as qualified suppliers converge, instruments measure to the millimetre, and one quiet rail opens into a twelve-line cleanroom.</p>
        <div class="tj-actions">
          <button type="button" class="tj-btn solid" data-goto-beat="1.62">Follow the bottle <span aria-hidden="true">↓</span></button>
          <button type="button" class="tj-btn ghost" data-cruise-toggle>Auto-run line <span aria-hidden="true">▶</span></button>
          @if (signedIn)
          {
            <a class="tj-btn ghost" asp-controller="Account" asp-action="GoToDashboard">Open workspace</a>
          }
          else
          {
            <a class="tj-btn ghost" asp-controller="Account" asp-action="Register">Become a supplier</a>
          }
        </div>
      </div>

      <!-- ==================== BEAT 1: SOURCING CONVERGENCE & 4-TOWER GATE ==================== -->
      <article class="tj-beat tj-card pos-L" id="b-source" data-in="1.08" data-out="2.22" aria-labelledby="t-source">
        <header class="tj-card-head">
          <span class="tj-eyebrow"><i></i>01 · Sourcing &amp; Governance</span>
          <span class="tj-badge">TND-0417 · 4/4</span>
        </header>
        <h2 id="t-source">Three verified streams. <em>One released rail.</em></h2>
        <p>Before formulation starts, three compliant supplier streams—borosilicate glass, bio-actives, and closures—converge through our four-tower committee gate while non-compliant lots divert.</p>

        <div class="tj-stream-list" role="listbox" aria-label="Select supplier feeder stream to highlight in 3D">
          <button type="button" class="tj-stream is-selected" role="option" aria-selected="true" data-stream="0">
            <span class="tj-stream-dot"></span>
            <span class="tj-stream-main">
              <strong>Al-Hikma Pharmaceutical Glass</strong>
              <small>Type III vessel · 14,200 JD + 16% tax</small>
            </span>
            <b class="tj-stream-score">94.2</b>
          </button>
          <button type="button" class="tj-stream" role="option" aria-selected="false" data-stream="1">
            <span class="tj-stream-dot"></span>
            <span class="tj-stream-main">
              <strong>Levant Bio-Active Solutions</strong>
              <small>Purified oral active · COA verified</small>
            </span>
            <b class="tj-stream-score">95.1</b>
          </button>
          <button type="button" class="tj-stream" role="option" aria-selected="false" data-stream="2">
            <span class="tj-stream-dot"></span>
            <span class="tj-stream-main">
              <strong>Amman Precision Closures</strong>
              <small>28 mm tamper-ring cap · 13,850 JD</small>
            </span>
            <b class="tj-stream-score">91.8</b>
          </button>
        </div>

        <dl class="tj-mini-grid">
          <div><dt>Evaluation</dt><dd id="r-eval-seat">4/4 scored · Rank 1</dd></div>
          <div><dt>CEO &amp; Chiefs</dt><dd>4/4 award signed</dd></div>
        </dl>
      </article>

      <!-- ==================== BEAT 2: FORMULATION & DIVING-NOZZLE FILLING ==================== -->
      <article class="tj-beat tj-card pos-R" id="b-fill" data-in="2.48" data-out="3.68" aria-labelledby="t-fill">
        <header class="tj-card-head">
          <span class="tj-eyebrow"><i></i>02 · Formulation &amp; Filling</span>
          <span class="tj-badge">STATION F-02</span>
        </header>
        <h2 id="t-fill">Measured to <em>the meniscus.</em></h2>
        <p>Homogenized solution feeds from the jacketed vessel to the diving nozzle, dosing from inside the neck so the stream stays calm and the level exact.</p>

        <div class="tj-burette-wrap">
          <div class="tj-burette" aria-hidden="true">
            <span class="tj-burette-stream" id="inst-stream"></span>
            <span class="tj-burette-fill" id="inst-fill"></span>
            <u style="top:22%"></u>
            <u style="top:44%"></u>
            <u style="top:66%"></u>
            <u style="top:84%"></u>
          </div>
          <dl class="tj-readout">
            <div><dt>Nozzle</dt><dd id="r-nozzle">raised</dd></div>
            <div><dt>Volume</dt><dd id="r-volume">0.0 mL</dd></div>
            <div><dt>Meniscus</dt><dd id="r-meniscus">awaiting</dd></div>
            <div><dt>Specimen</dt><dd>TQ-0417</dd></div>
          </dl>
        </div>
      </article>

      <!-- ==================== BEAT 3: TORQUE SEALING & WRAP IDENTITY ==================== -->
      <article class="tj-beat tj-card pos-L" id="b-seal" data-in="3.96" data-out="5.18" aria-labelledby="t-seal">
        <header class="tj-card-head">
          <span class="tj-eyebrow"><i></i>03 · Sealing &amp; Identity</span>
          <span class="tj-badge">STATION C-03</span>
        </header>
        <h2 id="t-seal">Sealed tight, then <em>given a name.</em></h2>
        <p>A ribbed closure seats on the neck and turns into the calibrated torque window before the rotary drum wraps the Velmira batch label in one clean revolution.</p>

        <div class="tj-dial-wrap">
          <svg class="tj-dial-svg" viewBox="0 0 120 120" aria-hidden="true">
            <circle cx="60" cy="60" r="48" fill="none" stroke="rgba(10,31,38,0.11)" stroke-width="8"/>
            <path d="M26 94 A48 48 0 1 1 94 94" fill="none" stroke="rgba(10,31,38,0.18)" stroke-width="2"/>
            <path id="inst-dial-arc" d="M26 94 A48 48 0 1 1 94 94" fill="none" stroke="#d98a2b" stroke-width="8" stroke-linecap="round" pathLength="100" stroke-dasharray="0 100"/>
            <path d="M82 28 A48 48 0 0 1 102 56" fill="none" stroke="#1b8a6b" stroke-width="3.5" stroke-linecap="round"/>
            <g id="inst-needle" style="transform-origin:60px 60px; transform:rotate(-125deg)">
              <line x1="60" y1="60" x2="60" y2="20" stroke="#0a1f26" stroke-width="2.4" stroke-linecap="round"/>
              <circle cx="60" cy="60" r="5" fill="#0a1f26"/>
            </g>
          </svg>
          <dl class="tj-readout">
            <div><dt>Closure</dt><dd id="r-cap">in chute</dd></div>
            <div><dt>Torque</dt><dd id="r-torque">0.00 N·m</dd></div>
            <div><dt>Wrap label</dt><dd id="r-label">standby</dd></div>
            <div><dt>Identity</dt><dd>Velmira · 100 mL</dd></div>
          </dl>
        </div>
      </article>

      <!-- ==================== BEAT 4: 5-POINT DARK-FIELD VISION INSPECTION ==================== -->
      <article class="tj-beat tj-card pos-R" id="b-qc" data-in="5.46" data-out="6.66" aria-labelledby="t-qc">
        <header class="tj-card-head">
          <span class="tj-eyebrow"><i></i>04 · Optical Inspection</span>
          <span class="tj-badge">VISION V-05</span>
        </header>
        <h2 id="t-qc">Five checks. <em>One decision.</em></h2>
        <p>Dark-field cameras scan cap, meniscus, label, batch code, and clarity. A unit advances only when all five checks agree—the unlabelled unit ahead was diverted.</p>

        <ol class="tj-qc-list" id="inst-qc">
          <li data-qc-step="0"><span>Meniscus fill band (100 mL ±0.2%)</span><em>queued</em></li>
          <li data-qc-step="1"><span>Closure seated · tamper ring intact</span><em>queued</em></li>
          <li data-qc-step="2"><span>Velmira label aligned &amp; verified</span><em>queued</em></li>
          <li data-qc-step="3"><span>Batch &amp; expiry OCR · TQ-0417</span><em>queued</em></li>
          <li data-qc-step="4"><span>Zero suspended particulates</span><em>queued</em></li>
        </ol>
      </article>

      <!-- ==================== BEAT 5: DAYLIGHT BLOOM & 12-RAIL CLEANROOM ATRIUM ==================== -->
      <aside class="tj-beat tj-dock" id="b-scale" data-in="6.98" data-out="8.42" aria-labelledby="t-scale">
        <div class="tj-dock-top">
          <div>
            <span class="tj-eyebrow"><i></i>05 · Twelve-Line Cleanroom Atrium · Drag Scene to Orbit</span>
            <h2 id="t-scale">The same care, multiplied across <em>every form.</em></h2>
          </div>
          <div class="tj-cam-pills" role="group" aria-label="Atrium 3D camera angle">
            <button type="button" class="is-on" data-atrium-cam="crane">Atrium crane</button>
            <button type="button" data-atrium-cam="chase">Chase TQ-0417</button>
            <button type="button" data-atrium-cam="zenith">Aerial blueprint</button>
          </div>
        </div>

        <div class="tj-form-pills" role="tablist" aria-label="Highlight dosage form lines in the 3D atrium">
          <button type="button" class="tj-form-pill is-on" role="tab" aria-selected="true" data-form-focus="oral">
            <strong>Oral solutions</strong>
            <span>Line 04 spine · Dosing &amp; torque</span>
          </button>
          <button type="button" class="tj-form-pill" role="tab" aria-selected="false" data-form-focus="solid">
            <strong>Tablets &amp; capsules</strong>
            <span>3 glass sky-tubes · Pneumatic</span>
          </button>
          <button type="button" class="tj-form-pill" role="tab" aria-selected="false" data-form-focus="sterile">
            <strong>Sterile injectables</strong>
            <span>North multi-tier waves · Rotary</span>
          </button>
          <button type="button" class="tj-form-pill" role="tab" aria-selected="false" data-form-focus="topical">
            <strong>Topicals &amp; dosing</strong>
            <span>South counter-flow &amp; robotics</span>
          </button>
        </div>
      </aside>

      <!-- ==================== BEAT 6: SUNLIT MORNING WINDOWSILL AT HOME ==================== -->
      <div class="tj-beat tj-home" id="b-home" data-in="8.82" data-out="10.5">
        <p class="tj-eyebrow"><i></i>Lot TQ-0417 · Delivered Home</p>
        <h2>Every detail matters, because every medicine <em>reaches a person.</em></h2>
        <p>From verified supplier tenders and dual four-member governance to twelve synchronized cleanroom lines—every safeguard exists so a quiet morning at home can stay quiet.</p>
        <div class="tj-actions">
          <a class="tj-btn solid" asp-controller="Home" asp-action="Contact">Partner with Tiryaq</a>
          <a class="tj-btn outline-teal" asp-controller="Home" asp-action="HowItWorks">Explore 6-step campus ↗</a>
          <button type="button" class="tj-btn outline-teal" data-goto-beat="0">Watch it again ↑</button>
        </div>
      </div>

      <!-- ==================== UNIFIED BOTTOM BOTTLE TIMELINE RAIL ==================== -->
      <div class="tj-rail-bar" id="journey-rail">
        <div class="tj-rail-track" id="rail-track" role="navigation" aria-label="Production journey stations">
          <div class="tj-rail-line"></div>
          <div class="tj-rail-done" id="rail-done"></div>
          <div class="tj-rail-nodes" id="rail-nodes"></div>
          <svg class="tj-mini-bottle" id="mini-bottle" viewBox="0 0 16 28" aria-hidden="true">
            <rect id="mb-cap" x="5" y="0.5" width="6" height="4.2" rx="1" fill="#1d5560" opacity="0.22"/>
            <path d="M5.5 4.8h5v2.6c3 .9 4.5 2.7 4.5 5.6V24.5a2.3 2.3 0 0 1-2.3 2.3H3.3A2.3 2.3 0 0 1 1 24.5V13c0-2.9 1.5-4.7 4.5-5.6z" fill="rgba(244,238,226,0.88)" stroke="#0a1f26" stroke-width="0.9"/>
            <path id="mb-liq" d="M1.6 15.2h12.8v9a1.8 1.8 0 0 1-1.8 1.8H3.4a1.8 1.8 0 0 1-1.8-1.8z" fill="#efb85c" opacity="0"/>
            <rect id="mb-lbl" x="1.5" y="15.5" width="13" height="6.2" fill="#fbf7ef" opacity="0"/>
            <rect id="mb-lbl-band" x="1.5" y="15.5" width="13" height="1.6" fill="#1d5560" opacity="0"/>
          </svg>
        </div>

        <div class="tj-rail-meta">
          <span class="tj-orbit-hint" id="orbit-hint">Scroll to advance · Drag scene to inspect</span>
          <button type="button" class="tj-autorun" id="autorun-btn" data-cruise-toggle aria-pressed="false">▶ Auto-run</button>
        </div>
      </div>
    </section>
  </div>

  <!-- ==================== ARCHITECTURAL PRIMARY-TEAL & HONEY FINALE ==================== -->
  <section class="tj-after" id="contact" aria-labelledby="contact-title">
    <div class="tj-finale-shell">
      <div class="tj-finale-hero">
        <div class="tj-finale-lead">
          <p class="tj-kicker"><span>CHAIN COMPLETE</span>Sourcing &amp; Manufacturing Partnerships</p>
          <h2 id="contact-title">Precision you can <em>partner with.</em></h2>
          <p class="tj-finale-copy">For qualified raw-material and packaging tenders, contract manufacturing, regional distribution, or institutional enquiries, connect directly with Tiryaq’s sourcing and technical teams.</p>
          <div class="tj-actions">
            <a class="tj-btn solid" asp-controller="Home" asp-action="Contact">Write to Tiryaq <span aria-hidden="true">→</span></a>
            @if (signedIn)
            {
              <a class="tj-btn ghost" asp-controller="Account" asp-action="GoToDashboard">Open my workspace</a>
            }
            else
            {
              <a class="tj-btn ghost" asp-controller="Account" asp-action="Register">Supplier registration</a>
              <a class="tj-btn ghost" asp-controller="Account" asp-action="Login">Sign in</a>
            }
          </div>
        </div>

        <aside class="tj-passport" aria-label="Lot TQ-0417 verified chain-of-custody summary">
          <div class="tj-passport-head">
            <span class="tj-passport-id">SPECIMEN LEDGER · LOT TQ-0417</span>
            <span class="tj-passport-status"><i></i>VERIFIED END-TO-END</span>
          </div>

          <ol class="tj-chain" aria-label="Six-stage platform lifecycle">
            <li><span>01</span>Request</li>
            <li><span>02</span>Tender</li>
            <li><span>03</span>4/4 Eval</li>
            <li><span>04</span>4/4 Award</li>
            <li><span>05</span>12-Rail Line</li>
            <li class="is-final"><span>06</span>Patient</li>
          </ol>

          <dl class="tj-passport-metrics">
            <div>
              <dt>Standard tender gate</dt>
              <dd><strong>3+</strong><span>Compliant supplier lines</span></dd>
            </div>
            <div>
              <dt>Dual committee quorum</dt>
              <dd><strong>4 + 4</strong><span>Independent scores &amp; votes</span></dd>
            </div>
            <div>
              <dt>Cleanroom choreography</dt>
              <dd><strong>12</strong><span>Synchronized multi-tier rails</span></dd>
            </div>
            <div>
              <dt>Inline optical release</dt>
              <dd><strong>±0.2%</strong><span>Meniscus &amp; torque tolerance</span></dd>
            </div>
          </dl>
        </aside>
      </div>

      <div class="tj-gateways" aria-label="Explore Tiryaq pathways">
        @if (signedIn)
        {
          <a class="tj-gateway" asp-controller="Account" asp-action="GoToDashboard">
            <div class="tj-gw-top">
              <span class="tj-gw-num">01 · WORKSPACE</span>
              <svg viewBox="0 0 28 28" aria-hidden="true"><rect x="3" y="4" width="22" height="20" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 15l4 4 8-9" fill="none" stroke="#efb85c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3>Continue in your role workspace</h3>
            <p>Review active purchase requests, tender invitations, technical evaluations, clarifications, and executive decisions.</p>
            <span class="tj-gw-cta">Open dashboard <i aria-hidden="true">→</i></span>
          </a>
        }
        else
        {
          <a class="tj-gateway" asp-controller="Account" asp-action="Register">
            <div class="tj-gw-top">
              <span class="tj-gw-num">01 · SUPPLIER NETWORK</span>
              <svg viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="14" r="10.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9.5 14.5l3 3 6-6.5" fill="none" stroke="#efb85c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3>Qualify as a Tiryaq supplier</h3>
            <p>Submit company credentials for administrator approval, receive category invitations, raise clarifications, and place audited bids.</p>
            <span class="tj-gw-cta">Apply for qualification <i aria-hidden="true">→</i></span>
          </a>
        }

        <a class="tj-gateway" asp-controller="Home" asp-action="HowItWorks">
          <div class="tj-gw-top">
            <span class="tj-gw-num">02 · SOURCING CAMPUS</span>
            <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M14 4l10 5.5v9L14 24 4 18.5v-9z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M14 4v20M4 9.5l10 5.5 10-5.5" fill="none" stroke="#efb85c" stroke-width="1.6"/></svg>
          </div>
          <h3>Explore the 6-step sourcing map</h3>
          <p>Step inside Tiryaq’s interactive campus to trace department requests, shortfall policies, four-reviewer scoring, and award gates.</p>
          <span class="tj-gw-cta">Enter interactive map <i aria-hidden="true">↗</i></span>
        </a>

        <a class="tj-gateway" asp-controller="Home" asp-action="Contact">
          <div class="tj-gw-top">
            <span class="tj-gw-num">03 · PARTNERSHIPS</span>
            <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M10 4h8M12 4v6l-5.5 9.5A2.5 2.5 0 0 0 8.7 23h10.6a2.5 2.5 0 0 0 2.2-3.5L16 10V4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.5 18h11" stroke="#efb85c" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <h3>Manufacturing &amp; institutional</h3>
          <p>Partner with our oral-solution, solid-dose, sterile, and supply teams—every formulation step documented, tested, and reviewable.</p>
          <span class="tj-gw-cta">Start a conversation <i aria-hidden="true">→</i></span>
        </a>
      </div>
    </div>

    <footer class="tj-footer">
      <div class="tj-foot-brand">
        <strong>Tiryaq Pharma</strong>
        <span>&copy; @DateTime.UtcNow.Year · Sourcing &amp; Multi-Line Manufacturing</span>
      </div>
      <nav class="tj-foot-links" aria-label="Footer">
        <a asp-controller="Home" asp-action="About">About</a>
        <a asp-controller="Home" asp-action="HowItWorks">How sourcing works</a>
        <a asp-controller="Home" asp-action="Team">Our team</a>
        <a asp-controller="Home" asp-action="Contact">Contact</a>
      </nav>
      <span class="tj-foot-note">Velmira and lot TQ-0417 are illustrative specimens demonstrating Tiryaq’s sourcing and manufacturing choreography.</span>
    </footer>
  </section>
</div>

@section Styles {
    <link rel="modulepreload" href="~/lib/login-scene/three.module.js" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@@0;1&family=Geist:wght@@400;500;600;700&family=JetBrains+Mono:wght@@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/tiryaq-journey.css" asp-append-version="true" />
}
@section Scripts {
    <script type="module" src="~/js/tiryaq-journey.js" asp-append-version="true"></script>
}
