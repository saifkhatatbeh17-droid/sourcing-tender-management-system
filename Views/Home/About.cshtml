@* About: a public website page. Shown by HomeController.About(). *@
@{
    ViewData["Title"] = "About";
    ViewData["DarkPublicPage"] = true;
}

<div class="ab">
    <section class="ab-hero" aria-labelledby="about-title">
        <div class="ab-wrap ab-hero-grid">
            <div class="ab-hero-copy">
                <p class="ab-kicker">About Tiryaq · Pharmaceutical manufacturing</p>
                <h1 id="about-title">Reliable sourcing supports <em>reliable manufacturing.</em></h1>
                <p class="ab-lead">We manufacture pharmaceuticals and work with qualified suppliers to meet the purchasing needs of our production teams.</p>
                <div class="ab-actions">
                    <a class="ab-btn ab-btn-honey" asp-action="Contact">Contact the sourcing team <span aria-hidden="true">↗</span></a>
                    <a class="ab-btn ab-btn-ghost" asp-controller="Account" asp-action="Register">Register as a supplier</a>
                </div>
            </div>
            <div class="ab-hero-art" aria-hidden="true">
                <svg viewBox="0 0 320 320">
                    <g class="ab-hex" fill="none" stroke="currentColor">
                        <polygon points="160,20 281,90 281,230 160,300 39,230 39,90" />
                        <polygon points="160,62 245,111 245,209 160,258 75,209 75,111" />
                    </g>
                    <g class="ab-pill">
                        <rect x="92" y="136" width="136" height="48" rx="24" fill="#f4eee2" />
                        <path d="M116 136h44v48h-44a24 24 0 0 1 0-48z" fill="#efb85c" />
                        <rect x="104" y="144" width="40" height="7" rx="3.5" fill="#fff" opacity=".5" />
                    </g>
                    <g fill="#efb85c"><circle cx="160" cy="20" r="4" /><circle cx="281" cy="230" r="4" /><circle cx="39" cy="230" r="4" /></g>
                </svg>
            </div>
        </div>
    </section>

    <section class="ab-story ab-wrap" aria-labelledby="story-title">
        <div class="ab-story-copy">
            <p class="ab-kicker ab-kicker-dark">Who we are</p>
            <h2 id="story-title">A manufacturer that sources with care.</h2>
            <p>Tiryaq is a pharmaceutical manufacturing company. Our procurement team helps production teams get the materials and services they need by defining purchasing requirements, reviewing supplier documentation, and coordinating deliveries with qualified suppliers.</p>
            <p>For us, a good supplier relationship starts with clear expectations. We share what the business needs, give suppliers a way to demonstrate how they can meet those needs, and document how purchasing decisions are made.</p>
        </div>
        <ol class="ab-priorities" aria-label="Our priorities">
            <li><span>01</span><div><h3>Quality at the point of purchase</h3><p>We review supplier documents and compare offers with the specifications for each purchase.</p></div></li>
            <li><span>02</span><div><h3>Continuity for production teams</h3><p>We consider delivery timelines and a supplier’s ability to meet the needs of the business.</p></div></li>
            <li><span>03</span><div><h3>Clear communication with suppliers</h3><p>We set out tender requirements and deadlines so suppliers know what to submit and when.</p></div></li>
        </ol>
    </section>

    <section class="ab-process" aria-labelledby="process-title">
        <div class="ab-wrap">
            <p class="ab-kicker ab-kicker-dark">Working together</p>
            <h2 id="process-title">How we work with suppliers</h2>
            <ol class="ab-steps">
                <li class="ab-step">
                    <span class="ab-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 22s7-3 7-10V5l-7-3-7 3v7c0 7 7 10 7 10Z"/><path d="m9 12 2 2 4-4"/></svg></span>
                    <p class="ab-step-no">Step 01</p>
                    <h3>Supplier qualification</h3>
                    <p>Start by creating a company profile and uploading your official business documents. The Tiryaq team reviews the application before suppliers can participate in tenders.</p>
                    <ul><li>Enter your company and contact details.</li><li>Follow the status of your application.</li></ul>
                </li>
                <li class="ab-step">
                    <span class="ab-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6m-6 4h6"/></svg></span>
                    <p class="ab-step-no">Step 02</p>
                    <h3>Tenders and offers</h3>
                    <p>When you receive an invitation, review the requested items, specifications, and submission deadline. Prepare an offer and attach the documents requested for that tender.</p>
                    <ul><li>Review requirements and tender documents.</li><li>Submit your offer and follow its progress.</li></ul>
                </li>
                <li class="ab-step">
                    <span class="ab-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="m8 13-2 8 6-3 6 3-2-8m-6-4 1 1 3-3"/></svg></span>
                    <p class="ab-step-no">Step 03</p>
                    <h3>Evaluation and award</h3>
                    <p>Procurement teams review submitted offers against the tender requirements and document their evaluations and approvals. Suppliers can follow the outcome in their workspace.</p>
                    <ul><li>Track your offer through the review stages.</li><li>See the outcome once a decision is recorded.</li></ul>
                </li>
            </ol>
        </div>
    </section>

    <section class="ab-cta ab-wrap" aria-labelledby="cta-title">
        <div>
            <h2 id="cta-title">Ready to supply Tiryaq?</h2>
            <p>Create your supplier profile, or talk to the sourcing team first.</p>
        </div>
        <div class="ab-actions">
            <a class="ab-btn ab-btn-honey" asp-controller="Account" asp-action="Register">Supplier registration</a>
            <a class="ab-btn ab-btn-ghost" asp-action="Contact">Contact us</a>
        </div>
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}
