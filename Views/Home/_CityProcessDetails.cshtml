@{
    var steps = new[]
    {
        (Title: "Request needs", Owner: "Department", Artifact: "PR-0417 · Purchase request", Text: "Define required items, quantities, technical specifications, and target delivery date in a structured two-stage request.", Outcome: "Verified request queued for sourcing review"),
        (Title: "Publish tender", Owner: "Sourcing officer", Artifact: "TND-0417 · Published tender", Text: "Validate the request, set compliance criteria and closing schedule, and invite approved suppliers in the matching category.", Outcome: "Open tender and category invitations issued"),
        (Title: "Submit offers", Owner: "Invited suppliers", Artifact: "3–6 sealed quotations", Text: "Submit unit prices in JD (16% sales tax applied automatically), additional charges, delivery terms, and supporting certificates before closing.", Outcome: "Complete quotations ready for compliance check"),
        (Title: "Evaluate offers", Owner: "Officer & 4-member evaluation committee", Artifact: "Locked weights & 4 scorecards", Text: "Confirm compliance first. Four committee members lock technical and financial weights, score every eligible offer, and resolve any tie unanimously.", Outcome: "Committee evaluation report and recommendation"),
        (Title: "Approve selection", Owner: "Sourcing manager, CEO & Chiefs", Artifact: "Manager referral & 4/4 votes", Text: "The sourcing manager reviews the officer-checked report and refers the case. Four CEO & Chiefs positions record final approvals.", Outcome: "Executive-approved supplier nomination"),
        (Title: "Finalize award", Owner: "Manager & sourcing officer", Artifact: "AWD-0417 · Closed award file", Text: "The manager confirms the shared report and the officer finalizes the award, linking the original request, offers, scores, and votes.", Outcome: "Auditable award outcome shared with stakeholders")
    };

    var safeguards = new[]
    {
        (Tag: "Onboarding", Title: "Approved suppliers only", Copy: "Administrators verify company registration and compliance documents before any supplier can receive tender invitations."),
        (Tag: "Competition", Title: "Three offers & up to four rounds", Copy: "Standard handoff requires three distinct compliant suppliers across up to four rounds; final-round shortfalls require a written reason."),
        (Tag: "Dialogue", Title: "Record-linked clarifications", Copy: "Clarifications attach directly to the active record and can pause progression until open questions are resolved."),
        (Tag: "Continuity", Title: "Rejection & replacement path", Copy: "If CEO & Chiefs reject a nomination, the decision history stays intact and the officer can open a linked replacement tender.")
    };
}
<section class="campus-details" id="process-details" aria-labelledby="process-details-title">
    <header class="campus-details-heading">
        <div>
            <p class="campus-details-kicker">Process reference · Complete workflow</p>
            <h2 id="process-details-title">Every handoff stays on one shared record.</h2>
        </div>
        <p>Select any stage below to highlight its station on the interactive campus map above.</p>
    </header>

    <div class="campus-detail-columns" aria-hidden="true">
        <span>Stage &amp; responsible team</span>
        <span>What happens</span>
        <span>Shared record &amp; outcome</span>
    </div>

    <ol class="campus-detail-list">
        @for (var index = 0; index < steps.Length; index++)
        {
            var step = steps[index];
            <li data-campus-detail-row="@index">
                <span class="campus-detail-number">@((index + 1).ToString("00"))</span>
                <div class="campus-detail-meta">
                    <h3>
                        <button type="button" class="campus-detail-trigger" data-campus-detail-jump="@index">
                            @step.Title <span aria-hidden="true">↗</span>
                        </button>
                    </h3>
                    <p class="campus-detail-owner">@step.Owner</p>
                </div>
                <p class="campus-detail-copy">@step.Text</p>
                <div class="campus-detail-outcome">
                    <span class="campus-detail-artifact">@step.Artifact</span>
                    <p>@step.Outcome</p>
                </div>
            </li>
        }
    </ol>

    <div class="campus-safeguards" aria-label="Workflow governance and exception handling">
        @foreach (var rule in safeguards)
        {
            <article class="campus-safeguard-card">
                <span>@rule.Tag</span>
                <h3>@rule.Title</h3>
                <p>@rule.Copy</p>
            </article>
        }
    </div>
</section>
