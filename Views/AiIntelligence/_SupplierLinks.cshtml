@model SourcingTenderManagement.Services.Integrity.SupplierLinkMap
@using System.Text.Json
@using SourcingTenderManagement.Services.Integrity
@{
    // The map shows the busiest suppliers; every supplier in a suspected pair is always included.
    var linked = Model.Links.SelectMany(l => new[] { l.SupplierA, l.SupplierB }).ToHashSet();
    var nodes = Model.Nodes.Where(n => linked.Contains(n.Id))
        .Concat(Model.Nodes.Where(n => !linked.Contains(n.Id)).Take(Math.Max(0, 18 - linked.Count))).ToList();
    var graphJson = JsonSerializer.Serialize(new
    {
        nodes = nodes.Select(n => new { id = n.Id, name = n.Name, offers = n.Offers, linked = linked.Contains(n.Id) }),
        links = Model.Links.Select(l => new { a = l.SupplierA, b = l.SupplierB, level = l.Level, score = l.Score, label = SupplierLinks.LevelLabel(l.Level) })
    }, new JsonSerializerOptions(JsonSerializerDefaults.Web));
    var workspace = ViewData["WorkspaceController"] as string ?? "Admin";
    var back = ViewData["BackTender"] as int?;
    var tenderLinkFormat = $"/{workspace}/AiIntelligence?tenderId={{0}}#tender-explorer";
}

<section class="ai-intel-section sl" id="supplier-links" aria-labelledby="supplier-links-heading" data-supplier-links data-workspace="@workspace" data-graph="@graphJson">
    <div class="ai-intel-section-head">
        <div>
            <h2 id="supplier-links-heading">Suppliers who may be working together</h2>
            <p class="ai-intel-section-sub">Every supplier is a dot. When two suppliers send offers that look too similar, a line joins them. Click a line or a pair to see why.</p>
        </div>
    </div>
    @if (back is int backTender)
    {
        <a class="sl-backlink" href="/TopCommittee/TenderDetails/@backTender#recommendation"><span aria-hidden="true">←</span> Back to tender #@backTender</a>
    }

    <div class="sl-layout">
        <div class="sl-graph-card">
            <svg class="sl-graph" viewBox="0 0 600 440" role="img" aria-label="Map of suppliers. Lines join suppliers whose offers look too similar." data-sl-graph></svg>
            <aside class="sl-key-panel" aria-label="Map key">
                <h3>Map key</h3>
                <dl>
                    <div><dt><span class="sl-key is-high"></span></dt><dd><strong>High risk</strong>Several strong reasons they may be working together</dd></div>
                    <div><dt><span class="sl-key is-medium"></span></dt><dd><strong>Worth checking</strong>One reason, worth a look</dd></div>
                    <div><dt><span class="sl-key is-linked"></span></dt><dd><strong>Supplier in a pair</strong>Has at least one line</dd></div>
                    <div><dt><span class="sl-key is-node"></span></dt><dd><strong>No warning signs</strong>Offers look independent</dd></div>
                </dl>
                <p>Thicker line = more reasons.</p>
            </aside>
        </div>

        <div class="sl-panel" aria-live="polite">
            <div data-sl-list>
                @if (Model.Links.Count == 0)
                {
                    <div class="sl-empty">
                        <h3>All clear</h3>
                        <p>We checked @(Model.OffersChecked > 0 ? $"{Model.OffersChecked} offers in {Model.TendersChecked} tenders" : $"the {Model.TendersChecked} tenders in your workspace"). No two suppliers look like they are working together.</p>
                    </div>
                }
                else
                {
                    <h3 class="sl-panel-title">@Model.Links.Count @(Model.Links.Count == 1 ? "pair" : "pairs") to check</h3>
                    <p class="sl-panel-sub">Found @(Model.OffersChecked > 0 ? $"in {Model.OffersChecked} offers across {Model.TendersChecked} tenders" : $"across the {Model.TendersChecked} tenders in your workspace").</p>
                    <ul class="sl-pairs">
                        @foreach (var link in Model.Links)
                        {
                            <li>
                                <button type="button" class="sl-pair" data-sl-open="@link.SupplierA-@link.SupplierB">
                                    <span class="sl-pair-top">
                                        <span class="sl-pair-names">@link.NameA <span>&amp;</span> @link.NameB</span>
                                        <span class="sl-level is-@link.Level">@SupplierLinks.LevelLabel(link.Level)</span>
                                    </span>
                                    <span class="sl-pair-why">@SupplierLinks.Reasons(link)</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>

            @foreach (var link in Model.Links)
            {
                <article class="sl-detail" data-sl-detail="@link.SupplierA-@link.SupplierB" hidden tabindex="-1" aria-labelledby="sl-detail-@link.SupplierA-@link.SupplierB">
                    <button type="button" class="sl-back" data-sl-back>Back to all pairs</button>
                    <h3 id="sl-detail-@link.SupplierA-@link.SupplierB">@link.NameA <span>&amp;</span> @link.NameB</h3>
                    <p class="sl-verdict is-@link.Level"><strong>@SupplierLinks.LevelLabel(link.Level).</strong> Their offers look too similar to be fully independent. Check before you award.</p>
                    <h4 class="sl-why-title">Why</h4>
                    <partial name="~/Views/Shared/_SupplierLinkEvidence.cshtml" model="link" view-data='new ViewDataDictionary(ViewData) { ["TenderLink"] = tenderLinkFormat }' />
                    <div class="sl-brief" data-sl-brief>
                        <button type="button" class="ai-intel-btn is-primary" data-sl-explain data-a="@link.SupplierA" data-b="@link.SupplierB" data-busy-label="Thinking…">Explain with AI</button>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
