@* Index: the AI Intelligence workspace. Shown by AiIntelligenceController.Index().
   One view at a time (Overview, Ask AI, Tenders, Suppliers, Link signals), chosen by the tabs and kept in the URL hash
   by wwwroot/js/ai-intelligence.js, so refresh, Back and deep links land on the same view. *@
@model SourcingTenderManagement.Models.AiIntelligencePageModel
@using System.Text.Json
@using SourcingTenderManagement.Services.Intelligence
@functions {
    static string StatusText(string status) => AiIntelligenceService.FormatStatusLabel(status);

    // Status families share a colour everywhere on the page; the label is always written next to it.
    static string StatusTone(string status) => status switch
    {
        "Awarded" => "done",
        "UnderEvaluation" or "AwaitingManagerReview" or "AwaitingCommitteeDecision" => "waiting",
        "Rejected" or "Cancelled" or "Canceled" => "stopped",
        "Closed" => "closed",
        _ => "open"
    };

    static bool IsWaiting(string status) => status is "UnderEvaluation" or "AwaitingManagerReview" or "AwaitingCommitteeDecision";

    // Long text values ("No awarded cycle yet") get a smaller size than numbers.
    static bool IsTextValue(string value) => value.Count(char.IsLetter) > 4;

    const string UploadIcon = "<svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 16V4m0 0l-4 4m4-4l4 4\"/><path d=\"M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3\"/></svg>";
    const string PdfIcon = "<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/><path d=\"M14 3v5h5\"/><path d=\"M9 13h6M9 17h4\"/></svg>";
    const string ExcelIcon = "<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"/><path d=\"M4 10h16M4 15h16M10 4v16\"/></svg>";

    static double AgeDays(string createdUtc) =>
        DateTime.TryParse(createdUtc, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal, out var created)
            ? (DateTime.UtcNow - created).TotalDays : 0;

    // "13d 7h open", counted from the tender's creation time (stored as "yyyy-MM-dd HH:mm" UTC).
    static string AgeText(string createdUtc)
    {
        var days = AgeDays(createdUtc);
        if (days <= 0) return "";
        var age = TimeSpan.FromDays(days);
        return age.TotalHours < 24 ? $"{Math.Max(1, (int)age.TotalHours)}h open" : $"{(int)age.TotalDays}d {age.Hours}h open";
    }

    // Waiting longer than a week is worth a look; longer than two weeks is urgent. Shown as words as well as colour.
    static (string Tone, string Label) Urgency(string createdUtc) => AgeDays(createdUtc) switch
    {
        >= 14 => ("urgent", "Overdue"),
        >= 7 => ("aging", "Aging"),
        _ => ("fresh", "On track")
    };
}
@{
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var initialTenderJson = JsonSerializer.Serialize(Model.SelectedTenderReport, jsonOptions);
    var statusChartJson = JsonSerializer.Serialize(Model.StatusDistribution, jsonOptions);
    var maxCatVal = Model.CategoryBreakdown.Count > 0 ? Math.Max(1m, Model.CategoryBreakdown.Max(x => x.Value)) : 1m;
    var tenderColumnCount = Model.CanViewSupplierPricing ? 9 : 7;
    var supplierLinks = ViewData["SupplierLinks"] as SourcingTenderManagement.Services.Integrity.SupplierLinkMap;
    var waiting = Model.Tenders.Where(t => IsWaiting(t.Status)).OrderBy(t => t.CreatedUtc).ToList();
    var noOffers = Model.Tenders.Where(t => t.SubmittedOffersCount == 0 && !IsWaiting(t.Status) && t.Status != "Awarded").ToList();
    var linkCount = supplierLinks?.Links.Count ?? 0;
    var highLinks = supplierLinks?.Links.Count(l => l.Level == SourcingTenderManagement.Services.Integrity.SupplierLinks.High) ?? 0;

    // Suppliers that appear in at least one flagged pair, so the supplier table can point to the evidence.
    var flaggedPairsBySupplier = supplierLinks == null
        ? new Dictionary<int, int>()
        : supplierLinks.Links.SelectMany(l => new[] { l.SupplierA, l.SupplierB }).GroupBy(id => id).ToDictionary(g => g.Key, g => g.Count());

    // Chart legends show display labels; the table filter works on stored status values.
    var statusValueByLabel = Model.Tenders
        .Select(t => t.Status)
        .Distinct()
        .GroupBy(StatusText)
        .ToDictionary(g => g.Key, g => g.First());

    // Each role gets questions it can act on, answerable from the tenders in its own scope.
    var suggestions = Model.Workspace switch
    {
        "Admin" => new[]
        {
            "Which stage holds the most tenders right now?",
            "Which suppliers are invited but rarely submit offers?",
            "Where are offers being lost to compliance problems?"
        },
        "Department" => new[]
        {
            "Which of my department's tenders are waiting longest?",
            "What stage is each of our tenders at?",
            "Which of our tenders have no offers yet?"
        },
        "SourcingOfficer" => new[]
        {
            "Which of my tenders are closest to closing?",
            "Which tenders need more invited suppliers?",
            "Where are offers failing compliance?"
        },
        "EvaluationCommittee" => new[]
        {
            "Which tenders are waiting for our evaluation?",
            "How close are the leading offers on price?",
            "Which offers have the strongest delivery terms?"
        },
        "SourcingManager" => new[]
        {
            "Which recommendations are waiting for my review?",
            "How much do offer prices differ on each tender?",
            "Which tenders are taking longest to reach a decision?"
        },
        "TopCommittee" => new[]
        {
            "Which tenders are waiting for our vote?",
            "Summarize the recommended offer for each tender.",
            "What risks should we weigh before approving?"
        },
        _ => new[]
        {
            "Which tenders are waiting longest?",
            "What stage is each tender at?"
        }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/ai-intelligence.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/supplier-links.css" asp-append-version="true" />
}

<div class="ai-intel-page" data-ai-intelligence data-workspace="@Model.Workspace"
     data-initial-tender="@initialTenderJson" data-status-chart="@statusChartJson">
    @Html.AntiForgeryToken()

    <header class="ai-intel-hero">
        <div class="ai-intel-hero-main">
            <p class="ai-intel-workspace">@Model.WorkspaceDisplayName workspace</p>
            <h1 id="ai-intel-heading">AI Intelligence</h1>
            <p class="ai-intel-scope">@Model.DataScopeDescription <span class="ai-intel-stamp">Live snapshot, @Model.GeneratedUtc UTC</span></p>
        </div>
        <div class="ai-intel-toolbar" aria-label="Download the overview">
            <a class="ai-intel-icon-btn" asp-controller="AiIntelligence" asp-action="ExportDashboard"
               asp-route-workspace="@Model.Workspace" asp-route-format="pdf" download aria-label="Download the overview as PDF" data-tip="Download PDF">@Html.Raw(PdfIcon)</a>
            <a class="ai-intel-icon-btn" asp-controller="AiIntelligence" asp-action="ExportDashboard"
               asp-route-workspace="@Model.Workspace" asp-route-format="excel" download aria-label="Download the overview as Excel" data-tip="Download Excel">@Html.Raw(ExcelIcon)</a>
        </div>
    </header>

    @* The workspace views. Each tab shows one panel; counts tell you what is inside before you open it. *@
    <div class="ai-ws-tabs-wrap">
        <div class="ai-ws-tabs" role="tablist" aria-label="AI Intelligence views" data-view-tabs>
            <button type="button" role="tab" id="tab-overview" aria-controls="view-overview" data-view-tab="overview" aria-selected="true">
                Overview
                @if (waiting.Count > 0)
                {
                    <span class="ai-ws-count is-waiting" title="Tenders waiting for a decision">@waiting.Count<span class="visually-hidden"> waiting</span></span>
                }
            </button>
            <button type="button" role="tab" id="tab-ask" aria-controls="view-ask" data-view-tab="ask" aria-selected="false" tabindex="-1">Ask AI</button>
            <button type="button" role="tab" id="tab-tenders" aria-controls="view-tenders" data-view-tab="tenders" aria-selected="false" tabindex="-1">
                Tenders <span class="ai-ws-count">@Model.Tenders.Count</span>
            </button>
            @if (Model.CanViewSupplierPricing)
            {
                <button type="button" role="tab" id="tab-suppliers" aria-controls="view-suppliers" data-view-tab="suppliers" aria-selected="false" tabindex="-1">
                    Suppliers <span class="ai-ws-count">@Model.Suppliers.Count</span>
                </button>
            }
            @if (supplierLinks != null)
            {
                <button type="button" role="tab" id="tab-links" aria-controls="view-links" data-view-tab="links" aria-selected="false" tabindex="-1">
                    Link signals
                    <span class="ai-ws-count @(highLinks > 0 ? "is-high" : linkCount > 0 ? "is-medium" : "is-clear")">@linkCount<span class="visually-hidden"> flagged @(linkCount == 1 ? "pair" : "pairs")</span></span>
                </button>
            }
        </div>
    </div>

    @* ==================== OVERVIEW: get oriented ==================== *@
    <section class="ai-ws-view" role="tabpanel" id="view-overview" aria-labelledby="tab-overview" data-view="overview" tabindex="-1">
        <h2 class="visually-hidden">Overview</h2>
        <div class="ai-intel-kpi-grid">
            @foreach (var kpi in Model.Kpis)
            {
                <article class="ai-intel-kpi" data-tone="@kpi.Tone">
                    <div class="ai-intel-kpi-label">@kpi.Label</div>
                    <div class="ai-intel-kpi-value @(IsTextValue(kpi.Value) ? "is-text" : null)">@kpi.Value</div>
                    <div class="ai-intel-kpi-sub">@kpi.Subtext</div>
                </article>
            }
        </div>

        <form class="ai-cmd" data-quick-ask role="search" aria-label="Ask Tiryaq AI">
            <span class="ai-cmd-mark" aria-hidden="true">AI</span>
            <label class="visually-hidden" for="ai-quick-question">Ask Tiryaq AI about your tenders</label>
            <input type="text" id="ai-quick-question" maxlength="1000" dir="auto" autocomplete="off" placeholder="Ask about your tenders, e.g. “@suggestions[0]”" />
            <a href="#ask/file" class="ai-cmd-alt">Analyze a file</a>
            <button type="submit" class="ai-intel-btn is-primary">Ask</button>
        </form>

        <div class="ai-ov-grid">
            <article class="ai-ov-card ai-ov-attention" aria-labelledby="attention-heading">
                <div class="ai-ov-card-head">
                    <div>
                        <h3 id="attention-heading">Needs a decision</h3>
                        <p class="ai-intel-section-sub">With a committee or manager, oldest first.</p>
                    </div>
                    @if (waiting.Count > 0)
                    {
                        <a class="ai-ov-link" href="#tenders" data-go-tenders data-filter="__waiting">All @waiting.Count waiting <span aria-hidden="true">→</span></a>
                    }
                </div>
                @if (waiting.Count == 0)
                {
                    <p class="ai-intel-focus-empty">Nothing is waiting. Every tender is open for offers or already awarded.</p>
                }
                else
                {
                    <ul class="ai-intel-focus-list">
                        @foreach (var row in waiting.Take(5))
                        {
                            var (tone, label) = Urgency(row.CreatedUtc);
                            <li>
                                <a class="ai-intel-focus-row" href="#tenders/@row.TenderId" data-open-tender="@row.TenderId">
                                    <span class="ai-intel-focus-main">
                                        <strong>#@row.TenderId @row.Title</strong>
                                        <span><span class="ai-intel-tag" data-tone="@StatusTone(row.Status)">@StatusText(row.Status)</span> @row.Department</span>
                                    </span>
                                    <span class="ai-urgency" data-urgency="@tone"><span class="ai-urgency-label">@label</span> @AgeText(row.CreatedUtc)</span>
                                </a>
                            </li>
                        }
                    </ul>
                }

                @if (noOffers.Count > 0 || linkCount > 0)
                {
                    <ul class="ai-ov-alerts">
                        @if (linkCount > 0)
                        {
                            <li data-tone="@(highLinks > 0 ? "high" : "medium")">
                                <span class="ai-ov-alert-text"><strong>@linkCount supplier @(linkCount == 1 ? "pair" : "pairs") flagged</strong>@(highLinks > 0 ? $", {highLinks} high risk" : ""). Signals to review before an award.</span>
                                <a class="ai-ov-link" href="#links">Review <span aria-hidden="true">→</span></a>
                            </li>
                        }
                        @if (noOffers.Count > 0)
                        {
                            <li data-tone="medium">
                                <span class="ai-ov-alert-text"><strong>@noOffers.Count open @(noOffers.Count == 1 ? "tender has" : "tenders have") no offers yet.</strong> Consider inviting more suppliers.</span>
                                <a class="ai-ov-link" href="#tenders" data-go-tenders data-filter="__nooffers">Show <span aria-hidden="true">→</span></a>
                            </li>
                        }
                    </ul>
                }
            </article>

            <article class="ai-ov-card" aria-labelledby="status-heading">
                <div class="ai-ov-card-head">
                    <div>
                        <h3 id="status-heading">Tenders by status</h3>
                        <p class="ai-intel-section-sub">Choose a status to see those tenders.</p>
                    </div>
                </div>
                @if (Model.StatusDistribution.Count == 0)
                {
                    <p class="ai-intel-status-msg">No tenders in your workspace yet.</p>
                }
                else
                {
                    <div class="ai-intel-donut-wrap">
                        <svg class="ai-intel-donut-svg" viewBox="0 0 120 120" data-status-donut role="img" aria-label="Tender status donut chart"></svg>
                        <div class="ai-intel-legend">
                            @foreach (var seg in Model.StatusDistribution)
                            {
                                var statusValue = statusValueByLabel.TryGetValue(seg.Label, out var raw) ? raw : seg.Label;
                                <a class="ai-intel-legend-item" href="#tenders" data-go-tenders data-filter="@statusValue">
                                    <span><span class="ai-intel-swatch" style="background:@seg.Color"></span>@seg.Label</span>
                                    <strong>@seg.ValueFormatted <span class="ai-intel-muted">(@seg.SecondaryFormatted)</span></strong>
                                </a>
                            }
                        </div>
                    </div>
                }
            </article>


            <article class="ai-ov-card" aria-labelledby="categories-heading">
                <div class="ai-ov-card-head">
                    <div>
                        <h3 id="categories-heading">Categories and offer volume</h3>
                        <p class="ai-intel-section-sub">Tenders and quotations per procurement category.</p>
                    </div>
                </div>
                @if (Model.CategoryBreakdown.Count == 0)
                {
                    <p class="ai-intel-status-msg">No category activity recorded yet.</p>
                }
                else
                {
                    <div class="ai-intel-bars">
                        @foreach (var cat in Model.CategoryBreakdown)
                        {
                            var pct = Math.Clamp(Math.Round(100m * cat.Value / maxCatVal, 1), 6m, 100m);
                            <div class="ai-intel-bar-row">
                                <div class="ai-intel-bar-top">
                                    <span class="ai-intel-bar-label" title="@cat.Label">@cat.Label</span>
                                    <span class="ai-intel-bar-meta">@cat.ValueFormatted · @cat.SecondaryFormatted</span>
                                </div>
                                <div class="ai-intel-bar-track">
                                    <div class="ai-intel-bar-fill" style="width:@(pct)%;background:@cat.Color"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </article>
        </div>

        @if (!Model.CanViewSupplierPricing)
        {
            <p class="ai-intel-note">Supplier names and prices are hidden in the Department workspace to keep competing quotations confidential.</p>
        }
    </section>

    @* ==================== ASK AI: a question or a file ==================== *@
    <section class="ai-ws-view" role="tabpanel" id="view-ask" aria-labelledby="tab-ask" data-view="ask" tabindex="-1" hidden>
        <div class="ai-ask-layout">
            <div class="ai-ask-composer" id="ask-ai">
                <h2 class="ai-ws-view-title">Ask Tiryaq AI</h2>
                <div class="ai-hub-tabs" role="tablist" aria-label="AI tools" data-ai-tabs>
                    <button type="button" role="tab" id="ai-tab-ask" aria-selected="true" aria-controls="ai-panel-ask">Ask a question</button>
                    <button type="button" role="tab" id="ai-tab-file" aria-selected="false" aria-controls="ai-panel-file" tabindex="-1">Analyze a file</button>
                </div>

                <div role="tabpanel" id="ai-panel-ask" aria-labelledby="ai-tab-ask" class="ai-hub-panel">
                    <form class="ai-intel-ask" data-portfolio-form>
                        <label class="ai-field-label" for="ai-portfolio-question">Your question</label>
                        <textarea id="ai-portfolio-question" name="question" maxlength="1000" dir="auto" rows="3" class="ai-intel-input ai-ask-input"
                                  placeholder="Ask about your tenders, offers or suppliers…"></textarea>
                        <div class="ai-ask-actions">
                            <span class="ai-intel-muted ai-ask-hint">Enter to send, Shift+Enter for a new line. Empty box gives a general brief.</span>
                            <button type="submit" class="ai-intel-btn is-primary" data-portfolio-submit data-busy-label="Thinking…">Ask AI</button>
                        </div>
                        <div class="ai-intel-suggestions" role="group" aria-label="Suggested questions">
                            <span class="ai-intel-muted">Try:</span>
                            @foreach (var suggestion in suggestions)
                            {
                                <button type="button" class="ai-intel-chip" data-suggestion="@suggestion">@suggestion</button>
                            }
                        </div>
                    </form>
                </div>

                <div role="tabpanel" id="ai-panel-file" aria-labelledby="ai-tab-file" class="ai-hub-panel" hidden>
                    <form class="ai-intel-dropzone" data-upload-form enctype="multipart/form-data" novalidate>
                        <label class="ai-intel-drop-target" for="ai-upload-file">
                            <span class="ai-hub-drop-icon" aria-hidden="true">@Html.Raw(UploadIcon)</span>
                            <input type="file" id="ai-upload-file" class="ai-intel-file-input" name="file" accept=".xlsx,.pdf" data-upload-file
                                   aria-describedby="ai-upload-hint" />
                            <span class="ai-intel-drop-title" data-upload-filename>Drop an Excel or PDF file here, or choose a file</span>
                            <span class="ai-intel-drop-hint" id="ai-upload-hint">.xlsx or .pdf, under 10 MB. The AI reads its tables and compares them with your Tiryaq data.</span>
                        </label>
                        <label class="ai-field-label" for="ai-upload-prompt">What should the AI look for? <span class="ai-intel-muted">(optional)</span></label>
                        <textarea id="ai-upload-prompt" name="prompt" maxlength="1000" dir="auto" rows="2" class="ai-intel-input ai-ask-input"
                                  placeholder="For example: compare these prices with our latest offers"></textarea>
                        <div class="ai-ask-actions">
                            <span class="ai-intel-muted ai-ask-hint">The file is analyzed once and is not stored with your tenders.</span>
                            <button type="submit" class="ai-intel-btn is-primary" data-upload-submit data-busy-label="Analyzing…" disabled>Analyze file</button>
                        </div>
                    </form>
                </div>

                <p class="ai-hub-foot">Answers use only data you can see, and people make every decision.</p>
            </div>

            <div class="ai-ask-results" aria-live="polite">
                <div class="ai-ask-results-head">
                    <h3>Answers</h3>
                    <button type="button" class="ai-intel-btn is-surface is-small" data-thread-clear hidden>Clear answers</button>
                </div>
                <p class="ai-intel-status-msg" data-portfolio-status role="status" hidden></p>
                <p class="ai-intel-status-msg" data-upload-status role="status" hidden></p>
                <div class="ai-thread" data-ai-thread>
                    <div class="ai-thread-empty" data-thread-empty>
                        <p><strong>No answers yet.</strong></p>
                        <p>Ask a question or analyze a file. Each answer stays here so you can compare it with the next one and ask follow-ups.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ==================== TENDERS: find one, then inspect it ==================== *@
    <section class="ai-ws-view" role="tabpanel" id="view-tenders" aria-labelledby="tab-tenders" data-view="tenders" tabindex="-1" hidden>
        <div class="ai-tl" data-tender-list>
            <div class="ai-ws-view-head">
                <div>
                    <h2 class="ai-ws-view-title" id="tenders-heading">Tenders</h2>
                    <p class="ai-intel-section-sub">Open a tender for its report, offer comparison and requested items.</p>
                </div>
            </div>

            <div class="ai-intel-table-controls" hidden="@(Model.Tenders.Count == 0)">
                <label class="visually-hidden" for="ai-tender-search">Search tenders</label>
                <input type="search" id="ai-tender-search" class="ai-intel-input is-wide" placeholder="Search by number, title, department or category"
                       autocomplete="off" data-tender-search />
                <label class="visually-hidden" for="ai-tender-status-filter">Filter by status</label>
                <select id="ai-tender-status-filter" class="ai-intel-select" data-tender-status-filter>
                    <option value="">All statuses</option>
                    <optgroup label="Shortcuts">
                        <option value="__waiting">Waiting for a decision</option>
                        <option value="__nooffers">Open, no offers yet</option>
                    </optgroup>
                    <optgroup label="Status">
                        @foreach (var st in Model.Tenders.Select(t => t.Status).Distinct())
                        {
                            <option value="@st">@StatusText(st)</option>
                        }
                    </optgroup>
                </select>
                <button type="button" class="ai-intel-btn is-surface" data-tender-clear hidden>Clear filters</button>
                <p class="ai-intel-count" data-tender-count aria-live="polite">
                    @Model.Tenders.Count @(Model.Tenders.Count == 1 ? "tender" : "tenders")
                </p>
            </div>

            <div class="ai-intel-table-wrap">
                <table class="ai-intel-table" data-tenders-table>
                    <thead>
                        <tr>
                            <th scope="col">Tender</th>
                            <th scope="col">Status</th>
                            <th scope="col">Category</th>
                            <th scope="col">Department</th>
                            <th scope="col" title="Invited suppliers / offers received / compliant offers">Invited · offers · compliant</th>
                            @if (Model.CanViewSupplierPricing)
                            {
                                <th scope="col">Price range</th>
                                <th scope="col">Winner</th>
                            }
                            <th scope="col">Duration</th>
                            <th scope="col"><span class="visually-hidden">Open</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Tenders.Count == 0)
                        {
                            <tr><td colspan="@tenderColumnCount" class="ai-intel-empty-cell">No tenders in your workspace yet. Tenders appear here once they reach your stage of the process.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in Model.Tenders)
                            {
                                <tr class="is-clickable" data-tender-row="@row.TenderId" data-status="@row.Status"
                                    data-waiting="@(IsWaiting(row.Status) ? "1" : "0")"
                                    data-nooffers="@(row.SubmittedOffersCount == 0 && !IsWaiting(row.Status) && row.Status != "Awarded" ? "1" : "0")">
                                    <td class="ai-tl-name"><a href="#tenders/@row.TenderId" data-open-tender="@row.TenderId"><strong>#@row.TenderId</strong> @row.Title</a> <span class="ai-intel-muted">R@(row.Round)</span></td>
                                    <td><span class="ai-intel-tag" data-tone="@StatusTone(row.Status)">@StatusText(row.Status)</span></td>
                                    <td>@row.Category</td>
                                    <td>@row.Department</td>
                                    <td class="ai-tl-offers">
                                        @row.InvitedCount · <span class="@(row.SubmittedOffersCount == 0 ? "ai-zero" : null)">@row.SubmittedOffersCount</span> · @row.CompliantOffersCount
                                    </td>
                                    @if (Model.CanViewSupplierPricing)
                                    {
                                        <td>
                                            @if (row.LowestOfferTotal.HasValue)
                                            {
                                                <span class="ai-nowrap">@row.LowestOfferTotal.Value.ToString("N2") – @row.HighestOfferTotal!.Value.ToString("N2") @row.Currency</span>
                                            }
                                            else
                                            {
                                                <span class="ai-intel-muted">No offers</span>
                                            }
                                        </td>
                                        <td>@(row.WinningSupplier ?? "–")</td>
                                    }
                                    <td class="ai-nowrap">@row.LifecycleFormatted</td>
                                    <td class="ai-tl-open"><span aria-hidden="true">›</span></td>
                                </tr>
                            }
                            <tr data-tender-empty hidden>
                                <td colspan="@tenderColumnCount" class="ai-intel-empty-cell">No tenders match your search. <button type="button" class="ai-intel-linkbtn" data-tender-clear-inline>Clear the filters</button> to see all tenders.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="ai-td" id="tender-explorer" data-tender-detail hidden aria-labelledby="tender-report-heading">
            <div class="ai-td-bar">
                <a class="ai-td-back" href="#tenders" data-tender-back><span aria-hidden="true">←</span> All tenders <span class="ai-intel-muted" data-tender-back-note></span></a>
                <div class="ai-td-step" aria-label="Move through the tenders in your list">
                    <button type="button" class="ai-intel-btn is-surface is-small" data-tender-prev>‹ Previous</button>
                    <span class="ai-intel-muted" data-tender-position></span>
                    <button type="button" class="ai-intel-btn is-surface is-small" data-tender-next>Next ›</button>
                </div>
            </div>

            <div class="ai-td-head">
                <div class="ai-td-title">
                    <h2 id="tender-report-heading" tabindex="-1" data-tender-title>Tender report</h2>
                    <p class="ai-intel-report-meta" data-tender-meta></p>
                </div>
                <div class="ai-intel-toolbar">
                    <button type="button" class="ai-intel-btn is-primary" data-analyze-tender data-busy-label="Preparing…">Get AI recommendation</button>
                    <a class="ai-intel-icon-btn" data-export-tender-pdf download aria-label="Download this tender report as PDF" data-tip="Download PDF" href="#">@Html.Raw(PdfIcon)</a>
                    <a class="ai-intel-icon-btn" data-export-tender-excel download aria-label="Download this tender report as Excel" data-tip="Download Excel" href="#">@Html.Raw(ExcelIcon)</a>
                </div>
            </div>

            <p class="ai-intel-status-msg" data-tender-status role="status" aria-live="polite" hidden></p>
            <div class="ai-intel-live" data-tender-ai-box hidden tabindex="-1"></div>

            <div class="ai-td-tabs" role="tablist" aria-label="Tender details" data-detail-tabs>
                <button type="button" role="tab" id="td-tab-report" aria-controls="td-panel-report" aria-selected="true" data-detail-tab="report">Report</button>
                <button type="button" role="tab" id="td-tab-offers" aria-controls="td-panel-offers" aria-selected="false" tabindex="-1" data-detail-tab="offers">Offer comparison <span class="ai-ws-count" data-offer-count></span></button>
                <button type="button" role="tab" id="td-tab-items" aria-controls="td-panel-items" aria-selected="false" tabindex="-1" data-detail-tab="items">Requested items <span class="ai-ws-count" data-item-count></span></button>
            </div>
            <div class="ai-intel-report-body" data-tender-report-container aria-busy="false">
                <div role="tabpanel" id="td-panel-report" aria-labelledby="td-tab-report" data-detail-panel="report"></div>
                <div role="tabpanel" id="td-panel-offers" aria-labelledby="td-tab-offers" data-detail-panel="offers" hidden></div>
                <div role="tabpanel" id="td-panel-items" aria-labelledby="td-tab-items" data-detail-panel="items" hidden></div>
            </div>
        </div>
    </section>

    @* ==================== SUPPLIERS: performance ==================== *@
    @if (Model.CanViewSupplierPricing)
    {
        <section class="ai-ws-view" role="tabpanel" id="view-suppliers" aria-labelledby="tab-suppliers" data-view="suppliers" tabindex="-1" hidden>
            <div class="ai-ws-view-head">
                <div>
                    <h2 class="ai-ws-view-title" id="suppliers-heading">Suppliers</h2>
                    <p class="ai-intel-section-sub">Participation, compliance and awards per supplier.@(linkCount > 0 ? " Suppliers in a flagged pair are marked." : "")</p>
                </div>
            </div>

            <div class="ai-intel-table-controls">
                <label class="visually-hidden" for="ai-supplier-search">Search suppliers</label>
                <input type="search" id="ai-supplier-search" class="ai-intel-input is-wide" placeholder="Search by company, category or status"
                       autocomplete="off" data-supplier-search />
                <label class="visually-hidden" for="ai-supplier-sort">Sort suppliers</label>
                <select id="ai-supplier-sort" class="ai-intel-select" data-supplier-sort>
                    <option value="offers">Most offers first</option>
                    <option value="participation">Highest participation</option>
                    <option value="compliance">Highest compliance</option>
                    <option value="awards">Most awards</option>
                    <option value="name">Name A–Z</option>
                    @if (linkCount > 0)
                    {
                        <option value="flagged">Flagged first</option>
                    }
                </select>
                <p class="ai-intel-count" data-supplier-count aria-live="polite">
                    @Model.Suppliers.Count @(Model.Suppliers.Count == 1 ? "supplier" : "suppliers")
                </p>
            </div>

            <div class="ai-intel-table-wrap">
                <table class="ai-intel-table" data-suppliers-table>
                    <thead>
                        <tr>
                            <th scope="col">Supplier</th>
                            <th scope="col">Category</th>
                            <th scope="col">Account</th>
                            <th scope="col" title="Invitations / offers submitted / compliant offers">Invited · offers · compliant</th>
                            <th scope="col">Participation</th>
                            <th scope="col">Compliance</th>
                            <th scope="col">Awards won (value)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Suppliers.Count == 0)
                        {
                            <tr><td colspan="7" class="ai-intel-empty-cell">No suppliers recorded in scope.</td></tr>
                        }
                        else
                        {
                            @foreach (var s in Model.Suppliers)
                            {
                                var pairs = flaggedPairsBySupplier.TryGetValue(s.SupplierId, out var n) ? n : 0;
                                <tr data-supplier-row data-name="@s.CompanyName" data-offers="@s.SubmittedBidsCount"
                                    data-participation="@s.ParticipationRatePercent.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-compliance="@s.ComplianceRatePercent.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-awards="@s.AwardedCount" data-flagged="@pairs">
                                    <td>
                                        <strong>#@s.SupplierId</strong> @s.CompanyName
                                        @if (pairs > 0)
                                        {
                                            <a class="ai-flag-chip" href="#links?supplier=@s.SupplierId" data-show-supplier-links="@s.SupplierId">In @pairs flagged @(pairs == 1 ? "pair" : "pairs")</a>
                                        }
                                    </td>
                                    <td>@s.Category</td>
                                    <td><span class="ai-intel-tag" data-tone="@(s.Status == "Approved" ? "done" : "closed")">@s.Status</span></td>
                                    <td class="ai-nowrap">@s.InvitationsCount · @s.SubmittedBidsCount · @s.CompliantBidsCount</td>
                                    <td><span class="ai-meter" style="--v:@Math.Clamp(s.ParticipationRatePercent, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture)"><span></span></span> @s.ParticipationRatePercent.ToString("0.#")%</td>
                                    <td><span class="ai-meter is-compliance" style="--v:@Math.Clamp(s.ComplianceRatePercent, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture)"><span></span></span> @s.ComplianceRatePercent.ToString("0.#")%</td>
                                    <td><strong>@s.AwardedCount</strong>@if (s.AwardedCount > 0) { <span class="ai-intel-won-value">@s.AwardedValue.ToString("N2") JOD</span> }</td>
                                </tr>
                            }
                            <tr data-supplier-empty hidden>
                                <td colspan="7" class="ai-intel-empty-cell">No suppliers match your search.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @* ==================== LINK SIGNALS: possible supplier links to review ==================== *@
    @if (supplierLinks != null)
    {
        <partial name="_SupplierLinks" model="supplierLinks" />
    }
</div>

@section Scripts {
    <script src="~/js/ai-intelligence.js" asp-append-version="true"></script>
    <script src="~/js/supplier-links.js" asp-append-version="true"></script>
}
