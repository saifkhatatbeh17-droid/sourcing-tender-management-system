@* Index: a AI Intelligence page. Shown by AiIntelligenceController.Index(). *@
@model SourcingTenderManagement.Models.AiIntelligencePageModel
@using System.Text.Json
@using SourcingTenderManagement.Services.Intelligence
@functions {
    static string StatusText(string status) => AiIntelligenceService.FormatStatusLabel(status);

    // Long text values ("No awarded cycle yet") get a smaller size than numbers.
    static bool IsTextValue(string value) => value.Count(char.IsLetter) > 4;

    // Download icons: a document for PDF, a grid for Excel. Decorative; the button carries the name.
    // Upload arrow for the file tab.
    const string UploadIcon = "<svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 16V4m0 0l-4 4m4-4l4 4\"/><path d=\"M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3\"/></svg>";
    const string PdfIcon = "<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/><path d=\"M14 3v5h5\"/><path d=\"M9 13h6M9 17h4\"/></svg>";
    const string ExcelIcon = "<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"/><path d=\"M4 10h16M4 15h16M10 4v16\"/></svg>";

    // "13d 7h open", counted from the tender's creation time (stored as "yyyy-MM-dd HH:mm" UTC).
    static string AgeText(string createdUtc)
    {
        if (!DateTime.TryParse(createdUtc, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal, out var created))
            return "";
        var age = DateTime.UtcNow - created;
        return age.TotalHours < 24 ? $"{Math.Max(1, (int)age.TotalHours)}h open" : $"{(int)age.TotalDays}d {age.Hours}h open";
    }
}
@{
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var initialTenderJson = JsonSerializer.Serialize(Model.SelectedTenderReport, jsonOptions);
    var statusChartJson = JsonSerializer.Serialize(Model.StatusDistribution, jsonOptions);
    var maxCatVal = Model.CategoryBreakdown.Count > 0 ? Math.Max(1m, Model.CategoryBreakdown.Max(x => x.Value)) : 1m;
    var tenderColumnCount = Model.CanViewSupplierPricing ? 10 : 8;
    var supplierLinks = ViewData["SupplierLinks"] as SourcingTenderManagement.Services.Integrity.SupplierLinkMap;
    var waiting = Model.Tenders
        .Where(t => t.Status is "UnderEvaluation" or "AwaitingManagerReview" or "AwaitingCommitteeDecision")
        .OrderBy(t => t.CreatedUtc).ToList();

    // Chart legends show display labels; the table filter works on stored status values.
    var statusValueByLabel = Model.Tenders
        .Select(t => t.Status)
        .Distinct()
        .GroupBy(StatusText)
        .ToDictionary(g => g.Key, g => g.First());

    // Each role gets questions it can act on, answerable from the tenders in its own scope.
    var suggestions = Model.Workspace switch
    {
        "Admin" => new[]
        {
            "Which stage holds the most tenders right now?",
            "Which suppliers are invited but rarely submit offers?",
            "Where are offers being lost to compliance problems?"
        },
        "Department" => new[]
        {
            "Which of my department's tenders are waiting longest?",
            "What stage is each of our tenders at?",
            "Which of our tenders have no offers yet?"
        },
        "SourcingOfficer" => new[]
        {
            "Which of my tenders are closest to closing?",
            "Which tenders need more invited suppliers?",
            "Where are offers failing compliance?"
        },
        "EvaluationCommittee" => new[]
        {
            "Which tenders are waiting for our evaluation?",
            "How close are the leading offers on price?",
            "Which offers have the strongest delivery terms?"
        },
        "SourcingManager" => new[]
        {
            "Which recommendations are waiting for my review?",
            "How much do offer prices differ on each tender?",
            "Which tenders are taking longest to reach a decision?"
        },
        "TopCommittee" => new[]
        {
            "Which tenders are waiting for our vote?",
            "Summarize the recommended offer for each tender.",
            "What risks should we weigh before approving?"
        },
        _ => new[]
        {
            "Which tenders are waiting longest?",
            "What stage is each tender at?"
        }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/ai-intelligence.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/supplier-links.css" asp-append-version="true" />
}

<div class="ai-intel-page" data-ai-intelligence data-workspace="@Model.Workspace"
     data-initial-tender="@initialTenderJson" data-status-chart="@statusChartJson">
    @Html.AntiForgeryToken()

    <header class="ai-intel-hero">
        <div class="ai-intel-hero-main">
            <p class="ai-intel-workspace">@Model.WorkspaceDisplayName workspace</p>
            <h1 id="ai-intel-heading">AI Intelligence</h1>
            <p class="ai-intel-scope">@Model.DataScopeDescription</p>
            <p class="ai-intel-stamp">Live snapshot, @Model.GeneratedUtc UTC</p>
        </div>
        <div class="ai-intel-toolbar" aria-label="Download this page">
            <a class="ai-intel-icon-btn" asp-controller="AiIntelligence" asp-action="ExportDashboard"
               asp-route-workspace="@Model.Workspace" asp-route-format="pdf" download aria-label="Download this page as PDF" data-tip="Download PDF">@Html.Raw(PdfIcon)</a>
            <a class="ai-intel-icon-btn" asp-controller="AiIntelligence" asp-action="ExportDashboard"
               asp-route-workspace="@Model.Workspace" asp-route-format="excel" download aria-label="Download this page as Excel" data-tip="Download Excel">@Html.Raw(ExcelIcon)</a>
        </div>
        <div class="ai-hub" id="ask-ai" role="search" aria-labelledby="ask-ai-heading">
            <h2 id="ask-ai-heading" class="visually-hidden">Ask Tiryaq AI</h2>
            <div class="ai-hub-tabs" role="tablist" aria-label="AI tools" data-ai-tabs>
                <button type="button" role="tab" id="ai-tab-ask" aria-selected="true" aria-controls="ai-panel-ask">Ask a question</button>
                <button type="button" role="tab" id="ai-tab-file" aria-selected="false" aria-controls="ai-panel-file" tabindex="-1">Analyze a file</button>
            </div>

            <div role="tabpanel" id="ai-panel-ask" aria-labelledby="ai-tab-ask" class="ai-hub-panel">
                <form class="ai-intel-ask" data-portfolio-form>
                    <div class="ai-hub-prompt">
                        <label class="visually-hidden" for="ai-portfolio-question">Question for the AI</label>
                        <input type="text" id="ai-portfolio-question" name="question" maxlength="1000" dir="auto" autocomplete="off"
                               placeholder="Ask about your tenders…" />
                        <button type="submit" class="ai-intel-btn is-primary" data-portfolio-submit data-busy-label="Thinking…">Ask AI</button>
                    </div>
                    <div class="ai-intel-suggestions" role="group" aria-label="Suggested questions">
                        @foreach (var suggestion in suggestions)
                        {
                            <button type="button" class="ai-intel-chip" data-suggestion="@suggestion">@suggestion</button>
                        }
                    </div>
                </form>
            </div>

            <div role="tabpanel" id="ai-panel-file" aria-labelledby="ai-tab-file" class="ai-hub-panel" hidden>
                <form class="ai-intel-dropzone" data-upload-form enctype="multipart/form-data" novalidate>
                    <label class="ai-intel-drop-target" for="ai-upload-file">
                        <span class="ai-hub-drop-icon" aria-hidden="true">@Html.Raw(UploadIcon)</span>
                        <input type="file" id="ai-upload-file" class="ai-intel-file-input" name="file" accept=".xlsx,.pdf" data-upload-file
                               aria-describedby="ai-upload-hint" />
                        <span class="ai-intel-drop-title" data-upload-filename>Drop an Excel or PDF file here, or choose a file</span>
                        <span class="ai-intel-drop-hint" id="ai-upload-hint">.xlsx or .pdf, under 10 MB. The AI reads its tables and compares them with your Tiryaq data.</span>
                    </label>
                    <div class="ai-hub-prompt">
                        <label class="visually-hidden" for="ai-upload-prompt">Instruction for the AI</label>
                        <input type="text" id="ai-upload-prompt" name="prompt" maxlength="1000" dir="auto" autocomplete="off"
                               placeholder="Optional: what should the AI look for?" />
                        <button type="submit" class="ai-intel-btn is-primary" data-upload-submit data-busy-label="Analyzing…" disabled>Analyze file</button>
                    </div>
                </form>
            </div>

            <p class="ai-hub-foot">Leave the box empty for a general brief. Answers use only data you can see, and people make every decision.</p>
        </div>
    </header>

    <div class="ai-hub-results" aria-live="polite">
        <p class="ai-intel-status-msg" data-portfolio-status role="status" hidden></p>
        <div class="ai-intel-live" data-ai-portfolio-output hidden tabindex="-1"></div>
        <p class="ai-intel-status-msg" data-upload-status role="status" hidden></p>
        <div class="ai-intel-live" data-upload-results hidden tabindex="-1"></div>
    </div>

    <nav class="ai-intel-nav" aria-label="On this page" data-section-nav>
        <a href="#ask-ai">Ask AI</a>
        <a href="#overview">Overview</a>
        <a href="#tenders">Tenders</a>
        @if (Model.CanViewSupplierPricing)
        {
            <a href="#suppliers">Suppliers</a>
        }
        @if (supplierLinks != null)
        {
            <a href="#supplier-links">Supplier links@(supplierLinks.Links.Count > 0 ? $" ({supplierLinks.Links.Count})" : "")</a>
        }
    </nav>

    <section class="ai-intel-section" id="overview" aria-labelledby="overview-heading">
        <div class="ai-intel-section-head">
            <div>
                <h2 id="overview-heading">Overview</h2>
                <p class="ai-intel-section-sub">Current figures for the tenders in your workspace.</p>
            </div>
        </div>

        <div class="ai-intel-kpi-grid">
            @foreach (var kpi in Model.Kpis)
            {
                <article class="ai-intel-kpi" data-tone="@kpi.Tone">
                    <div class="ai-intel-kpi-label">@kpi.Label</div>
                    <div class="ai-intel-kpi-value @(IsTextValue(kpi.Value) ? "is-text" : null)">@kpi.Value</div>
                    <div class="ai-intel-kpi-sub">@kpi.Subtext</div>
                </article>
            }
        </div>

        <div class="ai-intel-charts-grid">
            <article class="ai-intel-chart-card">
                <div>
                    <h3>Tenders by status</h3>
                    <p class="ai-intel-section-sub">Select a status to filter the tenders table.</p>
                </div>
                @if (Model.StatusDistribution.Count == 0)
                {
                    <p class="ai-intel-status-msg">No tenders in your workspace yet.</p>
                }
                else
                {
                    <div class="ai-intel-donut-wrap">
                        <svg class="ai-intel-donut-svg" viewBox="0 0 120 120" data-status-donut role="img" aria-label="Tender status donut chart"></svg>
                        <div class="ai-intel-legend">
                            @foreach (var seg in Model.StatusDistribution)
                            {
                                var statusValue = statusValueByLabel.TryGetValue(seg.Label, out var raw) ? raw : seg.Label;
                                <button type="button" class="ai-intel-legend-item" data-filter-status="@statusValue" aria-pressed="false">
                                    <span><span class="ai-intel-swatch" style="background:@seg.Color"></span>@seg.Label</span>
                                    <strong>@seg.ValueFormatted (@seg.SecondaryFormatted)</strong>
                                </button>
                            }
                        </div>
                    </div>
                }
            </article>

            <article class="ai-intel-chart-card">
                <div>
                    <h3>Categories and offer volume</h3>
                    <p class="ai-intel-section-sub">Tenders and supplier quotations per procurement category.</p>
                </div>
                @if (Model.CategoryBreakdown.Count == 0)
                {
                    <p class="ai-intel-status-msg">No category activity recorded yet.</p>
                }
                else
                {
                    <div class="ai-intel-bars">
                        @foreach (var cat in Model.CategoryBreakdown)
                        {
                            var pct = Math.Clamp(Math.Round(100m * cat.Value / maxCatVal, 1), 6m, 100m);
                            <div class="ai-intel-bar-row">
                                <div class="ai-intel-bar-top">
                                    <span class="ai-intel-bar-label" title="@cat.Label">@cat.Label</span>
                                    <span class="ai-intel-bar-meta">@cat.ValueFormatted · @cat.SecondaryFormatted</span>
                                </div>
                                <div class="ai-intel-bar-track">
                                    <div class="ai-intel-bar-fill" style="width:@(pct)%;background:@cat.Color"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </article>


        </div>

        <article class="ai-intel-focus-card ai-intel-waiting" aria-labelledby="focus-waiting-heading">
            <h3 id="focus-waiting-heading">Waiting for a decision</h3>
            <p class="ai-intel-section-sub">Tenders that are with a committee or manager, oldest first. Select one to open its report.</p>
            @if (waiting.Count == 0)
            {
                <p class="ai-intel-focus-empty">Nothing is waiting. Every tender is open for offers or already awarded.</p>
            }
            else
            {
                <ul class="ai-intel-focus-list">
                    @foreach (var row in waiting.Take(5))
                    {
                        <li>
                            <button type="button" class="ai-intel-focus-row" data-open-tender="@row.TenderId" aria-label="Open report for tender #@row.TenderId">
                                <span class="ai-intel-focus-main">
                                    <strong>#@row.TenderId @row.Title</strong>
                                    <span>@StatusText(row.Status)</span>
                                </span>
                                <span class="ai-intel-focus-age">@AgeText(row.CreatedUtc)</span>
                            </button>
                        </li>
                    }
                </ul>
                @if (waiting.Count > 5)
                {
                    <a class="ai-intel-focus-more" href="#tenders">See all @waiting.Count in the tenders table</a>
                }
            }
        </article>
        @if (!Model.CanViewSupplierPricing)
        {
            <p class="ai-intel-note">Supplier names and prices are hidden in the Department workspace to keep competing quotations confidential.</p>
        }
    </section>

    <section class="ai-intel-section" id="tenders" aria-labelledby="tenders-heading">
        <div class="ai-intel-section-head">
            <div>
                <h2 id="tenders-heading">Tenders</h2>
                <p class="ai-intel-section-sub">Choose a tender to open its full report below the table.</p>
            </div>
        </div>

        <div class="ai-intel-table-controls" hidden="@(Model.Tenders.Count == 0)">
            <label class="visually-hidden" for="ai-tender-search">Search tenders</label>
            <input type="search" id="ai-tender-search" class="ai-intel-input is-wide" placeholder="Search tenders" title="Search by tender number, title, department or category"
                   autocomplete="off" data-tender-search />
            <label class="visually-hidden" for="ai-tender-status-filter">Filter by status</label>
            <select id="ai-tender-status-filter" class="ai-intel-select" data-tender-status-filter>
                <option value="">All statuses</option>
                @foreach (var st in Model.Tenders.Select(t => t.Status).Distinct())
                {
                    <option value="@st">@StatusText(st)</option>
                }
            </select>
            <button type="button" class="ai-intel-btn is-surface" data-tender-clear hidden>Clear filters</button>
            <p class="ai-intel-count" data-tender-count aria-live="polite">
                @Model.Tenders.Count @(Model.Tenders.Count == 1 ? "tender" : "tenders")
            </p>
        </div>

        <div class="ai-intel-table-wrap">
            <table class="ai-intel-table" data-tenders-table>
                <thead>
                    <tr>
                        <th scope="col">Tender</th>
                        <th scope="col">Category</th>
                        <th scope="col">Department</th>
                        <th scope="col">Status</th>
                        <th scope="col">Round</th>
                        <th scope="col">Invited / offers / compliant</th>
                        @if (Model.CanViewSupplierPricing)
                        {
                            <th scope="col">Price range</th>
                            <th scope="col">Winner</th>
                        }
                        <th scope="col">Duration</th>
                        <th scope="col"><span class="visually-hidden">Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Tenders.Count == 0)
                    {
                        <tr><td colspan="@tenderColumnCount" class="ai-intel-empty-cell">No tenders in your workspace yet. Tenders appear here once they reach your stage of the process.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in Model.Tenders)
                        {
                            <tr class="is-clickable @(Model.SelectedTenderId == row.TenderId ? "is-selected" : null)"
                                data-tender-row="@row.TenderId" data-status="@row.Status">
                                <td><strong>#@row.TenderId</strong> @row.Title</td>
                                <td>@row.Category</td>
                                <td>@row.Department</td>
                                <td>
                                    <span class="ai-intel-tag @(row.Status == "Awarded" ? "is-win" : row.SubmittedOffersCount == 0 ? "is-warn" : "")">@StatusText(row.Status)</span>
                                </td>
                                <td>R@(row.Round)</td>
                                <td>@row.InvitedCount / @row.SubmittedOffersCount / @row.CompliantOffersCount</td>
                                @if (Model.CanViewSupplierPricing)
                                {
                                    <td>
                                        @if (row.LowestOfferTotal.HasValue)
                                        {
                                            <span>@row.LowestOfferTotal.Value.ToString("N2") – @row.HighestOfferTotal!.Value.ToString("N2") @row.Currency</span>
                                        }
                                        else
                                        {
                                            <span class="ai-intel-muted">No offers</span>
                                        }
                                    </td>
                                    <td>@(row.WinningSupplier ?? "–")</td>
                                }
                                <td>@row.LifecycleFormatted</td>
                                <td>
                                    <button type="button" class="ai-intel-btn is-surface is-small" data-inspect-tender="@row.TenderId"
                                            aria-label="Open report for tender #@row.TenderId">Open</button>
                                </td>
                            </tr>
                        }
                        <tr data-tender-empty hidden>
                            <td colspan="@tenderColumnCount" class="ai-intel-empty-cell">No tenders match your search. Clear the filters to see all tenders.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ai-intel-report" id="tender-explorer" aria-labelledby="tender-report-heading">
            <div class="ai-intel-section-head">
                <div>
                    <h3 id="tender-report-heading" tabindex="-1">Tender report</h3>
                    <p class="ai-intel-section-sub">Lifecycle stage, requirements, offer comparison, committee scores and AI recommendation.</p>
                </div>
                @if (Model.TenderOptions.Count > 0)
                {
                    <div class="ai-intel-toolbar">
                        <label class="visually-hidden" for="ai-tender-selector">Tender</label>
                        <select id="ai-tender-selector" class="ai-intel-select" data-tender-select>
                            @foreach (var opt in Model.TenderOptions)
                            {
                                <option value="@opt.TenderId" selected="@(Model.SelectedTenderId == opt.TenderId)">
                                    #@opt.TenderId @opt.Title (@StatusText(opt.Status), @opt.Category)
                                </option>
                            }
                        </select>
                        <button type="button" class="ai-intel-btn is-primary" data-analyze-tender data-busy-label="Preparing…">Get AI recommendation</button>
                        <a class="ai-intel-icon-btn" data-export-tender-pdf download aria-label="Download this tender report as PDF" data-tip="Download PDF"
                           href="/AiIntelligence/ExportTender?tenderId=@Model.SelectedTenderId&amp;workspace=@Model.Workspace&amp;format=pdf">@Html.Raw(PdfIcon)</a>
                        <a class="ai-intel-icon-btn" data-export-tender-excel download aria-label="Download this tender report as Excel" data-tip="Download Excel"
                           href="/AiIntelligence/ExportTender?tenderId=@Model.SelectedTenderId&amp;workspace=@Model.Workspace&amp;format=excel">@Html.Raw(ExcelIcon)</a>
                    </div>
                }
            </div>

            <p class="ai-intel-status-msg" data-tender-status role="status" aria-live="polite" hidden></p>
            <div class="ai-intel-live" data-tender-ai-box hidden tabindex="-1"></div>
            <div class="ai-intel-report-body" data-tender-report-container aria-busy="false">
                @if (Model.TenderOptions.Count == 0)
                {
                    <p class="ai-intel-status-msg">No tenders available in your workspace yet.</p>
                }
            </div>
        </div>
    </section>

    @if (Model.CanViewSupplierPricing)
    {
        <section class="ai-intel-section" id="suppliers" aria-labelledby="suppliers-heading">
            <div class="ai-intel-section-head">
                <div>
                    <h2 id="suppliers-heading">Suppliers</h2>
                    <p class="ai-intel-section-sub">Participation, compliance and awards per supplier.</p>
                </div>
            </div>

            <div class="ai-intel-table-controls">
                <label class="visually-hidden" for="ai-supplier-search">Search suppliers</label>
                <input type="search" id="ai-supplier-search" class="ai-intel-input is-wide" placeholder="Search suppliers" title="Search by company, category or status"
                       autocomplete="off" data-supplier-search />
                <p class="ai-intel-count" data-supplier-count aria-live="polite">
                    @Model.Suppliers.Count @(Model.Suppliers.Count == 1 ? "supplier" : "suppliers")
                </p>
            </div>

            <div class="ai-intel-table-wrap">
                <table class="ai-intel-table" data-suppliers-table>
                    <thead>
                        <tr>
                            <th scope="col">Supplier</th>
                            <th scope="col">Category</th>
                            <th scope="col">Account status</th>
                            <th scope="col">Invitations</th>
                            <th scope="col">Offers submitted</th>
                            <th scope="col">Compliant offers</th>
                            <th scope="col">Participation</th>
                            <th scope="col">Compliance</th>
                            <th scope="col">Awards won (value)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Suppliers.Count == 0)
                        {
                            <tr><td colspan="9" class="ai-intel-empty-cell">No suppliers recorded in scope.</td></tr>
                        }
                        else
                        {
                            @foreach (var s in Model.Suppliers)
                            {
                                <tr data-supplier-row>
                                    <td><strong>#@s.SupplierId</strong> @s.CompanyName</td>
                                    <td>@s.Category</td>
                                    <td><span class="ai-intel-tag @(s.Status == "Approved" ? "is-win" : "")">@s.Status</span></td>
                                    <td>@s.InvitationsCount</td>
                                    <td>@s.SubmittedBidsCount</td>
                                    <td>@s.CompliantBidsCount</td>
                                    <td>@s.ParticipationRatePercent.ToString("0.#")%</td>
                                    <td>@s.ComplianceRatePercent.ToString("0.#")%</td>
                                    <td><strong>@s.AwardedCount</strong>@if (s.AwardedCount > 0) { <span class="ai-intel-won-value">@s.AwardedValue.ToString("N2") JOD</span> }</td>
                                </tr>
                            }
                            <tr data-supplier-empty hidden>
                                <td colspan="9" class="ai-intel-empty-cell">No suppliers match your search.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (supplierLinks != null)
    {
        <partial name="_SupplierLinks" model="supplierLinks" />
    }
</div>

@section Scripts {
    <script src="~/js/ai-intelligence.js" asp-append-version="true"></script>
    <script src="~/js/supplier-links.js" asp-append-version="true"></script>
}
