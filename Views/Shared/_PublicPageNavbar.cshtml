@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<header class="public-page-nav">
    <a class="public-page-brand" asp-controller="Home" asp-action="Index" aria-label="Tiryaq Pharma home"><svg viewBox="0 0 26 26" aria-hidden="true" width="26" height="26"><path d="M9 3h8v3H9z" fill="#efb85c"/><path d="M10 6h6v2.6c3.4 1 5 3.2 5 6.4v6a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-6c0-3.2 1.6-5.4 5-6.4z" fill="none" stroke="#f4eee2" stroke-width="1.6"/><path d="M6.6 16h12.8v5a2 2 0 0 1-2 2H8.6a2 2 0 0 1-2-2z" fill="#efb85c"/></svg> Tiryaq <small>Pharma</small></a>
    <nav aria-label="Main navigation">
        <a asp-controller="Home" asp-action="Index" aria-current="@(controller == "Home" && action == "Index" ? "page" : null)">Home</a>
        <a asp-controller="Home" asp-action="HowItWorks" aria-current="@(action == "HowItWorks" ? "page" : null)">How It Works</a>
        <a asp-controller="Home" asp-action="Contact" aria-current="@(action == "Contact" ? "page" : null)">Contact</a>
        <a asp-controller="Home" asp-action="Team" aria-current="@(action == "Team" ? "page" : null)">Our team</a>
        <a asp-controller="Home" asp-action="About" aria-current="@(action == "About" ? "page" : null)">About</a>
    </nav>
    <div class="public-page-account">
        @if (signedIn) { <a class="public-page-cta" asp-controller="Account" asp-action="GoToDashboard">My dashboard</a><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Sign out</button></form> }
        else { <a asp-controller="Account" asp-action="Login" aria-current="@(action == "Login" ? "page" : null)">Sign in</a><a class="public-page-cta" asp-controller="Account" asp-action="Register" aria-current="@(action == "Register" ? "page" : null)">Become a supplier</a> }
    </div>
</header>
