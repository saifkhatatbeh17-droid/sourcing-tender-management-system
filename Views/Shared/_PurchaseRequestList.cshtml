@model IReadOnlyList<SourcingTenderManagement.Models.Entities.PurchaseRequest>
@{ var showQrLink = ViewData["ShowQrLink"] is true; }
@if (Model.Count == 0)
{
    <p>No requests to display.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th><th>Department</th><th>Priority</th><th>Target date</th><th>Status</th>
                    @if (showQrLink) { <th scope="col">Details</th> }
                </tr>
            </thead>
            <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@request.PurchaseRequestId">@request.Title</a></td>
                    <td>@request.Department.Name</td>
                    <td>@request.Priority</td>
                    <td>@request.TargetDate.ToString("yyyy-MM-dd")</td>
                    <td>@request.Status</td>
                    @if (showQrLink)
                    {
                        <td><a asp-action="Details" asp-route-id="@request.PurchaseRequestId" asp-route-showQr="true" class="btn btn-sm btn-outline-primary text-nowrap">View QR code</a></td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}
