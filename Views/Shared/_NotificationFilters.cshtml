@model int

<div class="notice-center-filters" role="group" aria-label="Filter displayed notifications">
    <button type="button" data-notice-filter="all" aria-pressed="true">All</button>
    <button type="button" data-notice-filter="unread" aria-pressed="false">Unread (@Model)</button>
    <button type="button" data-notice-filter="approvals" aria-pressed="false">Approvals</button>
    <button type="button" data-notice-filter="messages" aria-pressed="false">Messages</button>
</div>
