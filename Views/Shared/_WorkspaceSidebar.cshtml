@using SourcingTenderManagement.Models
@{
    var currentAction = ViewData["ActivePage"]?.ToString() ?? ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewData["WorkspaceController"]?.ToString() ?? "Admin";
    var activeAction = ViewData["WorkspaceActiveAction"]?.ToString() ?? currentAction;
    var isManagerProfile = ViewContext.RouteData.Values["controller"]?.ToString() == "Account" &&
        (currentAction == "Profile" || currentAction == "EditProfile");
}
<aside class="admin-sidebar" aria-label="@ViewData["WorkspaceLabel"] navigation">
    <div class="admin-sidebar-top">
        <div class="admin-sidebar-header">
            <div class="admin-sidebar-role">@ViewData["WorkspaceLabel"]</div>
            <button type="button" class="admin-sidebar-toggle" aria-label="Toggle sidebar menu" aria-controls="admin-sidebar-menu" aria-expanded="true" title="Toggle sidebar menu">
                <partial name="_AdminSidebarIcon" model='@("Menu")' />
            </button>
        </div>
        <nav id="admin-sidebar-menu" class="admin-sidebar-nav" aria-label="Workspace pages">
            @foreach (var item in PageNavigation.Menus[controller])
            {
                var isActive = activeAction == item.Action;
                <a class="admin-sidebar-item @(isActive ? "is-active" : null)" asp-controller="@controller" asp-action="@item.Action"
                   aria-current="@(isActive ? "page" : null)" aria-label="@item.Title" title="@item.Title">
                    <partial name="_AdminSidebarIcon" model="item.Action" />
                    <span>@item.Title</span>
                </a>
            }
        </nav>
    </div>
    <div class="admin-sidebar-bottom">
        @if (controller == "SourcingManager")
        {
            <a class="admin-sidebar-item @(isManagerProfile ? "is-active" : null)" asp-controller="Account" asp-action="Profile"
               aria-current="@(isManagerProfile ? "page" : null)" aria-label="My Profile" title="My Profile">
                <partial name="_AdminSidebarIcon" model='@("Profile")' />
                <span>My Profile</span>
            </a>
        }
        <a class="admin-sidebar-item" asp-controller="FaceEnrollment" asp-action="Index" aria-label="Manage Face ID" title="Manage Face ID"><partial name="_AdminSidebarIcon" model='@("FaceId")' /><span>Manage Face ID</span></a>
        <button type="button" class="admin-sidebar-item" data-theme-toggle aria-pressed="false" aria-label="Dark mode" title="Dark mode">
            <partial name="_AdminSidebarIcon" model='@("Theme")' />
            <span data-theme-label>Dark Mode</span>
        </button>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="admin-sidebar-item" aria-label="Logout" title="Logout">
                <partial name="_AdminSidebarIcon" model='@("Logout")' />
                <span>Logout</span>
            </button>
        </form>
    </div>
</aside>
