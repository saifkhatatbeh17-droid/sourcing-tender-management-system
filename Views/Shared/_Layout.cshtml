@using SourcingTenderManagement.Data
@using SourcingTenderManagement.Models
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var profileController = User.IsInRole(RoleNames.Supplier) ? "Supplier" : "Account";
    var editingProfile = currentController == "Account" && currentAction == "EditProfile";
    var profileIsActive = editingProfile || (currentController == profileController && currentAction == "Profile");
    var workspaceController = currentController;
    if (profileIsActive && currentController == "Account")
    {
        workspaceController = User.IsInRole(RoleNames.Supplier)
            ? RoleNames.Supplier
            : RoleNames.Primary.FirstOrDefault(User.IsInRole) ?? currentController;
    }
    var standaloneLogin = ViewData["StandaloneLogin"] is true;
    var isHomeLanding = ViewData["HomeLanding"] is true;
    var isSupplierRegistration = currentController == "Account" && currentAction == "Register";
    var isContactPage = currentController == "Home" && currentAction == "Contact";
    var useLandingNavbar = isHomeLanding || isSupplierRegistration || isContactPage;
    if (!PageNavigation.Menus.ContainsKey(workspaceController) || !User.IsInRole(workspaceController))
        workspaceController = RoleNames.Primary.FirstOrDefault(User.IsInRole) ?? currentController;
    var showWorkspace = !isHomeLanding && User.Identity?.IsAuthenticated == true
        && ViewData["HideWorkspaceSidebar"] is not true && PageNavigation.Menus.ContainsKey(workspaceController)
        && (PageNavigation.Menus.ContainsKey(currentController) || currentController is "Clarification" or "Account" or "FaceEnrollment" or "FaceSetup" or "FaceVerification" or "FaceLogin");
    var showAdminSidebar = showWorkspace && workspaceController == "Admin";
    ViewData["WorkspaceController"] = workspaceController;
    ViewData["WorkspaceLabel"] = workspaceController == "Admin" ? "Administration" : RoleNames.DisplayName(workspaceController);
    var activeAction = ViewData["ActivePage"]?.ToString() ?? currentAction;
    if (currentController == "Clarification") activeAction = "Clarifications";
    activeAction = activeAction switch {
        "Details" when workspaceController == "Department" => "Requests",
        "Edit" when workspaceController == "Department" => "Create",
        "SupplierDetails" => "Suppliers", "CreateRequest" or "EditRequest" or "RequestDetails" => "Requests",
        "Tenders" or "TenderDetails" or "Create" or "Edit" or "Invitations" or "Compliance" or "Comparison" or "Evaluations"
            when workspaceController == "SourcingOfficer" => "Offers",
        "CreateOffer" or "Offer" => "Offers", "TenderDetails" when workspaceController == "TopCommittee" => "Decisions",
        "TenderDetails" => "Tenders", "Invitation" => "Invitations", _ => activeAction
    };
    ViewData["WorkspaceActiveAction"] = activeAction;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <script src="~/js/site-theme.js" asp-append-version="true"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Sourcing &amp; Tender Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/formatted-report.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/action-confirmation.css" asp-append-version="true" />
    @if (showAdminSidebar)
    {
        <link rel="stylesheet" href="~/css/admin-sidebar.css" asp-append-version="true" />
    }
    @if (showWorkspace) { <link rel="stylesheet" href="~/css/root.css" asp-append-version="true" /> }
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/site-theme.css" asp-append-version="true" />
    @if (showAdminSidebar)
    {
        <link rel="stylesheet" href="~/css/root.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/admin-root.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/admin-usability.css" asp-append-version="true" />
    }
    @if (showWorkspace) { <link rel="stylesheet" href="~/css/workspace-shell.css" asp-append-version="true" /> }
    @if (showWorkspace && currentAction == "Dashboard") { <link rel="stylesheet" href="~/css/workspace-dashboard.css" asp-append-version="true" /> }
    <link rel="stylesheet" href="~/css/workflow-ux.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
@if (showWorkspace)
{
    <partial name="_WorkspaceNavbar" />
}
else if (!standaloneLogin)
{
<header class="@(isSupplierRegistration ? "landing-header registration-navbar" : isContactPage ? "landing-header is-past-hero contact-navbar" : isHomeLanding ? "landing-header" : "border-bottom bg-white")">
    <nav class="container-fluid d-flex flex-wrap align-items-center gap-3 @(useLandingNavbar ? "landing-nav" : "p-3")" aria-label="Main navigation">
        @if (useLandingNavbar)
        {
            <a class="pharma-brand landing-brand" asp-controller="Home" asp-action="Index"><partial name="_PharmaBrand" /></a>
        }
        else
        {
            <a class="pharma-brand text-decoration-none text-dark me-auto" asp-controller="Home" asp-action="Index"><partial name="_PharmaBrand" /></a>
        }
        <div class="d-flex flex-wrap align-items-center gap-3 @(useLandingNavbar ? "landing-links" : "")">
            <a asp-controller="Home" asp-action="Index" aria-current="@(isHomeLanding ? "page" : null)">Home</a>
            <a asp-controller="Home" asp-action="Team">Our Team</a>
            <a asp-controller="Home" asp-action="@(isHomeLanding ? "Index" : "About")" asp-fragment="@(isHomeLanding ? "about" : null)">About</a>
            <a asp-controller="Home" asp-action="@(isHomeLanding ? "Index" : "HowItWorks")" asp-fragment="@(isHomeLanding ? "how-it-works" : null)">How It Works</a>
            <a asp-controller="Home" asp-action="@(isHomeLanding ? "Index" : "Contact")" asp-fragment="@(isHomeLanding ? "contact" : null)" aria-current="@(isContactPage ? "page" : null)">Contact</a>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 @(useLandingNavbar ? "landing-account" : "")">
        <partial name="_ThemeToggle" />
        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (!isHomeLanding)
            {
                <a asp-controller="Account" asp-action="GoToDashboard">My Dashboard</a>
            }
            <a asp-controller="FaceEnrollment" asp-action="Index">Biometric sign-in</a>
            @await Component.InvokeAsync("NotificationBell")
            @if (!showAdminSidebar)
            {
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-secondary">Sign Out</button></form>
            }
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Login</a>
            <a class="@(useLandingNavbar ? "landing-register" : "")" asp-controller="Account" asp-action="Register" aria-current="@(isSupplierRegistration ? "page" : null)">Supplier Registration</a>
        }
        </div>
    </nav>
</header>
}
<div class="app-shell @(showAdminSidebar ? "admin-shell" : null) @(showWorkspace ? "workspace-shell" : null)">
@if (showWorkspace)
{
    <partial name="_WorkspaceSidebar" />
}
<main id="main" class="main-content @(standaloneLogin ? "login-main" : isHomeLanding ? "landing-main" : "p-4")" tabindex="-1">@RenderBody()</main>
</div>
@if (!standaloneLogin) { @await RenderSectionAsync("Footer", required: false) }
<partial name="_ActionConfirmation" />
<script src="~/js/action-confirmation.js" asp-append-version="true"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@if (showWorkspace) { <script src="~/js/workspace-sidebar.js" asp-append-version="true"></script><script src="~/js/supplier-picker.js" asp-append-version="true"></script> }
@if (showAdminSidebar)
{
    <script src="~/js/admin-sidebar.js" asp-append-version="true"></script>
}

<script src="~/js/voice-search.js" asp-append-version="true"></script>

<script src="~/js/workflow-ux.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
