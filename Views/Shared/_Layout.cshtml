@using SourcingTenderManagement.Data
@using SourcingTenderManagement.Models
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var isHomeLanding = ViewData["HomeLanding"] is true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Sourcing &amp; Tender Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="@(isHomeLanding ? "landing-header" : "border-bottom bg-white")">
    <nav class="container-fluid d-flex flex-wrap align-items-center gap-3 @(isHomeLanding ? "landing-nav" : "p-3")" aria-label="Main navigation">
        @if (isHomeLanding)
        {
            <a class="pharma-brand landing-brand" asp-controller="Home" asp-action="Index"><partial name="_PharmaBrand" /></a>
        }
        else
        {
            <a class="pharma-brand text-decoration-none text-dark me-auto" asp-controller="Home" asp-action="Index"><partial name="_PharmaBrand" /></a>
        }
        <div class="d-flex flex-wrap align-items-center gap-3 @(isHomeLanding ? "landing-links" : "")">
            <a asp-controller="Home" asp-action="Index" aria-current="@(isHomeLanding ? "page" : null)">Home</a>
            <a asp-controller="Home" asp-action="@(isHomeLanding ? "Index" : "About")" asp-fragment="@(isHomeLanding ? "about" : null)">About</a>
            <a asp-controller="Home" asp-action="@(isHomeLanding ? "Index" : "HowItWorks")" asp-fragment="@(isHomeLanding ? "how-it-works" : null)">How It Works</a>
            <a asp-controller="Home" asp-action="@(isHomeLanding ? "Index" : "Contact")" asp-fragment="@(isHomeLanding ? "contact" : null)">Contact</a>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 @(isHomeLanding ? "landing-account" : "")">
        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (!isHomeLanding)
            {
                <a asp-controller="Account" asp-action="GoToDashboard">My Dashboard</a>
            }
            @await Component.InvokeAsync("NotificationBell")
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-secondary">Sign Out</button></form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Login</a>
            <a class="@(isHomeLanding ? "landing-register" : "")" asp-controller="Account" asp-action="Register">Supplier Registration</a>
        }
        </div>
    </nav>
</header>
<div class="app-shell">
@if (!isHomeLanding && ViewData["HideWorkspaceSidebar"] is not true && User.Identity?.IsAuthenticated == true)
{
    <aside class="sidebar p-3 border-end" aria-label="Workspace navigation">
        @foreach (var role in RoleNames.Primary.Where(User.IsInRole))
        {
            <a class="workspace-link" asp-controller="@role" asp-action="Dashboard">@role workspace</a>
        }
        @if (PageNavigation.Menus.TryGetValue(currentController, out var menu) && User.IsInRole(currentController))
        {
            <hr />
            @foreach (var item in menu)
            {
                var active = (ViewData["ActivePage"]?.ToString() ?? ViewContext.RouteData.Values["action"]?.ToString()) == item.Action;
                <a class="page-link-item @(active ? "active" : "")" asp-controller="@currentController" asp-action="@item.Action" aria-current="@(active ? "page" : null)">@item.Title</a>
            }
        }
    </aside>
}
<main id="main" class="main-content @(isHomeLanding ? "landing-main" : "p-4")" tabindex="-1">@RenderBody()</main>
</div>
@await RenderSectionAsync("Footer", required: false)
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
