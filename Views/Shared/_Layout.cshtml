@using SourcingTenderManagement.Data
@using SourcingTenderManagement.Models
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var profileController = User.IsInRole(RoleNames.Supplier) ? "Supplier" : "Account";
    var editingProfile = currentController == "Account" && currentAction == "EditProfile";
    var profileIsActive = editingProfile || (currentController == profileController && currentAction == "Profile");
    var workspaceController = currentController;
    if (profileIsActive && currentController == "Account")
    {
        workspaceController = User.IsInRole(RoleNames.Supplier)
            ? RoleNames.Supplier
            : RoleNames.Primary.FirstOrDefault(User.IsInRole) ?? currentController;
    }
    var isHomeLanding = ViewData["HomeLanding"] is true;
    var showAdminSidebar = currentController == "Admin" && User.IsInRole(RoleNames.Admin);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <script src="~/js/site-theme.js" asp-append-version="true"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Sourcing &amp; Tender Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (showAdminSidebar)
    {
        <link rel="stylesheet" href="~/css/admin-sidebar.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/site-theme.css" asp-append-version="true" />
    @if (showAdminSidebar)
    {
        <link rel="stylesheet" href="~/css/root.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/admin-root.css" asp-append-version="true" />
    }
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
@if (showAdminSidebar)
{
    <partial name="_AdminNavbar" />
}
else
{
<header class="@(isHomeLanding ? "landing-header" : "border-bottom bg-white")">
    <nav class="container-fluid d-flex flex-wrap align-items-center gap-3 @(isHomeLanding ? "landing-nav" : "p-3")" aria-label="Main navigation">
        @if (isHomeLanding)
        {
            <a class="pharma-brand landing-brand" asp-controller="Home" asp-action="Index"><partial name="_PharmaBrand" /></a>
        }
        else
        {
            <a class="pharma-brand text-decoration-none text-dark me-auto" asp-controller="Home" asp-action="Index"><partial name="_PharmaBrand" /></a>
        }
        <div class="d-flex flex-wrap align-items-center gap-3 @(isHomeLanding ? "landing-links" : "")">
            <a asp-controller="Home" asp-action="Index" aria-current="@(isHomeLanding ? "page" : null)">Home</a>
            <a asp-controller="Home" asp-action="@(isHomeLanding ? "Index" : "About")" asp-fragment="@(isHomeLanding ? "about" : null)">About</a>
            <a asp-controller="Home" asp-action="@(isHomeLanding ? "Index" : "HowItWorks")" asp-fragment="@(isHomeLanding ? "how-it-works" : null)">How It Works</a>
            <a asp-controller="Home" asp-action="@(isHomeLanding ? "Index" : "Contact")" asp-fragment="@(isHomeLanding ? "contact" : null)">Contact</a>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 @(isHomeLanding ? "landing-account" : "")">
        <partial name="_ThemeToggle" />
        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (!isHomeLanding)
            {
                <a asp-controller="Account" asp-action="GoToDashboard">My Dashboard</a>
            }
            <a asp-controller="FaceEnrollment" asp-action="Index">Manage Face ID</a>
            @await Component.InvokeAsync("NotificationBell")
            @if (!showAdminSidebar)
            {
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-secondary">Sign Out</button></form>
            }
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Login</a>
            <a class="@(isHomeLanding ? "landing-register" : "")" asp-controller="Account" asp-action="Register">Supplier Registration</a>
        }
        </div>
    </nav>
</header>
}
<div class="app-shell @(showAdminSidebar ? "admin-shell" : null)">
@if (showAdminSidebar)
{
    <partial name="_AdminSidebar" />
}
else if (!isHomeLanding && ViewData["HideWorkspaceSidebar"] is not true && User.Identity?.IsAuthenticated == true)
{
    <aside class="sidebar p-3 border-end" aria-label="Workspace navigation">
        @foreach (var role in RoleNames.Primary.Where(User.IsInRole))
        {
            <a class="workspace-link" asp-controller="@role" asp-action="Dashboard">@role workspace</a>
        }
        @if (PageNavigation.Menus.TryGetValue(workspaceController, out var menu) && User.IsInRole(workspaceController))
        {
            <hr />
            @foreach (var item in menu)
            {
                var active = (ViewData["ActivePage"]?.ToString() ?? currentAction) == item.Action;
                <a class="page-link-item @(active ? "active" : "")" asp-controller="@workspaceController" asp-action="@item.Action" aria-current="@(active ? "page" : null)">@item.Title</a>
            }
        }
        <hr />
        <a class="page-link-item @(profileIsActive ? "active" : "")" asp-controller="@profileController" asp-action="Profile" aria-current="@(profileIsActive ? "page" : null)">My Profile</a>
    </aside>
}
<main id="main" class="main-content @(isHomeLanding ? "landing-main" : "p-4")" tabindex="-1">@RenderBody()</main>
</div>
@await RenderSectionAsync("Footer", required: false)
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@if (showAdminSidebar)
{
    <script src="~/js/admin-sidebar.js" asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
