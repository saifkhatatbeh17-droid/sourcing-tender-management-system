@model SourcingTenderManagement.Models.Entities.Tender

@if (Model.OfferExtensions.Count > 0)
{
    <details class="my-3">
        <summary>Offer round history</summary>
        @foreach (var extension in Model.OfferExtensions.OrderBy(e => e.Round))
        {
            <section class="mt-3">
                <h3 class="h6">Round @extension.Round</h3>
                <p>Round @(extension.Round - 1) closed @extension.PreviousDeadline.ToString("dd MMM yyyy HH:mm") UTC with @extension.PreviousCompliantOffers compliant offers.</p>
                <p>Opened @extension.OpenedAt.ToString("dd MMM yyyy HH:mm") UTC · Deadline @extension.Deadline.ToString("dd MMM yyyy HH:mm") UTC</p>
                <ul>
                    @foreach (var contact in extension.Outreach.Split('\n'))
                    {
                        <li>@contact</li>
                    }
                </ul>
            </section>
        }
    </details>
}
@if (!string.IsNullOrWhiteSpace(Model.OfferShortfallReason))
{
    <div class="alert alert-info">
        <strong>Reason for proceeding with fewer than three compliant offers</strong>
        <p class="mb-0 text-break">@Model.OfferShortfallReason</p>
    </div>
}
