@using SourcingTenderManagement.Models.Entities
@model List<BidGuarantee>
@if (Model.Count > 0)
{
    <link rel="stylesheet" href="~/css/guarantees.css" asp-append-version="true" />
    <section class="guarantee-section guarantee-records" aria-label="Warranties and guarantees">
        <h3>Warranties &amp; guarantees</h3>
        @foreach (var guarantee in Model)
        {
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            var state = guarantee.ExpiresOn < today ? "Expired" : guarantee.StartsOn > today ? "Not yet active" : "Within validity period";
            <article class="guarantee-record">
                <div class="guarantee-record-body">
                    <header><h4>@guarantee.Label</h4><span class="guarantee-status">@state</span></header>
                    <dl class="guarantee-facts">
                        <div><dt>Reference</dt><dd>@guarantee.ReferenceNumber</dd></div>
                        <div><dt>Issuer</dt><dd>@guarantee.Issuer</dd></div>
                        <div><dt>Coverage</dt><dd>@guarantee.Coverage · @guarantee.Scope</dd></div>
                        <div><dt>Validity</dt><dd>@guarantee.StartsOn.ToString("dd MMM yyyy") – @guarantee.ExpiresOn.ToString("dd MMM yyyy") <small>(@guarantee.DurationDays days)</small></dd></div>
                    </dl>
                    <a asp-controller="Guarantees" asp-action="Document" asp-route-id="@guarantee.BidGuaranteeId" class="btn btn-outline-primary">Download document</a>
                </div>
                @if (guarantee.Kind == "Bank")
                {
                    <div class="guarantee-qr">
                        <a asp-controller="Guarantees" asp-action="Verify" asp-route-token="@guarantee.VerificationToken" target="_blank" rel="noopener" aria-label="Open bank guarantee demo verification in a new tab">
                            <img src="@Url.Action("Qr", "Guarantees", new { token = guarantee.VerificationToken })" width="220" height="220" loading="lazy" alt="QR code linking to this bank guarantee's demo verification record" />
                        </a>
                        <a asp-controller="Guarantees" asp-action="Verify" asp-route-token="@guarantee.VerificationToken" target="_blank" rel="noopener">Verify guarantee ↗</a>
                        <a asp-controller="Guarantees" asp-action="Qr" asp-route-token="@guarantee.VerificationToken" download="guarantee-qr.svg">Download QR</a>
                        <small>Tiryaq bank simulation</small>
                    </div>
                }
            </article>
        }
    </section>
}
