@* Partial view (a reusable piece of a page). Used by: Account/Profile, Supplier/Profile. *@
@model ChangePasswordViewModel
@{
    var errors = TempData["PasswordChangeErrors"] as IEnumerable<string> ?? [];
    var hasErrors = errors.Any();
    var success = TempData["PasswordChangeSuccess"] as string;
    // Set on accounts created by the spreadsheet import until the temporary password is replaced.
    var mustChange = User.HasClaim(SourcingTenderManagement.Services.Admin.EmployeeAccounts.PasswordChangeRequiredClaim, "true");
}

<section class="ap-card ap-security" id="profile-security" aria-labelledby="profile-security-title">
    <h2 id="profile-security-title">Account security</h2>
    @if (success is not null)
    {
        <p class="alert alert-success" role="status">@success</p>
    }
    @if (mustChange)
    {
        <p class="alert alert-warning" role="alert">Your account was created with a temporary password. Choose your own password below to start using Tiryaq.</p>
    }
    <details class="ap-password-details" open="@(hasErrors || mustChange)">
        <summary>
            <span>Change password</span>
            <span class="ap-chevron" aria-hidden="true"></span>
        </summary>
        <form asp-controller="Account" asp-action="ChangePassword" method="post" class="ap-password-form">
            @if (hasErrors)
            {
                <div class="alert alert-danger" role="alert">
                    <ul class="mb-0">
                        @foreach (var error in errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
            <div class="ap-password-fields">
                <div class="ap-password-current">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" required />
                </div>
                <div>
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" required />
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
                </div>
            </div>
            <div class="ap-actions">
                <button type="submit" class="btn btn-primary">Save new password</button>
            </div>
        </form>
    </details>
</section>
