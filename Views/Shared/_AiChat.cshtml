@using SourcingTenderManagement.Data
@using SourcingTenderManagement.Services.Chat
@{
    var workspace = ViewData["WorkspaceController"]?.ToString() ?? "";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var chatPage = controller == workspace && AiChatPage.Record(workspace, action) != null ? action : null;
    var pageId = ViewData["AiChatRecordId"] ??
        ViewContext.RouteData.Values["id"] ?? ViewContext.HttpContext.Request.Query["id"].ToString();
    var recordId = chatPage != null && int.TryParse(pageId.ToString(), out var id) && id > 0 ? (int?)id : null;
    var starterQuestion = recordId.HasValue ? "What's the status of this record?" : "What can I do in this workspace?";
}
<div class="ai-chat" data-ai-chat data-workspace="@workspace" data-page="@chatPage" data-record-id="@recordId">
    <button class="ai-chat-launcher" type="button" aria-label="Open Tiryaq Assistant"
            aria-haspopup="dialog" aria-controls="ai-chat-dialog" aria-expanded="false">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 11.5a7.9 7.9 0 0 1-8 7.8 8.2 8.2 0 0 1-3.2-.7L4 20l1.4-4.1A7.7 7.7 0 0 1 4 11.5a8 8 0 0 1 16 0Z" />
            <path d="M8.5 11.5h7" />
        </svg>
    </button>
    <dialog class="ai-chat-dialog" id="ai-chat-dialog" aria-labelledby="ai-chat-title">
        <div class="ai-chat-panel">
            <header class="ai-chat-header">
                <span class="ai-chat-header-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 11.5a7.9 7.9 0 0 1-8 7.8 8.2 8.2 0 0 1-3.2-.7L4 20l1.4-4.1A7.7 7.7 0 0 1 4 11.5a8 8 0 0 1 16 0Z" />
                        <path d="M8.5 11.5h7" />
                    </svg>
                </span>
                <div>
                    <h2 id="ai-chat-title">Tiryaq Assistant</h2>
                    <p>@RoleNames.DisplayName(workspace)</p>
                </div>
                <button class="ai-chat-close" type="button" aria-label="Close Tiryaq Assistant" autofocus>
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </header>
            <div class="ai-chat-body">
                <div class="ai-chat-start" data-chat-start>
                    <p>@(workspace == RoleNames.Admin ? "Ask about any Tiryaq workflow." :
                            recordId.HasValue ? "Ask about this record or your workspace." : "Ask about your Tiryaq workspace.")</p>
                    <button type="button" data-chat-question="What's my role?">What's my role?</button>
                    <button type="button" data-chat-question="@starterQuestion">@starterQuestion</button>
                </div>
                <div class="ai-chat-messages" role="log" aria-label="Conversation" tabindex="-1"></div>
            </div>
            <form class="ai-chat-form" asp-controller="AiChat" asp-action="Ask" method="post">
                <p class="ai-chat-status" role="status" aria-atomic="true"></p>
                <label class="visually-hidden" for="ai-chat-question">Your message</label>
                <div class="ai-chat-composer">
                    <textarea id="ai-chat-question" name="question" rows="2" maxlength="750" required
                              dir="auto" enterkeyhint="send" placeholder="Type a message…" aria-describedby="ai-chat-shortcuts"></textarea>
                    <button class="ai-chat-send" type="submit" disabled>
                        <span>Send</span>
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5m-6 6 6-6 6 6" /></svg>
                    </button>
                </div>
                <p class="ai-chat-shortcuts" id="ai-chat-shortcuts">Enter to send · Shift+Enter for a new line</p>
            </form>
        </div>
    </dialog>
</div>
