@model List<SourcingTenderManagement.Models.Entities.SupplierProfile>
@{ ViewData["Title"] = "Suppliers"; }
<h1>Suppliers</h1>
@if (Model.Count == 0) { <p class="text-secondary">No suppliers registered yet.</p> }
@foreach (var supplier in Model)
{
    <details class="workspace-section supplier-details">
        <summary><strong>@supplier.CompanyName</strong> <span class="text-secondary">(@supplier.Status)</span></summary>
        <dl class="row mt-3 mb-0">
            <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@supplier.User.Email</dd>
            <dt class="col-sm-4">Contact Name</dt><dd class="col-sm-8">@supplier.ContactName</dd>
            <dt class="col-sm-4">Registration Number</dt><dd class="col-sm-8">@supplier.RegistrationNumber</dd>
            <dt class="col-sm-4">Tax Number</dt><dd class="col-sm-8">@supplier.TaxNumber</dd>
            <dt class="col-sm-4">Address</dt><dd class="col-sm-8">@supplier.Address</dd>
            <dt class="col-sm-4">Review Notes</dt><dd class="col-sm-8">@supplier.ReviewNotes</dd>
        </dl>
        <!-- TEAM TODO: Display authorized legal documents and any additional supplier actions inside this section. -->
    </details>
}
