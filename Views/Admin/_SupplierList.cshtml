@model SupplierListViewModel
@{
    var title = Model.ApplicationsOnly ? "Supplier Applications" : "Suppliers";

}

<div class="workspace-heading">
    <div><h1>@title</h1><p>@(Model.ApplicationsOnly ? "Review supplier registrations and supporting documents." : "Browse supplier records, approval status, and company details.")</p></div>
    @if (!Model.ApplicationsOnly)
    {
        <a id="supplier-export" asp-action="ExportSuppliers" asp-route-search="@ViewBag.FilterSearch" asp-route-status="@Model.SelectedStatus" class="btn btn-outline-primary">
            <span aria-hidden="true">↓</span> Export CSV
        </a>
    }
</div>

@if (TempData["SupplierReviewFeedback"] is string feedback)
{
    <p class="admin-feedback admin-review-feedback" data-admin-feedback role="status">@feedback</p>
}
@if (TempData["SupplierReviewConflict"] is string conflict)
{
    <p class="alert alert-warning" role="alert">@conflict</p>
}


@if (!Model.ApplicationsOnly)
{
    <div class="admin-filter-bar">
    <form asp-action="Suppliers" method="get" class="admin-record-filters row g-3" data-local-filter data-results="supplier-results" aria-label="Filter suppliers">
        <div class="col-12 col-sm">
            <label class="form-label" for="supplier-directory-search">Find a supplier</label>
            <div class="voice-search-control">
                <div class="input-group">
                    <input id="supplier-directory-search" class="form-control" type="search" name="search" value="@ViewBag.FilterSearch" placeholder="Search by company, registration or email" data-voice-search data-voice-search-mode="local" aria-describedby="supplier-search-voice-status" />
                    <select class="form-select form-select-sm w-auto" data-voice-search-language aria-label="Voice search language"><option value="en-US">English</option><option value="ar-JO">العربية</option></select>
                    <button type="button" class="btn btn-outline-primary" data-voice-search-button aria-label="Start voice search" aria-pressed="false" aria-describedby="supplier-search-voice-status">
                        <svg data-voice-icon="mic" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3m-4 0h8"/></svg>
                        <svg data-voice-icon="stop" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" hidden><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
                    </button>
                </div>
                <div id="supplier-search-voice-status" class="form-text small" data-voice-search-status role="status" aria-live="polite"></div>
            </div>
        </div>
        <div class="col">
            <select class="form-select" name="status" aria-label="Supplier status">
                <option value="">All statuses</option>
                @foreach (var status in Model.AvailableStatuses)
                {
                    <option value="@status" selected="@(status == Model.SelectedStatus)">@SupplierListViewModel.StatusLabel(status)</option>
                }
            </select>
        </div>
        <div class="col-auto"><a asp-action="Suppliers" class="btn btn-link">Clear</a></div>
    </form>
    </div>
}
<section class="admin-records" aria-label="@title records">
<div id="supplier-results">
@if (Model.Suppliers.Count == 0)
{
    <p class="admin-record-empty">No @(Model.ApplicationsOnly ? "applications" : "suppliers") match this view.</p>
}
else
{
    <div class="table-responsive" tabindex="0" role="region" aria-label="@title">
        <table class="table align-middle admin-record-table">
            <thead>
                <tr>
                    <th scope="col">Company</th>
                    <th scope="col">Registration</th>
                    <th scope="col">Submitted</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in Model.Suppliers)
                {
                    <tr data-admin-row data-search="@supplier.CompanyName @supplier.RegistrationNumber @supplier.User.Email" data-status="@supplier.Status">
                        <th scope="row">
                            <div class="admin-record-identity">
                                <span class="admin-record-avatar" aria-hidden="true">@supplier.CompanyName.Trim().FirstOrDefault()</span>
                                <div class="text-break">@supplier.CompanyName
                                    <div class="text-secondary fw-normal small">@supplier.User.Email</div>
                                </div>
                            </div>
                        </th>
                        <td>@supplier.RegistrationNumber</td>
                        <td>@supplier.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td><span class="badge rounded-pill @SupplierListViewModel.StatusStyle(supplier.Status)">@SupplierListViewModel.StatusLabel(supplier.Status)</span></td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary text-nowrap" asp-action="SupplierDetails" asp-route-id="@supplier.SupplierProfileId"
                               asp-route-reviewApplication="@Model.ApplicationsOnly.ToString().ToLowerInvariant()" data-supplier-dialog data-company="@supplier.CompanyName"
                               aria-label="Open @supplier.CompanyName">@(Model.ApplicationsOnly ? "Review" : "View details")</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_AdminPager" />
}

</div>
</section>

<partial name="_SupplierReviewDialog" />
