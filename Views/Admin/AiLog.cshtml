@* AI log: a Admin page. Shown by AdminController.AiLog(). *@
@model AiLogPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "AI log";
    string Percent(double? value) => value.HasValue ? value.Value.ToString("0%", CultureInfo.InvariantCulture) : "–";
    string Seconds(double? ms) => ms.HasValue ? (ms.Value / 1000).ToString("0.0", CultureInfo.InvariantCulture) + " s" : "–";
    string OutcomeClass(string outcome) => outcome switch
    {
        "Succeeded" => "is-ok",
        "Failed" => "is-failed",
        "LimitReached" => "is-limit",
        _ => "is-muted"
    };
    string Who(AiLogRow row) => row.UserName ?? (row.Workspace switch { "Public" => "Website visitor", "System" => "Background task", _ => "Unknown user" });
    Dictionary<string, string?> RouteFor(int page) => new()
    {
        ["search"] = Model.Search, ["feature"] = Model.Feature, ["workspace"] = Model.Workspace, ["outcome"] = Model.Outcome,
        ["from"] = Model.From?.ToString("yyyy-MM-dd"), ["to"] = Model.To?.ToString("yyyy-MM-dd"), ["page"] = page.ToString(CultureInfo.InvariantCulture)
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/ai-log.css" asp-append-version="true" />
}

<div class="workspace-heading">
    <div>
        <h1>AI log</h1>
        <p>Every request Tiryaq sends to the AI model: who asked, from which feature, and what happened.</p>
    </div>
</div>

<p class="ai-log-privacy">
    Prompts are not stored, only their size and fingerprint. Answers are kept shortened to 4,000 characters and can include supplier names and prices, so treat this page as confidential.
</p>

<section class="ai-log-summary" aria-label="Summary for the current filters">
    <div><span>Requests</span><strong>@Model.Summary.Total.ToString("N0")</strong></div>
    <div><span>Succeeded</span><strong>@Percent(Model.Summary.Total > 0 ? Model.Summary.Succeeded / (double)Model.Summary.Total : null)</strong><small>@Model.Summary.Succeeded.ToString("N0") requests</small></div>
    <div data-tone="@(Model.Summary.Failed > 0 ? "warn" : null)"><span>Failed</span><strong>@Model.Summary.Failed.ToString("N0")</strong><small>@Model.Summary.Cancelled cancelled · @Model.Summary.LimitReached hit the daily limit</small></div>
    <div><span>Average time</span><strong>@Seconds(Model.Summary.AverageMs)</strong><small>successful requests</small></div>
    <div><span>Expected format</span><strong>@Percent(Model.Summary.ConformRate)</strong><small>answers that matched the requested structure</small></div>
</section>

<form asp-action="AiLog" method="get" class="admin-record-filters workspace-search-card row g-3" aria-label="Filter the AI log">
    <h2 class="workspace-search-title">Filter requests</h2>
    <div class="col-12 col-lg-3">
        <label for="ai-log-search" class="form-label">User</label>
        <input id="ai-log-search" name="search" type="search" value="@Model.Search" class="form-control" placeholder="Name or email" />
    </div>
    <div class="col-6 col-lg-2">
        <label for="ai-log-feature" class="form-label">Feature</label>
        <select id="ai-log-feature" name="feature" class="form-select">
            <option value="">All features</option>
            @foreach (var option in Model.FeatureOptions)
            {
                <option value="@option" selected="@(Model.Feature == option)">@AiLogPageViewModel.FeatureName(option)</option>
            }
        </select>
    </div>
    <div class="col-6 col-lg-2">
        <label for="ai-log-workspace" class="form-label">Workspace</label>
        <select id="ai-log-workspace" name="workspace" class="form-select">
            <option value="">All workspaces</option>
            @foreach (var option in Model.WorkspaceOptions)
            {
                <option value="@option" selected="@(Model.Workspace == option)">@SourcingTenderManagement.Data.RoleNames.DisplayName(option)</option>
            }
        </select>
    </div>
    <div class="col-6 col-lg-2">
        <label for="ai-log-outcome" class="form-label">Result</label>
        <select id="ai-log-outcome" name="outcome" class="form-select">
            <option value="">All results</option>
            @foreach (var option in new[] { "Succeeded", "Failed", "Cancelled", "LimitReached" })
            {
                <option value="@option" selected="@(Model.Outcome == option)">@AiLogPageViewModel.OutcomeName(option)</option>
            }
        </select>
    </div>
    <div class="col-3 col-lg-1">
        <label for="ai-log-from" class="form-label">From</label>
        <input id="ai-log-from" name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-3 col-lg-1">
        <label for="ai-log-to" class="form-label">To</label>
        <input id="ai-log-to" name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-12 col-lg-auto d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-outline-primary">Apply filters</button>
        <a asp-action="AiLog" class="btn btn-link">Clear</a>
    </div>
</form>

@if (Model.Features.Count > 0)
{
    <section class="ai-log-section" aria-labelledby="ai-log-features-title">
        <h2 id="ai-log-features-title">By feature</h2>
        <div class="table-responsive" tabindex="0" role="region" aria-label="AI requests by feature">
            <table class="table align-middle admin-record-table">
                <thead>
                    <tr>
                        <th scope="col">Feature</th>
                        <th scope="col">Requests</th>
                        <th scope="col">Succeeded</th>
                        <th scope="col">Average time</th>
                        <th scope="col">Expected format</th>
                        <th scope="col">Prompt versions</th>
                        <th scope="col">Last used</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Features)
                    {
                        <tr>
                            <th scope="row">
                                <a asp-action="AiLog" asp-route-feature="@row.Feature" asp-route-workspace="@Model.Workspace"
                                   asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">@AiLogPageViewModel.FeatureName(row.Feature)</a>
                            </th>
                            <td>@row.Calls.ToString("N0")</td>
                            <td><span class="ai-log-rate @(row.SuccessRate < 0.9 ? "is-low" : null)">@Percent(row.SuccessRate)</span></td>
                            <td>@Seconds(row.AverageMs)</td>
                            <td>@Percent(row.ConformRate)</td>
                            <td>@row.PromptVersions</td>
                            <td>@row.LastUsedUtc.ToString("dd MMM yyyy HH:mm", CultureInfo.InvariantCulture) UTC</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="ai-log-section" aria-labelledby="ai-log-requests-title">
    <div class="ai-log-section-head">
        <h2 id="ai-log-requests-title">Requests</h2>
        <p>@Model.TotalMatching.ToString("N0") @(Model.TotalMatching == 1 ? "request" : "requests")@(Model.HasFilters ? " match these filters" : "")</p>
    </div>
    @if (Model.Rows.Count == 0)
    {
        <p class="admin-record-empty">@(Model.HasFilters ? "No AI requests match these filters." : "No AI requests have been recorded yet.")</p>
    }
    else
    {
        <div class="table-responsive" tabindex="0" role="region" aria-label="AI requests">
            <table class="table align-middle admin-record-table ai-log-table">
                <thead>
                    <tr>
                        <th scope="col">Time (UTC)</th>
                        <th scope="col">User</th>
                        <th scope="col">Feature</th>
                        <th scope="col">Record</th>
                        <th scope="col">Result</th>
                        <th scope="col">Time taken</th>
                        <th scope="col"><span class="visually-hidden">Details</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="text-nowrap">@row.CreatedAtUtc.ToString("dd MMM yyyy HH:mm:ss", CultureInfo.InvariantCulture)</td>
                            <td>
                                <span class="ai-log-user">@Who(row)</span>
                                <small>@(row.UserEmail ?? "")@(row.UserEmail != null ? " · " : "")@SourcingTenderManagement.Data.RoleNames.DisplayName(row.Workspace)</small>
                            </td>
                            <td>@AiLogPageViewModel.FeatureName(row.Feature)</td>
                            <td>@(row.RecordType != null ? $"{row.RecordType} #{row.RecordId}" : "–")</td>
                            <td>
                                <span class="ai-log-outcome @OutcomeClass(row.Outcome)">@AiLogPageViewModel.OutcomeName(row.Outcome)</span>
                                @if (row.SchemaConforms == false) { <small class="ai-log-format">Unexpected format</small> }
                            </td>
                            <td class="text-nowrap">@Seconds(row.DurationMs)</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-primary" data-ai-log-toggle aria-expanded="false"
                                        aria-controls="ai-log-detail-@row.Id">Details</button>
                            </td>
                        </tr>
                        <tr class="ai-log-detail" id="ai-log-detail-@row.Id" hidden>
                            <td colspan="7">
                                <dl class="ai-log-facts">
                                    <div><dt>Request</dt><dd>#@row.Id</dd></div>
                                    <div><dt>Model</dt><dd>@(row.Model ?? "–")</dd></div>
                                    <div><dt>Prompt version</dt><dd><code>@row.PromptVersion</code></dd></div>
                                    <div><dt>Sent</dt><dd>@row.InputChars.ToString("N0") characters</dd></div>
                                    <div><dt>Answer</dt><dd>@(row.OutputChars?.ToString("N0") ?? "–") characters</dd></div>
                                    <div><dt>Counts toward daily limit</dt><dd>@(row.IsInteractive ? "Yes" : "No")</dd></div>
                                    @if (row.ErrorType != null) { <div><dt>Error</dt><dd>@row.ErrorType</dd></div> }
                                    @if (row.SchemaIssues != null) { <div class="is-wide"><dt>Format problems</dt><dd>@row.SchemaIssues</dd></div> }
                                </dl>
                                @if (!string.IsNullOrEmpty(row.OutputPreview))
                                {
                                    <h3 class="ai-log-preview-title">Answer (shortened)</h3>
                                    <pre class="ai-log-preview" dir="auto">@row.OutputPreview</pre>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="ai-log-pager" aria-label="AI log pages">
                @if (Model.Page > 1) { <a class="btn btn-sm btn-outline-primary" asp-action="AiLog" asp-all-route-data="RouteFor(Model.Page - 1)">← Newer</a> }
                <span>Page @Model.Page of @Model.TotalPages</span>
                @if (Model.Page < Model.TotalPages) { <a class="btn btn-sm btn-outline-primary" asp-action="AiLog" asp-all-route-data="RouteFor(Model.Page + 1)">Older →</a> }
            </nav>
        }
    }
</section>

@section Scripts {
    <script>
        document.querySelectorAll('[data-ai-log-toggle]').forEach(button => button.addEventListener('click', () => {
            const detail = document.getElementById(button.getAttribute('aria-controls'));
            const open = button.getAttribute('aria-expanded') === 'true';
            detail.hidden = open;
            button.setAttribute('aria-expanded', String(!open));
            button.textContent = open ? 'Details' : 'Hide';
        }));
    </script>
}
