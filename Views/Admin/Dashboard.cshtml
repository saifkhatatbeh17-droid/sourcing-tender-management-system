@* Dashboard: a Admin page. Shown by AdminController.Dashboard(). *@
@model AdminDashboardViewModel
@inject SourcingTenderManagement.Services.Reports.Hub.ReportRegistry ReportRegistry

@{
    ViewData["Title"] = "Dashboard";
    var availableReports = (await ReportRegistry.GetAvailableAsync("Admin", Context.RequestAborted)).Select(report => report.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);
    string? ReportUrl(string key, string? status = null) => availableReports.Contains(key)
        ? Url.Action("Show", "Reports", new { key, status }) : null;
    var metrics = new[]
    {
        (Label: "Users", Count: Model.UsersCount),
        (Label: "Suppliers", Count: Model.SuppliersCount),
        (Label: "Departments", Count: Model.DepartmentsCount),
        (Label: "Purchase requests", Count: Model.PurchaseRequestsCount),
        (Label: "Tenders", Count: Model.TendersCount)
    };
}

<div class="admin-dashboard unified-dashboard">
    <div class="dashboard-heading">
        <div>
            <h1>Admin dashboard</h1>
            <p>Manage users, departments, and supplier approvals.</p>
        </div>
        <a class="dashboard-cta" asp-action="SupplierApplications">Review supplier applications <span aria-hidden="true">→</span></a>
    </div>

    <section class="dashboard-metrics is-five" aria-label="System totals">
        @foreach (var metric in metrics)
        {
            var reportKey = metric.Label switch { "Suppliers" => "suppliers", "Purchase requests" => "purchase-requests", "Tenders" => "tenders", _ => null };
            <partial name="_DashboardMetric" model='@(new DashboardMetric(metric.Label, metric.Count.ToString("N0"), "System total", metric.Label == "Users", Link: reportKey == null ? null : ReportUrl(reportKey)))' />
        }
    </section>
@{
 var supplierStates = ViewBag.DashboardSupplierStates as Dictionary<string,int> ?? new();
 int N(params string[] keys) => keys.Sum(k => supplierStates.GetValueOrDefault(k));
 var overview = new DashboardOverview("Supplier approval status", "All registered supplier companies", "suppliers", "approved",
 [new("Approved", N("Approved"), "positive", ReportUrl("suppliers", "Approved")), new("Awaiting action", N("Pending", "ChangesRequested"), "active"), new("Inactive", N("Rejected", "Suspended"), "muted")], "Supplier review breakdown", "Current account status of each company",
 [new("Awaiting admin review", N("Pending"), Link: ReportUrl("suppliers", "Pending")), new("Changes requested", N("ChangesRequested"), Link: ReportUrl("suppliers", "ChangesRequested")), new("Approved", N("Approved"), Link: ReportUrl("suppliers", "Approved")), new("Rejected", N("Rejected"), Link: ReportUrl("suppliers", "Rejected")), new("Suspended", N("Suspended"), Link: ReportUrl("suppliers", "Suspended"))], ReportUrl("suppliers"));
}
<partial name="_DashboardOverview" model="overview" />
    <section class="workspace-section mb-4" aria-labelledby="admin-reports-heading">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 id="admin-reports-heading">Reports</h2>
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-primary">Open Reports Hub</a>
        </div>
        <p>Explore the system totals above and review offers and evaluation results.</p>
        <div class="d-flex flex-wrap gap-2">
            @if (ReportUrl("purchase-requests") is { } requestsUrl) { <a href="@requestsUrl" class="btn btn-outline-primary">Purchase requests · @Model.PurchaseRequestsCount.ToString("N0")</a> }
            @if (ReportUrl("tenders") is { } tendersUrl) { <a href="@tendersUrl" class="btn btn-outline-primary">Tenders · @Model.TendersCount.ToString("N0")</a> }
            @if (ReportUrl("suppliers") is { } suppliersUrl) { <a href="@suppliersUrl" class="btn btn-outline-primary">Suppliers · @Model.SuppliersCount.ToString("N0")</a> }
            @if (ReportUrl("bids-evaluation") is { } evaluationsUrl) { <a href="@evaluationsUrl" class="btn btn-outline-primary">Offers &amp; evaluation</a> }
            <a asp-controller="ReportAccess" asp-action="Index" class="btn btn-outline-primary">Manage report access</a>
        </div>
    </section>


    <div class="admin-dashboard-panels">
        <section class="workspace-section" aria-labelledby="pending-applications-heading">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <h2 id="pending-applications-heading" class="mb-0">Pending supplier applications</h2>
                <a class="btn btn-sm admin-applications-button" asp-action="SupplierApplications" aria-label="View all supplier applications">View all <span aria-hidden="true">↗</span></a>
            </div>

            @if (Model.PendingApplications.Count == 0)
            {
                <p class="mb-0">No pending supplier applications.</p>
            }
            else
            {
                <div class="table-responsive" role="region" aria-labelledby="pending-applications-heading" tabindex="0">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Company</th>
                                <th scope="col">Submitted (UTC)</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var application in Model.PendingApplications)
                            {
                                <tr>
                                    <th scope="row">@application.CompanyName</th>
                                    <td><time datetime="@application.CreatedAt.ToString("yyyy-MM-dd")">@application.CreatedAt.ToString("dd MMM yyyy")</time></td>
                                    <td>
                                        <a class="btn btn-sm admin-review-button" asp-action="SupplierDetails" asp-route-id="@application.Id"
                                       asp-route-reviewApplication="true" data-supplier-dialog data-company="@application.CompanyName"
                                           aria-label="Review application for @application.CompanyName">Review <span aria-hidden="true">→</span></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>


    </div>
</div>

<partial name="_SupplierReviewDialog" />

@section Styles { <link rel="stylesheet" href="~/css/dashboard-overview.css" asp-append-version="true" /> }
