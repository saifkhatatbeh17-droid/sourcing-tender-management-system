@using SourcingTenderManagement.Data
@model UsersPageViewModel
@{
    ViewData["Title"] = "Users";
    var editInput = ViewData["EditInput"] as EditUserViewModel;
    var openEditId = ViewData["OpenEditUser"] as string;
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || Model.Role != null || Model.IsActive.HasValue;
}

<div class="workspace-heading">
    <h1>Users</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#create-user-modal">Create User</button>
</div>

@if (TempData["UsersFeedback"] is string feedback)
{
    <div class="alert alert-success" role="status">@feedback</div>
}

<form asp-action="Users" method="get" class="row g-3 align-items-end mb-4" aria-label="Filter users">
    <div class="col-12 col-lg">
        <label for="user-search" class="form-label">Name or email</label>
        <input id="user-search" name="search" type="search" value="@Model.Search" class="form-control" />
    </div>
    <div class="col-6 col-lg">
        <label for="user-role" class="form-label">Role</label>
        <select id="user-role" name="role" class="form-select">
            <option value="">All roles</option>
            @foreach (var role in RoleNames.Primary)
            {
                <option value="@role" selected="@(Model.Role == role)">@role</option>
            }
        </select>
    </div>
    <div class="col-6 col-lg">
        <label for="user-status" class="form-label">Status</label>
        <select id="user-status" name="isActive" class="form-select">
            <option value="">All statuses</option>
            <option value="true" selected="@(Model.IsActive == true)">Active</option>
            <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
        </select>
    </div>
    <div class="col-auto d-flex align-items-center gap-2">
        <button class="btn btn-outline-primary" type="submit">Apply filters</button>
        @if (hasFilters)
        {
            <a asp-action="Users" class="btn btn-link">Clear</a>
        }
    </div>
</form>

@if (Model.Users.Count == 0)
{
    <p class="workspace-section">@(hasFilters ? "No users match these filters." : "No user accounts yet.")</p>
}
else
{
    <div class="table-responsive" tabindex="0" role="region" aria-label="User accounts">
        <table class="table align-middle">
            <caption class="caption-top">@Model.Users.Count @(Model.Users.Count == 1 ? "account" : "accounts")</caption>
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Roles</th>
                    <th scope="col">Department</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Model.Users)
                {
                    <tr>
                        <th scope="row">@account.FullName</th>
                        <td class="text-break">@(account.Email ?? "—")</td>
                        <td>@(account.Roles.Count == 0 ? "Unassigned" : string.Join(", ", account.Roles))</td>
                        <td>@(account.DepartmentName ?? "—")</td>
                        <td>
                            <span class="badge @(account.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(account.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal"
                                    data-bs-target="#edit-user-@account.Id" aria-label="Edit @account.FullName">Edit</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="modal fade" id="create-user-modal" tabindex="-1" aria-labelledby="create-user-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="create-user-title">Create User</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <partial name="_CreateUserForm" model="Model.CreateUser" />
        </div>
    </div>
</div>

@foreach (var account in Model.Users)
{
    var input = editInput?.Id == account.Id ? editInput : new EditUserViewModel
    {
        Id = account.Id,
        FullName = account.FullName,
        IsActive = account.IsActive,
        DepartmentId = account.DepartmentId
    };
    var isCurrentUser = account.Id == Model.CurrentUserId;

    <div class="modal fade" id="edit-user-@account.Id" tabindex="-1" aria-labelledby="edit-user-title-@account.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <form asp-action="EditUser" method="post" class="modal-content" data-account-name="@account.FullName"
                  data-confirm-disable="@(account.IsActive && !isCurrentUser ? "true" : "false")">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="edit-user-title-@account.Id">Edit @account.FullName</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (openEditId == account.Id)
                    {
                        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                    }
                    <input type="hidden" name="Id" value="@account.Id" />
                    <p class="text-break">@account.Email</p>
                    <div class="field">
                        <label for="edit-name-@account.Id">Full name</label>
                        <input id="edit-name-@account.Id" name="FullName" value="@input.FullName" class="form-control" required maxlength="150" />
                    </div>
                    <div class="field">
                        <label for="edit-department-@account.Id">Department</label>
                        <select id="edit-department-@account.Id" name="DepartmentId" class="form-select">
                            <option value="">No department</option>
                            @foreach (var department in Model.Departments.Where(d => d.IsActive || d.DepartmentId == account.DepartmentId))
                            {
                                <option value="@department.DepartmentId" selected="@(input.DepartmentId == department.DepartmentId)">
                                    @department.Name@(department.IsActive ? "" : " (inactive)")
                                </option>
                            }
                        </select>
                    </div>
                    @if (isCurrentUser)
                    {
                        <input type="hidden" name="IsActive" value="true" />
                        <p class="mb-0">Your administrator account stays active.</p>
                    }
                    else
                    {
                        <div class="form-check">
                            <input id="edit-active-@account.Id" name="IsActive" type="checkbox" value="true"
                                   checked="@input.IsActive" class="form-check-input" />
                            <label for="edit-active-@account.Id" class="form-check-label">Active account</label>
                            <input type="hidden" name="IsActive" value="false" />
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('form[data-confirm-disable="true"]').forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.querySelector('input[type="checkbox"][name="IsActive"]').checked
                    && !window.confirm('Disable the account for ' + form.dataset.accountName + '?')) {
                    event.preventDefault();
                }
            });
        });

        const createForm = document.getElementById('create-user-form');
        const roleSelect = createForm.querySelector('[name="Role"]');
        const committeeSelect = createForm.querySelector('[name="CommitteeRole"]');
        const departmentSelect = createForm.querySelector('[name="DepartmentId"]');

        function updateCreateFields() {
            const role = roleSelect.value;
            const topCommittee = role === '@RoleNames.TopCommittee';
            const evaluationCommittee = role === '@RoleNames.EvaluationCommittee';
            const showCommittee = topCommittee || evaluationCommittee || role === '@RoleNames.SourcingManager';
            committeeSelect.closest('.field').hidden = !showCommittee;
            committeeSelect.disabled = !showCommittee;
            committeeSelect.required = topCommittee || evaluationCommittee;
            for (const option of committeeSelect.options) {
                if (!option.value) continue;
                option.disabled = !showCommittee || (option.dataset.committee === 'top') !== topCommittee;
                option.hidden = option.disabled;
            }
            if (!showCommittee || committeeSelect.selectedOptions[0]?.disabled) committeeSelect.value = '';
            departmentSelect.required = role === '@RoleNames.Department';
        }

        roleSelect.addEventListener('change', updateCreateFields);
        updateCreateFields();
    </script>
    @if (ViewData["OpenCreateUser"] is true)
    {
        <script>bootstrap.Modal.getOrCreateInstance(document.getElementById('create-user-modal')).show();</script>
    }
    @if (openEditId != null)
    {
        <script>bootstrap.Modal.getOrCreateInstance(document.getElementById(@Html.Raw(System.Text.Json.JsonSerializer.Serialize("edit-user-" + openEditId)))).show();</script>
    }
}
