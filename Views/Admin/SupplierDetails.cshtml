@model SupplierDetailsViewModel
@{
    var supplier = Model.Supplier;

    ViewData["Title"] = supplier.CompanyName;
}

<nav class="mb-3 d-flex flex-wrap gap-3" aria-label="Supplier navigation">
    <a asp-action="SupplierApplications">Supplier Applications</a>
    <a asp-action="Suppliers">All Suppliers</a>
</nav>

<div class="workspace-heading">
    <h1 class="text-break">@supplier.CompanyName</h1>
    <span class="badge @SupplierListViewModel.StatusStyle(supplier.Status)">@SupplierListViewModel.StatusLabel(supplier.Status)</span>
</div>

@if (TempData["SupplierReviewFeedback"] is string feedback)
{
    <p class="admin-feedback" data-admin-feedback role="status">@feedback</p>
}
@if (TempData["SupplierReviewConflict"] is string conflict)
{
    <p class="alert alert-warning" role="alert">@conflict</p>
}

<partial name="_SupplierDetailsContent" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
