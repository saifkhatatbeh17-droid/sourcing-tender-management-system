@model CommitteeEvaluationPage
@using System.Globalization
@{ var scenario = Model.AiRecommendation?.Scenarios.FirstOrDefault(); var suggested = Model.Offers.FirstOrDefault(b => b.BidId == scenario?.RecommendedBidId); }
<section id="ai-offers" class="cs-panel cs-ai" aria-labelledby="ai-heading">
    <div class="cs-section-heading"><div><h3 id="ai-heading">AI comparison</h3><p>Uses the committee’s locked percentages. Your accepted marks determine the result.</p></div><span class="cs-pill">Advisory</span></div>
    @if (TempData["AiError"] is string error) { <p class="cs-notice is-error" role="alert">@error</p> }
    @if (Model.AiOutdated) { <p class="cs-notice">The saved comparison is out of date. Run a new comparison using the locked percentages.</p> }
    <form asp-action="RecommendBids" method="post" data-ai-comparison>
        <input type="hidden" name="id" value="@Model.Tender!.TenderId" />
        <div class="cs-ai-fields"><label>Financial percentage<input type="text" name="financialWeight" value="@(Model.ConsensusLocked ? Model.FinancialWeight.ToString(CultureInfo.InvariantCulture) : null)" readonly placeholder="Awaiting consensus" aria-describedby="ai-weight-lock" /></label><label>Technical percentage<input type="text" name="requirementsWeight" value="@(Model.ConsensusLocked ? Model.TechnicalWeight.ToString(CultureInfo.InvariantCulture) : null)" readonly placeholder="Awaiting consensus" aria-describedby="ai-weight-lock" /></label><button class="cs-button" disabled="@(!Model.WeightsReady || Model.Locked || !Model.Members.Any(m => m.UserId == Model.UserId))">Compare offers</button></div>
        <p id="ai-weight-lock" class="cs-help">Automatically calculated from all four confirmed proposals. These values cannot be edited.</p><span role="status" hidden>Comparing offers…</span>
    </form>
    @if (scenario != null)
    { <div class="cs-ai-result"><strong>@(suggested?.Invitation.SupplierProfile.CompanyName ?? "Saved comparison")</strong><p>@scenario.Reason</p><a asp-action="RecommendationPdf" asp-route-id="@Model.Tender!.TenderId" class="cs-text-link">Download comparison PDF</a></div> }
</section>
