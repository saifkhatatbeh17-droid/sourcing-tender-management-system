@model CommitteeEvaluationPage
@using SourcingTenderManagement.Services.Evaluation
<section class="ev-shared-evaluation"><div class="ev-weights-summary"><div><h3>Evaluate every offer</h3><p>Each member submits both marks for every eligible offer. Submitted marks are locked.</p></div><div class="ev-weight-value"><span>Financial</span><strong>@Model.FinancialWeight.ToString("0")%</strong></div><div class="ev-weight-value"><span>Technical</span><strong>@Model.TechnicalWeight.ToString("0")%</strong></div></div></section>
@if (AllOfferScoring.Complete(Model))
{ <p class="ev-notice ev-notice-success">All offers have four completed reviews. <button type="button" class="ev-reference-link" data-open-evaluation-tab="report-tab">View scores &amp; report →</button></p> }
<nav class="ev-offer-navigation" aria-label="Choose an offer to evaluate">
    <p>Choose an offer</p><div class="ev-offer-navigation-list">
    @foreach (var choice in Model.Offers.OrderByDescending(offer => offer.SubmittedAt).ThenByDescending(offer => offer.BidId))
    {
        var currentOffer = Model.ReviewOffer?.BidId == choice.BidId;
        <a asp-controller="EvaluationCommittee" asp-action="Evaluations" asp-route-id="@Model.Tender!.TenderId" asp-route-offerId="@choice.BidId" asp-route-tab="forms" asp-fragment="offer-review-@choice.BidId" aria-current="@(currentOffer ? "page" : null)">
            <strong>@choice.Invitation.SupplierProfile.CompanyName</strong>
            <span>Offer #@choice.BidId@(currentOffer ? " · Viewing" : "")</span>
            <small class="ev-offer-review-label @(Model.MyReviewApproved(choice) ? "is-approved" : "")">@(Model.MyReviewApproved(choice) ? "Approved by you" : "Needs your review")</small>
        </a>
    }
    </div>
</nav>
@if (Model.ReviewOffer is { } offer)
{
    var accepted = AllOfferScoring.Count(Model, offer);
    <section class="ev-offer-review-section" id="offer-review-@offer.BidId" aria-labelledby="offer-review-title-@offer.BidId" tabindex="-1">
        <header class="ev-review-heading"><div><span class="ev-subtle">Offer #@offer.BidId · @CommitteeEvaluationPage.Total(offer).ToString("N2") @offer.Currency</span><h3 id="offer-review-title-@offer.BidId">@offer.Invitation.SupplierProfile.CompanyName</h3></div><span class="ev-status">@accepted / 4 approved</span></header>
        <div class="ev-forms-grid">
        @foreach (var member in Model.Members.OrderByDescending(m => m.UserId == Model.UserId).ThenBy(m => m.Position))
        {
            var review = Model.Evaluation(member, offer);
            var approved = AllOfferScoring.Accepted(Model, review);
            var mine = member.UserId == Model.UserId;
            var editable = mine && !approved && !Model.Locked && Model.WeightsReady;
            var key = $"{offer.BidId}-{member.Position}";
            <details class="ev-member-form ev-approval-card @(mine ? "is-yours" : "")" open="@mine">
                <summary class="ev-member-disclosure"><strong>@(mine ? "Your scoring form" : CommitteeEvaluationPage.MemberName(member.Position))</strong><span>@(approved ? "Review submitted" : "Pending review") <span aria-hidden="true">⌄</span></span></summary>
                <header><div class="ev-member-heading"><span class="ev-form-badge @(approved ? "is-approved" : "")">@(approved ? "✓ Approved" : "Pending")</span><span class="ev-access-label">@(mine ? "Your review" : "Read-only")</span></div><h4>@CommitteeEvaluationPage.MemberName(member.Position)</h4><p>@member.User.FullName</p></header>
                <form asp-action="ScoreOffer" method="post" class="ev-member-review" data-offer-score-form>
                    <input type="hidden" name="id" value="@Model.Tender!.TenderId" /><input type="hidden" name="bidId" value="@offer.BidId" /><input type="hidden" name="version" value="@Model.SharedVersion" />
                    <div class="ev-member-marks">
                        <label for="financial-@key">Financial <span>out of @Model.FinancialWeight.ToString("0")</span><input id="financial-@key" type="number" name="financialMark" min="0" max="@Model.FinancialWeight" step="1" inputmode="numeric" required disabled="@(!editable)" value="@(approved ? review?.FinancialMark?.ToString("0") : null)" class="form-control" /></label>
                        <label for="technical-@key">Technical <span>out of @Model.TechnicalWeight.ToString("0")</span><input id="technical-@key" type="number" name="technicalMark" min="0" max="@Model.TechnicalWeight" step="1" inputmode="numeric" required disabled="@(!editable)" value="@(approved ? review?.TechnicalMark?.ToString("0") : null)" class="form-control" /></label>
                    </div>
                    <label for="comment-@key">Comment <span>Optional · included in the report</span></label><textarea id="comment-@key" name="comment" rows="3" maxlength="4000" disabled="@(!editable)" class="form-control">@(approved ? review?.Notes : null)</textarea>
                    @if (editable) { <p class="ev-field-help">Check both marks. Submitting locks this offer’s review.</p><button class="btn ev-button-primary pharma-action-approve">Approve review</button> }
                    else { <p class="ev-field-help">@(approved ? "Review submitted · locked" : mine ? "Review unavailable" : "Awaiting this member")</p> }
                </form>
            </details>
        }
        </div>
    </section>
}
