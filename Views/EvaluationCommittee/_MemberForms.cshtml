@model CommitteeEvaluationPage
@using System.Globalization
<div class="cs-section-heading"><div><h3>Review every offer</h3><p>Each of the four members must enter both marks for every offer. Accepted marks cannot be edited.</p></div></div>
@if (!Model.ConsensusLocked && Model.UsesScoredWorkflow) { <p class="cs-notice">Scoring opens after all four members confirm their percentages above.</p> }
@if (Model.ConsensusLocked && !Model.WeightsReady) { <p class="cs-notice is-error">Scoring needs eligible offers in one currency and valid criteria totalling 100%. Ask the sourcing officer to review the offers and configuration.</p> }
@if (!Model.UsesScoredWorkflow) { <p class="cs-notice">This historical evaluation uses its original approval record. See Scores &amp; report.</p> }
@if (Model.UsesScoredWorkflow)
{
@foreach (var offer in Model.Offers)
{
    var acceptedCount = Model.AcceptedCount(offer);
    <section class="cs-panel cs-score-offer" aria-labelledby="score-offer-@offer.BidId">
        <header class="cs-score-offer-heading"><div><span class="cs-reference">Offer #@offer.BidId</span><h3 id="score-offer-@offer.BidId">@offer.Invitation.SupplierProfile.CompanyName</h3><p>@CommitteeEvaluationPage.Total(offer).ToString("N2") @offer.Currency · @offer.DeliveryDays-day delivery</p></div><div class="cs-acceptance"><strong>@acceptedCount / 4 accepted</strong><div class="cs-acceptance-dots" aria-hidden="true">@foreach (var member in Model.Members) { <span class="@(Model.IsAccepted(Model.Evaluation(member, offer)) ? "is-complete" : "")"></span> }</div></div></header>
        <div class="cs-review-grid">
        @foreach (var member in Model.Members)
        {
            var entry = Model.Evaluation(member, offer);
            var accepted = Model.IsAccepted(entry);
            var mine = member.UserId == Model.UserId;
            <article class="cs-review @(mine ? "is-yours" : "")"><header><div><h4>@CommitteeEvaluationPage.MemberName(member.Position)</h4><p>@member.User.FullName</p></div><span class="cs-pill @(accepted ? "is-success" : "")">@(accepted ? "Accepted" : mine ? "Your review" : "Pending")</span></header>
            @if (mine && !accepted && Model.ConsensusLocked && !Model.Locked)
            {
                <form asp-action="AcceptScoredOffer" method="post" data-score-form>
                    <input type="hidden" name="id" value="@Model.Tender!.TenderId" /><input type="hidden" name="bidId" value="@offer.BidId" /><input type="hidden" name="version" value="@Model.SharedVersion" />
                    <div class="cs-mark-fields"><label for="financial-@offer.BidId">Financial <span>/ @Model.FinancialWeight.ToString("0.##")</span><input id="financial-@offer.BidId" name="financialMark" type="number" inputmode="decimal" min="0" max="@Model.FinancialWeight.ToString(CultureInfo.InvariantCulture)" step="0.01" required value="@entry?.FinancialMark?.ToString(CultureInfo.InvariantCulture)" /></label><label for="technical-@offer.BidId">Technical <span>/ @Model.TechnicalWeight.ToString("0.##")</span><input id="technical-@offer.BidId" name="technicalMark" type="number" inputmode="decimal" min="0" max="@Model.TechnicalWeight.ToString(CultureInfo.InvariantCulture)" step="0.01" required value="@entry?.TechnicalMark?.ToString(CultureInfo.InvariantCulture)" /></label></div>
                    <label for="notes-@offer.BidId">Review note <span class="cs-help">Optional</span></label><textarea id="notes-@offer.BidId" name="notes" rows="2" maxlength="4000">@entry?.Notes</textarea>
                    <div class="cs-review-footer"><output data-mark-total aria-live="polite">Total: — / 100</output><button class="cs-button is-primary">Accept marks<span class="visually-hidden"> for @offer.Invitation.SupplierProfile.CompanyName</span></button></div><p class="cs-help">Accepting locks both marks for this offer.</p>
                </form>
            }
            else
            {
                <dl class="cs-marks"><div><dt>Financial / @Model.FinancialWeight.ToString("0.##")</dt><dd>@(accepted ? entry!.FinancialMark!.Value.ToString("0.##") : "—")</dd></div><div><dt>Technical / @Model.TechnicalWeight.ToString("0.##")</dt><dd>@(accepted ? entry!.TechnicalMark!.Value.ToString("0.##") : "—")</dd></div></dl>
                <p class="cs-review-total">@(accepted ? $"{(entry!.FinancialMark + entry.TechnicalMark):0.##} / 100 · Locked" : Model.Locked ? "No scored form in this historical record" : "Awaiting member review")</p>
                @if (accepted && !string.IsNullOrWhiteSpace(entry?.Notes)) { <p class="cs-review-note">@entry.Notes</p> }
            }
            </article>
        }
        </div>
    </section>
}

}
