@model CommitteeEvaluationPage
@{ var editable = !Model.Locked && Model.Members.Any(m => m.UserId == Model.UserId); }
@if (Model.Members.Count == 0)
{ <div class="ev-empty"><p>Start the evaluation to open the shared form.</p></div> }
else
{
    <section class="ev-shared-evaluation">
        <div class="ev-weights-summary">
            <div><h3>Evaluation weights</h3><p>Same weights for all offers</p></div>
            <div class="ev-weight-value"><span>Price</span><strong>@Model.Criteria.Where(c => c.Category == "Financial").Sum(c => c.Weight).ToString("0.##")%</strong></div>
            <div class="ev-weight-value"><span>Technical</span><strong>@Model.Criteria.Where(c => c.Category == "Requirements").Sum(c => c.Weight).ToString("0.##")%</strong></div>
            @if (editable) { <button type="button" class="btn ev-button-secondary" id="edit-weights" aria-expanded="false" aria-controls="weights-editor">Edit weights</button> }
            else if (Model.Members.Any(m => m.UserId == Model.UserId))
            {
                <div class="ev-weights-locked"><button type="button" class="btn ev-button-secondary" disabled aria-describedby="weights-locked-reason">Edit weights</button><span id="weights-locked-reason">Locked after committee approval</span></div>
            }
            else { <span class="ev-access-label">Only assigned members can edit</span> }
        </div>
        @if (editable)
        {
        <form asp-action="SaveWeights" method="post" id="weights-editor" hidden>
            <input type="hidden" name="id" value="@Model.Tender!.TenderId" /><input type="hidden" name="version" value="@Model.SharedVersion" />
            <div class="ev-overall-weights">
                <label for="financial-weight">Price (%)<input id="financial-weight" name="financialWeight" type="number" min="0.01" max="99.99" step="0.01" required class="form-control" value="@Model.Criteria.Where(c => c.Category == "Financial").Sum(c => c.Weight).ToString(System.Globalization.CultureInfo.InvariantCulture)" /></label>
                <label for="requirements-weight">Technical requirements (%)<input id="requirements-weight" name="requirementsWeight" type="number" min="0.01" max="99.99" step="0.01" required class="form-control" value="@Model.Criteria.Where(c => c.Category == "Requirements").Sum(c => c.Weight).ToString(System.Globalization.CultureInfo.InvariantCulture)" /></label>
            </div>
            <div class="ev-shared-actions"><p>Changes clear previous approvals.</p><span id="weight-total" role="status">Total 100%</span><button type="button" id="cancel-weights" class="btn ev-button-secondary">Cancel</button><button type="submit" class="btn ev-button-primary">Save weights</button></div>
        </form>
        }
    </section>

    <section class="ev-shared-evaluation ev-committee-selection" aria-labelledby="selection-heading">
        <div class="ev-selection-summary"><div><h3 id="selection-heading">Committee-selected offer</h3>
        @if (Model.SelectionReady)
        {
            var selectedOffer = Model.Offers.Single(b => b.BidId == Model.Tender!.EvaluationReport!.RecommendedBidId);
            <p class="ev-selected-supplier">@selectedOffer.Invitation.SupplierProfile.CompanyName <span class="ev-subtle">· Offer #@selectedOffer.BidId</span></p>
            <p class="ev-field-help">@CommitteeEvaluationPage.Total(selectedOffer).ToString("N2") @selectedOffer.Currency · @selectedOffer.DeliveryDays-day delivery</p>
        }
        else { <p class="ev-field-help">Choose an offer from Tender &amp; offers before approving.</p> }
        </div>
        @if (editable) { <button type="button" class="btn ev-button-secondary" data-open-evaluation-tab="offers-tab">@(Model.SelectionReady ? "Change offer" : "Choose an offer") <span aria-hidden="true">↗</span></button> }
        </div>
        @if (editable && Model.SelectionReady) { <p class="ev-field-help">Your approval covers this offer and the shared percentages. Changing either clears previous approvals.</p> }
    </section>
    <div class="ev-forms-heading"><h3>Committee approvals</h3><span class="ev-approval-summary">@Model.Approvals.Count / 4 approved</span></div>
    @if (!Model.Locked && Model.Approvals.Count == 4)
    { <p class="ev-notice ev-notice-success">All four approvals are recorded. Open Comparison &amp; report to generate the final report and send it to the sourcing officer.</p> }
    <div class="ev-forms-grid">
    @foreach (var member in Model.Members.OrderBy(m => m.Position))
    {
        var mine = member.UserId == Model.UserId;
        var approved = Model.Approvals.Any(a => a.UserId == member.UserId);
        <section class="ev-member-form ev-approval-card @(mine ? "is-yours" : "")">
            <header><div class="ev-member-heading"><span class="ev-form-badge @(approved ? "is-approved" : "")">@(approved ? "✓ Approved" : "Pending")</span><span class="ev-access-label">@(mine ? "Your approval" : "Read-only")</span></div><h3>@CommitteeEvaluationPage.MemberName(member.Position)</h3><p>@member.User.FullName @(mine ? "(you)" : "")</p></header>
            <div class="ev-approval-footer">
            @if (mine && !approved && !Model.Locked)
            {
                <form asp-action="Approve" method="post" class="ev-approval-action"><input type="hidden" name="id" value="@Model.Tender!.TenderId" /><input type="hidden" name="version" value="@Model.SharedVersion" /><button class="btn ev-button-primary" disabled="@(!Model.WeightsReady || !Model.SelectionReady)">Approve selected offer</button></form>
            }
            else { <span class="ev-approval-readonly">@(mine && approved ? "Your approval is recorded" : "Read-only")</span> }
            </div>
        </section>
    }
    </div>


    <section class="ev-comments" aria-labelledby="committee-comments-heading">
        <h3 id="committee-comments-heading">Committee comments</h3>
        <div class="ev-comments-list">
        @{ var comments = Model.Members.Select(m => new { Member = m, Entry = Model.Evaluations.Where(e => e.CommitteeAssignmentId == m.CommitteeAssignmentId && !string.IsNullOrWhiteSpace(e.Notes)).OrderByDescending(e => e.SubmittedAt).FirstOrDefault() }).Where(c => c.Entry != null).OrderBy(c => c.Entry!.SubmittedAt).ToList(); }
        @if (comments.Count == 0) { <p class="ev-comment-empty">No comments yet.</p> }
        @foreach (var item in comments)
        {
            <article class="ev-comment"><header><strong>@item.Member.User.FullName</strong><span>@CommitteeEvaluationPage.MemberName(item.Member.Position)</span><time>@item.Entry!.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") UTC</time></header><p>@item.Entry!.Notes</p></article>
        }
        </div>
        @if (editable && Model.Offers.Count > 0)
        {
            var myComment = comments.FirstOrDefault(c => c.Member.UserId == Model.UserId)?.Entry?.Notes;
            <form asp-action="SaveComment" method="post" class="ev-comment-form"><input type="hidden" name="id" value="@Model.Tender!.TenderId" /><label for="committee-comment">Your comment <span>Visible to all committee members</span></label><textarea id="committee-comment" name="comment" class="form-control" rows="2" maxlength="4000" required placeholder="Share a note with the committee…">@myComment</textarea><button class="btn ev-button-secondary">@(myComment == null ? "Post comment" : "Update comment")</button></form>
        }
    </section>

}
