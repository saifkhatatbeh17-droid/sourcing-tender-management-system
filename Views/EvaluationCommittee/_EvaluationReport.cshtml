@model CommitteeEvaluationPage
@{ var report = Model.Tender?.EvaluationReport; }
@if (!string.IsNullOrWhiteSpace(report?.OfficerSummary)) { <p class="ev-notice" role="status">Officer review: @report.OfficerSummary</p> }
@if (TempData["AiError"] is string aiError) { <p class="ev-notice ev-notice-error" role="alert">@aiError</p> }
<div class="ev-section-heading"><div><h3>The committee's recommendation</h3><p>Review the overall evaluation weights and the report sent to the sourcing officer.</p></div><span class="ev-status">@Model.Approvals.Count of 4 approved</span></div>
<div class="ev-report-grid"><section class="ev-report-body"><h3>Combined report</h3><p class="ev-field-help">The AI drafts the report using the agreed committee weights. Review it before approval; regenerating clears previous approvals.</p>
@if (!Model.Locked && Model.Members.Any(m => m.UserId == Model.UserId))
{
    <form asp-action="RecommendBids" method="post" data-ai-report>
        <input type="hidden" name="id" value="@Model.Tender!.TenderId" />
        <input type="hidden" name="writeReport" value="true" />
        <input type="hidden" name="financialWeight" value="@Model.Criteria.Where(c => c.Category == "Financial").Sum(c => c.Weight).ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <input type="hidden" name="requirementsWeight" value="@Model.Criteria.Where(c => c.Category == "Requirements").Sum(c => c.Weight).ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <button class="btn ev-button-primary" disabled="@(!Model.WeightsReady)">@(Model.ReportReady ? "Regenerate AI report" : "Generate AI report")</button><span role="status" hidden>Writing report…</span>
    </form>
}
<dl class="ev-report-summary"><dt>Recommended offer</dt><dd>@(Model.Offers.FirstOrDefault(b => b.BidId == report?.RecommendedBidId)?.Invitation.SupplierProfile.CompanyName ?? "No offer recommended yet")</dd><dt>Committee report</dt><dd class="ev-report-text">@(report?.CommitteeSummary ?? "Generate the AI report, then review it with the committee before approving.")</dd></dl>
</section><aside class="ev-report-approvals"><h3>Approval record</h3><p>Four independent member approvals are required.</p>
@foreach (var member in Model.Members)
{
    var approved = Model.Approvals.Any(a => a.UserId == member.UserId);
    <div><span class="ev-check @(approved ? "ev-is-complete" : "")" aria-hidden="true">@(approved ? "✓" : member.Position.ToString())</span><span><strong>@CommitteeEvaluationPage.MemberName(member.Position)</strong><small>@(approved ? "Approved" : "Awaiting approval")</small></span></div>
}
@if (Model.Locked) { <p class="ev-notice ev-notice-success">Evaluation complete. Current tender status: @Model.Tender!.Status.</p> }
</aside></div>
