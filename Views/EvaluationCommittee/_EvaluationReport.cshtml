@model CommitteeEvaluationPage
@{ var report = Model.Tender?.EvaluationReport; var ranking = Model.Rank(); var leaders = Model.Leaders; }
<section class="cs-panel cs-result" aria-labelledby="result-heading">
    <div class="cs-section-heading"><div><h3 id="result-heading">Committee result</h3><p>Each offer’s score is the average of four accepted financial and technical reviews.</p></div></div>
    @if (Model.UsesScoredWorkflow && !Model.AllOffersAccepted)
    { <div class="cs-empty"><h4>Every review counts</h4><p>The result unlocks when every offer has four accepted forms. No offer can progress early.</p><button class="cs-button" type="button" data-open-evaluation-tab="forms-tab">Continue reviewing offers</button></div> }
    @if (ranking.Count > 0)
    {
        <div class="cs-table-scroll"><table class="cs-ranking"><caption class="visually-hidden">Average committee marks for every reviewed offer</caption><thead><tr><th>Offer</th><th>Financial / @Model.FinancialWeight.ToString("0.##")</th><th>Technical / @Model.TechnicalWeight.ToString("0.##")</th><th>Total / 100</th><th>Result</th></tr></thead><tbody>
        @foreach (var row in ranking)
        { <tr class="@(Model.ScoredWinnerId == row.BidId ? "is-winner" : "")"><th scope="row"><span>#@row.BidId</span> @row.Supplier</th><td>@row.Financial.ToString("0.####")</td><td>@row.Requirements.ToString("0.####")</td><td><strong>@row.Score.ToString("0.####")</strong></td><td>@(Model.ScoredWinnerId == row.BidId ? "Selected" : leaders.Count > 1 && leaders.Any(r => r.BidId == row.BidId) ? "Tied highest" : "Reviewed")</td></tr> }
        </tbody></table></div>
    }
    @if (Model.HasTie && !Model.ScoredWinnerId.HasValue)
    {
        <div class="cs-notice"><strong>The highest score is tied.</strong><p>Progression is paused. The four members must explicitly agree on the same tied offer. Original marks remain locked.</p></div>
        <div class="cs-tie-status">@foreach (var leader in leaders) { <p><strong>@leader.Supplier</strong> <span>@Model.Tender!.CommitteeTieVotes.Count(v => v.BidId == leader.BidId && Model.Members.Any(m => m.CommitteeAssignmentId == v.CommitteeAssignmentId)) / 4 agree</span></p> }</div>
        @if (!Model.Locked && Model.Members.Any(m => m.UserId == Model.UserId))
        {
            var mine = Model.Members.Single(m => m.UserId == Model.UserId);
            var previous = Model.Tender!.CommitteeTieVotes.SingleOrDefault(v => v.CommitteeAssignmentId == mine.CommitteeAssignmentId);
            <form asp-action="DecideTie" method="post" class="cs-tie-form"><input type="hidden" name="id" value="@Model.Tender.TenderId" /><input type="hidden" name="version" value="@Model.SharedVersion" /><label for="tie-choice">Your committee tie decision<select id="tie-choice" name="bidId" required><option value="">Choose a tied offer</option>@foreach (var leader in leaders) { <option value="@leader.BidId" selected="@(previous?.BidId == leader.BidId)">#@leader.BidId — @leader.Supplier</option> }</select></label><button class="cs-button is-primary">Confirm tie decision</button><p class="cs-help">You may change this tie decision until all four members agree. Accepted marks cannot change.</p></form>
        }
    }
    @if (Model.ScoredWinnerId.HasValue)
    { <p class="cs-notice is-success" role="status">The selected offer and committee score report have progressed to sourcing officer review.</p> }
    @if (!string.IsNullOrWhiteSpace(report?.CommitteeSummary) && (!Model.UsesScoredWorkflow || Model.ScoredWinnerId.HasValue))
    { <div class="cs-section-heading"><h3>Committee report</h3><a class="cs-button" asp-action="EvaluationReportPdf" asp-route-id="@Model.Tender!.TenderId">Download PDF</a></div><div class="cs-report-text">@report.CommitteeSummary</div> }
    @if (!string.IsNullOrWhiteSpace(report?.OfficerSummary)) { <div class="cs-notice"><strong>Officer review</strong><p>@report.OfficerSummary</p></div> }
    @if (!Model.UsesScoredWorkflow)
    { <h3>Original approval record</h3>@foreach (var approval in Model.Approvals) { <p class="cs-help">@Model.Members.FirstOrDefault(m => m.UserId == approval.UserId)?.User.FullName — @approval.Decision · @approval.DecidedAt.ToString("dd MMM yyyy HH:mm") UTC</p> } }
</section>
