@model CommitteeEvaluationPage
@{ var result = Model.AiRecommendation; var scenario = result?.Scenarios.FirstOrDefault(); }
    @if (scenario != null)
    {
        <div class="collapse ev-ai-tradeoffs" id="offer-comparison"><div class="ev-ai-tradeoff-grid">
        @foreach (var comparison in result!.Comparisons)
        {
            var offer = Model.Offers.Single(b => b.BidId == comparison.BidId);
            <article><header><span>Offer #@offer.BidId</span><h4>@offer.Invitation.SupplierProfile.CompanyName</h4></header><div><h5>Strengths</h5><p>@comparison.Strengths</p></div><div><h5>Tradeoffs</h5><p>@comparison.Tradeoffs</p></div></article>
        }
        </div>
        @if (result!.MissingInformation.Length > 0) { <div class="ev-ai-missing"><h4>Information to verify</h4><ul>@foreach (var item in result.MissingInformation) { <li>@item</li> }</ul></div> }
        </div>
    }
