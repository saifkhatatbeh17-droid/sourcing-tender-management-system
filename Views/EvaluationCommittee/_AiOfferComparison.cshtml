@model CommitteeEvaluationPage
@* Per-offer advantages and disadvantages are shown inside each offer card. This partial keeps only the
   AI "information to verify" list, which has no other place on the page. *@
@if (Model.AiRecommendation is { Scenarios.Length: > 0, MissingInformation.Length: > 0 } result)
{
    <div class="ev-ai-tradeoffs" id="offer-comparison">
        <div class="ev-ai-missing">
            <h4>Information to verify</h4>
            <ul>@foreach (var item in result.MissingInformation) { <li>@item</li> }</ul>
        </div>
    </div>
}
