@model CommitteeEvaluationPage
@using System.Globalization
<section class="cs-panel cs-consensus" aria-labelledby="consensus-heading">
    <div class="cs-section-heading"><div><h3 id="consensus-heading">@(Model.ConsensusLocked ? "Committee percentages are locked" : "Confirm the committee percentages")</h3><p id="consensus-lock-reason">@(Model.ConsensusLocked ? "The average of four confirmed proposals applies to every offer and the AI comparison. Nobody can edit the calculated percentage." : "Each member confirms a financial percentage; technical is the remainder. After all four confirmations, the average is calculated once and locked. The committee can then choose an offer and use the original approval forms.")</p></div><span class="cs-pill @(Model.ConsensusLocked ? "is-success" : "")">@Model.WeightProposals.Count / 4 confirmed</span></div>
    @if (Model.Members.Count == 0 && !Model.Locked)
    { <form asp-action="Start" method="post"><input type="hidden" name="id" value="@Model.Tender!.TenderId" /><button class="cs-button is-primary">Start committee evaluation</button></form> }
    @if (Model.ConsensusLocked)
    { <div class="cs-locked-split"><div><span>Financial weight</span><strong>@Model.FinancialWeight.ToString("0.##")<small> / 100</small></strong></div><div><span>Technical weight</span><strong>@Model.TechnicalWeight.ToString("0.##")<small> / 100</small></strong></div><p>Locked @Model.Tender!.CommitteeWeightsLockedAt?.ToString("dd MMM yyyy HH:mm") UTC<br />These percentages apply to the AI comparison and committee approval.</p></div> }
    @if (Model.ConsensusLocked)
    { <details class="cs-proposal-details"><summary>View the four confirmed proposals</summary><partial name="_PercentageProposals" model="Model" /></details> }
    else { <partial name="_PercentageProposals" model="Model" /> }
</section>
