@model CommitteeEvaluationPage
@{
    ViewData["Title"] = "Committee dashboard";
    var active = Model.Tenders.Where(t => t.Status == "UnderEvaluation").ToList();
    var pending = active.Where(t => t.CommitteeAssignments.Any(m => m.CommitteeType == "Evaluation" && m.UserId == Model.UserId)
        && !t.TenderApprovals.Any(a => a.Stage == "Evaluation" && a.UserId == Model.UserId && a.Decision == "Approved")).ToList();
    var next = pending.FirstOrDefault() ?? active.FirstOrDefault();
}
@section Styles { <partial name="_CommitteePageStyles" /> }
<div class="evaluation-page committee-workspace unified-dashboard">
    <header class="cw-page-header"><div><p class="cw-eyebrow">Evaluation committee</p><h1>Committee dashboard</h1><p>Your tenders, shared evaluations, and next actions.</p></div><a class="cw-button cw-button-primary" asp-action="Evaluations" asp-route-id="@next?.TenderId">Open evaluations <span aria-hidden="true">↗</span></a></header>
    <dl class="cw-metrics">
        <div class="cw-metric-primary"><dt>Under evaluation</dt><dd>@active.Count</dd><span>Open for committee review</span><svg class="cw-brand-watermark" viewBox="305 78 470 540" aria-hidden="true"><image href="@Url.Content("~/images/tiryaq-logo.png")" width="2172" height="724" /></svg></div>
        <div class="cw-metric-attention"><dt>Needs your review</dt><dd>@pending.Count</dd><span>Assigned evaluations to complete</span></div>
        <div><dt>Past evaluation</dt><dd>@(Model.Tenders.Count - active.Count)</dd><span>Follow the recorded outcome</span></div>
    </dl>
    <div class="cw-dashboard-grid">
        <section class="cw-panel cw-tenders" aria-labelledby="tenders-heading">
            <header class="cw-panel-header"><div><h2 id="tenders-heading">Your tenders</h2><p>Active evaluations appear first.</p></div><span class="cw-count">@Model.Tenders.Count</span></header>
            @if (Model.Tenders.Count == 0)
            { <div class="cw-empty"><partial name="_AdminSidebarIcon" model='@("Evaluations")' /><h3>No tenders to review yet</h3><p>Tenders appear here when eligible offers reach the evaluation committee.</p></div> }
            else
            {
                <div class="cw-tender-list">
                @foreach (var tender in Model.Tenders.OrderByDescending(t => t.Status == "UnderEvaluation"))
                {
                    var approvals = tender.TenderApprovals.Count(a => a.Stage == "Evaluation" && a.Decision == "Approved");
                    <a class="cw-tender-row" asp-action="Evaluations" asp-route-id="@tender.TenderId">
                        <span class="cw-document" aria-hidden="true"><partial name="_AdminSidebarIcon" model='@("Reports")' /></span>
                        <span class="cw-tender-name"><small>Tender #@tender.TenderId</small><strong>@tender.Title</strong></span>
                        <span class="cw-row-meta"><span class="cw-status @(tender.Status == "UnderEvaluation" ? "cw-status-active" : "")">@CommitteeEvaluationPage.StatusLabel(tender.Status)</span><small>@approvals / 4 approvals</small></span>
                        <span class="cw-row-arrow" aria-hidden="true">↗</span>
                    </a>
                }
                </div>
            }
        </section>
        <aside class="cw-dashboard-aside">
            <section class="cw-next-action"><span class="cw-aside-icon" aria-hidden="true"><partial name="_AdminSidebarIcon" model='@("Evaluations")' /></span><h2>@(next == null ? "You’re up to date" : "Continue your review")</h2>
            @if(next != null) { <p class="cw-next-title">@next.Title</p><p>Review the offers, agree on the weights, and approve the committee-selected offer.</p><a class="cw-text-link" asp-action="Evaluations" asp-route-id="@next.TenderId">Review tender <span aria-hidden="true">→</span></a> }
            else { <p>No open evaluations need your review. You can still view past reports and approvals.</p><a class="cw-text-link" asp-action="Reports">Browse reports <span aria-hidden="true">→</span></a> }
            </section>
            <section class="cw-process-note"><h2>One shared evaluation</h2><ol><li>Agree on financial and technical weights.</li><li>Choose an offer; AI advice is optional.</li><li>Each of the four members approves.</li></ol><p>After all four approvals, generate the final report and send it to the sourcing officer.</p></section>
        </aside>
    </div>
</div>
