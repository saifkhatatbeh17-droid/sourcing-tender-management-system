@model CommitteeEvaluationPage
@using System.Globalization
@{ ViewData["Title"] = "Committee evaluation"; var tender = Model.Tender; }
@section Styles {
    <link rel="stylesheet" href="~/css/committee-evaluations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/committee-evaluations-webex.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/committee-scoring.css" asp-append-version="true" />
}
<div class="evaluation-page committee-scoring">
    <input type="hidden" id="tender" value="@tender?.TenderId" />
    <header class="cs-page-heading"><div><h1>Committee evaluation</h1><p>Four independent reviews. One shared result.</p></div></header>
    @if (TempData["CommitteeError"] is string error) { <div class="cs-notice is-error" role="alert">@error</div> }
    @if (TempData["CommitteeSuccess"] is string success) { <div class="cs-notice is-success" role="status">@success</div> }
    <div class="cs-workspace">
        <partial name="_TenderBrowser" model="Model" />
        <div class="cs-main">
        @if (tender == null)
        { <section class="cs-panel cs-empty"><h2>Choose a tender</h2><p>Eligible offers appear here when the sourcing officer sends them for evaluation.</p></section> }
        else
        {
            <header class="cs-tender-heading"><div><span class="cs-reference">Tender #@tender.TenderId</span><h2>@tender.Title</h2></div><span class="cs-pill">@CommitteeEvaluationPage.StatusLabel(tender.Status)</span></header>
            @if (Model.UsesScoredWorkflow)
            {
            <ol class="cs-steps" aria-label="Evaluation progress">
                <li class="@(Model.ConsensusLocked ? "is-complete" : "is-current")"><span>1</span><div><strong>Agree percentages</strong><small>@Model.WeightProposals.Count / 4 confirmed</small></div></li>
                <li class="@(Model.AllOffersAccepted ? "is-complete" : Model.ConsensusLocked ? "is-current" : "")"><span>2</span><div><strong>Review every offer</strong><small>@Model.Offers.Count(b => Model.AcceptedCount(b) == 4) / @Model.Offers.Count complete</small></div></li>
                <li class="@(Model.ScoredWinnerId.HasValue ? "is-complete" : Model.HasTie ? "is-current" : "")"><span>3</span><div><strong>Committee result</strong><small>@(Model.HasTie && !Model.ScoredWinnerId.HasValue ? "Tie requires a decision" : Model.ScoredWinnerId.HasValue ? "Ready for officer review" : "Highest score progresses")</small></div></li>
            </ol>
            }
            @if (Model.UsesScoredWorkflow) { <partial name="_ConsensusWeights" model="Model" /> }
            else { <p class="cs-notice">Historical evaluation. Its original approvals and report are preserved.</p> }
            @if (tender.EvaluationReport?.Status == "ReturnedForReview" && Model.UsesScoredWorkflow)
            { <div class="cs-notice"><strong>Returned for review</strong><p>The percentage remains locked. Review the feedback and accept a fresh form for every offer.</p><p>@tender.EvaluationReport.OfficerSummary</p><p>@tender.EvaluationReport.ManagerSummary</p></div> }
            <nav class="nav cs-tabs" role="tablist" aria-label="Evaluation sections">
                <button class="nav-link active" id="offers-tab" data-bs-toggle="tab" data-bs-target="#offers" type="button" role="tab" aria-controls="offers" aria-selected="true">Tender &amp; offers <span>@Model.Offers.Count</span></button>
                <button class="nav-link" id="forms-tab" data-bs-toggle="tab" data-bs-target="#forms" type="button" role="tab" aria-controls="forms" aria-selected="false">Evaluation forms</button>
                <button class="nav-link" id="report-tab" data-bs-toggle="tab" data-bs-target="#report" type="button" role="tab" aria-controls="report" aria-selected="false">Scores &amp; report</button>
            </nav>
            <div class="tab-content">
                <section class="tab-pane fade show active" id="offers" role="tabpanel" aria-labelledby="offers-tab" tabindex="0">
                    <details class="cs-panel cs-brief"><summary>Purchase requirements <span>@tender.PurchaseRequest.PurchaseRequestItems.Count items</span></summary><p>@tender.Description</p>
                        @foreach (var item in tender.PurchaseRequest.PurchaseRequestItems) { <div class="cs-line-item"><strong>@item.ItemName <span>@item.Quantity.ToString("0.###") @item.Unit</span></strong><p>@item.Specifications</p></div> }
                        <p>@tender.Terms</p><small>Closing date: @tender.ClosesAt.ToString("dd MMM yyyy HH:mm") UTC</small>
                    </details>
                    <partial name="_AiBidRecommendation" model="Model" />
                    <div class="cs-section-heading"><div><h3>Eligible offers</h3><p>Review the evidence before recording your marks.</p></div><button type="button" class="cs-button" data-open-evaluation-tab="forms-tab">Open evaluation forms</button></div>
                    <div class="cs-offers">
                    @foreach (var offer in Model.Offers)
                    {
                        <article class="cs-panel cs-offer-preview"><header><span class="cs-reference">Offer #@offer.BidId</span><span class="cs-pill">@(Model.UsesScoredWorkflow ? $"{Model.AcceptedCount(offer)} / 4 accepted" : "Historical offer")</span></header><h3>@offer.Invitation.SupplierProfile.CompanyName</h3><p class="cs-price">@CommitteeEvaluationPage.Total(offer).ToString("N2") <span>@offer.Currency</span></p><p>@offer.DeliveryDays-day delivery · @(offer.PaymentTerms ?? "Payment terms not supplied")</p><p>@offer.TechnicalDetails</p>
                        <details><summary>Item breakdown</summary>@foreach (var item in offer.BidItems) { <div class="cs-line-item"><strong>@item.Quantity.ToString("0.###") × @item.UnitPrice.ToString("N2") @offer.Currency</strong><p>@item.OfferedSpecifications</p></div> }<small>Tax @offer.TaxAmount.ToString("N2") · Additional costs @offer.AdditionalCosts.ToString("N2") @offer.Currency</small></details></article>
                    }
                    </div>
                    @if (Model.Offers.Count == 0) { <div class="cs-panel cs-empty">No compliant offers are available yet.</div> }
                </section>
                <section class="tab-pane fade" id="forms" role="tabpanel" aria-labelledby="forms-tab" tabindex="0"><partial name="_MemberForms" model="Model" /></section>
                <section class="tab-pane fade" id="report" role="tabpanel" aria-labelledby="report-tab" tabindex="0"><partial name="_EvaluationReport" model="Model" /></section>
            </div>
            <details class="cs-panel cs-conversations"><summary>Questions &amp; clarifications</summary><a class="cs-button" asp-controller="Clarification" asp-action="Index" asp-route-kind="tender" asp-route-recordId="@tender.TenderId">Ask for clarification</a>@await Component.InvokeAsync("ClarificationHistory", new { kind = "tender", recordId = tender.TenderId })</details>
        }
        </div>
    </div>
</div>
@section Scripts { <script src="~/js/committee-evaluations.js" asp-append-version="true"></script> }
