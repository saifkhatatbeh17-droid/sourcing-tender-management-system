@model CommitteeEvaluationPage
@{ ViewData["Title"] = "Combined Reports"; }
<h1>Combined Reports</h1>
<p>Open a tender to review its combined report, scores, and committee approvals.</p>
@foreach (var tender in Model.Tenders)
{
    <p><a asp-action="Evaluations" asp-route-id="@tender.TenderId">@tender.Title</a> — @tender.Status</p>
}
@if (Model.Tender != null && Model.Members.Count > 0) { <h2>@Model.Tender.Title</h2><partial name="_CombinedReport" model="Model" /> }
