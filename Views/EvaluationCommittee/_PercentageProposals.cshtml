@model CommitteeEvaluationPage
@using System.Globalization
    <div class="cs-proposals">
    @foreach (var member in Model.Members)
    {
        var proposal = Model.WeightProposals.SingleOrDefault(p => p.CommitteeAssignmentId == member.CommitteeAssignmentId);
        var mine = member.UserId == Model.UserId;
        <article class="cs-proposal @(mine ? "is-yours" : "")"><header><strong>@CommitteeEvaluationPage.MemberName(member.Position)</strong>@if (mine) { <span class="cs-you">You</span> }</header><p>@member.User.FullName</p>
        @if (proposal != null)
        { <div class="cs-proposal-value"><strong>@proposal.FinancialWeight.ToString("0.##")%</strong><span>financial · @((100 - proposal.FinancialWeight).ToString("0.##"))% technical</span></div><span class="cs-confirmed">Confirmed · locked</span> }
        else if (mine && !Model.Locked)
        {
            <form asp-action="ConfirmPercentage" method="post" data-percentage-proposal>
                <input type="hidden" name="id" value="@Model.Tender!.TenderId" /><input type="hidden" name="version" value="@Model.SharedVersion" />
                <label for="proposal-financial">Your financial percentage</label><div class="cs-percent-input"><input id="proposal-financial" name="financialWeight" type="number" inputmode="decimal" min="0.01" max="99.99" step="0.01" required aria-describedby="proposal-technical proposal-lock-note" /><span>%</span></div>
                <p id="proposal-technical" role="status" data-technical-remainder>Technical: —</p><p class="cs-help" id="proposal-lock-note">Confirming locks your proposal.</p><button class="cs-button is-primary">Confirm percentage</button>
            </form>
        }
        else { <span class="cs-pending">Awaiting confirmation</span> }
        </article>
    }
    </div>
