@* Face ID — Sign in: a face sign-in page. Shown by FaceLoginController.Index(). *@
@model SourcingTenderManagement.Models.FaceVerification.FaceVerificationPage
@{ ViewData["Title"] = "Face ID — Sign in"; }
@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/face-login-modal.css" asp-append-version="true" />
}
<div class="login-page">
    <section class="login-panel" aria-labelledby="face-login-heading">
        <h1 id="face-login-heading">You're signed in</h1>
        <p class="login-intro">Password sign-in is complete. Your optional Face ID check opens in a popup.</p>
        <button type="button" class="btn btn-outline-primary w-100 mb-3" data-bs-toggle="modal" data-bs-target="#face-login-modal">Open Face ID camera</button>
        <a asp-controller="Account" asp-action="GoToDashboard" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn login-submit">Continue to workspace</a>
        <p class="login-help mb-0">Face similarity is informational. You can continue without a match; your access is determined by your existing account and role.</p>
        <noscript><p class="text-danger mt-3">JavaScript is required for the camera popup. You can still continue to your workspace.</p></noscript>
    </section>
</div>
<partial name="_FaceIdModal" model="Model" />
@section Scripts {
    @if (Model.Enrolled)
    {
        <script src="~/lib/face-api/face-api.js" asp-append-version="true" defer></script>
        <script src="~/js/face-verification.js" asp-append-version="true" defer></script>
    }
    <script src="~/js/face-login-modal.js" asp-append-version="true" defer></script>
}
