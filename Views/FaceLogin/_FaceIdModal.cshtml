@model SourcingTenderManagement.Models.FaceVerification.FaceVerificationPage
<div class="modal fade face-login-modal" id="face-login-modal" tabindex="-1" aria-labelledby="face-modal-title" aria-describedby="face-modal-description" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="face-modal-title">Face ID check</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close Face ID camera"></button>
            </div>
            <div class="modal-body">
                <p id="face-modal-description" class="text-muted small">Your password has already signed you in. This optional camera similarity check is not a secure second authentication factor.</p>
                @if (!Model.Enrolled)
                {
                    <div class="alert alert-secondary" role="status">You have no face enrollment. You can enroll your face or continue to your workspace.</div>
                    <a asp-controller="FaceEnrollment" asp-action="Index" class="btn btn-outline-primary">Go to face enrollment</a>
                }
                else
                {
                    <form id="verification-form" method="post" data-success-redirect="@Url.Action("GoToDashboard", "Account")" data-verify-url="@Url.Action("Verify", "FaceVerification")"
                          data-model-url="@Url.Content("~/lib/face-api/model")"
                          data-model-identifier="@SourcingTenderManagement.Services.FaceEnrollment.FaceEnrollmentService.ModelIdentifier">
                        @Html.AntiForgeryToken()
                        <div class="face-modal-preview">
                            <video id="verification-video" autoplay muted playsinline aria-label="Live Face ID camera preview"></video>
                        </div>
                        <p id="verification-feedback" class="small mt-3" role="status" aria-live="polite">Camera is off. Allow camera access when your browser asks.</p>
                        <label for="verification-progress" class="small">Verification progress</label>
                        <progress id="verification-progress" max="3" value="0">Not started</progress>
                        <div class="face-modal-outcome">
                            <p id="verification-result" role="status" aria-live="polite" aria-atomic="true"></p>
                            <svg class="face-modal-success" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                                <circle cx="32" cy="32" r="28" />
                                <path d="M19 33l9 9 18-20" />
                            </svg>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button id="verification-start" type="submit" class="btn btn-primary" disabled>Start camera</button>
                            <button id="verification-cancel" type="button" class="btn btn-outline-secondary" disabled>Cancel check</button>
                        </div>
                        <p class="small text-muted mt-3 mb-0">Keep only one face in view. Photos and video are not uploaded; the submitted descriptor is not stored.</p>
                    </form>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <a asp-controller="Account" asp-action="GoToDashboard" class="btn btn-primary">Continue to workspace</a>
            </div>
        </div>
    </div>
</div>
