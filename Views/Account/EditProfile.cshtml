@* Edit Profile: a account page. Shown by AccountController.EditProfile(). *@
@model EditProfileViewModel
@{ ViewData["Title"] = "Edit Profile"; }

@section Styles {
    <link rel="stylesheet" href="~/css/account-profile.css" asp-append-version="true" />
}

<div class="account-profile">
    <header class="ap-heading"><h1>Edit Profile</h1></header>
    <section class="ap-card ap-edit" aria-labelledby="profile-contact">
        <h2 id="profile-contact">Contact information</h2>
        <form asp-action="EditProfile" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" type="tel" class="form-control" maxlength="32" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="ap-actions">
                <button type="submit" class="btn btn-primary">Save Phone Number</button>
                <a asp-action="Profile" class="btn btn-outline-primary">Cancel</a>
            </div>
        </form>
    </section>
</div>
