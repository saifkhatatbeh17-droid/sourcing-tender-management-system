@model RegisterViewModel
@{
    ViewData["Title"] = "Supplier Registration";
    ViewData["HideWorkspaceSidebar"] = true;
    var hasErrors = !ViewData.ModelState.IsValid;
}

<section class="registration-page @(hasErrors ? "registration-has-errors" : "")" aria-labelledby="registration-title">
    <div class="registration-form-area">
        <a class="registration-back" asp-controller="Home" asp-action="Index"><span aria-hidden="true">←</span> Back to Tiryaq</a>
        <div class="registration-reveal">
            <div class="registration-capsule-stage" aria-hidden="true">
                <span class="registration-capsule-halo"></span>
                <span class="registration-burst">
                    <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
                </span>
                <span class="registration-capsule">
                    <span class="registration-capsule-left"><b>✚</b></span>
                    <span class="registration-capsule-right"><b>APEX PHARMA</b></span>
                </span>
            </div>
            <div class="registration-form-card">
                <header class="form-heading">
                    <span class="form-step">SUPPLIER ONBOARDING</span>
                    <h1 id="registration-title">Create your supplier profile</h1>
                    <p>Enter your company information and attach the required official documents.</p>
                </header>

                <form asp-controller="Account" asp-action="Register" method="post" enctype="multipart/form-data" class="supplier-registration-form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="registration-validation" role="alert"></div>

                    <fieldset class="registration-section">
                        <legend><span>01</span><span><strong>Company information</strong><small>Legal details used to verify your business</small></span></legend>
                        <div class="registration-fields">
                            <div class="registration-field field-wide">
                                <label asp-for="CompanyName">Company name <b>*</b></label>
                                <input asp-for="CompanyName" class="form-control" autocomplete="organization" placeholder="e.g. Acme Pharmaceutical Industries" />
                                <span asp-validation-for="CompanyName" class="field-error"></span>
                            </div>
                            <partial name="_ProcurementCategoryFields" model='((ProcurementCategoryInput)Model, "Supplier", "Supply category")' />
                            <div class="registration-field">
                                <label asp-for="RegistrationNumber">Company registration number <b>*</b></label>
                                <input asp-for="RegistrationNumber" class="form-control" placeholder="Enter registration number" />
                                <span asp-validation-for="RegistrationNumber" class="field-error"></span>
                            </div>
                            <div class="registration-field">
                                <label asp-for="TaxNumber">Tax number <b>*</b></label>
                                <input asp-for="TaxNumber" class="form-control" placeholder="Enter tax number" />
                                <span asp-validation-for="TaxNumber" class="field-error"></span>
                            </div>
                            <div class="registration-field field-wide">
                                <label asp-for="Address">Registered business address <b>*</b></label>
                                <input asp-for="Address" class="form-control" autocomplete="street-address" placeholder="Street, city, country" />
                                <span asp-validation-for="Address" class="field-error"></span>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="registration-section">
                        <legend><span>02</span><span><strong>Primary contact</strong><small>Who should we contact about your application?</small></span></legend>
                        <div class="registration-fields">
                            <div class="registration-field">
                                <label asp-for="ContactName">Contact person <b>*</b></label>
                                <input asp-for="ContactName" class="form-control" autocomplete="name" placeholder="Full name" />
                                <span asp-validation-for="ContactName" class="field-error"></span>
                            </div>
                            <div class="registration-field">
                                <label asp-for="PhoneNumber">Phone number <b>*</b></label>
                                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" placeholder="+962 7X XXX XXXX" />
                                <span asp-validation-for="PhoneNumber" class="field-error"></span>
                            </div>
                            <div class="registration-field field-wide">
                                <label asp-for="Email">Business email <b>*</b></label>
                                <input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@company.com" />
                                <span asp-validation-for="Email" class="field-error"></span>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="registration-section">
                        <legend><span>03</span><span><strong>Secure your account</strong><small>Use a password that only your team can access</small></span></legend>
                        <div class="registration-fields">
                            <div class="registration-field">
                                <label asp-for="Password">Password <b>*</b></label>
                                <div class="password-input-wrap">
                                    <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Create a password" />
                                    <button class="password-visibility-toggle" type="button" data-password-toggle="Password" aria-label="Show password" aria-pressed="false" title="Show password">
                                        <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 3 18 18M10.6 5.2A10.7 10.7 0 0 1 12 5c6.4 0 10 7 10 7a16 16 0 0 1-3.1 3.9M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7c1.3 0 2.4-.3 3.4-.7"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="field-error"></span>
                            </div>
                            <div class="registration-field">
                                <label asp-for="ConfirmPassword">Confirm password <b>*</b></label>
                                <div class="password-input-wrap">
                                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Enter it again" />
                                    <button class="password-visibility-toggle" type="button" data-password-toggle="ConfirmPassword" aria-label="Show confirmation password" aria-pressed="false" title="Show password">
                                        <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 3 18 18M10.6 5.2A10.7 10.7 0 0 1 12 5c6.4 0 10 7 10 7a16 16 0 0 1-3.1 3.9M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7c1.3 0 2.4-.3 3.4-.7"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                            </div>
                        </div>
                    </fieldset>

                    <div class="registration-field document-field">
                        <label for="officialDocuments">Official company documents <b>*</b></label>
                        <label class="document-dropzone" for="officialDocuments">
                            <input id="officialDocuments" name="officialDocuments" type="file" multiple required accept=".pdf,.docx,.jpg,.jpeg,.png" />
                            <span class="upload-icon" aria-hidden="true">↑</span>
                            <span class="upload-copy"><strong>Choose files to upload</strong><small>Company license and relevant pharmaceutical certificates</small></span>
                            <span class="upload-action">Browse files</span>
                        </label>
                        <span class="document-file-list" aria-live="polite">PDF, DOCX, JPG or PNG · Maximum 10 MB per file</span>
                        <span class="field-error">@Html.ValidationMessage("officialDocuments")</span>
                    </div>

                    <div class="registration-submit-row">
                        <span><i aria-hidden="true">♢</i> Your information is handled securely.</span>
                        <button class="btn btn-primary registration-submit" type="submit">Submit application <span aria-hidden="true">→</span></button>
                    </div>
                </form>
                <p class="registration-login-note">Already registered? <a asp-controller="Account" asp-action="Login">Sign in to your account</a></p>
            </div>
        </div>
    </div>
</section>

@section Styles { <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" /> }
@section Scripts {
    <script src="~/js/procurement-categories.js" asp-append-version="true" defer></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            // Validate each field as the supplier edits it, rather than waiting for submit.
            if (window.jQuery && jQuery.validator) {
                jQuery(() => {
                    const form = document.querySelector('.supplier-registration-form');
                    const validator = form && jQuery(form).data('validator');
                    if (!validator) return;

                    form.querySelectorAll('input:not([type="file"]), select, textarea').forEach(field => {
                        field.addEventListener('input', () => validator.element(field));
                        field.addEventListener('change', () => validator.element(field));
                        field.addEventListener('blur', () => validator.element(field));
                    });
                });
            }

            document.querySelectorAll('[data-password-toggle]').forEach(button => {
                button.addEventListener('click', () => {
                    const field = document.getElementById(button.dataset.passwordToggle);
                    if (!field) return;
                    const willShow = field.type === 'password';
                    field.type = willShow ? 'text' : 'password';
                    button.setAttribute('aria-pressed', String(willShow));
                    button.setAttribute('aria-label', willShow ? 'Hide password' : 'Show password');
                    button.title = willShow ? 'Hide password' : 'Show password';
                    field.focus({ preventScroll: true });
                });
            });
            const input = document.getElementById('officialDocuments');
            const output = document.querySelector('.document-file-list');
            if (!input || !output) return;
            const hint = 'PDF, DOCX, JPG or PNG · Maximum 10 MB per file';
            input.addEventListener('change', () => {
                const files = Array.from(input.files || []);
                output.textContent = files.length ? files.map(file => file.name).join(' · ') : hint;
                output.classList.toggle('has-files', files.length > 0);
            });
        })();
    </script>
}
