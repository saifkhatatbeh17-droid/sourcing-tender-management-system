<div class="modal fade face-login-modal face-signin-compact" id="face-signin-modal" tabindex="-1" aria-labelledby="face-signin-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="face-signin-title">Face ID</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel Face ID sign-in"></button>
            </div>
            <div class="modal-body">
                <div class="face-modal-preview" id="face-signin-preview" data-state="pending">
                    <video id="face-signin-video" autoplay muted playsinline aria-label="Live sign-in camera preview"></video>
                    <canvas id="face-signin-snapshot" hidden aria-label="Captured face preview"></canvas>
                    <canvas class="fs-mesh" id="face-signin-mesh" aria-hidden="true"></canvas>
                    <div class="fs-scan" aria-hidden="true"></div>
                    <svg class="fs-frame" viewBox="0 0 100 125" preserveAspectRatio="none" aria-hidden="true">
                        <ellipse class="fs-oval" cx="50" cy="56" rx="29" ry="38" pathLength="100" />
                        <ellipse class="fs-orbit" cx="50" cy="56" rx="33" ry="42.5" pathLength="100" />
                        <path class="fs-corner" d="M6 18V8h10M84 8h10v10M94 107v10H84M16 117H6v-10" />
                    </svg>
                    <div class="fs-hud" aria-hidden="true"><span>TQ · Bio-scan</span><span class="fs-live"><i></i><b data-fs-readout>Standby</b></span></div>
                    <div class="face-signin-result" aria-hidden="true">
                        <svg class="face-signin-check" viewBox="0 0 48 48" fill="none"><path d="m12 25 8 8 16-18" /></svg>
                        <svg class="face-signin-cross" viewBox="0 0 48 48" fill="none"><path d="m15 15 18 18m0-18L15 33" /></svg>
                    </div>
                    <p id="face-signin-feedback" role="status" aria-live="polite">Starting camera…</p>
                </div>
            </div>
        </div>
    </div>
</div>
