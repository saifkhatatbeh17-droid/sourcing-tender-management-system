@model LoginViewModel
@{ ViewData["Title"] = "Sign In"; }

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/face-login-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/face-setup.css" asp-append-version="true" />
}

<div class="login-page">
    <section class="login-panel" aria-labelledby="login-heading">
        <h1 id="login-heading">Sign in</h1>
        <p class="login-intro">Access your sourcing and tender workspace.</p>

        <form asp-controller="Account" asp-action="Login" method="post" class="login-form">
            <input name="ReturnUrl" value="@Model.ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="login-error" role="alert"></div>

            <div class="field">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" class="form-control" autocomplete="username" autocapitalize="none"
                       spellcheck="false" aria-describedby="email-error" required />
                <span asp-validation-for="Email" id="email-error" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password"
                       aria-describedby="password-error" required />
                <span asp-validation-for="Password" id="password-error" class="field-error"></span>
            </div>

            <button class="btn login-submit" type="submit">Sign in</button>
            <button id="face-login-button" class="btn btn-outline-primary w-100 mt-3" type="submit"
                    asp-controller="Account" asp-action="LoginWithFaceId" aria-describedby="face-login-help">Login with Face ID + Password</button>
            <p id="face-login-help" class="small text-muted mt-2 mb-0">Enter your email and password first. After password sign-in, you can choose an optional camera similarity check. It is not an additional authentication factor.</p>
            <p id="face-login-error" class="text-danger mt-2" role="alert" hidden></p>
            <a id="face-login-continue" asp-controller="Account" asp-action="GoToDashboard" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-secondary w-100 mt-2" hidden>Continue to workspace</a>
        </form>

        <p class="login-help">Employee accounts are provided by your administrator.</p>
        <div class="login-registration">
            <span>New supplier?</span>
            <a asp-controller="Account" asp-action="Register">Register your company</a>
        </div>
    </section>
</div>
<div id="face-login-host" data-face-api-url="@Url.Content("~/lib/face-api/face-api.js")"
     data-verification-js="@Url.Content("~/js/face-verification.js")" data-modal-js="@Url.Content("~/js/face-login-modal.js")"
     data-enrollment-js="@Url.Content("~/js/face-enrollment.js")" data-setup-js="@Url.Content("~/js/face-setup-modal.js")"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/face-login-inline.js" asp-append-version="true" defer></script>
}
