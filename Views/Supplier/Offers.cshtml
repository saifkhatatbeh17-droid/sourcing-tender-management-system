@* My offers: a Supplier page. Shown by SupplierController.Offers(). *@
@model IEnumerable<SourcingTenderManagement.Models.Entities.Bid>
@{
    ViewData["Title"] = "My offers";
    var offers = Model.ToList();
    var query = ViewBag.Query as string;
    var selectedStatus = ViewBag.Status as string;
    var hasFilters = !string.IsNullOrWhiteSpace(query) || !string.IsNullOrWhiteSpace(selectedStatus);
    var now = DateTime.UtcNow;
    string StatusLabel(string status) => status switch { "UnderReview" => "Under review", "NonCompliant" => "Non-compliant", _ => status };
}
<div class="supplier-workspace supplier-workspace--offers">
    <header class="supplier-page-heading">
        <div><h1>My offers</h1><p>Continue a draft or check the latest status of a submitted offer.</p></div>
        <a asp-action="Invitations" class="btn btn-outline-primary">Browse invitations <span aria-hidden="true">→</span></a>
    </header>


<form method="get" class="supplier-card supplier-offer-filters workspace-search-card" aria-label="Filter offers">
        <h2 class="workspace-search-title">Find an offer</h2>
        <div>
            <label for="q">Search offers</label>
            <div class="voice-search-control"><div class="input-group"><input type="search" id="q" name="q" value="@ViewBag.Query" class="form-control" placeholder="Tender title or bid reference" data-voice-search data-voice-search-mode="submit" aria-describedby="supplier-offer-voice-status"/><button type="button" class="btn btn-outline-primary" data-voice-search-button aria-label="Start voice search" aria-pressed="false" aria-describedby="supplier-offer-voice-status"><svg data-voice-icon="mic" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3m-4 0h8"/></svg><svg data-voice-icon="stop" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" hidden><rect x="6" y="6" width="12" height="12" rx="2"/></svg></button><select class="form-select form-select-sm w-auto" data-voice-search-language aria-label="Voice search language"><option value="en-US">English</option><option value="ar-JO">العربية</option></select></div><div id="supplier-offer-voice-status" class="form-text small" data-voice-search-status role="status" aria-live="polite"></div></div>
        </div>
        <div>
            <label for="status">Offer status</label>
            <select id="status" name="status" class="form-select">
                <option value="">All statuses</option>
                @foreach (var status in new[] { "Draft", "Submitted", "UnderReview", "Compliant", "NonCompliant", "Accepted", "Rejected", "Withdrawn", "Cancelled" })
                {
                    <option value="@status" selected="@(selectedStatus == status)">@StatusLabel(status)</option>
                }
            </select>
        </div>
        <div class="supplier-offer-filter-actions">
            <button type="submit" class="btn btn-primary">Apply filters</button>
            @if (hasFilters) { <a asp-action="Offers" class="btn btn-link">Clear</a> }
        </div>
    </form>


    <section class="supplier-offer-results" aria-labelledby="offers-result-title">
        <header><h2 id="offers-result-title">@(hasFilters ? "Matching offers" : "Your offers")</h2>
            <span class="supplier-count">@offers.Count @(offers.Count == 1 ? "offer" : "offers")</span></header>
        @if (offers.Count == 0)
        {
            <div class="supplier-card empty-state">
                <h3>@(hasFilters ? "No offers match these filters" : "No offers yet")</h3>
                <p>@(hasFilters ? "Try a different search or clear the filters to see all offers." : "Accept a tender invitation to prepare your first offer.")</p>
                @if (hasFilters) { <a asp-action="Offers" class="btn btn-outline-primary">Clear filters</a> }
                else { <a asp-action="Invitations" class="btn btn-primary">Browse invitations</a> }
            </div>
        }
        else
        {
            <div class="supplier-offer-card-grid">
                @foreach (var bid in offers)
                {
                    var tender = bid.Invitation.Tender;
                    var status = tender.Status == "Cancelled" ? "Cancelled" : bid.Status;
                    var canEdit = bid.Status == "Draft" && bid.Invitation.Status == "Accepted" && tender.IsAcceptingOffers(now);
                    var canRevise = bid.Invitation.Status == "Accepted" && tender.IsAcceptingOffers(now) &&
                        tender.OfferExtensions.Count > 0 && bid.Status is "NonCompliant" or "Withdrawn";
                    <article class="supplier-card supplier-offer-record">
                        <div class="supplier-offer-record-heading">
                            <div>
                                <p class="supplier-reference">Offer #@bid.BidId · Tender #@tender.TenderId</p>
                                <h3><a asp-action="Offer" asp-route-id="@bid.BidId" data-offer-details>@tender.Title</a></h3>
                            </div>
                            <span class="status-badge status-@status.ToLowerInvariant()">@StatusLabel(status)</span>
                        </div>
                        <dl class="supplier-offer-facts">
                            <div><dt>Total amount</dt><dd>@CommitteeEvaluationPage.Total(bid).ToString("N2") @(bid.Currency == "JOD" ? "JD" : bid.Currency)</dd></div>
                            <div><dt>Submitted</dt><dd>@(bid.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "Not submitted")</dd></div>
                            <div><dt>Deadline (UTC)</dt><dd>@tender.ClosesAt.ToString("dd MMM yyyy, HH:mm")</dd></div>
                            <div><dt>Tender stage</dt><dd>@CommitteeEvaluationPage.StatusLabel(tender.Status)</dd></div>
                        </dl>
                        <footer class="supplier-offer-record-actions">
                            @if (canEdit || canRevise)
                            {
                                <a asp-action="Offer" asp-route-id="@bid.BidId" data-offer-details class="btn btn-outline-primary">View details</a>
                                <a asp-action="CreateOffer" asp-route-invitationId="@bid.InvitationId" asp-route-bidId="@bid.BidId" class="btn btn-primary">@(canRevise ? "Revise offer" : "Edit draft") <span aria-hidden="true">→</span></a>
                            }
                            else
                            {
                                <a asp-action="Offer" asp-route-id="@bid.BidId" data-offer-details class="btn btn-primary">View details <span aria-hidden="true">→</span></a>
                            }
                        </footer>
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Styles { <link rel="stylesheet" href="~/css/supplier.css" asp-append-version="true" /> }

<dialog class="supplier-offer-dialog" data-offer-dialog aria-labelledby="supplier-dialog-title"><header><h2 id="supplier-dialog-title">Offer details</h2><button type="button" class="btn btn-outline-secondary" data-offer-dialog-close aria-label="Close offer details">Close</button></header><p data-dialog-status role="status"></p><div data-dialog-content></div></dialog>
@section Scripts { <script src="~/js/supplier-workspace.js" asp-append-version="true" defer></script> }
