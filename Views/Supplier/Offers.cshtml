@model IEnumerable<SourcingTenderManagement.Models.Entities.Bid>
@{ ViewData["Title"] = "My offers"; }
<div class="supplier-page-heading"><div><p class="eyebrow">YOUR COMMERCIAL SUBMISSIONS</p><h1>My offers</h1><p>View your drafts, submitted offers, and tender outcomes.</p></div></div>
<form method="get" class="supplier-filters"><label for="q">Search</label><input id="q" name="q" value="@ViewBag.Query" class="form-control" placeholder="Tender title or bid reference"/><label for="status">Status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option>@foreach (var s in new[] { "Draft", "Submitted", "UnderReview", "Compliant", "NonCompliant", "Accepted", "Rejected", "Withdrawn" }) { <option value="@s" selected="@(ViewBag.Status as string == s)">@s</option> }</select><button class="btn btn-outline-primary">Apply</button></form>
<section class="supplier-card">@if (!Model.Any()) { <div class="empty-state"><span class="empty-mark">↗</span><h2>No offers found</h2><p>Accept a tender invitation to create an offer. Drafts and submissions will appear here.</p><a asp-action="Invitations" class="btn btn-primary">Browse invitations</a></div> } else { <div class="table-responsive"><table class="table supplier-table align-middle"><thead><tr><th>Bid reference</th><th>Tender</th><th>Submission date</th><th>Total amount</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var bid in Model) { var tender = bid.Invitation.Tender; var total = bid.BidItems.Sum(i => i.Quantity * i.UnitPrice); <tr><td><strong>BID-@bid.BidId.ToString("D6")</strong></td><td>@tender.Title<small class="d-block text-muted">TND-@tender.TenderId.ToString("D6")</small></td><td>@(bid.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "Draft")</td><td><strong>@total.ToString("N2") @bid.Currency</strong></td><td><span class="status-badge status-@bid.Status.ToLowerInvariant()">@bid.Status</span></td><td><div class="d-flex gap-2"><a asp-action="Offer" asp-route-id="@bid.BidId" class="btn btn-sm btn-outline-primary">Details</a>@if (bid.Status == "Draft") { <a asp-action="CreateOffer" asp-route-invitationId="@bid.InvitationId" asp-route-bidId="@bid.BidId" class="btn btn-sm btn-primary">Edit draft</a> }</div></td></tr> }</tbody></table></div> }</section>

@section Styles { <link rel="stylesheet" href="~/css/supplier.css" asp-append-version="true" /> }
