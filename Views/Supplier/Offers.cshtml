@model IEnumerable<SourcingTenderManagement.Models.Entities.Bid>
@{ ViewData["Title"] = "My offers"; }
<div class="supplier-workspace supplier-workspace--offers">
<div class="supplier-page-heading"><div><h1>My offers</h1><p>View your drafts, submitted offers, and tender outcomes.</p></div></div>
<form method="get" class="supplier-filters"><label for="q">Search</label><div class="voice-search-control"><div class="input-group"><input id="q" name="q" value="@ViewBag.Query" class="form-control" placeholder="Tender title or bid reference" data-voice-search data-voice-search-mode="submit" aria-describedby="supplier-offer-voice-status"/><select class="form-select form-select-sm w-auto" data-voice-search-language aria-label="Voice search language"><option value="en-US">English</option><option value="ar-JO">العربية</option></select><button type="button" class="btn btn-outline-primary" data-voice-search-button aria-label="Start voice search" aria-pressed="false" aria-describedby="supplier-offer-voice-status"><svg data-voice-icon="mic" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3m-4 0h8"/></svg><svg data-voice-icon="stop" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" hidden><rect x="6" y="6" width="12" height="12" rx="2"/></svg></button></div><div id="supplier-offer-voice-status" class="form-text small" data-voice-search-status role="status" aria-live="polite"></div></div><label for="status">Status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option>@foreach (var s in new[] { "Draft", "Submitted", "UnderReview", "Compliant", "NonCompliant", "Accepted", "Rejected", "Withdrawn" }) { <option value="@s" selected="@(ViewBag.Status as string == s)">@s</option> }</select><button class="btn btn-outline-primary">Apply</button></form>
<section class="supplier-card">@if (!Model.Any()) { <div class="empty-state"><span class="empty-mark">↗</span><h2>No offers found</h2><p>Accept a tender invitation to create an offer. Drafts and submissions will appear here.</p><a asp-action="Invitations" class="btn btn-primary">Browse invitations</a></div> } else { <div class="table-responsive"><table class="table supplier-table align-middle"><thead><tr><th>Bid reference</th><th>Tender</th><th>Submission date</th><th>Total amount</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var bid in Model) { var tender = bid.Invitation.Tender; var total = CommitteeEvaluationPage.Total(bid); <tr><td><strong>BID-@bid.BidId.ToString("D6")</strong></td><td>@tender.Title<small class="d-block text-muted">TND-@tender.TenderId.ToString("D6")</small></td><td>@(bid.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "Draft")</td><td><strong>@total.ToString("N2") @bid.Currency</strong></td><td><span class="status-badge status-@bid.Status.ToLowerInvariant()">@bid.Status</span></td><td><div class="d-flex gap-2"><a asp-action="Offer" asp-route-id="@bid.BidId" class="btn btn-sm btn-outline-primary">Details</a>@if (bid.Status == "Draft" && bid.Invitation.Status == "Accepted" && tender.ClosesAt > DateTime.UtcNow && tender.Status is ("Open" or "Published")) { <a asp-action="CreateOffer" asp-route-invitationId="@bid.InvitationId" asp-route-bidId="@bid.BidId" class="btn btn-sm btn-primary">Edit draft</a> }</div></td></tr> }</tbody></table></div> }</section>

@section Styles { <link rel="stylesheet" href="~/css/supplier.css" asp-append-version="true" /> }

</div>
