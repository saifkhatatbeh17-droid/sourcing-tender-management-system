@model SourcingTenderManagement.Models.OfferFormViewModel
@{ ViewData["Title"] = Model.BidId.HasValue ? "Continue offer draft" : "Prepare offer"; }
<div class="supplier-workspace supplier-workspace--createoffer">
<nav class="supplier-offer-back" aria-label="Offer navigation"><a asp-action="Invitation" asp-route-id="@Model.InvitationId">← Back to tender</a></nav>
<p class="eyebrow">TENDER OFFER · TND-@Model.TenderId.ToString("D6")</p><div class="supplier-page-heading"><div><h1>@(ViewData["IsOfferRevision"] is true ? "Revise your offer" : Model.BidId.HasValue ? "Continue your draft" : "Prepare an offer")</h1><p>@Model.TenderTitle · Tender deadline @Model.ClosesAt.ToString("dd MMM yyyy, HH:mm") UTC</p></div></div>
<div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1" data-supplier-errors></div>
<form asp-action="SaveOffer" method="post" enctype="multipart/form-data" class="supplier-form" data-offer-form><input type="hidden" asp-for="InvitationId"/><input type="hidden" asp-for="TenderId"/><input type="hidden" asp-for="BidId"/><input type="hidden" asp-for="TenderTitle"/><input type="hidden" asp-for="ClosesAt"/>
<nav class="supplier-offer-steps" aria-label="Offer preparation" data-offer-steps hidden><ol><li aria-current="step">1. Items and prices</li><li>2. Terms and documents</li><li>3. Review and submit</li></ol><p data-step-status role="status">Step 1 of 3</p></nav>
<section class="supplier-card" data-offer-step="0"><div class="supplier-card-heading"><div><h2>Itemized offer</h2><p>Enter your offered quantity, unit price, and technical response for each requested item.</p></div></div>
<div class="supplier-item-editor">@for (var i = 0; i < Model.Items.Count; i++) {
<article class="supplier-price-item" aria-labelledby="item-title-@i">
<header><span class="supplier-reference">Item @(i + 1) of @Model.Items.Count</span><h3 id="item-title-@i">@Model.Items[i].ItemName</h3></header>
<div class="supplier-requested"><strong>Requested: @Model.Items[i].RequestedQuantity.ToString("N3") @Model.Items[i].Unit</strong><p>@Model.Items[i].RequestedSpecifications</p>@if (Model.Items[i].RequestedLegalWarrantyMonths is int warrantyMonths) { <p><strong>Legal warranty required:</strong> at least @warrantyMonths month@(warrantyMonths == 1 ? "" : "s"). Attach it under Warranties &amp; guarantees.</p> }</div>
<input type="hidden" asp-for="Items[i].PurchaseRequestItemId"/><input type="hidden" asp-for="Items[i].ItemName"/><input type="hidden" asp-for="Items[i].Unit"/><input type="hidden" asp-for="Items[i].RequestedQuantity"/><input type="hidden" asp-for="Items[i].RequestedSpecifications"/>
<div class="supplier-price-fields"><div><label class="form-label" asp-for="Items[i].Quantity">Your quantity (@Model.Items[i].Unit)</label><input type="number" inputmode="decimal" class="form-control line-quantity" asp-for="Items[i].Quantity" required min="0.001" step="0.001" aria-describedby="quantity-error-@i"/><span id="quantity-error-@i" asp-validation-for="Items[i].Quantity" class="text-danger"></span></div>
<div><label class="form-label" asp-for="Items[i].UnitPrice">Price per @Model.Items[i].Unit</label><input type="number" inputmode="decimal" class="form-control line-price" asp-for="Items[i].UnitPrice" required min="0" step="0.01" aria-describedby="price-error-@i"/><span id="price-error-@i" asp-validation-for="Items[i].UnitPrice" class="text-danger"></span></div><div class="supplier-line-result"><span>Line total</span><strong class="line-total">—</strong><small data-line-currency>@(Model.Currency == "JOD" ? "JD" : Model.Currency)</small></div></div>
<label class="form-label" asp-for="Items[i].Specifications">Your technical response</label><textarea class="form-control" asp-for="Items[i].Specifications" rows="3" required maxlength="4000" placeholder="Describe the product you are offering and how it meets the requested specifications" aria-describedby="spec-error-@i"></textarea><span id="spec-error-@i" asp-validation-for="Items[i].Specifications" class="text-danger"></span>
<div class="supplier-product-photo" data-product-photo>
    <label class="form-label" asp-for="Items[i].ProductPhoto">Product photo (optional)</label>
    <input asp-for="Items[i].ProductPhoto" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" data-product-photo-input aria-describedby="photo-help-@i" />
    <small class="form-text" id="photo-help-@i">Upload a clear photo of this product. JPG, PNG or WebP, up to 5 MB. A new photo replaces the saved one.</small>
    <span asp-validation-for="Items[i].ProductPhoto" class="text-danger"></span>
    <img data-product-photo-preview src="@(Model.Items[i].ProductPhotoDocumentId.HasValue ? "/OfferProductPhotos/" + Model.Items[i].ProductPhotoDocumentId : null)" hidden="@(!Model.Items[i].ProductPhotoDocumentId.HasValue)" alt="Product photo for @Model.Items[i].ItemName" width="180" height="140" style="object-fit:contain;display:block;margin-top:.6rem;border-radius:12px;background:white;border:1px solid #ccdadd" />
    <small class="form-text" data-product-photo-status aria-live="polite">@(Model.Items[i].ProductPhotoDocumentId.HasValue ? "Saved product photo. Kept unless you upload a replacement." : "")</small>
</div>
</article> }</div>
<div class="offer-total">Total offer including tax &amp; extra costs <strong id="offer-total">0.00</strong> <span id="offer-currency">@(Model.Currency == "JOD" ? "JD" : Model.Currency)</span><small>Totals are recalculated and validated by the server.</small></div></section>
<section class="supplier-card mt-3" data-offer-step="1"><h2>Delivery and payment</h2><p class="text-secondary">Use the same currency for every item. Enter a positive price for each item before submitting.</p><div class="form-grid"><div><label asp-for="Currency" class="form-label">Currency</label><select asp-for="Currency" class="form-select"><option value="JOD">JD — Jordanian dinar</option><option value="USD">USD — US dollar</option><option value="EUR">EUR — Euro</option>@if (Model.Currency is not ("JOD" or "USD" or "EUR")) { <option value="@Model.Currency">@Model.Currency</option> }</select><span asp-validation-for="Currency" class="text-danger"></span></div><div><label asp-for="DeliveryDays" class="form-label">Delivery time (days)</label><input asp-for="DeliveryDays" class="form-control" min="0" required/><span asp-validation-for="DeliveryDays" class="text-danger"></span></div><div><span class="form-label d-block" id="offer-tax-label">Sales tax</span><p class="form-control-plaintext mb-0" aria-labelledby="offer-tax-label"><strong>@SourcingTenderManagement.Models.OfferTax.RatePercent.ToString("0.##")%</strong> of the item subtotal (fixed)</p><input type="hidden" id="TaxPercentage" name="TaxPercentage" value="@SourcingTenderManagement.Models.OfferTax.RatePercent.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></div><div><label asp-for="AdditionalCosts" class="form-label">Extra costs</label><input asp-for="AdditionalCosts" type="number" inputmode="decimal" min="0" step="0.01" class="form-control" aria-describedby="offer-cost-help" required/><span asp-validation-for="AdditionalCosts" class="text-danger"></span></div><p id="offer-cost-help" class="form-span form-text">Sales tax is applied automatically at 16% of the item subtotal and does not include extra costs. Enter delivery or other extra charges as an amount. Use 0 when none apply.</p><div class="form-span"><label asp-for="PaymentTerms" class="form-label">Payment terms</label><textarea asp-for="PaymentTerms" class="form-control" rows="2" maxlength="1000"></textarea><span asp-validation-for="PaymentTerms" class="text-danger"></span></div><div class="form-span"><label asp-for="TechnicalDetails" class="form-label">Technical notes</label><textarea asp-for="TechnicalDetails" class="form-control" rows="4" maxlength="4000" placeholder="Product compliance, storage conditions, certificates, or other relevant details"></textarea><span asp-validation-for="TechnicalDetails" class="text-danger"></span></div><div class="form-span"><label for="documents" class="form-label">Supporting documents</label><input id="documents" name="documents" type="file" multiple class="form-control" accept=".pdf,.docx,.xlsx,.jpg,.jpeg,.png" aria-describedby="documents-help"/><small class="form-text" id="documents-help">PDF, DOCX, XLSX, JPG, or PNG; up to 10 MB per file. Files already saved with your offer are retained; select new files again after a validation error.</small><p data-upload-status role="status" class="form-text"></p></div></div><partial name="_GuaranteeFields" model="Model" /></section>
<section class="supplier-card mt-3" data-offer-step="2" data-offer-review hidden><h2>Review your offer</h2><p>Check your items, tax, delivery and documents before submitting. Submission sends your offer to the Sourcing Officer.</p><div data-review-content></div><div class="offer-total">Offer total <strong data-review-total></strong></div></section>
<div class="supplier-action-bar"><a asp-action="Invitations" class="btn btn-outline-secondary">Cancel</a><div><button class="btn btn-outline-secondary" type="button" data-offer-back hidden>Back</button><button class="btn btn-primary" type="button" data-offer-next hidden>Continue</button>@if (ViewData["IsOfferRevision"] is not true) { <button class="btn btn-outline-primary" type="submit" name="submissionCommand" value="Draft">Save draft</button> }<button class="btn btn-primary" type="submit" name="submissionCommand" value="Submit" data-offer-submit>Submit offer</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/offer-guarantees.js" asp-append-version="true" defer></script><script src="~/js/supplier-workspace.js" asp-append-version="true" defer></script> }

@section Styles { <link rel="stylesheet" href="~/css/guarantees.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/supplier.css" asp-append-version="true" /> }

</div>
