@model SourcingTenderManagement.Models.OfferFormViewModel
@{ ViewData["Title"] = Model.BidId.HasValue ? "Continue offer draft" : "Prepare offer"; }
<div class="supplier-workspace supplier-workspace--createoffer">
<p class="eyebrow">TENDER OFFER · TND-@Model.TenderId.ToString("D6")</p><div class="supplier-page-heading"><div><h1>@(Model.BidId.HasValue ? "Continue your draft" : "Prepare an offer")</h1><p>@Model.TenderTitle · Tender deadline @Model.ClosesAt.ToString("dd MMM yyyy, HH:mm") UTC</p></div></div>
<div asp-validation-summary="All" class="alert alert-danger"></div>
<form asp-action="SaveOffer" method="post" enctype="multipart/form-data" class="supplier-form"><input type="hidden" asp-for="InvitationId"/><input type="hidden" asp-for="TenderId"/><input type="hidden" asp-for="BidId"/><input type="hidden" asp-for="TenderTitle"/><input type="hidden" asp-for="ClosesAt"/>
<section class="supplier-card"><div class="supplier-card-heading"><div><h2>Itemized offer</h2><p>Enter your offered quantity, unit price, and technical response for each requested item.</p></div></div>
<div class="table-responsive"><table class="table offer-table"><thead><tr><th>Requested item</th><th>Requested quantity</th><th>Your quantity</th><th>Unit price</th><th>Line total</th></tr></thead><tbody>@for (var i = 0; i < Model.Items.Count; i++) { <tr><td><strong>@Model.Items[i].ItemName</strong><small class="d-block text-muted">@Model.Items[i].RequestedSpecifications</small><input type="hidden" asp-for="Items[i].PurchaseRequestItemId"/><input type="hidden" asp-for="Items[i].ItemName"/><input type="hidden" asp-for="Items[i].Unit"/><input type="hidden" asp-for="Items[i].RequestedQuantity"/><input type="hidden" asp-for="Items[i].RequestedSpecifications"/></td><td>@Model.Items[i].RequestedQuantity.ToString("N3") @Model.Items[i].Unit</td><td><input class="form-control line-quantity" asp-for="Items[i].Quantity" min="0.001" step="0.001"/><span asp-validation-for="Items[i].Quantity" class="text-danger"></span></td><td><input class="form-control line-price" asp-for="Items[i].UnitPrice" min="0" step="0.01"/><span asp-validation-for="Items[i].UnitPrice" class="text-danger"></span></td><td class="line-total">—</td></tr><tr class="spec-row"><td colspan="5"><label asp-for="Items[i].Specifications">Technical response for @Model.Items[i].ItemName</label><textarea class="form-control" asp-for="Items[i].Specifications" rows="2"></textarea><span asp-validation-for="Items[i].Specifications" class="text-danger"></span></td></tr> }</tbody></table></div>
<div class="offer-total">Estimated offer total <strong id="offer-total">0.00</strong> <span id="offer-currency">@Model.Currency</span><small>Totals are recalculated and validated by the server.</small></div></section>
<section class="supplier-card mt-3"><h2>Commercial terms</h2><div class="form-grid"><div><label asp-for="Currency" class="form-label">Currency (3-letter code)</label><input asp-for="Currency" class="form-control" maxlength="3"/><span asp-validation-for="Currency" class="text-danger"></span></div><div><label asp-for="DeliveryDays" class="form-label">Delivery time (days)</label><input asp-for="DeliveryDays" class="form-control" min="0"/><span asp-validation-for="DeliveryDays" class="text-danger"></span></div><div class="form-span"><label asp-for="PaymentTerms" class="form-label">Payment terms</label><textarea asp-for="PaymentTerms" class="form-control" rows="2"></textarea><span asp-validation-for="PaymentTerms" class="text-danger"></span></div><div class="form-span"><label asp-for="TechnicalDetails" class="form-label">Technical notes</label><textarea asp-for="TechnicalDetails" class="form-control" rows="4" placeholder="Product compliance, storage conditions, certificates, or other relevant details"></textarea><span asp-validation-for="TechnicalDetails" class="text-danger"></span></div><div class="form-span"><label for="documents" class="form-label">Supporting documents</label><input id="documents" name="documents" type="file" multiple class="form-control" accept=".pdf,.docx,.xlsx,.jpg,.jpeg,.png"/><small class="form-text">PDF, DOCX, XLSX, JPG, or PNG; up to 10 MB per file.</small></div></div></section>
<div class="supplier-action-bar"><a asp-action="Invitations" class="btn btn-outline-secondary">Cancel</a><div><button class="btn btn-outline-primary" type="submit" name="submissionCommand" value="Draft">Save draft</button><button class="btn btn-primary" type="submit" name="submissionCommand" value="Submit">Submit offer</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script>
(() => { const rows = [...document.querySelectorAll('.offer-table tbody tr:not(.spec-row)')]; const total = document.getElementById('offer-total'); const currency = document.getElementById('Currency'); function update(){let sum=0; for(const row of rows){const q=Number(row.querySelector('.line-quantity')?.value||0),p=Number(row.querySelector('.line-price')?.value||0),v=q*p; sum+=v; row.querySelector('.line-total').textContent=new Intl.NumberFormat(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}).format(v);} total.textContent=new Intl.NumberFormat(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}).format(sum); document.getElementById('offer-currency').textContent=currency.value.toUpperCase();} document.querySelectorAll('.line-quantity,.line-price,#Currency').forEach(e=>e.addEventListener('input',update)); update(); })();
</script> }

@section Styles { <link rel="stylesheet" href="~/css/supplier.css" asp-append-version="true" /> }

</div>
