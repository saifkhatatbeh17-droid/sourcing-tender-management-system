@model IEnumerable<SourcingTenderManagement.Models.Entities.Clarification>
@{ ViewData["Title"] = "Clarifications"; }
<div class="supplier-page-heading"><div><p class="eyebrow">TENDER COMMUNICATION</p><h1>Clarifications</h1><p>Questions and answers linked to your tender invitations and offers.</p></div></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (!Model.Any()) { <section class="supplier-card"><div class="empty-state"><h2>No clarification requests</h2><p>Clarifications connected to your invited tenders or offers will appear here.</p></div></section> } else { <div class="clarification-list">@foreach (var item in Model) { <section class="supplier-card"><div class="supplier-card-heading"><div><span class="eyebrow">@(item.Tender != null ? $"TND-{item.TenderId:D6} · {item.Tender.Title}" : $"BID-{item.BidId:D6}")</span><h2>@item.Subject</h2></div><span class="status-badge status-@item.Status.ToLowerInvariant()">@item.Status</span></div><p class="clarification-message">@item.Description</p><small class="text-muted">Opened @item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small>
<div class="response-thread">@foreach (var reply in item.ClarificationResponses.OrderBy(r => r.CreatedAt)) { <div class="response-entry"><strong>@reply.RespondedByUser.FullName</strong><small>@reply.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small><p>@reply.Message</p></div> }</div>
@if (item.Status != "Resolved") { <form asp-action="Reply" method="post" class="reply-form"><input type="hidden" name="id" value="@item.ClarificationId"/><label class="form-label" for="reply-@item.ClarificationId">Reply to sourcing officer</label><textarea id="reply-@item.ClarificationId" name="message" class="form-control" rows="3" maxlength="4000" required placeholder="Write your reply"></textarea><button class="btn btn-primary btn-sm mt-2">Send reply</button></form> }</section> }</div> }

@section Styles { <link rel="stylesheet" href="~/css/supplier.css" asp-append-version="true" /> }
