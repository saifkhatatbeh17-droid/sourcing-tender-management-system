@model SourcingTenderManagement.Models.Entities.Invitation
@{ ViewData["Title"] = "Tender details"; var closed = Model.Tender.ClosesAt <= DateTime.UtcNow || Model.Tender.Status is not ("Open" or "Published"); var bid = Model.Bids.FirstOrDefault(); }
<p class="eyebrow">TND-@Model.TenderId.ToString("D6") · INVITATION #@Model.InvitationId.ToString("D6")</p><div class="supplier-page-heading"><div><h1>@Model.Tender.Title</h1><p>@Model.Tender.Description</p></div><span class="status-badge status-@Model.Status.ToLowerInvariant()">@Model.Status</span></div>
@await Component.InvokeAsync("DetailsQr", new { controller = "Supplier", action = "Invitation", id = Model.InvitationId, label = "Tender" })
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="supplier-detail-grid"><section class="supplier-card"><h2>Tender overview</h2><dl class="detail-list"><dt>Submission deadline</dt><dd>@Model.Tender.ClosesAt.ToLocalTime().ToString("dddd, dd MMM yyyy · HH:mm")</dd><dt>Invitation received</dt><dd>@Model.SentAt.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</dd><dt>Participation response</dt><dd>@(Model.RespondedAt?.ToLocalTime().ToString("dd MMM yyyy · HH:mm") ?? "No response recorded")</dd><dt>Terms and conditions</dt><dd>@(string.IsNullOrWhiteSpace(Model.Tender.Terms) ? "See tender documents" : Model.Tender.Terms)</dd></dl></section>
<section class="supplier-card"><h2>Requested items</h2>@foreach (var item in Model.Tender.PurchaseRequest.PurchaseRequestItems) { <div class="requested-item"><div><strong>@item.ItemName</strong><small>@item.Quantity.ToString("N3") @item.Unit requested</small></div><p>@item.Specifications</p></div> }</section></div>
<section class="supplier-card mt-3"><h2>Required documents</h2>@if (!Model.Tender.TenderDocuments.Any()) { <p class="text-muted mb-0">No tender documents are attached.</p> } else { <ul class="document-list">@foreach (var doc in Model.Tender.TenderDocuments) { <li><a asp-action="DownloadTenderDocument" asp-route-id="@doc.TenderDocumentId">@doc.OriginalFileName</a><small>@(doc.IsMandatory ? "Required" : "Optional")</small></li> }</ul> }</section>
@if (Model.Tender.EvaluationCriteria.Any()) { <section class="supplier-card mt-3"><h2>Published evaluation criteria</h2><div class="criteria-grid">@foreach (var criterion in Model.Tender.EvaluationCriteria) { <div><strong>@criterion.Name</strong><small>@criterion.Category · @criterion.Weight.ToString("N0")%</small><p>@criterion.Description</p></div> }</div></section> }
<section class="supplier-action-bar"><a asp-action="Invitations" class="btn btn-outline-secondary">Back to invitations</a><div>@if (Model.Status == "Pending" && !closed) { <form asp-action="Respond" method="post" class="d-inline" onsubmit="return confirm('Accept this tender invitation?')"><input type="hidden" name="id" value="@Model.InvitationId"/><input type="hidden" name="response" value="Accepted"/><button class="btn btn-primary">Accept invitation</button></form><form asp-action="Respond" method="post" class="d-inline" onsubmit="return confirm('Decline this tender invitation?')"><input type="hidden" name="id" value="@Model.InvitationId"/><input type="hidden" name="response" value="Declined"/><button class="btn btn-outline-danger">Decline</button></form> }
@if (Model.Status == "Accepted" && !closed) { if (bid == null) { <a asp-action="CreateOffer" asp-route-invitationId="@Model.InvitationId" class="btn btn-primary">Prepare offer</a> } else if (bid.Status == "Draft") { <a asp-action="CreateOffer" asp-route-invitationId="@Model.InvitationId" asp-route-bidId="@bid.BidId" class="btn btn-primary">Continue draft</a> } else { <a asp-action="Offer" asp-route-id="@bid.BidId" class="btn btn-primary">View submitted offer</a> } }
@if (Model.Status == "Accepted" && closed && bid?.Status == "Draft") { <span class="text-muted">Submission period has ended.</span> }</div></section>

@section Styles { <link rel="stylesheet" href="~/css/supplier.css" asp-append-version="true" /> }
